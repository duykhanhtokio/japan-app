/*
 * =========================================================
 * LOOKUP
 * =========================================================
 */

export const GAME_ITEM_BY_ID =
    new Map<
        GameItemId,
        GameItemDefinition
    >(
        GAME_ITEMS.map(
            item => [
                item.id,
                item,
            ]
        )
    );

export function getGameItem(
    id:
        GameItemId
) {
    return GAME_ITEM_BY_ID.get(
        id
    );
}
