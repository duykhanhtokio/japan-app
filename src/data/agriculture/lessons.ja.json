    {
      "id": "agr-flowers",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "花きの生産と利用形態",
      "objectiveJa": "花きの意味と統計上の利用形態を理解し、切り花と鉢ものを区別できる。",
      "paragraphs": [
        {
          "id": "agr-flowers-p1",
          "titleJa": "花きを学ぶ範囲",
          "textJa": "生産・栽培・販売の対象となる花は、花きとして扱われます。食用の野菜や果実と同じ分類にまとめず、農業の一つの生産分野として整理します。",
          "knowledgeIds": [
            "AGR-K-FLOWERS-01"
          ]
        },
        {
          "id": "agr-flowers-p2",
          "titleJa": "切り花類",
          "textJa": "資料の花き統計には切り花類の区分があります。キクやバラなど、作物名と販売・利用の形態を結び付けて読みましょう。",
          "knowledgeIds": [
            "AGR-K-FLOWERS-02"
          ]
        },
        {
          "id": "agr-flowers-p3",
          "titleJa": "鉢もの類",
