    {
      "id": "agr-flowering",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "花芽分化と日長・低温",
      "objectiveJa": "花芽分化のきっかけを整理し、短日・長日と暗い時間の関係を取り違えない。",
      "paragraphs": [
        {
          "id": "agr-flowering-p1",
          "titleJa": "花芽分化とは",
          "textJa": "栄養成長がある程度進み、花芽がつくられる段階を花芽分化と呼びます。花芽ができることと、すでに花が開いていることは区別して観察します。",
          "knowledgeIds": [
            "AGR-K-FLOWERING-01"
          ]
        },
        {
          "id": "agr-flowering-p2",
          "titleJa": "成長に伴うタイプ",
          "textJa": "トマトは、ある程度成長した後、規則的に花芽分化する作物の例です。この説明と、環境の変化がきっかけになるタイプを分けて理解します。",
          "knowledgeIds": [
            "AGR-K-FLOWERING-02"
          ]
        },
        {
          "id": "agr-flowering-p3",
          "titleJa": "環境の影響を受けるタイプ",
          "textJa": "温度や日長などの環境条件が花芽分化に影響するタイプもあります。作物名だけで判断するのではなく、どの条件について説明しているのかを確認します。",
          "knowledgeIds": [
            "AGR-K-FLOWERING-03"
          ]
        },
        {
          "id": "agr-flowering-p4",
          "titleJa": "短日植物",
          "textJa": "イチゴやキクは、短日植物の例です。一定の長さより暗い時間が長い、言い換えると明るい時間が短い条件に着目します。すべての種類に共通する具体的な時間数は、この説明からは決まりません。",
          "knowledgeIds": [
            "AGR-K-FLOWERING-04"
          ]
        },
        {
          "id": "agr-flowering-p5",
          "titleJa": "長日植物",
          "textJa": "ホウレンソウは長日植物の例です。短日植物とは反対に、一定の長さより暗い時間が短い条件に着目します。「長い」のが暗い時間なのか明るい時間なのかを、必ず確かめましょう。",
          "knowledgeIds": [
            "AGR-K-FLOWERING-05"
          ]
        },
        {
          "id": "agr-flowering-p6",
          "titleJa": "低温の影響",
          "textJa": "低温に遭うことで花芽分化する作物の例に、ダイコン、キャベツ、ブロッコリーがあります。日長と低温は異なる条件なので、一つの条件の説明ですべてを置き換えないようにします。",
          "knowledgeIds": [
            "AGR-K-FLOWERING-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "花芽分化",
          "reading": "かがぶんか"
        },
        {
          "ja": "日長",
          "reading": "にっちょう"
        },
        {
          "ja": "短日植物",
          "reading": "たんじつしょくぶつ"
        },
        {
          "ja": "長日植物",
          "reading": "ちょうじつしょくぶつ"
        }
      ],
      "activityJa": "「短日・長日・低温」の比較表を作ります。暗い時間の長短、本文の作物例、具体的な時間数が示されていないことを別々に整理して説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 10,
          "printedPage": 4
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 12,
          "printedPage": 10
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "4d57dba7c9477a4e9f74bdd38926d28278c0b050558ef863dd6ead598f3e8e15"
    },
    {
      "id": "agr-crop-plan",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "作付体系・作型と収穫時期",
      "objectiveJa": "栽培する順序の計画と作型を区別し、促成・抑制を普通栽培との比較で説明できる。",
      "paragraphs": [
        {
          "id": "agr-crop-plan-p1",
          "titleJa": "何をどの順で作るか",
          "textJa": "作付体系を考えるときは、どの作物を、どの順序で育てるかを整理します。一つの作物の名前を並べるだけでなく、栽培のつながりを考えることが大切です。",
          "knowledgeIds": [
            "AGR-K-CROP-PLAN-01"
          ]
        },
        {
          "id": "agr-crop-plan-p2",
          "titleJa": "作型を組み立てる",
          "textJa": "作型は、季節や地域の環境に合わせ、品種の選定や播種から収穫までの計画・技術を組み合わせたものとして理解します。種をまく日だけを指す言葉ではありません。",
          "knowledgeIds": [
            "AGR-K-CROP-PLAN-02"
          ]
        },
        {
          "id": "agr-crop-plan-p3",
          "titleJa": "播種時期で分ける",
          "textJa": "キャベツやダイコンなどでは、春まき、夏まき、秋まきといった作型があります。まいた季節と収穫の季節は別の情報なので、二つを対応させて記録します。",
          "knowledgeIds": [
            "AGR-K-CROP-PLAN-03"
          ]
        },
        {
          "id": "agr-crop-plan-p4",
          "titleJa": "促成栽培",
          "textJa": "トマトやキュウリなどの施設栽培で、露地の普通栽培より生育や収穫時期を早める方法が促成栽培です。何と比べて早いのかを含めて説明しましょう。",
          "knowledgeIds": [
            "AGR-K-CROP-PLAN-04"
          ]
        },
        {
          "id": "agr-crop-plan-p5",
          "titleJa": "抑制栽培",
          "textJa": "普通栽培より生育や収穫時期を遅らせる方法が抑制栽培です。早める促成栽培と、名称や矢印の向きを取り違えないようにします。",
          "knowledgeIds": [
            "AGR-K-CROP-PLAN-05"
          ]
        },
        {
          "id": "agr-crop-plan-p6",
          "titleJa": "作型図の読み方",
          "textJa": "作型図では、播種の記号、ハウスの範囲、収穫期間を別々に読み取ります。図の例の月を、そのまま全国すべての地域・品種に共通する作業日程と考えてはいけません。",
          "knowledgeIds": [
            "AGR-K-CROP-PLAN-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "作付体系",
          "reading": "さくつけたいけい"
        },
        {
          "ja": "作型",
          "reading": "さくがた"
        },
        {
          "ja": "促成栽培",
          "reading": "そくせいさいばい"
        },
        {
          "ja": "抑制栽培",
          "reading": "よくせいさいばい"
        }
      ],
      "activityJa": "普通栽培の収穫時期を基準に、促成と抑制を左右に配置します。次に、播種・施設利用・収穫の三つを別の記号で表した説明図を自分で作ります。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 10,
          "printedPage": 4
        },
        {
          "documentId": "AGR-S1",
          "pdfPage": 11,
          "printedPage": 5
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 12,
          "printedPage": 10
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 13,
          "printedPage": 11
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "655f67184582087bc66dd988bd5b03af717c02c89cb0580df74a9fea378a7da3"
