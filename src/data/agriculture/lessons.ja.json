    {
      "id": "agr-nursery",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "育苗と定植の仕事",
      "objectiveJa": "育苗と定植を順序で説明し、機械植えと手植えの長所・短所を比較できる。",
      "paragraphs": [
        {
          "id": "agr-nursery-p1",
          "titleJa": "育苗する場所",
          "textJa": "本来栽培する田畑とは別の場所で、種から苗を育てることを育苗と呼びます。苗を育てる場所は苗床です。種をまく場所と、後で栽培する場所を分けて考えます。",
          "knowledgeIds": [
            "AGR-K-NURSERY-01"
          ]
        },
        {
          "id": "agr-nursery-p2",
          "titleJa": "苗を守る",
          "textJa": "育苗では、雨や風などの天候の変化、病気、害虫から苗を守りやすくなります。ただし、育苗すれば病害虫が絶対に発生しない、という意味ではありません。",
          "knowledgeIds": [
            "AGR-K-NURSERY-02"
          ]
        },
        {
          "id": "agr-nursery-p3",
          "titleJa": "そろった苗を作る",
          "textJa": "健康で生育のそろった苗を、比較的狭い場所で効率よく育てられることが育苗の利点です。苗の大きさや生育のばらつきを見る視点も必要です。",
          "knowledgeIds": [
            "AGR-K-NURSERY-03"
          ]
        },
        {
          "id": "agr-nursery-p4",
          "titleJa": "田畑の利用期間",
          "textJa": "育苗期間を別の場所で過ごすことで、本来の畑でその作物を育てる期間を短くできます。その間に別の作物を育てるなど、畑の使い方と関連付けて考えます。",
          "knowledgeIds": [
            "AGR-K-NURSERY-04"
          ]
        },
        {
          "id": "agr-nursery-p5",
          "titleJa": "定植と株間",
          "textJa": "育てた苗を田畑に植え付ける仕事が定植です。適した苗の育ち具合や、苗同士の間隔である株間は、作物の種類によって異なります。",
          "knowledgeIds": [
            "AGR-K-NURSERY-05"
          ]
        },
        {
          "id": "agr-nursery-p6",
          "titleJa": "機械植えと手植え",
          "textJa": "移植機は広い面積を短時間で植えられる一方、生育のそろった苗を用意するなどの技術が必要です。手植えは一株ずつ確実に植えられますが、時間と労力がかかります。手植えなら人件費も含めて費用が全く要らない、とは一般化しません。",
          "knowledgeIds": [
            "AGR-K-NURSERY-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "育苗",
          "reading": "いくびょう"
        },
        {
          "ja": "苗床",
          "reading": "なえどこ"
        },
        {
          "ja": "定植",
          "reading": "ていしょく"
        },
        {
          "ja": "株間",
          "reading": "かぶま"
        }
      ],
      "activityJa": "苗床から田畑へ移る流れを描き、育苗と定植の名称を書きます。機械植えと手植えを、作業速度・苗のそろい方・時間と労力の三項目で比較します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 12,
          "printedPage": 6
        },
        {
          "documentId": "AGR-S1",
          "pdfPage": 13,
          "printedPage": 7
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 15,
          "printedPage": 13
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 16,
          "printedPage": 14
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "c1a937413a433a99ba32d9e8c6a6a18f62ee806fa325596e9556fe46d4c8bc17"
    },
    {
      "id": "agr-crop-types",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "作物を用途から分類する",
      "objectiveJa": "食用・飼料・緑肥・工芸と園芸の区分を、用途や利用する部分から整理できる。",
      "paragraphs": [
        {
          "id": "agr-crop-types-p1",
          "titleJa": "作物という言葉",
          "textJa": "人が栽培している植物が作物です。資料では、農作物と園芸作物の分類を示しています。分類図を読むときは、上位の項目とその下の項目を区別します。",
          "knowledgeIds": [
            "AGR-K-CROP-TYPES-01"
          ]
        },
        {
          "id": "agr-crop-types-p2",
          "titleJa": "食用作物",
          "textJa": "イネ、ムギ、トウモロコシなど、人が主食として食べる作物が食用作物の例です。用途を説明する区分なので、葉や根などの器官の名前とは違います。",
          "knowledgeIds": [
            "AGR-K-CROP-TYPES-02"
          ]
        },
        {
          "id": "agr-crop-types-p3",
          "titleJa": "飼料作物と緑肥作物",
          "textJa": "家畜のえさに使う作物が飼料作物です。一方、肥料として土壌にすき込むために育てる作物が緑肥作物です。動物が食べる目的と、土へ戻す目的を混同しないでください。",
          "knowledgeIds": [
            "AGR-K-CROP-TYPES-03"
          ]
        },
        {
          "id": "agr-crop-types-p4",
          "titleJa": "工芸作物",
          "textJa": "ナタネ、ゴマ、ワタなどは、油や繊維などの工業原料を得る工芸作物の例です。名称の「工芸」を、完成した手工芸品だけの意味に狭めないようにします。",
          "knowledgeIds": [
            "AGR-K-CROP-TYPES-04"
          ]
        },
        {
          "id": "agr-crop-types-p5",
          "titleJa": "園芸作物",
          "textJa": "園芸作物には、果樹、野菜、観賞植物があります。食べることだけでなく、花やサボテンなどを見て楽しむ利用も含まれます。",
          "knowledgeIds": [
            "AGR-K-CROP-TYPES-05"
          ]
        },
        {
          "id": "agr-crop-types-p6",
          "titleJa": "栽培規模と機械化",
          "textJa": "資料は農作物で大面積・機械化が多い傾向、園芸作物では機械化しにくい作業や狭い面積での栽培も多い傾向を示しています。すべての農場に当てはまる絶対的な境界としては扱いません。",
          "knowledgeIds": [
            "AGR-K-CROP-TYPES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "飼料作物",
          "reading": "しりょうさくもつ"
        },
        {
          "ja": "緑肥作物",
          "reading": "りょくひさくもつ"
        },
        {
          "ja": "工芸作物",
          "reading": "こうげいさくもつ"
        },
        {
          "ja": "園芸作物",
          "reading": "えんげいさくもつ"
        }
      ],
      "activityJa": "「食用・飼料・緑肥・工芸」の四欄に用途を書き、園芸作物の三つの区分を別の図にまとめます。用途と栽培規模を同じ分類基準にしないよう確認します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 10,
          "printedPage": 8
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "d10fc90dea2cc955ee04b2c69927f4507a7dbd156498ec6db5333631a7f14601"
    },
    {
      "id": "agr-plant-responses",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "光の強さと水分の調節",
      "objectiveJa": "光飽和点という限界と、暑いとき・土が乾燥したときの水分反応を説明できる。",
      "paragraphs": [
        {
          "id": "agr-plant-responses-p1",
          "titleJa": "光を強くすればよいとは限らない",
          "textJa": "2号資料は、光飽和点に達するまでは、光が強いほど光合成が多くなると説明しています。この「達するまで」という範囲を省かないことが重要です。",
          "knowledgeIds": [
            "AGR-K-PLANT-RESPONSES-01"
          ]
        },
        {
          "id": "agr-plant-responses-p2",
          "titleJa": "光飽和点を超えた説明",
          "textJa": "この資料の説明から、光を際限なく強くすれば光合成も際限なく増える、とは言えません。光の強さを増やす効果には限界があることを読み取ります。",
          "knowledgeIds": [
            "AGR-K-PLANT-RESPONSES-02"
          ]
        },
        {
          "id": "agr-plant-responses-p3",
          "titleJa": "暑いときの水分の移動",
          "textJa": "気温が高いときや直射日光で暑いとき、作物は体内の温度が上がり過ぎないように余分な水分を外へ出します。水分を外へ出す働きと、根が吸う働きは分けて考えます。",
          "knowledgeIds": [
            "AGR-K-PLANT-RESPONSES-03"
          ]
        },
        {
          "id": "agr-plant-responses-p4",
          "titleJa": "蒸散が起こる部分",
          "textJa": "葉の気孔から水蒸気を出すことが蒸散です。液体の水を土に注ぐ作業や、肥料を与える作業の名前ではありません。",
          "knowledgeIds": [
            "AGR-K-PLANT-RESPONSES-04"
          ]
        },
        {
          "id": "agr-plant-responses-p5",
          "titleJa": "土が乾燥しているとき",
          "textJa": "乾燥が続いて土の水分が少ないとき、作物は水分を体内にとどめようとします。暑いときに外へ出すという説明だけを、あらゆる条件へ当てはめないようにしましょう。",
          "knowledgeIds": [
            "AGR-K-PLANT-RESPONSES-05"
          ]
        },
        {
          "id": "agr-plant-responses-p6",
          "titleJa": "観察と設定値を分ける",
          "textJa": "本文から整理できるのは、条件と反応の関係です。特定の作物の最適な照度、温度、かん水量まで決められるわけではありません。数値がない箇所へ、一律の設定値を追加しないでください。",
          "knowledgeIds": [
            "AGR-K-PLANT-RESPONSES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "光飽和点",
          "reading": "ひかりほうわてん"
        },
        {
          "ja": "直射日光",
          "reading": "ちょくしゃにっこう"
        },
        {
          "ja": "水分",
          "reading": "すいぶん"
        },
        {
          "ja": "乾燥",
          "reading": "かんそう"
        }
      ],
      "activityJa": "「光飽和点まで」「暑いとき」「土の水分が少ないとき」の三条件を見出しにして、作物の反応を書き分けます。本文で決まらない設定値は、未確定として分けます。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 9,
          "printedPage": 7
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 11,
          "printedPage": 9
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "2b43852ebebb6e415823dd199b4ad4a20b5395b3559601844a78aa3982033d00"
    },
    {
      "id": "agr-sowing-design",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "種のまき方と株間・条間",
      "objectiveJa": "ばらまき・すじまき・点まきと、直まきの理由や株間・条間を区別できる。",
      "paragraphs": [
        {
          "id": "agr-sowing-design-p1",
          "titleJa": "ばらまき",
          "textJa": "うね全体に種をまく方法がばらまきです。資料ではタマネギの育苗などが例です。無作為にどこへでもまくという意味に広げず、うね全体という範囲を確認します。",
          "knowledgeIds": [
            "AGR-K-SOWING-DESIGN-01"
          ]
        },
        {
          "id": "agr-sowing-design-p2",
          "titleJa": "すじまき",
          "textJa": "うねに一列に種をまく方法がすじまきです。ニンジンなどが例として挙げられています。種を置く位置が列状になることを図で表してください。",
          "knowledgeIds": [
            "AGR-K-SOWING-DESIGN-02"
          ]
        },
        {
          "id": "agr-sowing-design-p3",
          "titleJa": "点まき",
          "textJa": "一か所に数粒ずつまく方法が点まきです。資料ではダイコンなどが例です。一か所に必ず一粒だけという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-SOWING-DESIGN-03"
          ]
        },
        {
          "id": "agr-sowing-design-p4",
          "titleJa": "直根性と直まき",
          "textJa": "根がまっすぐ伸びる直根性の作物では、移植で根が傷んだり生育が遅れたりしやすいため、直まきします。ダイコン、ニンジン、オクラ、ヒマワリが資料の例です。",
          "knowledgeIds": [
            "AGR-K-SOWING-DESIGN-04"
          ]
        },
        {
          "id": "agr-sowing-design-p5",
          "titleJa": "短期間の葉菜類",
          "textJa": "栽培期間の短い葉菜類も、直まきすることが多いと説明されています。ホウレンソウやコマツナの例を、直根性だけを理由にした分類と混同しないようにします。",
          "knowledgeIds": [
            "AGR-K-SOWING-DESIGN-05"
          ]
        },
        {
          "id": "agr-sowing-design-p6",
          "titleJa": "株間と条間",
          "textJa": "定植した作物の列を条と呼び、列と列の間隔が条間です。株間は株同士の間隔で、条間とは異なります。作物ごとの具体的な間隔を、図の見た目だけから決めてはいけません。",
          "knowledgeIds": [
            "AGR-K-SOWING-DESIGN-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "直根性",
          "reading": "ちょっこんせい"
        },
        {
          "ja": "株間",
          "reading": "かぶま"
        },
        {
          "ja": "条間",
          "reading": "じょうかん"
        },
        {
          "ja": "条",
          "reading": "じょう"
        }
      ],
      "activityJa": "ばらまき・すじまき・点まきを、点と線で別々に描きます。次に二列の苗を描き、株間と条間に異なる色の線を付けて説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
