    {
      "id": "agr-germination",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "播種と発芽に必要な条件",
      "objectiveJa": "発芽三条件、光に対する性質、直まきと間引きを区別できる。",
      "paragraphs": [
        {
          "id": "agr-germination-p1",
          "titleJa": "播種と発芽",
          "textJa": "種をまく作業を播種と呼び、種から芽が出ることを発芽と呼びます。作業をしたという記録と、芽が出たという観察結果を分けましょう。",
          "knowledgeIds": [
            "AGR-K-GERMINATION-01"
          ]
        },
        {
          "id": "agr-germination-p2",
          "titleJa": "発芽三条件",
          "textJa": "発芽に必要な三条件は、水・温度・酸素です。光に対する性質の違いもありますが、発芽三条件の中の酸素を光に置き換えてはいけません。",
          "knowledgeIds": [
            "AGR-K-GERMINATION-02"
          ]
        },
        {
          "id": "agr-germination-p3",
          "titleJa": "覆土の役割",
          "textJa": "種をまいた後に土をかけることが覆土です。発芽条件を確保するための作業として捉え、どの種子にも同じ厚さで土をかけると決めつけないようにします。",
          "knowledgeIds": [
            "AGR-K-GERMINATION-03"
          ]
        },
        {
          "id": "agr-germination-p4",
          "titleJa": "明発芽種子と暗発芽種子",
          "textJa": "光があると発芽しやすい種子は明発芽種子、光があると発芽しにくい種子は暗発芽種子です。資料では、前者は薄く、後者は厚く覆土するという違いが説明されています。具体的な厚さを一律に決める説明ではありません。",
          "knowledgeIds": [
            "AGR-K-GERMINATION-04"
          ]
        },
        {
          "id": "agr-germination-p5",
          "titleJa": "直まき",
          "textJa": "直接、畑に種をまく方法が直まきです。ダイコンやニンジンなどで行います。苗を別の場所で育ててから植える方法とは区別してください。",
          "knowledgeIds": [
            "AGR-K-GERMINATION-05"
          ]
        },
        {
          "id": "agr-germination-p6",
          "titleJa": "間引き",
          "textJa": "直まき栽培では、余分な苗や、病害虫の影響がある苗、形に異常がある苗などを取り除き、苗同士の間隔を整えます。大きな苗を無条件に全部抜くという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-GERMINATION-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "播種",
          "reading": "はしゅ"
        },
        {
          "ja": "発芽",
          "reading": "はつが"
        },
        {
          "ja": "覆土",
          "reading": "ふくど"
        },
        {
          "ja": "間引き",
          "reading": "まびき"
        }
      ],
      "activityJa": "発芽三条件を何も見ずに書き、その後本文と照合します。明発芽・暗発芽を比較し、播種、発芽、間引きが同じ作業ではない理由を説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
