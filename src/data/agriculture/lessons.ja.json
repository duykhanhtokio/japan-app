    {
      "id": "agr-organs",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "作物の器官と二つの成長",
      "objectiveJa": "葉・茎・根と花・果実を役割で分け、栄養成長と生殖成長を説明できる。",
      "paragraphs": [
        {
          "id": "agr-organs-p1",
          "titleJa": "器官を役割で見る",
          "textJa": "作物のからだは、葉、茎、根、花、果実などで構成されています。形や位置を見分けるだけでなく、その部分がどのような役割をもつかも整理します。",
          "knowledgeIds": [
            "AGR-K-ORGANS-01"
          ]
        },
        {
          "id": "agr-organs-p2",
          "titleJa": "栄養器官",
          "textJa": "葉・茎・根は、作物が成長するための器官です。この三つを栄養器官と呼びます。「栄養」という語だけから肥料そのものを指すと考えないようにしましょう。",
          "knowledgeIds": [
            "AGR-K-ORGANS-02"
          ]
        },
        {
          "id": "agr-organs-p3",
          "titleJa": "生殖器官",
          "textJa": "花や果実は、次の世代につながる働きをもつ器官で、生殖器官と呼びます。栄養器官との違いは、大きさではなく、ここで学ぶ役割にあります。",
          "knowledgeIds": [
            "AGR-K-ORGANS-03"
          ]
        },
        {
          "id": "agr-organs-p4",
          "titleJa": "栄養成長",
          "textJa": "葉や茎、根が大きくなる成長が栄養成長です。たとえば、葉が増えたり茎が伸びたりする様子を、どの器官の変化かと結び付けて説明します。",
          "knowledgeIds": [
            "AGR-K-ORGANS-04"
          ]
        },
        {
          "id": "agr-organs-p5",
          "titleJa": "生殖成長",
          "textJa": "花や果実などをつくり、果実や種子の形成につながる成長が生殖成長です。作物の成長を、背が高くなることだけに限って理解しないことが大切です。",
          "knowledgeIds": [
            "AGR-K-ORGANS-05"
          ]
        },
        {
          "id": "agr-organs-p6",
          "titleJa": "移行の条件は一律ではない",
          "textJa": "栄養成長から生殖成長へ移る条件や、その移り方は作物によって異なります。すべての作物が同じ日数や同じ大きさで移る、と決めつけずに整理してください。",
          "knowledgeIds": [
            "AGR-K-ORGANS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "器官",
          "reading": "きかん"
        },
        {
          "ja": "栄養成長",
          "reading": "えいようせいちょう"
        },
        {
          "ja": "生殖成長",
          "reading": "せいしょくせいちょう"
        },
        {
          "ja": "種子",
          "reading": "しゅし"
        }
      ],
      "activityJa": "葉・茎・根・花・果実の五枚のカードを役割で分けます。その後、「茎が伸びる」と「果実をつくる」を、それぞれの成長と対応させて理由を説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 8,
          "printedPage": 2
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 9,
          "printedPage": 7
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "b6860139509b2eb4052e64097e6f3baee60de8e838b1a69b380637c53edd05a9"
    },
    {
      "id": "agr-plant-balance",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "光合成・呼吸・蒸散・吸収",
      "objectiveJa": "炭水化物をつくる働きと消費する働き、水分が入る経路と出る経路を区別できる。",
      "paragraphs": [
        {
          "id": "agr-plant-balance-p1",
          "titleJa": "光合成の材料と光",
          "textJa": "作物が光合成をするには、光・二酸化炭素・水が必要です。図や説明を読むときは、光と物質を区別し、何が必要なのかを三つそろえて確認します。",
          "knowledgeIds": [
            "AGR-K-PLANT-BALANCE-01"
          ]
        },
        {
          "id": "agr-plant-balance-p2",
          "titleJa": "つくられるもの",
          "textJa": "光合成によって炭水化物がつくられます。水や二酸化炭素を取り込むことと、炭水化物を合成することを同じ意味にせず、材料と生成物を分けて考えます。",
          "knowledgeIds": [
            "AGR-K-PLANT-BALANCE-02"
          ]
        },
        {
          "id": "agr-plant-balance-p3",
          "titleJa": "呼吸との違い",
          "textJa": "作物は光合成だけでなく呼吸も行います。資料では、成長が盛んなときや温度が高いときに呼吸が盛んになることが説明されています。呼吸を、炭水化物をつくる光合成と取り違えないでください。",
          "knowledgeIds": [
            "AGR-K-PLANT-BALANCE-03"
          ]
        },
        {
          "id": "agr-plant-balance-p4",
          "titleJa": "夜温と蓄積",
          "textJa": "夜の温度が高いと呼吸による消費が増え、昼につくられた炭水化物のうち、作物に残る量が少なくなります。これだけで全作物に共通の適温を決めることはできません。",
          "knowledgeIds": [
            "AGR-K-PLANT-BALANCE-04"
          ]
        },
        {
          "id": "agr-plant-balance-p5",
          "titleJa": "葉から出る水分",
          "textJa": "葉の気孔から水蒸気が出る働きが蒸散です。土の水を根が吸うこととは、場所も水の移動する向きも異なります。",
          "knowledgeIds": [
            "AGR-K-PLANT-BALANCE-05"
          ]
        },
        {
          "id": "agr-plant-balance-p6",
          "titleJa": "根から入る養水分",
          "textJa": "作物は根を通して、土の中の養分や水分を吸収します。根から入る経路と葉から出る経路を区別すると、吸収と蒸散の関係を図で整理できます。",
          "knowledgeIds": [
            "AGR-K-PLANT-BALANCE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "光合成",
          "reading": "こうごうせい"
        },
        {
          "ja": "呼吸",
          "reading": "こきゅう"
        },
        {
          "ja": "蒸散",
          "reading": "じょうさん"
        },
        {
          "ja": "気孔",
          "reading": "きこう"
        }
      ],
      "activityJa": "「光合成・呼吸・蒸散・養水分の吸収」の四欄を作ります。必要なもの、起こる部分、水や炭水化物の移動について、本文で確認できたことだけを書き込みます。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 8,
