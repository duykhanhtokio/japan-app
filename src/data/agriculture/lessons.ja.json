    },
    {
      "id": "agr-fruit",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "常緑果樹と落葉果樹",
      "objectiveJa": "資料に挙がる果樹を常緑・落葉に分け、代表的な栽培地域の傾向を説明できる。",
      "paragraphs": [
        {
          "id": "agr-fruit-p1",
          "titleJa": "葉の性質で整理する",
          "textJa": "果樹には常緑果樹と落葉果樹があります。果実の色や甘さだけで分類せず、葉の性質に着目して学びましょう。",
          "knowledgeIds": [
            "AGR-K-FRUIT-01"
          ]
        },
        {
          "id": "agr-fruit-p2",
          "titleJa": "常緑果樹の例",
          "textJa": "ウンシュウミカンなどのかんきつ類や、ビワは常緑果樹として整理します。名前を覚えるだけでなく、分類と組み合わせて確認してください。",
          "knowledgeIds": [
            "AGR-K-FRUIT-02"
          ]
        },
        {
          "id": "agr-fruit-p3",
          "titleJa": "落葉果樹の例",
          "textJa": "リンゴ、ブドウ、ナシ、モモ、カキは落葉果樹の例です。よく食べる果実でも、木の分類を別に確認することが必要です。",
          "knowledgeIds": [
            "AGR-K-FRUIT-03"
          ]
        },
        {
          "id": "agr-fruit-p4",
          "titleJa": "気候と栽培地域",
          "textJa": "リンゴは寒い地域、ウンシュウミカンは暖かい地域で多く栽培されています。これは代表的な傾向であり、その地域以外では絶対に作れないという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-FRUIT-04"
          ]
        },
        {
          "id": "agr-fruit-p5",
          "titleJa": "分類と産地の違い",
          "textJa": "常緑・落葉は果樹の分類、寒い・暖かいは栽培地域の気候の説明です。別の情報として整理すると、混同を防げます。",
          "knowledgeIds": [
            "AGR-K-FRUIT-05"
          ]
        },
        {
          "id": "agr-fruit-p6",
          "titleJa": "今日の整理",
          "textJa": "七つの例を常緑・落葉に分けたあと、リンゴとウンシュウミカンの栽培地域の傾向を説明してください。「多い」を「そこだけ」に言い換えないようにしましょう。",
          "knowledgeIds": [
            "AGR-K-FRUIT-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "常緑果樹",
          "reading": "じょうりょくかじゅ"
        },
        {
          "ja": "落葉果樹",
          "reading": "らくようかじゅ"
        },
        {
          "ja": "果樹",
          "reading": "かじゅ"
        },
        {
          "ja": "栽培",
          "reading": "さいばい"
        }
      ],
      "activityJa": "果樹名をカードに書いて二群に分け、分類理由を声に出して説明します。リンゴとウンシュウミカンは、地域の気候の傾向も別の欄に加えます。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 7,
          "printedPage": 1
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 6,
          "printedPage": 4
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "b915024a36469c05ff9670fd762bcd4e2538e4fbfc1b98c603804ce104c1ddd5"
    },
    {
      "id": "agr-climate",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "日本の気候と農業の地域差",
      "objectiveJa": "南北差・四季・冬の地域差を整理し、資料の気候説明を全国一律の条件にしない。",
      "paragraphs": [
        {
          "id": "agr-climate-p1",
          "titleJa": "南北の違い",
          "textJa": "日本の気候を一つの条件だけで説明することはできません。資料では、沖縄の亜熱帯、北海道の亜寒帯という南北の違いが示されています。",
          "knowledgeIds": [
            "AGR-K-CLIMATE-01"
          ]
        },
        {
          "id": "agr-climate-p2",
          "titleJa": "四季の流れ",
          "textJa": "春は気温が上がり、植物の生長が始まります。梅雨には長雨があり、その後は高温多湿の夏へ進みます。季節と作物の状態を結び付けて考えましょう。",
          "knowledgeIds": [
            "AGR-K-CLIMATE-02"
          ]
        },
        {
          "id": "agr-climate-p3",
          "titleJa": "冬の地域差",
          "textJa": "冬は、日本海側で雪が降りやすく、太平洋側では乾燥した晴天が続きやすいという違いがあります。両側を取り違えると、地域の説明が逆になります。",
          "knowledgeIds": [
            "AGR-K-CLIMATE-03"
          ]
        },
        {
          "id": "agr-climate-p4",
          "titleJa": "雨の降り方",
          "textJa": "資料は、局地的な大雨や線状降水帯にも触れています。短時間の雨と、広い範囲で長く続く雨を区別し、単に雨量が多いという一語にまとめないようにします。",
          "knowledgeIds": [
            "AGR-K-CLIMATE-04"
          ]
        },
        {
          "id": "agr-climate-p5",
          "titleJa": "土地と作物",
          "textJa": "水田ではイネが、畑地では畑作物や野菜、果樹、花などが育てられています。土地の区分と作物の例を組み合わせて理解してください。",
          "knowledgeIds": [
            "AGR-K-CLIMATE-05"
          ]
        },
        {
          "id": "agr-climate-p6",
          "titleJa": "今日の整理",
          "textJa": "沖縄と北海道、日本海側と太平洋側の冬を比較します。資料の説明は地域の傾向であり、その日の作業可否を決める気象予報そのものではありません。",
          "knowledgeIds": [
            "AGR-K-CLIMATE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "亜熱帯",
          "reading": "あねったい"
        },
        {
          "ja": "亜寒帯",
          "reading": "あかんたい"
        },
        {
          "ja": "梅雨",
          "reading": "つゆ"
        },
        {
          "ja": "水田",
          "reading": "すいでん"
        }
      ],
      "activityJa": "日本の簡単な位置図に南北の気候差と冬の地域差を書き込みます。四季の流れも加え、地域差と季節差を分けて説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 3,
          "printedPage": 1
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "ddcee332204a8d627b6c832c733ad7721ef9efedf32ee880a205f1fbfae7bb7b"
    },
    {
      "id": "agr-statistics",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "農業統計の年と割合を読む",
      "objectiveJa": "統計の年・単位・対象・割合の分母を確認し、異なる統計を混ぜない。",
      "paragraphs": [
        {
          "id": "agr-statistics-p1",
          "titleJa": "最初に年を見る",
          "textJa": "資料の農業統計には2019年の値や、平成30年の花きの統計があります。資料に載る数値を、そのまま現在の数値として説明してはいけません。",
          "knowledgeIds": [
            "AGR-K-STATISTICS-01"
          ]
        },
        {
          "id": "agr-statistics-p2",
          "titleJa": "割合の分母を確認する",
          "textJa": "2019年の農業産出額の説明では、野菜24％、米20％、果実9％、花き4％という割合が示されています。これは作付面積の割合や、重量の割合とは異なります。",
          "knowledgeIds": [
            "AGR-K-STATISTICS-02"
          ]
        },
        {
          "id": "agr-statistics-p3",
          "titleJa": "金額の単位を確認する",
          "textJa": "同じ金額でも、円・億円・兆円では表示が変わります。表題と単位を確認してから比較し、単位が異なる数字をそのまま足し算しないようにします。",
          "knowledgeIds": [
            "AGR-K-STATISTICS-03"
          ]
        },
        {
          "id": "agr-statistics-p4",
          "titleJa": "自給率の指標を区別する",
          "textJa": "資料にはカロリーベースの説明と、重量ベースの2019年の表があります。指標が違うため、同じ分母の百分率として単純に比べることはできません。",
          "knowledgeIds": [
            "AGR-K-STATISTICS-04"
          ]
        },
        {
          "id": "agr-statistics-p5",
          "titleJa": "花きの内訳と全体",
          "textJa": "花き全体の金額に対する切り花類などの割合と、農業全体に対する花きの割合は別の比率です。何を100％とした数字かを書き添えてください。",
          "knowledgeIds": [
            "AGR-K-STATISTICS-05"
          ]
        },
        {
          "id": "agr-statistics-p6",
          "titleJa": "今日の整理",
          "textJa": "年・単位・対象・分母の四つを先に記録します。別の年の数字は別の欄に置き、数字が違うだけで資料の誤りと判断しないようにしましょう。",
          "knowledgeIds": [
            "AGR-K-STATISTICS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "産出額",
          "reading": "さんしゅつがく"
        },
        {
          "ja": "自給率",
          "reading": "じきゅうりつ"
        },
        {
          "ja": "割合",
          "reading": "わりあい"
        },
        {
          "ja": "単位",
          "reading": "たんい"
        }
      ],
      "activityJa": "資料の2019年の説明を使い、年・単位・対象・分母の記録欄を作ります。花きの内訳の割合と農業全体に占める割合が同じ意味でない理由を説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
