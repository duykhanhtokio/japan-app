    {
      "id": "agr-rice",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "稲作と米の利用",
      "objectiveJa": "イネの分類と、もみ・玄米・白米の違いを説明できる。",
      "paragraphs": [
        {
          "id": "agr-rice-p1",
          "titleJa": "稲作の対象",
          "textJa": "稲作は、米を得るためにイネを育てる仕事です。イネという植物と、収穫後に食用などに使う米を区別しましょう。",
          "knowledgeIds": [
            "AGR-K-RICE-01"
          ]
        },
        {
          "id": "agr-rice-p2",
          "titleJa": "イネの分類",
          "textJa": "世界で育てられるイネには、アジアイネとアフリカイネがあります。アジアイネはインディカとジャポニカに大別され、日本の栽培ではジャポニカが中心です。",
          "knowledgeIds": [
            "AGR-K-RICE-02"
          ]
        },
        {
          "id": "agr-rice-p3",
          "titleJa": "もみから玄米へ",
          "textJa": "収穫したもみから、もみ殻を取り除くと玄米になります。玄米をさらに精米すると、食卓でよく使われる白米になります。脱穀と、もみ殻を取る作業を同じ意味にしないことが大切です。",
          "knowledgeIds": [
            "AGR-K-RICE-03"
          ]
        },
        {
          "id": "agr-rice-p4",
          "titleJa": "食用以外の利用",
          "textJa": "米の用途は、そのまま炊いて食べることだけではありません。家畜の飼料にする米や、米粉などに加工する米も作られています。用途によって区分して整理しましょう。",
          "knowledgeIds": [
            "AGR-K-RICE-04"
          ]
        },
        {
          "id": "agr-rice-p5",
          "titleJa": "作業のつながり",
          "textJa": "田を耕す、苗を植える、収穫する、脱穀・調整をするという作業を、年間の流れの中で捉えます。これらの稲作作業では機械化が進んでいます。",
          "knowledgeIds": [
            "AGR-K-RICE-05"
          ]
        },
        {
          "id": "agr-rice-p6",
          "titleJa": "今日の整理",
          "textJa": "玄米と白米の違いを、処理の順序を使って説明してください。続いて、日本で中心となるイネの分類と、米の二つの食用以外の用途を確認しましょう。",
          "knowledgeIds": [
            "AGR-K-RICE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "稲作",
          "reading": "いなさく"
        },
        {
          "ja": "玄米",
          "reading": "げんまい"
        },
        {
          "ja": "精米",
          "reading": "せいまい"
        },
        {
          "ja": "飼料",
          "reading": "しりょう"
        }
      ],
      "activityJa": "「もみ→玄米→白米」を紙に描き、各矢印に何をするかを書きます。次に、食用・飼料用・加工用を用途別に整理し、イネの分類図と照合してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 7,
          "printedPage": 1
        },
        {
