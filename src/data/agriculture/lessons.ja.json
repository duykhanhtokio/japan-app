        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "082543983ec36686dab7ba6d1d0f76c43156b06db90ef54e9430fe2d128abf28"
    },
    {
      "id": "agr-vegetables",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "野菜の利用部位と栽培の場所",
      "objectiveJa": "野菜の利用部位と、露地栽培・施設栽培を区別できる。",
      "paragraphs": [
        {
          "id": "agr-vegetables-p1",
          "titleJa": "利用する部分を見る",
          "textJa": "野菜を分けるときは、何を収穫して利用するのかを考えます。根や地下の茎などを利用する根菜類、葉を利用する葉菜類、実を利用する果菜類という分け方があります。",
          "knowledgeIds": [
            "AGR-K-VEGETABLES-01"
          ]
        },
        {
          "id": "agr-vegetables-p2",
          "titleJa": "分類の軸を混ぜない",
          "textJa": "根菜類という呼び方は、食べる部分に着目した分類です。露地栽培や施設栽培という呼び方は、育てる場所や設備に着目しています。二つの分類は同じ軸ではありません。",
          "knowledgeIds": [
            "AGR-K-VEGETABLES-02"
          ]
        },
        {
          "id": "agr-vegetables-p3",
          "titleJa": "露地と施設",
          "textJa": "屋外の畑で育てる露地栽培に加え、ハウスなどを利用する施設栽培も行われています。施設の利用と、作物そのものの種類を区別して記録しましょう。",
          "knowledgeIds": [
            "AGR-K-VEGETABLES-03"
          ]
        },
        {
          "id": "agr-vegetables-p4",
          "titleJa": "周年栽培",
          "textJa": "環境を管理する機器や被覆資材などを活用し、同じ種類の野菜を一年を通じて生産することを周年栽培といいます。単に同じ場所で同じ作物を続けるという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-VEGETABLES-04"
          ]
        },
        {
          "id": "agr-vegetables-p5",
          "titleJa": "産地リレー",
          "textJa": "地域の気候や標高の違いを利用し、生産地を移しながら一年を通じて野菜を供給する方法が産地リレーです。周年栽培と産地リレーは、着目する仕組みが異なります。",
          "knowledgeIds": [
            "AGR-K-VEGETABLES-05"
          ]
        },
        {
          "id": "agr-vegetables-p6",
          "titleJa": "今日の整理",
          "textJa": "野菜の分類を「利用部位」「栽培場所」「年間の供給方法」の三つに分けて整理してください。一つの野菜に、異なる軸の説明を組み合わせることができます。",
          "knowledgeIds": [
            "AGR-K-VEGETABLES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "根菜類",
          "reading": "こんさいるい"
        },
        {
          "ja": "果菜類",
          "reading": "かさいるい"
        },
        {
          "ja": "露地栽培",
          "reading": "ろじさいばい"
        },
        {
          "ja": "周年栽培",
          "reading": "しゅうねんさいばい"
        }
      ],
      "activityJa": "三列の表を作り、利用部位・栽培場所・年間供給の仕組みを別々に書きます。周年栽培と産地リレーについて、どこを変える方法なのかを説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 7,
          "printedPage": 1
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 5,
          "printedPage": 3
        },
        {
          "documentId": "AGR-S2",
