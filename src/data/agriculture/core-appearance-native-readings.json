      "sourceSnapshot": {
        "schemaVersion": 1,
        "figureId": "agr-royal-week01-fruit-tree-comparison",
        "lessonId": "agr-fruit",
        "sourceHash": "b915024a36469c05ff9670fd762bcd4e2538e4fbfc1b98c603804ce104c1ddd5",
        "assetPath": "assets/agriculture/royal-weekly-20261107/week01/evergreen-deciduous-tree-examples.webp",
        "assetSha256": "f7f832a3e31f513f690c3987a53a052514be6b5517ea61aabf3dc0d712a0d8d6",
        "status": "translated_ai_unreviewed",
        "translatedDirectlyFrom": "ja",
        "humanReviewed": false,
        "nativeReviewed": false,
        "domainReviewed": false,
        "altJa": "左は葉を付けたウンシュウミカンの木の例、右は葉が落ちた状態のリンゴの木の例です。葉の性質を比べます。"
      },
      "canonicalJapanese": {
        "titleJa": "常緑果樹と落葉果樹",
        "paragraphs": [
          {
            "id": "agr-fruit-p1",
            "titleJa": "葉の性質で整理する",
            "textJa": "果樹には常緑果樹と落葉果樹があります。果実の色や甘さだけで分類せず、葉の性質に着目して学びましょう。"
          },
          {
            "id": "agr-fruit-p2",
            "titleJa": "常緑果樹の例",
            "textJa": "ウンシュウミカンなどのかんきつ類や、ビワは常緑果樹として整理します。名前を覚えるだけでなく、分類と組み合わせて確認してください。"
          },
          {
            "id": "agr-fruit-p3",
            "titleJa": "落葉果樹の例",
            "textJa": "リンゴ、ブドウ、ナシ、モモ、カキは落葉果樹の例です。よく食べる果実でも、木の分類を別に確認することが必要です。"
          },
          {
            "id": "agr-fruit-p4",
            "titleJa": "気候と栽培地域",
            "textJa": "リンゴは寒い地域、ウンシュウミカンは暖かい地域で多く栽培されています。これは代表的な傾向であり、その地域以外では絶対に作れないという意味ではありません。"
          },
          {
            "id": "agr-fruit-p5",
            "titleJa": "分類と産地の違い",
            "textJa": "常緑・落葉は果樹の分類、寒い・暖かいは栽培地域の気候の説明です。別の情報として整理すると、混同を防げます。"
          },
          {
            "id": "agr-fruit-p6",
            "titleJa": "今日の整理",
            "textJa": "七つの例を常緑・落葉に分けたあと、リンゴとウンシュウミカンの栽培地域の傾向を説明してください。「多い」を「そこだけ」に言い換えないようにしましょう。"
          }
        ]
      },
