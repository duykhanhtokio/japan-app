      "canonicalJapanese": {
        "agr-flowers": {
          "titleJa": "花きの生産と利用形態",
          "paragraphs": [
            {
              "id": "agr-flowers-p1",
              "titleJa": "花きを学ぶ範囲",
              "textJa": "生産・栽培・販売の対象となる花は、花きとして扱われます。食用の野菜や果実と同じ分類にまとめず、農業の一つの生産分野として整理します。"
            },
            {
              "id": "agr-flowers-p2",
              "titleJa": "切り花類",
              "textJa": "資料の花き統計には切り花類の区分があります。キクやバラなど、作物名と販売・利用の形態を結び付けて読みましょう。"
            },
            {
              "id": "agr-flowers-p3",
              "titleJa": "鉢もの類",
              "textJa": "シクラメンや洋ランなどの鉢もの類も示されています。切り花類と鉢もの類は、同じ花きの中でも利用形態が異なります。"
            },
            {
              "id": "agr-flowers-p4",
              "titleJa": "統計は当時の値",
              "textJa": "花きの図表には平成30年などの年の表示があります。掲載当時の構成や産地の説明と、現在の市場動向を混同してはいけません。"
            },
            {
              "id": "agr-flowers-p5",
              "titleJa": "地域と生産",
              "textJa": "資料は花きの県別産出額も示しています。順位を扱うときは、対象年と金額の単位を添え、その順位が将来も固定だと説明しないようにします。"
            },
            {
              "id": "agr-flowers-p6",
              "titleJa": "今日の整理",
              "textJa": "花きという分野、切り花類・鉢もの類という区分、統計の対象年を分けてまとめます。詳しい栽培作業は、2号の花き栽培作業の章で別に学びます。"
            }
          ]
        },
        "agr-f40-general-history-flower-records": {
          "titleJa": "導入の歴史と平成30年の花き統計を補う",
          "paragraphs": [
            {
              "id": "agr-f40-general-history-flower-records-p1",
              "titleJa": "導入の歴史と品質向上",
              "textJa": "資料は、トマト・キャベツ・ハクサイ・タマネギを1886年以降に外国から導入された野菜の例としています。日本で栽培されることと、日本原産であることは別です。また、野菜の品質向上には品種と栽培技術の改良が関係しています。導入の時期、原産の区分、品質をよくする取組を混ぜずに説明しましょう。"
            },
            {
              "id": "agr-f40-general-history-flower-records-p2",
              "titleJa": "花き生産の変化を時代順に追う",
              "textJa": "近代の花き栽培は、明治以降に入った欧米の技術・文化と、新しい品種・栽培技術によって発展しました。戦後は生活様式の変化や品目の導入に伴い、生産と消費が増えました。その後、バブル崩壊後の消費停滞と単価低下が生産の変化の背景になったと資料は説明しています。これは資料が述べる歴史であり、現在の市況予測ではありません。"
            },
            {
              "id": "agr-f40-general-history-flower-records-p3",
              "titleJa": "花き全体と利用形態の合計を分ける",
              "textJa": "平成30年の花きの図では、全体は3,567億円です。その内訳の合計として、切り花類は2,024億円・57％、鉢もの類は921億円・26％が示されています。割合の分母は花き全体です。農業全体の中で花きが占める割合とは区別します。図の注記では花きに別の調査額も加えているので、他の統計と範囲をそろえずに合算しません。"
            },
            {
              "id": "agr-f40-general-history-flower-records-p4",
              "titleJa": "切り花類の内訳を金額と割合で照合する",
              "textJa": "同じ平成30年の図で、切り花類の掲載値は、キク614億円・17％、ユリ202億円・6％、バラ164億円・5％、切り枝180億円・5％、トルコギキョウ121億円・3％、カーネーション103億円・3％、その他の切り花640億円・18％です。例えば、バラと切り枝は表示割合が同じでも金額は違います。丸めた割合だけで金額が等しいと判断せず、品目・億円・％を一組にして読みます。"
            },
            {
              "id": "agr-f40-general-history-flower-records-p5",
              "titleJa": "鉢ものとその他の形態を混ぜない",
              "textJa": "鉢もの類の内訳は、洋ラン353億円・10％、花木146億円・4％、観葉植物122億円・3％、シクラメン73億円・2％、その他227億円・6％です。別の区分として、花壇用苗もの300億円・8％、地植え花木類194億円・5％、芝75億円・2％、地被植物36億円・1％、球根類17億円・1％も載っています。同じ花木という語があっても、鉢ものの花木と地植え花木類は別欄です。"
            },
            {
              "id": "agr-f40-general-history-flower-records-p6",
              "titleJa": "順位と概数を元の表示へ戻して読む",
              "textJa": "平成30年度の県別花き産出額の順位例は、愛知、千葉、福岡、埼玉、静岡の順です。順位の年と対象を保ち、現在の順位とは呼びません。本文の花き約3,500億円、切り花約2,000億円、鉢もの約920億円は概数の説明です。図の3,567、2,024、921億円を誤記とせず、概数と詳しい表示を区別します。県別表の割合や農業全体の図にある未解決の数値は、この課から補正しません。"
            }
          ]
        }
      },
