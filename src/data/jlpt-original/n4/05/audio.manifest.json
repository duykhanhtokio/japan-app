  "items": [
    {
      "questionId": "jpapp-n4-original-05-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n4/05/audio/problem-1-01.mp3",
      "startMs": 134997,
      "endMs": 204372,
      "durationMs": 69375,
      "sha256": "66dbb05975ab98d8d1eab0daf57995cc0b1d76e53a758f31bb61dea3e5cfc11d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "洋服の店で、男の人と店員が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "買ったズボンの長さを少し短くしたいんですが、お願いできますか。いつも履く靴を持ってきました。先に料金を払ったほうがいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "料金は長さが決まってからで大丈夫です。まず、そのズボンに着替えて、持ってきた靴を履いてください。鏡の前で長さを見ます。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "家で測った紙があるんですが、それを見て切ってもらえませんか。着替えると時間がかかりそうで、急いでいるんです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "紙の長さは参考になりますが、実際に履くと位置が少し変わります。短くしすぎると戻せませんから、今ここで確かめましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-05-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n4/05/audio/problem-1-02.mp3",
      "startMs": 204372,
      "endMs": 277533,
      "durationMs": 73161,
      "sha256": "5f06d6be686a74fc14874579c71cca0dd497f913516cd68cdeaf1eb99a8c67a2",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "プールの受付で、男の人と係の人が話しています。男の人は、次に何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "初めてこのプールを使います。入場券はあの機械で買うんですね。水着とタオルは持っていますが、帽子がいるとは知りませんでした。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "泳ぐ方は全員、帽子が必要です。貸し出し用がありますので、入場券を買う前にこちらでサイズを合わせてください。料金はかかりません。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "家は近いので、取りに帰ってもいいんですが、泳げる時間が短くなりますね。大人の大きいサイズもありますか。頭が大きいほうなんです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "大きさは三種類あります。こちらをかぶってみてください。きつければ別のものを出します。帽子が決まってから、入場券を買いましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-05-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n4/05/audio/problem-1-03.mp3",
      "startMs": 277533,
      "endMs": 351548,
      "durationMs": 74015,
      "sha256": "26327934e69b31b949a32182b71b390569b2b74bd25ec3297a51e10e548de3ed",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "美術の教室で、学生と先生が話しています。学生は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、ポスターに貼る写真を持ってきました。でも途中で雨にぬれてしまいました。端が少し曲がっています。今、はさみで切っても大丈夫ですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ぬれたまま切ると破れやすいので、先に乾かしましょう。机に新聞を広げて、写真を一枚ずつ、重ならないように置いてください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "早く乾かすために、窓の近くに立ててもいいですか。机に全部広げると、ほかの人が作業する場所が少なくなりそうです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "立てると曲がった形のまま乾いてしまいます。隣の机は今日は使わないから、そちらに平らに広げましょう。のりで貼るのも乾いてからです。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-05-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n4/05/audio/problem-1-04.mp3",
      "startMs": 351548,
      "endMs": 424539,
      "durationMs": 72991,
      "sha256": "6056beeb3698b5b20c15946cae4dce973c05856f3b35016abed13954e4009e3f",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "ホテルで、男の人と係の人が電話で話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "部屋のテレビがつきません。リモコンのボタンを押しても、何も変わらないんです。新しいリモコンを受付まで取りに行ったほうがいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "リモコンの電池が切れているかもしれません。電池をお持ちしますが、二種類あるので、まず裏のふたを開けて、大きさを見ていただけますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "テレビの横にもボタンがありますね。これを押せば使えるでしょうか。急いで天気予報を見たいので、簡単な方法があると助かります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "横のボタンでもつけられますが、放送を選ぶにはリモコンを使うほうが便利です。電池の種類がわかれば、すぐお部屋へお持ちします。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-05-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n4/05/audio/problem-1-05.mp3",
      "startMs": 424539,
      "endMs": 501860,
      "durationMs": 77321,
      "sha256": "b0d1d087a55b4b43db8dc8e8b16ec3007d10c131acfd8c876f37322105cff748",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "海岸で、女の人と活動の係の人が話しています。女の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "海岸の掃除に来ました。あの人たちのところへ行って、一緒にごみを拾えばいいですか。袋と手袋は持ってきたので、すぐに始められます。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ありがとうございます。今日は場所を分けて掃除しています。初めに、この図で担当する場所を確認してください。あなたは三番の区域です。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "三番は、船が置いてある所ですね。友達は波の近くを掃除すると言っていました。そちらを手伝ったほうが早く終わると思うんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "波の近くはもう人数が十分います。船のそばは人が少ないので、お願いします。図で、どこからどこまでかを見てから行ってください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-05-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n4/05/audio/problem-1-06.mp3",
      "startMs": 501860,
      "endMs": 576216,
      "durationMs": 74356,
      "sha256": "aa8dc82a2e83caa13d64006db705df0abf09ff2e620539b00d3d926c14cf2678",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "二人が寄付された食品を整理しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "寄付された食品がたくさん届きましたね。箱に入ったままですけど、日付を見て古い順に並べましょうか。棚の空いている所なら、全部入りそうです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その前に種類ごとに分けましょう。お米、缶の食品、それ以外で三つの場所に置いてください。棚の場所は種類で決めてあります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "缶の食品だけでもかなりありますね。重い物を下の棚に入れたほうが安全だと思います。先に棚へ運んでから分けるのはどうですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "棚へ入れてしまうと、確認するとき出し直すことになります。まず机の上で種類を分けて、それから日付を確かめ、使う順番を決めます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-05-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "assets/jlpt-original/n4/05/audio/problem-1-07.mp3",
      "startMs": 576216,
      "endMs": 648631,
      "durationMs": 72415,
      "sha256": "b69bfb4c2ae7db7276d89dbfea360fd8d8fb7ec2109dfbeb769aaf1cc1a0787d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "自転車の店で、男の人と店員が話しています。男の人は、次に何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "番号で開ける鍵を買いましたが、最初の番号はどこに書いてありますか。説明書には自分で好きな番号に変えられるとありますね。家で変えればいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "最初は四つともゼロです。変え方を今ご説明しますが、その前に、決めたい番号を紙に書いておいてください。忘れると鍵を開けられなくなります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "自分の電話番号の最後の四つなら、忘れなさそうですね。鍵を自転車につけてから、番号を変えても大丈夫でしょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "つける前に番号を変え、開くことを確かめたほうがいいです。紙はなくさない場所に保管してください。番号を写すときは、よく確認しましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-05-v1-listening-1-08",
      "group": 1,
      "number": 8,
      "path": "assets/jlpt-original/n4/05/audio/problem-1-08.mp3",
      "startMs": 648631,
      "endMs": 719029,
      "durationMs": 70399,
      "sha256": "4a841ce88fb6a586aa1701a796c2e104bb2a775e789f14090d5153cb4da3379a",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "二人が市の部屋の予約について話しています。女の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "土曜日の集まり、会議室を予約しようと思う。十人なら小さい部屋でいいよね。今、電話すれば空いているか教えてもらえると思うんだけど。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "待って。昨日、山田さんから、もう五人来るかもしれないと聞いたよ。十五人になるなら、小さい部屋では机が足りないんじゃないかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "大きい部屋は料金が高いんだよね。でも誰も断りたくないし、十五人で申し込んでおけば安心かな。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
