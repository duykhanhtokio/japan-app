  "items": [
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n4/03/audio/problem-1-01.mp3",
      "startMs": 121312,
      "endMs": 211303,
      "durationMs": 89991,
      "sha256": "9ae87232c4d4176726c7cb169cc4a3e3336d8d9a7a9b29d82846fa32139484af",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "自転車の店で、男の人と店員が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "自転車の後ろのタイヤから空気が抜けるんです。朝入れたのに、帰るころにはまた柔らかくなっていました。修理をお願いできますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "もちろんです。中のゴムに穴があるか調べましょう。自転車はどこにありますか。ここへ持ってきましたか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "入口の横に置きました。買い物の袋を後ろのかごに入れたままです。袋を取ってから、中に運べばいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "自転車は私が運びますから、先に袋を持ってきてください。野菜が入っているなら、作業の間はこの涼しい所に置いておけますよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ありがとうございます。どのくらいかかりますか。直るまで店で待っていようと思っているんですが、夕方までかかるでしょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "穴が小さければ三十分くらいです。まず荷物を取ってきてください。そのあと、自転車を見て、終わる時間をお伝えします。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n4/03/audio/problem-1-02.mp3",
      "startMs": 211303,
      "endMs": 303235,
      "durationMs": 91932,
      "sha256": "0a8c534be12b9c814066befe44d0c684ccacea321731529764a7c7209dce2831",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で、学生と先生が話しています。学生は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、発表に使う写真を印刷したんですが、黒い線が入ってしまいました。このまま使うと見にくいと思います。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうですね。教室の機械は昨日から調子が悪いんです。職員室の機械で印刷し直しましょう。元の写真は持っていますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "携帯電話に入っています。でも、職員室に行く前に、発表の文章を直したほうがいいでしょうか。最後の文が少し長いので。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "文章は発表までに直せば大丈夫です。まず、写真を私のメールに送ってください。私のパソコンから印刷します。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "写真は三枚あるんですが、全部送りますか。一枚目だけはきれいに印刷できています。残りの二枚に線が入っています。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "では、二枚目と三枚目だけ送ってください。届いたら私が印刷します。あなたはその間に、文章を短くしておいてください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n4/03/audio/problem-1-03.mp3",
      "startMs": 303235,
      "endMs": 386196,
      "durationMs": 82961,
      "sha256": "b7b04f17881522cd785ccfc89c69906d71c446a87e9d96aa33012eb1ad84133d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、二人が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "明日、親戚が泊まりに来るんだったね。布団はもう出した？今から押し入れの物を動かそうと思うんだけど。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "布団は昼に出して、干してある。まだベランダにあるけど、その前に客の部屋を掃除してくれる？床にほこりがあるの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかった。掃除機を持ってくるね。机や椅子も動かしたほうがいいかな。布団を二枚広げるなら、少し狭そうだよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "椅子はもう廊下に出したから大丈夫。先に床に置いてある本を棚に戻して。掃除機はそれからかけてほしい。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "本はどこの棚に入れればいい？いつも使っている本だったら、居間に持っていったほうが便利じゃないかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "客の部屋の棚でいいよ。私があとで並べるから、今は空いている所へ入れておいて。終わったら掃除機をお願い。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n4/03/audio/problem-1-04.mp3",
      "startMs": 386196,
      "endMs": 474277,
      "durationMs": 88081,
      "sha256": "514047037c02ddf21e8371b4ed4e2fe4834628f49efc49721424b50b588d3cac",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "スーパーで、店長と店員が話しています。店員は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "店長、入口に置く果物が届きました。すぐ並べていいですか。午前中はまだお客さんが少ないので、今なら作業できます。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "その前に値段を確認してください。今日はりんごだけ安くすることになりました。昨日の札では高いままなんです。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。新しい札を作りますね。みかんの値段も変わりますか。箱に貼ってある紙には、前より安い値段が書いてあります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "それは店が仕入れた値段です。売る値段は変えません。りんごの新しい値段は、机にあるノートに書いてあります。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先にノートを見て、それから札を作ればいいですね。入口の台はもう拭いたので、果物はすぐ置けると思います。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうです。まず値段を見てください。札ができたら、箱からりんごを出して並べましょう。みかんは私があとで運びます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n4/03/audio/problem-1-05.mp3",
      "startMs": 474277,
      "endMs": 566497,
      "durationMs": 92220,
      "sha256": "34b57e12866523f9610c8fd812bca2c2ef5232fe8b2c64c9516dc7f2a0a9dc3b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "電話で、男の人と荷物の配達の人が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "荷物を受け取れなかったので、電話しました。紙には今日の夕方にもう一度届けると書いてありますが、夕方も家にいないんです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、明日の午前はいかがですか。九時から十二時までなら届けられます。ご都合のよい時間を教えてください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "明日は家にいます。でも、大きい棚なので、一人で部屋に運べるか心配です。玄関まで運んでもらえますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "玄関までお持ちします。箱が大きいので、玄関の幅を先に測っていただけますか。狭い場合は別の入口を使う必要があります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "玄関には靴の棚があります。先にそれを動かしたほうがいいでしょうか。棚を動かせば、少し広くなると思います。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "まず幅を測ってください。八十センチ以上あれば、靴の棚は動かさなくて大丈夫です。測ったら、もう一度こちらにお電話ください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n4/03/audio/problem-1-06.mp3",
      "startMs": 566497,
      "endMs": 654056,
      "durationMs": 87559,
      "sha256": "be69fa426907424bbebc3f55565dd14527c68280cbcdbbc1b804494f8d672344",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "料理教室で、先生と参加者が話しています。参加者は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "野菜は全部切りました。次は鍋に入れて煮ればいいですか。水も用意しましたが、どのくらい入れるかわかりません。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "鍋に入れるのは、まだです。今日は野菜を先に炒めます。そのほうが味がよくなります。フライパンは出しましたか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "はい。でも、野菜を切るのに使った包丁とまな板が、机の上に残っています。洗っておいたほうがいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "もう包丁は使いませんから、先に洗ってください。机の上を広くしてから、フライパンを置きましょう。油は私が用意します。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。水はこのまま置いておきますね。野菜は皿に入れてあるので、机を片づけても大丈夫です。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうしてください。包丁とまな板を洗ったら、ここへ戻ってきてください。炒めるときの火の強さを一緒に確認しましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "assets/jlpt-original/n4/03/audio/problem-1-07.mp3",
      "startMs": 654056,
      "endMs": 742127,
      "durationMs": 88071,
      "sha256": "3a132e68ff6e528dc6b6466629ae07b6571c18c28372b9011768599a373dc0ac",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "駅で、男の人と駅員が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "すみません。電車に帽子を忘れました。さっきこの駅に着いた電車です。青い帽子で、席の上の棚に置いていました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今、忘れ物が届いているか確認しますね。帽子のほかに、何か置いていませんでしたか。かばんなどは大丈夫ですか。"
        },
        {
          "actor": "youngMale",
