  "items": [
    {
      "questionId": "jpapp-n4-original-01-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n4/01/audio/problem-1-01.mp3",
      "startMs": 129791,
      "endMs": 215768,
      "durationMs": 85977,
      "sha256": "841eb48196acd72219e4e985c37dc5b716e7df90b305b3bc90a5b19b43d7dd24",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "会社で女の人と男の人が話しています。男の人は、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "会議の資料、もう印刷できましたか。午後のお客様にも配るので、十部必要なんです。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "はい、十部あります。受付の机に並べておきましょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その前に、最後のページを確かめてください。今朝、数字が変わったので、そこだけ新しいものに入れ替える必要があります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうなんですね。全部もう一度印刷した方がいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "いいえ、最初から九ページ目までは同じです。新しい最後のページは、私の机の上に置いてあります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "前のページは、そのまま捨ててもいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "捨てずに私に渡してください。どこが変わったか、あとで担当の人に説明するために使います。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "分かりました。まず最後のページを見て、それから入れ替えます。机に並べるのはその後ですね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-01-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n4/01/audio/problem-1-02.mp3",
      "startMs": 215768,
      "endMs": 298972,
      "durationMs": 83204,
      "sha256": "39ad44cd2bf1efca6bf4db4b25527bbf1788e36c10d6ede6f04fd624fa8cbfe5",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "料理教室で先生と学生が話しています。女の学生は、次に何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "野菜を全部切りましたか。今日はスープを作りますが、明日の料理にも同じ野菜を使う予定です。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "はい、全部切りました。次は鍋に入れて、火をつけてもいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "まだ火はつけないでください。先に、切った野菜を重さで二つに分けましょう。半分を今日使って、残りを明日のために取っておきます。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "見た感じで半分にすればいいですか。じゃがいもは大きく切りましたけど。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "大きさが違うので、はかりを使ってください。今日の分を分けてから、明日の分を袋に入れます。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "袋は冷蔵庫の横にあるものですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ええ、そこにあります。袋に入れたら、空気を出して閉じてください。今日はまだ調味料を入れないでね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "分かりました。まず、はかりを持ってきて量ります。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-01-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n4/01/audio/problem-1-03.mp3",
      "startMs": 298972,
      "endMs": 385685,
      "durationMs": 86713,
      "sha256": "c034a577853cf991391f708ec064d66191daa03273a144993ea431bb762522c0",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "駅で男の人が係の女の人に聞いています。男の人は、まず何をしなければなりませんか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "すみません。この切符で急行に乗れますか。急いでいるので、次の電車に乗りたいんです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "乗れますが、その切符のほかに急行の切符が必要です。次の急行は三番線から出ます。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "追加の切符はここでも買えますか。現金しか持っていないんですが。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ここは案内だけなんです。右にある機械で買ってください。あの機械なら、現金でも買えますよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "買った後は、新しい切符だけを改札に入れればいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "今お持ちの切符も一緒に入れてください。出てきた二枚は、降りる駅までなくさないようにお願いします。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ホームへは、ここから階段で上がるんですね。まだ時間はありますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ええ、出発まで十五分あります。先に急行の切符を買ってから、改札に進んでください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-01-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n4/01/audio/problem-1-04.mp3",
      "startMs": 385685,
      "endMs": 468623,
      "durationMs": 82937,
      "sha256": "994ac45ab8fa2dcf057609937c9a523ce4271cbf63f285a514698f829386370f",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "家で姉と弟が話しています。男の人は、今、何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "明日の朝、ごみを出してくれる。私はいつもより早く仕事へ行くから、お願いしたいの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "いいよ。新聞はまとめてあるね。台所の袋も一緒に出せばいいの。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その袋は別の日に出すの。明日は新聞と段ボールだけだよ。新聞はひもでまとめてあるから、そのままで大丈夫。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "段ボールはどこにあるの。玄関に置いてある大きい箱。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "そう。まだ箱の形のままだから、平らにして新聞の隣に置いておいて。道具は棚の上にあるよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "今、外へ出しておこうか。玄関が少し狭いから。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "今日は出さないで。夜に風が強くなるそうだから、明日の朝、両方一緒に出してね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "分かった。今は段ボールを平らにして、玄関に置いておくよ。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-01-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n4/01/audio/problem-1-05.mp3",
      "startMs": 468623,
      "endMs": 556659,
      "durationMs": 88036,
      "sha256": "dfbd73e63b6cc94f5a173ad9c6b44fe0a6c2d34433b1e85b0b10d89bdef3ca78",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "店で女の人が男の店員に話しています。女の人は、次に何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "このシャツを交換したいんですが、見てもらえますか。昨日ここで買いました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。サイズが合わなかったのでしょうか。着た後の商品は交換できない場合があります。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "家で袋から出しただけです。大きさはよさそうなんですが、袖に小さな穴がありました。レシートも持ってきました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "申し訳ありません。確かに穴がありますね。同じ色の新しいものを調べますので、少しお待ちください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "別の色にしないといけませんか。この色が気に入っているんです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "同じ色はこの店にはありませんが、ほかの店から取り寄せられます。二、三日で用意できると思います。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "では、同じ色でお願いします。用意できたら、また来ればいいんですね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。まず、この紙に連絡先を書いてください。届いたら電話します。今のシャツはお預かりします。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-01-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n4/01/audio/problem-1-06.mp3",
      "startMs": 556659,
      "endMs": 644449,
      "durationMs": 87791,
      "sha256": "0dbbaea3c2aa2e2f0bdbb380a4d6cbd50d7fdfd9b10fc85c432bfdaa2313c992",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "大学で女の学生と男の学生が話しています。男の学生は、これから何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "発表の準備、写真は集まった。昨日のうちに送ってもらう予定だったよね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "うん、全部あるよ。ただ、説明の文章を書いたら、思ったより長くなってしまったんだ。先に写真の順番を決めようか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "順番は昨日決めたから、そのままでいいと思う。今日は文章を短くしよう。発表は一人五分までだよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "写真ごとに説明をつけたけど、全部読むと七分ぐらいかかりそう。どこを減らそうかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "同じことを書いている所があるから、そこを一つにしよう。写真を見れば分かる説明も、なくしていいと思う。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうだね。文章を直したら、すぐに印刷する。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "印刷は明日で大丈夫。今は、五分以内で話せるように文章を直す方が先だよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "分かった。まず要らない説明を減らして、それから読んで時間を量ろう。"
        }
      ]
    },
    {
