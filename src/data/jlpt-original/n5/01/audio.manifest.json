  "items": [
    {
      "questionId": "jpapp-n5-original-01-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n5/01/audio/problem-1-01.mp3",
      "startMs": 158855,
      "endMs": 230059,
      "durationMs": 71204,
      "sha256": "1f20e11c7d111045ac8506e4bdeb6d3b26519f0eb185e6896be4142b2c2a280e",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で 女の 人と 男の 人が 話しています。男の 人は このあと、何を しますか。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "洗濯機の中はもう空ですよ。シャツは部屋に入れましたが、タオルはまだ外にあります。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "タオルも今日洗ったんですか。まだぬれていますか。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "朝、シャツといっしょに洗いました。今は全部かわいていますよ。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "じゃあ、このまま外に置いてもいいですか。夕方まで出かけませんから。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "でも、空が暗くなってきましたね。雨がふる前に、タオルも中に入れてください。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "わかりました。新しいタオルも買いますか。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "いいえ、買わなくていいです。今ある物で大丈夫です。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "はい。外のタオルを取ってきます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-01-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n5/01/audio/problem-1-02.mp3",
      "startMs": 230059,
      "endMs": 296760,
      "durationMs": 66701,
      "sha256": "2d528e24c1a777609b8933b67b286b30413e4717a6be5e3b3b51db770b7b108f",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "教室で 先生が 学生に 話しています。学生は まず、何を しますか。"
        },
        {
          "actor": "teacher",
          "role": "adultMale",
          "text": "今日は町の地図を使います。みなさんのかばんの中に地図がありますね。でも、まだ開かないでください。今から小さい紙を一人に一枚ずつあげます。紙の上に名前を書くところがありますから、はじめにそこに自分の名前を書いてください。名前だけでいいです。住所や電話番号は書きません。名前を書いた人は、地図をかばんから出してください。それから、わたしといっしょに地図を開きます。学校と公園の場所を見ましょう。紙は授業の終わりに集めますから、今は先生に返さないで、机の上に置いてください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-01-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n5/01/audio/problem-1-03.mp3",
      "startMs": 296760,
      "endMs": 365884,
      "durationMs": 69124,
      "sha256": "c10a649ab943194d1fbaa37a985b82dc0382f757975d1fe9608fa773da7e882b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "女の 人と 男の 人が 話しています。男の 人は 何を 買いますか。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "今からお店へ行くけど、夕ごはんに何かいる？"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "卵を買ってきてくれる？あしたの朝ごはんにも使いたいの。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "わかった。パンも少なくなっていたね。パンと卵でいい？"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "パンは今朝買ったから、台所の大きい袋に入っているよ。ちょっと冷蔵庫も見てみるね。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "じゃあ、玄関で待っているよ。牛乳はどう？"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "あ、卵もまだたくさんあった。ごめん、卵は買わなくていいよ。牛乳はもうないね。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "牛乳だけ買えばいいんだね。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "うん、お願い。お金はこの財布に入っているよ。袋も持って行ってね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-01-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n5/01/audio/problem-1-04.mp3",
      "startMs": 365884,
      "endMs": 437631,
      "durationMs": 71747,
      "sha256": "b99ad7249864ab4c4b25daae95618beaff8d47cc693002fdcf2721e1707f0184",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "電話で 男の 人と 女の 人が 話しています。女の 人は どこで まちますか。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "もしもし。もう駅に着いた？ぼくはまだバスの中なんだ。"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "うん、電車を降りたところ。今、駅の入口の前にいるよ。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "バスはあと五分ぐらいで着くよ。そこ、風が強くない？"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "寒いね。駅の外に店が見えるから、そこで待とうか。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "その店は今日は休みだったよ。駅の中に大きい時計があるのが見える？"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "うん、入口から見えるよ。時計の下には人が少ないね。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "じゃあ、その下で待っていて。ぼくも駅に入って、そこへ行くから。"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "わかった。入口の前から中に入るね。電話を切っても大丈夫？"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "うん。あとで会おう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-01-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n5/01/audio/problem-1-05.mp3",
      "startMs": 437631,
      "endMs": 515181,
      "durationMs": 77551,
      "sha256": "ec23e24bbf28397dd1564fd29b23dcfd332dc95abca76487f595c45bacdb20a5",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で 女の 人と 男の 人が 話しています。男の 人は どの 本を かばんに 入れますか。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "あした学校に持って行く本を、かばんに入れてくれる？机の上に二冊あるでしょう。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "赤い本と青い本だね。赤いほうは大きくて、写真がたくさんあるよ。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "そう。それは家で料理をするときに使う本なの。今夜も見たいから、机に置いておいて。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "じゃあ、青い本を持って行くの？これは図書館の本かな。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "うん、学校の図書館から借りた本よ。あした返すから、それを一冊だけ入れてね。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "かばんの中にはもうノートが入っているけど、本も入るね。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "ありがとう。本の間の紙は取らないで。図書館のカードが入っているから。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "わかった。カードもそのままにしておくよ。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-01-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n5/01/audio/problem-1-06.mp3",
      "startMs": 515181,
      "endMs": 592357,
      "durationMs": 77176,
      "sha256": "a47072062f4bc64a5a7e821326ef88f45b13d37cea9a753415b3b8e8daf691b4",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "男の 人と 女の 人が あしたの ピクニックについて 話しています。女の 人は 何を 持って 行きますか。"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "あしたのピクニック、何人で行くの？お昼ごはんはどうしようか。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "四人で行くよ。ぼくがおにぎりを作るから、ごはんは持ってこなくていいよ。"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "じゃあ、わたしはお茶を用意しようか。家に大きい水筒があるよ。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "公園の入口で飲み物を買えるから、お茶も大丈夫。それより、座る物がいるね。"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "小さいシートならあるけど、四人は座れないと思う。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "先月、お姉さんと使った大きいシートは？あれならみんなで座れるでしょう。"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "あ、それも家にあるよ。きれいに洗って、しまってある。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "じゃあ、それをお願い。おにぎりはぼくのかばんに全部入れるよ。"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "うん。わたしは大きいシートを持って行くね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-01-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "assets/jlpt-original/n5/01/audio/problem-1-07.mp3",
      "startMs": 592357,
      "endMs": 665951,
      "durationMs": 73593,
      "sha256": "55dcc434a3dd5d065cef0caca1797f593fa95a904aae0cb6e073b84684e94e0f",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "店で 女の 人と 男の 人が 話しています。男の 人は どの 箱を 運びますか。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "この三つの箱は、全部外に出すんですか。大きい箱はずいぶん重いですね。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "大きい箱にはお皿が入っています。落とすと困るので、それはあとから二人で運びましょう。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "今は小さい箱からですね。この一つを持って行きます。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "小さい箱は二つともお願いします。中は紙ですから、どちらも軽いですよ。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "外のどこに置きますか。車の中ですか。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "まだ車は来ていません。店の入口の右に置いてください。左はお客さんが歩きますから。"
        },
        {
          "actor": "male",
          "role": "adultMale",
          "text": "わかりました。大きい箱はここに置いたままでいいですね。"
        },
        {
          "actor": "female",
          "role": "adultFemale",
          "text": "はい。わたしが戻ってから、いっしょに運びます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-01-v1-listening-2-01",
      "group": 2,
      "number": 1,
      "path": "assets/jlpt-original/n5/01/audio/problem-2-01.mp3",
      "startMs": 758445,
      "endMs": 828167,
      "durationMs": 69721,
      "sha256": "6d9f3ade9eea78953a218acd2537e8fcfb9385ce7db1f3dab4c86251d39be920",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "男の 人と 女の 人が 話しています。女の 人は 何時に 家を 出ますか。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "あしたの電車は九時だね。駅に着いてから切符を買う？"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "切符はもう買ったよ。でも、駅の店でお昼ごはんも買いたいな。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "じゃあ、少し早く来たほうがいいね。家から駅までは近いの？"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "歩くと二十分かかるよ。だから八時半に家を出るつもり。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "そうすると、電車が出る十分前に着くね。雨ならバスにする？"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "バスは駅の前まで行かないから、雨でも歩くよ。傘はもうかばんに入れた。"
        },
        {
          "actor": "male",
          "role": "youngMale",
          "text": "ぼくは八時二十分に家を出るよ。駅の入口で待っているね。"
        },
        {
          "actor": "female",
          "role": "femaleStudent",
          "text": "ありがとう。駅に着いたら電話するよ。時間があったら、いっしょにお店へ行こう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-01-v1-listening-2-02",
      "group": 2,
      "number": 2,
      "path": "assets/jlpt-original/n5/01/audio/problem-2-02.mp3",
      "startMs": 828167,
      "endMs": 895800,
      "durationMs": 67633,
      "sha256": "1e578adba104869d34012421e028dfd2d32dd4a4c762fdf7a841dc601a5bab31",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "女の 人と 男の 人が 話しています。男の 人は 何曜日に 休みますか。"
        },
        {
