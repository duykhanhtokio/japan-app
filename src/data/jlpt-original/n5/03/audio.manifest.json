  "items": [
    {
      "questionId": "jpapp-n5-original-03-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n5/03/audio/problem-1-01.mp3",
      "startMs": 162983,
      "endMs": 232951,
      "durationMs": 69968,
      "sha256": "5ab1caad18a4df1dbd2786760b6a4950b3370bb0a14c01815f173a6554e25a6a",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で女の学生と男の学生が話しています。 女の学生は、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "写真を印刷したいんだけど、この機械、動かないね。ボタンを押しても何も出ないよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ああ、紙がないんだ。さっきぼくが最後の紙を使ったよ。新しい紙は教室にはないんだ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "そうなんだ。隣の教室にもらいに行けばいい？"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "今日は隣の教室も使っているから、職員室でもらって。機械はそのあと使えるよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかった。写真は五枚だけだから、少しもらって来るね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "先生に、写真用の紙がほしいって言ってね。普通の紙だと写真がきれいに出ないから。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん。紙をもらってから、ここに戻って来るね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-03-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n5/03/audio/problem-1-02.mp3",
      "startMs": 232951,
      "endMs": 310779,
      "durationMs": 77828,
      "sha256": "a24ae6f2836f0771f816d0fe6398987fc1a0b1ddd43d2cb137a6d193a3f5b786",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "料理の教室で先生と男の学生が話しています。 男の学生は、まず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "先生、野菜を切ってもいいですか。包丁を持って来ました。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ちょっと待ってください。玉ねぎはもう切りました。そちらのじゃがいもをお願いします。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "じゃがいもですね。このまま、小さく切ればいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その前に、よく洗ってください。まだ土がついていますから。洗ったら、大きい皿に置いてください。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。それから、皮を取りますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "今日は皮も使います。洗ってから切りましょう。お湯はわたしが用意します。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "わかりました。じゃがいもは全部洗いますね。小さいのも同じですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ええ、全部お願いします。切る大きさは、洗ったあとで教えます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-03-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n5/03/audio/problem-1-03.mp3",
      "startMs": 310779,
      "endMs": 380639,
      "durationMs": 69860,
      "sha256": "790416fbda40262f46e54385dc022bbb13bc673736ad2040c9af7c6618eb970e",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で女の人と男の人が犬について話しています。 男の人は、まず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "犬のごはん、もうあげた？ぼくがあげようと思っていたんだけど。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "うん、さっき食べたよ。でも、水の皿が汚れているの。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "じゃあ、新しい水を入れようか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "入れる前に、皿を洗ってくれる？朝、外で遊んだときに土が入ったみたい。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうか。水は外の水道でいい？"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "皿は台所で洗って。そのあと冷たすぎない水を入れてね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "わかった。犬の散歩はどうする？"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "今は外が暑いから、夕方に行こう。まず、きれいな皿を用意してあげて。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-03-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n5/03/audio/problem-1-04.mp3",
      "startMs": 380639,
      "endMs": 453379,
      "durationMs": 72740,
      "sha256": "32552a121b3b370fe44980088c6d413a232028a95ba472ef99930855d86183a1",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "音楽の練習のあと、女の学生と男の学生が話しています。 女の学生は、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "もう五時だね。この部屋、閉めてもいいかな。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "うん。ぼくは楽器を箱に入れたよ。窓も閉めた。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "じゃあ、かぎを先生に返して来るね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "その前に、部屋の電気を消して。まだついているよ。先生は今、会議中だから、かぎは受付に返せばいいんだって。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "受付は一階だよね。電気を消したら、かばんを持って下に行くね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "お願い。ぼくは椅子を元の場所に戻すから。かばんは入口の机に置いてあるよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "ありがとう。受付では、この部屋のかぎですって言えばいいね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "うん。部屋の中をもう一度見てから出よう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-03-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n5/03/audio/problem-1-05.mp3",
      "startMs": 453379,
      "endMs": 526332,
      "durationMs": 72953,
      "sha256": "368c3d14babe2f264226d8000e64130df0bf943958a2ce6f0c266e9a33a45af2",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "荷物を送る店で女の店員と男の客が話しています。 男の客は、まず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "この箱を送りたいんですが、このままで大丈夫ですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "重さは大丈夫です。住所もはっきり書いてありますね。ただ、箱の下のところが少し開いています。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "あ、本当ですね。新しい箱を買ったほうがいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "箱はまだ使えます。下のところにテープをもう少し貼ってください。荷物が落ちないようにしましょう。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "テープはどこにありますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "そちらの机にあります。使っていいですよ。貼ったら、こちらに持って来てください。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "わかりました。住所は書き直さなくてもいいですね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい、そのままで大丈夫です。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-03-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n5/03/audio/problem-1-06.mp3",
      "startMs": 526332,
      "endMs": 596181,
      "durationMs": 69849,
      "sha256": "22c16acafd156b6632d68179a05f4565ecbe86349b1d653ea21caaf203a9359d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "公園へ行く前に女の学生と男の学生が話しています。 女の学生は、家で何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "公園で食べる果物、ぶどうを買ったよ。かばんに入れて持って行けばいい？"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "公園の水道、今使えないんだ。だから、家で洗ってから持って行こう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "じゃあ、洗ったら袋に入れるね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "袋だとつぶれるかもしれないよ。ふたのある入れ物に入れたらどうかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "小さい入れ物があるから、それを使うね。ナイフも持って行く？"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ぶどうは切らなくていいよ。ぼくはおにぎりを作って持って行くね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "ありがとう。ぶどうを洗って、入れ物に入れてから出るね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "うん。公園では、木の下の机でいっしょに食べよう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-03-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "assets/jlpt-original/n5/03/audio/problem-1-07.mp3",
      "startMs": 596181,
      "endMs": 673049,
      "durationMs": 76868,
      "sha256": "46b72621b6f8d79aa871f1dd0fee174ea2fb2813fd172a6f9d2821f9bdc9214c",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校のクラブで女の学生と男の先生が話しています。 女の学生は、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、クラブのポスターができました。廊下の壁に貼ってもいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "廊下の壁はだめです。入口の掲示板を使ってください。でも、貼る前に事務室の人に見せてくださいね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "事務室ですね。先生の名前は書いてあります。これで大丈夫ですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "名前はいいです。事務室の人に、貼ってもいいか聞いてください。掲示板には決まりがありますから。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。許可をもらったら、入口に貼ります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ええ。それから、終わったら自分でポスターを取ってくださいね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "はい。クラブの集まりは来週ですから、そのあと取ります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "では、ポスターを持って事務室へ行ってください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-03-v1-listening-2-01",
      "group": 2,
      "number": 1,
      "path": "assets/jlpt-original/n5/03/audio/problem-2-01.mp3",
      "startMs": 770291,
      "endMs": 844172,
      "durationMs": 73881,
      "sha256": "c959b17139ac2b4c60f68e8f0a68156a1e1d7dbcce8cdd796608cd41b0f148ee",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "女の学生と男の学生が音楽の教室について話しています。 女の学生は、教室へ何で行きますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "土曜日、音楽の教室へ行くんだよね。駅で会って、いっしょに電車に乗らない？"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "ううん、教室へ行くときはバスを使うんだ。家の前から出るバスが、教室の近くまで行くから。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうなんだ。いつも自転車で行っていると思っていたよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "学校へは自転車だけど、音楽の教室は遠いからね。バスなら、楽器を持っていても楽なんだ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "帰りもバスに乗るの？夜になるよね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "帰りは父が車で迎えに来るよ。父の仕事が終わる時間と同じだから。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "じゃあ、教室で会おう。ぼくは電車で行くね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん。また土曜日にね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-03-v1-listening-2-02",
      "group": 2,
      "number": 2,
      "path": "assets/jlpt-original/n5/03/audio/problem-2-02.mp3",
