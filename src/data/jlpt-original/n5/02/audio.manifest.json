  "items": [
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n5/02/audio/problem-1-01.mp3",
      "startMs": 179067,
      "endMs": 250187,
      "durationMs": 71120,
      "sha256": "36f101dd85b517e6848aa0ea494e6fbf6fd728745ca56a577469f66b314c3029",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "コインランドリーで、店の人と女の人が話しています。女の人は、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "すみません。この洗濯機を使ってもいいですか。洗う服はこのかごに入っています。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。でも、服を入れる前に、この空のかごを入口の棚へ運んでください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "入口の棚ですね。青いかごと白いかごがあるけど、どちらですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "青いほうです。白いかごはあとで私が使うので、ここに置いてください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。それから服を入れます。洗剤も買わないといけませんか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "洗剤は機械の中にあります。床も今ふいたので、そうじはしなくていいですよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "では、青いかごを運んでから、洗濯を始めます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n5/02/audio/problem-1-02.mp3",
      "startMs": 250187,
      "endMs": 328516,
      "durationMs": 78329,
      "sha256": "c931c4123dda6724ca43a8a88c82e449784b36eb13c620ba9734635ff0f9ead6",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "建物の入口で、男の人が係の女の人に聞いています。男の人は、まずどこへ行きますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "写真を見に来ました。切符は、ここで買えますか。この紙は学校でもらいました。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その紙がある方は、先に二階の案内所へ行ってください。今日の切符をもらえます。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "紙には家で名前を書きました。ここでお金も払いますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "いいえ。お金はいりません。二階で、その紙を見せるだけでいいですよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "二階へは、この奥の階段ですか。右にも階段がありますね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "奥のほうです。右はお店の階段です。一階のお店には帰りに寄れますよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "駅の改札でも、この紙を見せるんですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "駅では使いません。二階で切符をもらったら、この入口に戻ってください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n5/02/audio/problem-1-03.mp3",
      "startMs": 328516,
      "endMs": 401491,
      "durationMs": 72975,
      "sha256": "48165cf55da0c728c2becc57626a2c6c6bff2ce2c7e53dbac14c88d1db4af4a8",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、男の人と女の人が携帯電話について話しています。女の人は、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "携帯電話が熱くなっているけど、このまま充電しても大丈夫かな。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "今は充電しないで、先に電話の電源を切っておこう。ずっと使っていたからだと思うよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "電源を切るのね。電池も外したほうがいい？前の電話は外せたよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この電話の電池は自分では取れないから、触らないでね。少し待ってみよう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "お母さんに電話をかけたかったけど、あとにするね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "うん。熱くなくなってから使って。それでも熱かったら、店で見てもらおう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "充電の線も、新しいのを買ったほうがいい？"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "まだ買わなくていいよ。今は使うのをやめて、電源を切ろう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n5/02/audio/problem-1-04.mp3",
      "startMs": 401491,
      "endMs": 469848,
      "durationMs": 68357,
      "sha256": "798356fa34a02de38ce12ba8764a0aaa950f1879b07c7db473cecb3221be906c",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、女の人と男の人が空のびんを片づけています。男の人は、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "このびん、中にジュースが少し残っているよ。ふたはもう取ったけど、どうしよう。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "水で洗ってから、こっちのかごに入れて。ふたは私があとで別にするよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "洗ったら、外に出してもいい？今日は、ごみの日だよね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "普通のごみは今日だけど、びんは明日。今日は家の中に置いておいてね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この袋に入れるの？びんが重いから、二枚使おうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "袋は紙のごみ用だよ。びんはかごに入れて。紙を貼らなくてもいいよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "じゃあ、台所で、水で中をきれいにするね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n5/02/audio/problem-1-05.mp3",
      "startMs": 469848,
      "endMs": 545329,
      "durationMs": 75481,
      "sha256": "ccdf2656a89c064edd70c8c2b05f85b50541f21c2bfee0304ab919df472a0037",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "店で、男の人と女の人が卵を選んでいます。女の人は、どの卵を買いますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "明日は八人で朝ごはんだね。卵は家に何個あるかな。一人一個でいい？"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん、二個あるから、あと六個買えばいいね。パンや野菜も食べるよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "大きい卵の六個入りは、こっちの小さい卵より安いよ。どうする？"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "お皿が小さいから、小さい卵がいいな。全部食べられると思うし。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "じゃあ、小さい卵の十個入りは？残った分は、夜に使えばいいよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "夜は外で食べるし、あさってから旅行に行くから、卵を残したくないの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうか。では、小さい卵の六個入りにしようか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん。家の二個と合わせて、ちょうど八個になるね。これを買おう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n5/02/audio/problem-1-06.mp3",
      "startMs": 545329,
      "endMs": 613741,
      "durationMs": 68412,
      "sha256": "05afb72824ebac5e8c60627137a913e3488040034a6a8d379bc8c1dcdf8b07a3",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "店で、男の人が女の店員にコピーの取り方を聞いています。男の人は、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この紙を十枚コピーしたいんですが、どうしますか。お金はもう入れました。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "今は大きい紙のサイズになっていますね。先に、お持ちの紙と同じ小さいサイズに変えましょう。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この下のボタンですか。十枚という数字も、今入れたほうがいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "数字はサイズのあとです。小さい紙のボタンを押してから、十枚と入れてください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかりました。お金が足りないときは、あとで足せますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。でも、今のお金で十枚は取れると思います。足りないと、画面に出ますよ。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "assets/jlpt-original/n5/02/audio/problem-1-07.mp3",
      "startMs": 613741,
      "endMs": 686077,
      "durationMs": 72336,
      "sha256": "ddb7d056bcbe8d25e2fa7b897ce5fd95a949fc8ca5cdf32c67af20b240c217d2",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で、先生と女の人が掃除について話しています。女の人は、まず何を持って来ますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "床はきれいですが、窓の上にごみがありますね。今日はあそこをそうじしましょう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "いすに乗って、ぞうきんでふきますか。台所に小さいぞうきんがあります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "いすは危ないので、やめましょう。長いほうきなら、下から届きますよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "どこにありますか。入口には短いほうきしかありませんでした。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "長いほうきは、廊下の奥の棚にあります。まず、それを持ってきてください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "水のバケツも使いますか。床もふこうと思っていたんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "床はさっきふいたので、水はいりません。ごみが取れたら、白い袋に入れましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-2-01",
      "group": 2,
      "number": 1,
      "path": "assets/jlpt-original/n5/02/audio/problem-2-01.mp3",
      "startMs": 798624,
      "endMs": 868773,
      "durationMs": 70149,
      "sha256": "16898e340b000f0e8d6535b884264d53a417c04840290ec5810509a822e37822",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "男の人と女の人がパンの店について話しています。女の人は、どうしてこの店によく来ますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ここのパン、おいしいね。いつも買っているの？家は近いのかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "家は駅の反対側だよ。歩くと二十分ぐらいかかるので、少し遠いね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "でも、よく来るんだね。ほかのお店より安いのかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "値段は普通だと思う。家の近くの店のほうが、少し安いものもあるよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうなの？ここに友だちが働いているのかなと思っていたよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "知っている人はいないよ。私、仕事が終わるのが遅いでしょう。近所の店は、その時間にはもう閉まっているの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ここは夜まで開いているから、帰りに買えるんだね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-2-02",
      "group": 2,
      "number": 2,
      "path": "assets/jlpt-original/n5/02/audio/problem-2-02.mp3",
      "startMs": 868773,
      "endMs": 936225,
      "durationMs": 67452,
      "sha256": "f334cd9b935081181909b7f92cc95a750ab3219dde015bdb89ebb8a7a925f23d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "女の人と男の人が今週の休みについて話しています。男の人は、何曜日に休みますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
