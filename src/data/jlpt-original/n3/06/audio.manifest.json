  "items": [
    {
      "questionId": "jpapp-n3-original-06-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n3/06/audio/problem-1-01.mp3",
      "startMs": 106984,
      "endMs": 200591,
      "durationMs": 93607,
      "sha256": "b05b742a69b185d001527b0d13c7fee194dc0e600df8d6bc796f3abb358cb4a9",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあと何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "明日の町の催しで配るカード、画面ではきれいにできたよ。店の名前の横に小さな印も入れた。百枚必要なんだけど、今から全部印刷して、真ん中で切ればいいかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "待って。その印、切る線に近すぎない？　画面では余白が見えていても、紙にすると少しずれることがあるよ。前のカードも、端の絵が半分なくなってしまったでしょう。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "印の画像を小さくし直したほうがいい？　消しても名前は分かるけど、店の人は残してほしいと言っていたね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "印はそのままで、一枚だけ刷ってみよう。線の所で紙を折って、印が全部見えるか確かめて。折るだけなら、位置を直すときにも元の大きさが分かるから。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "じゃあ、試した紙で印と線の間を見てから、必要なら少し内側へ動かすよ。確認できたら残りを刷る。全部切ってから気付くと、紙が無駄になってしまうね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "切る道具は私が用意しておくね。位置を確かめてから残りを刷って、夕方に見本を届けよう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-06-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n3/06/audio/problem-1-02.mp3",
      "startMs": 200591,
      "endMs": 298208,
      "durationMs": 97617,
      "sha256": "232e3b7bba326df41d517053b04ceb2c2bee6ff23e4c65b42740056d556f2b2a",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "市の講座を申し込んでいたら、送信のボタンを押したあとで画面が止まってしまいました。完了という表示が出なかったので、もう一度初めから入力しようと思っています。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "押した時点で、申請が届いていることもありますよ。確認のメールがすぐ来ない場合もあるので、届いていないと決めないでください。同じ申請が二つになると、後で取り消しが必要です。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "メールの受信箱には何もありません。どう確かめればいいですか。支払いのカードを変えれば画面が進むでしょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今回は無料の講座ですから、カードは使いません。自分の名前で入った画面に、申請の記録という所があります。まずそこを開いて、今日の日付で講座名が出ているか見てください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "記録があれば、画面が止まっても申し込みは済んでいるんですね。なければ、すぐもう一度送っていいですか。締め切りが今日なので、少し心配です。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "記録がなければ受付へ電話してください。二重にならないよう、確認前には送らず待ってください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-06-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n3/06/audio/problem-1-03.mp3",
      "startMs": 298208,
      "endMs": 398044,
      "durationMs": 99836,
      "sha256": "f96c254c198ee5cca2c2e5c7f757da9ecd2f6a09697ece931bd5863f6bd6b34e",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "机に置いている電気スタンド、同じ形の製品に問題があるって店から連絡が来たんだ。昨日まで普通に使えていたけど、すぐ店へ持って行くほうがいいかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "全部ではないようですよ。同じ色や形でも、作った時期によって違うそうです。箱は残っていますか。箱の番号か、本体の底にある番号で、対象かどうか分かると書いてあります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "箱は処分したけど、底に小さい札がある。中を開けて、製品の名前を探そうと思ったんだけど。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "開けないでください。外側の札だけで分かるそうです。電源を切って線を抜いたら、札の番号を一度読んで、店へ伝えてください。使い方の説明の番号と間違えないように。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "分かった。まず外側に書いてある製品の番号を確認するよ。それが対象なら返す方法を聞く。色が同じだからといって、先に新しい物を買う必要はないんだね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "対象でないならそのまま使えますが、確認まで電源を入れないでください。返す場合の方法は、店へ聞きましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-06-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n3/06/audio/problem-1-04.mp3",
      "startMs": 398044,
      "endMs": 496131,
      "durationMs": 98087,
      "sha256": "df0bfdc22a4ccc9b19640e29edab680d0d5dc73660eac6fd669a82fa39711c82",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあと何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "さっき、電話が来て本を読むのを止めちゃったね。おじいちゃん、どこまで聞いたか覚えている？　私も何行目だったか分からなくなったから、章の最初から読み直そうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "最後に聞いたのは、主人公が川を渡る前に、かばんを開けた所だったよ。その続きを早く知りたいんだけど、同じ所を全部もう一度聞くと、少し長くなるね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "私の本に印を付けていなかったの。次の章へ飛ばすと、川を渡れたか分からないから、先ほどの場面を探したいな。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "僕が持っている大きい字の本では、かばんを開けたあと、手紙を取り出したと書いてある。ここの行を見て。その言葉を、君の小さい本でも見つければ、同じ所から続けられるよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "本によってページの数が違うんだね。そちらのページ番号だけでは探せないけど、同じ言葉がある行なら分かる。まずその行を合わせて、次の文から読むことにするね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ゆっくり続けてくれればいいよ。今度止まるときは、最後の言葉を書いておこう。ページが違っても探せるからね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-06-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n3/06/audio/problem-1-05.mp3",
      "startMs": 496131,
      "endMs": 594601,
      "durationMs": 98471,
      "sha256": "6e8b4a2becd2f49b34d948ff85774dc9353b3a2ad3be7a3f4592c0d776787823",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、何を壁に付けますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "地域の作業室の道具、初めて来た人が逆向きに持つことが多いね。棚には道具の名前が書いてあるけど、これだけでは使うときの向きが分からないみたいだ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "戻す場所はそれで分かるんですが、使い方は別ですね。説明書を壁に貼ると字が細かくて、作業しながら読むのは難しそうです。写真ならすぐ見られるでしょうか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "新品の箱の写真は、道具が横になっていて前が分からない。空の棚の写真もあるけど、それは片付けるときの案内だね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "実際に机で使う向きに置いて、手を離した状態で撮りましょう。前の側が分かるように、机の端も少し写してください。人が持っている写真だと、手に隠れる部分が出ますから。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "なるほど。使う状態の写真を大きくして、机の前の壁に付けるよ。値段の一覧は事務室だけに置けばいいね。作業している人には、買うときの情報は必要ないから。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ええ。写真の下に前と後ろを短く書けば十分です。片付ける場所が分かるよう、棚の名前も残してください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-06-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n3/06/audio/problem-1-06.mp3",
      "startMs": 594601,
      "endMs": 696816,
      "durationMs": 102215,
      "sha256": "10a80e0b652a1c7dd920af03bd6da580fa52e51950e238459ebed26b5be977e3",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、今日、どうしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "明日は子供たちと料理を作る日ですね。時間が足りなくなるかもしれないので、野菜は今日のうちに切って、袋に分けておきましょうか。材料は全員分そろっています。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "材料を分ける準備はお願いしたいですが、切る作業は明日残しておきたいんです。今回は、硬い野菜と柔らかい野菜で、包丁の使い方を変える練習もするので。"
        },
