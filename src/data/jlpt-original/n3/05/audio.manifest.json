        {
          "actor": "option-1",
          "role": "femaleStudent",
          "text": "一つの場面の行動だけで人を決め付けないこと"
        },
        {
          "actor": "option-2",
          "role": "femaleStudent",
          "text": "二人で話せば相手の全てを理解できること"
        },
        {
          "actor": "option-3",
          "role": "femaleStudent",
          "text": "静かな人に大勢の前で話すよう必ず求めること"
        },
        {
          "actor": "option-4",
          "role": "femaleStudent",
          "text": "授業で話さない人とは作業を分担しないこと"
        }
      ]
