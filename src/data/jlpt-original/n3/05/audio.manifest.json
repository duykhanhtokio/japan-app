  "items": [
    {
      "questionId": "jpapp-n3-original-05-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n3/05/audio/problem-1-01.mp3",
      "startMs": 108296,
      "endMs": 203108,
      "durationMs": 94812,
      "sha256": "dee0f688c48159c647ecc62906fca2e96ffe5b626cb33e89fdda8dbef4a98f57",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "体育館で演劇の準備をしているんだけど、幕を引くと、途中で大きな音がするんだ。金具が古いから、全部新しい物に取り替えたほうがいいのかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "昨日、幕を外したときは、金具は滑らかに動いていたよ。上のレールに何か挟まっていないか見た？　飾りに使った紙を、昨日その近くで切ったから。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "下から見てもよく分からなかった。油を差せば音が小さくなると思うけど、紙が挟まっていたら、そこだけ動かなくなっているのかもしれないね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "今はまだ油を差さないで、係の人に台を借りて、まずレールの中を見てほしい。私が下で幕を支えるから、一人で無理に引かないようにしよう。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "先に上の通り道を確かめるんだね。紙があれば取り除いて、それから動きを見る。金具を注文するのは、そのあとでも間に合うかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん。明日の練習まで時間はあるから、原因を見ないで全部買い直す必要はないよ。台は職員室にある。先生には、私から作業することを伝えておくね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-05-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n3/05/audio/problem-1-02.mp3",
      "startMs": 203108,
      "endMs": 302763,
      "durationMs": 99655,
      "sha256": "432083ffc0db144e6338a2feab873b953fc760ccd4190659d77296b2c688f092",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "店の案内を印刷したんですが、携帯で読み取るための四角い模様が、紙ではうまく読み取れません。画面に出した物なら、私の携帯では開けるんです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "模様を小さくしたのかもしれませんね。印刷のとき、紙に収まるように自動で縮める設定を使っていませんか。昨日は別の大きさの紙を使いましたから。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "確かに、昨日の設定のまま印刷しました。模様の色をもっと濃くするか、案内文を短くして、余白を増やせばよくなるでしょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "色や文を変える前に、拡大も縮小もしない設定に戻して、一枚だけ印刷してください。元の大きさで読めるか試してから、必要な部数を決めましょう。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、印刷の大きさの設定を戻して試します。まだ店に配っていないので、読めない紙を全部印刷し直すより、先に一枚で確かめられますね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ええ。携帯を買い替える話でもありません。画面の元の模様では読めるので、紙へ出すときに変わった所を順に調べればよいと思います。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-05-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n3/05/audio/problem-1-03.mp3",
      "startMs": 302763,
      "endMs": 404028,
      "durationMs": 101265,
      "sha256": "cb50210e39d789863edded8322a6ffdc75f6833a0a8873b2d813d6c5f1d13972",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "二人で歌を録音したんですが、別々に録った声を重ねると、入りの所だけ合いません。伴奏は同じ物を使ったので、歌う速さは変わっていないはずです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "録音を始めてから伴奏が鳴るまで、少し静かな時間がありますよね。各自がその時間を数えて歌い始めたのなら、最初の数え方が違ったかもしれません。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "その無音の長さだけを短くしたら、合うでしょうか。でも、途中を切ると伴奏との位置も変わります。二人で同時に来て録り直すのは、今週は難しいです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "別々のまま録り直せますよ。まず伴奏の前に四つの拍の音を付けてください。二人ともその音を聞いて入れば、同じ始まりを使えるはずです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "伴奏を速くするのではなく、始まる合図を入れるんですね。その同じファイルを二人に渡して、入り方を確かめてから録り直します。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。今の録音は残しておいて、次の物と比べましょう。二人で来る予定を合わせるより、まず共通の合図がある伴奏を準備するのがよさそうです。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-05-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n3/05/audio/problem-1-04.mp3",
      "startMs": 404028,
      "endMs": 496675,
      "durationMs": 92647,
      "sha256": "46628f619f3fefbb3f90ef3be54a8ef382378af54b39dc16c61d55f31111f2a8",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "町の壁に絵を描く活動に申し込んだよ。今日から色を塗れると思って、道具も持ってきたんだけど、参加者には下絵をまず見せるように書いてあるね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そう。壁を貸している人が、建物の雰囲気に合うか確認するんだ。参加の申込みが受け付けられたことと、その絵を塗ってよいことは別なんだって。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "じゃあ、下絵を紙に描くんだね。私は壁の前に立って見たほうが分かりやすいと思うから、薄い色で壁に描いてから写真を送ってもいいかな。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "許可が出る前は、薄くても壁に描けないよ。まず、持ってきた紙に下絵を描いて、担当の人に送ってほしい。大きさも紙に書けば確認してもらえる。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "分かった。今日は壁を使わずに、紙で案を作って送るね。返事が来たら、色や位置について修正が必要か確かめればいいんだね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "うん。道具を買い足すのもそのあとでよさそう。今ある紙なら十分大きいから、ここで描けるよ。担当の人の連絡先は申込書に載っている。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-05-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n3/05/audio/problem-1-05.mp3",
      "startMs": 496675,
      "endMs": 592287,
      "durationMs": 95612,
      "sha256": "8e759f49cfdfc67e1694dc4f4c79cf1304fd761347d3993d86ceef04e87fdb3f",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "展示用の写真を壁に掛けたんだけど、右側が少し下がっている。額を裏返して見たら、ひもの長さは左右同じだったよ。ひもを短くすれば直るのかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "壁の二つの掛ける所の高さが違うのかもしれないね。昨日、左側のねじだけ付け替えていたよね。額のひもより先に、壁を見たほうがよさそう。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうだった。額を手で傾けて、真っすぐに見える所へ押しておけば、とりあえず展示には間に合うけど、人が触ると戻ってしまうよね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "額は私が持つから、いったん外して、二つのねじの高さを測ってみて。違いが分かってから、係の人に付け直しをお願いしよう。勝手に新しい穴を開けないでね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "では、まず外して壁の二か所を測るんだね。額のひもはまだ切らず、測った結果を持って係の人に相談する。左を動かしたのが原因かもしれない。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん。ほかの写真も同じ壁を使うから、元の位置が分かる記録もあると思う。新しい額を買うのではなく、掛ける所をそろえられるか確認しよう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-05-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n3/05/audio/problem-1-06.mp3",
      "startMs": 592287,
      "endMs": 694416,
      "durationMs": 102129,
      "sha256": "06cb26ad1525251aabe056502c6b71340f38fc17a8c6ff42176cdd77f57df018",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "明日の打合せには、耳が聞こえにくい方も参加します。皆が話す内容を後でまとめて渡せばよいと思っていましたが、話合いの途中も参加していただきたいですね。"
        },
        {
