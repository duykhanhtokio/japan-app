  "items": [
    {
      "questionId": "jpapp-n3-original-04-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n3/04/audio/problem-1-01.mp3",
      "startMs": 116395,
      "endMs": 211217,
      "durationMs": 94823,
      "sha256": "bb6eabe7fae9df7fad256dd348a27ba2e996087671712d465c22957d6262182f",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "明日の昼の注文を数えたら、弁当が三十個でした。材料を切り始めてもいいですか。二つの団体から来た注文は、同じ紙にまとめてあります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "昨日、一つの団体から、午後の行事がなくなったので五個取り消すと連絡がありました。電話のメモが、その注文の紙に重ねてありますよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "それなら二十五個ですね。ただ、別の担当者が今朝も五個減らしてほしいと言っていました。二回連絡があったので、二十個にしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "同じ注文の確認かもしれません。まだ人数を減らす作業はしていないので、まず取り消しの二つのメモの注文番号を比べてください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "番号が同じなら、一回だけ五個減らすんですね。違う場合は、そのまま作業せず、相手に電話したほうがよさそうです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ええ。材料が余るかどうか考えるのは、必要な数が決まってからにしましょう。私は箱を準備しますので、メモの番号を見てもらえますか。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-04-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n3/04/audio/problem-1-02.mp3",
      "startMs": 211217,
      "endMs": 304099,
      "durationMs": 92881,
      "sha256": "d965fde61fb90b328e17e3857cdafd3bf1b5e5b92dded6558fd9ac93582d992b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "自宅の玄関に宅配の箱が置いてありましたが、宛名が知らない人です。住所はこの家で合っています。配達の人が、部屋を間違えたんでしょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "前に住んでいた人の荷物かもしれませんね。中を開ける前に、配達の会社へ、宛名と住所が合っていないことを知らせてください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "近所に同じ名前の人がいたら、私が持っていってあげてもいいですか。住所が正しいので、受け取ったことにしてもよい気もしますが。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "この家の荷物とは限りませんし、送り主の品物を勝手に移さないほうがいいです。伝票の番号を伝えれば、会社で届け先を調べてもらえます。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "分かりました。箱には触っただけで、まだ開けていません。電話して、引き取りなどの方法を聞きます。伝票をなくさないように置いておきます。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "それで大丈夫です。もし会社から改めて連絡があったら、記録も残しておいてください。前の住人の住所を自分で調べる必要はありません。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-04-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n3/04/audio/problem-1-03.mp3",
      "startMs": 304099,
      "endMs": 394868,
      "durationMs": 90769,
      "sha256": "a73a5f3bc093fb11e47adbba0c4c5a1383523ab021b4b86f15bbc95e1538e506",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "上映会の座席札、番号だけ書けばいいよね。同じ列では同じ色にして、入口で迷わないようにしたいんだけど、紙はもう切ってあるよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "番号は列ごとに一から始まるから、それだけだと同じ数字がいくつもできる。入口で配る券には、列の文字と番号が両方印刷されているんだ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "じゃあ、色だけで列を分けるのでは足りないんだね。札を椅子に置く前に、全員へ違う券を配り直したほうがいいのかな。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "券は直さなくていいよ。まず、札の番号の前に、その列の文字を足してほしい。入り口から並ぶ列の順番は、この机の図で確認できる。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "文字を足してから、同じ列の札をまとめるね。色は、そのあとで選んでもいいかな。暗い中では色の差が分かりにくいこともあるよね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうだね。色は補助にしよう。文字と番号が券に合っていれば、係も案内しやすい。札を置く場所を確認するのは、書き足したあとに一緒にやろう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-04-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n3/04/audio/problem-1-04.mp3",
      "startMs": 394868,
      "endMs": 493883,
      "durationMs": 99015,
      "sha256": "fc3b09499b512361b2818a49a13d1e8e8dc19059fb54e6f9b3ac6cbb2e78ae01",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "畑の網が、昨夜の風で少し下がっていますね。午後にまた風が強くなるそうです。作物へ水をやってから、新しい網を買いに行きましょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "網そのものは破れていません。端の柱が一本傾いて、結んだ所が緩んでいるようです。今は網の交換より、柱を立て直すことが必要ですね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "網がないと鳥が入るので、全部取り外すのは心配です。支えている間に結び直せるなら、先にひもだけ強く引いておきますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "柱が傾いたままだと、強く引いてもまた緩みます。先に柱の周りの土を戻して、まっすぐ固定してください。網は私が持っておきます。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "分かりました。柱を直したあとで、ひもの長さを調整するんですね。土が乾いている所があったら、あとで水もやっておきましょう。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ええ。作物の水やりは、そのあとで大丈夫です。今日のうちに確認すれば、午後の風にも備えられます。予備の網は、まだ棚に一枚ありますよ。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-04-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n3/04/audio/problem-1-05.mp3",
      "startMs": 493883,
      "endMs": 593580,
      "durationMs": 99697,
      "sha256": "09dbb8e021b8a0574d3eb5bbe71e3300757b7793c5659f836b5584501bd88324",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "募金が集まったので、今日中に支援団体へ送ろうと思います。封筒の現金を銀行で振り込めばよいでしょうか。合計は二万円です。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "その二万円は全額を団体に送ると案内して集めました。振込には手数料がかかるかもしれませんが、それは募金から引かず、会の運営費で払います。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "手数料の分も別に持っていくんですね。千円くらい用意すれば足りそうですが、銀行へ行ってから足りないと、もう一度戻ることになりますね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "必要な金額は、振り込む方法によって違うそうです。まず銀行に電話して、現金で二万円を送る場合の手数料を聞いてください。分かってから運営費を渡します。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、募金の金額は変えず、送るための費用を先に問い合わせます。団体の口座番号は手元にあるので、それも見ながら相談できます。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "お願いします。振込後の控えは保管して、後日、二万円を届けたことを参加者へ報告しましょう。備品を買うお金とは別に管理してあります。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-04-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n3/04/audio/problem-1-06.mp3",
      "startMs": 593580,
      "endMs": 687805,
      "durationMs": 94225,
      "sha256": "44598969f2b670c913903944e8630fa2c4cd25ae22da892243ae2b5b13576aa5",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "劇の音を編集していたら、必要な鐘の音まで消してしまった。最後の場面で使うんだ。もう一度録音に行かないと、明日の練習に間に合わないかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "その編集用のファイルには戻す機能があるよ。ただ、今ここで戻すと、そのあと直した声の大きさまで元に戻ってしまうんじゃないかな。"
        },
        {
          "actor": "youngMale",
