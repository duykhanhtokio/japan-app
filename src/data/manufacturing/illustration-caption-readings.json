  "lessonBindings": {
    "mfg1-mechanical-completion37-lesson-005": {
      "sourceHash": "2bf5cb74cabbf985db053d356c2ce307406d85d9d4f3c4f1ba3914fc19d2132d",
      "titleJa": "尺度と九種類の線を図の役割から読む",
      "summaryJa": "尺度、書かれた実寸、線の種類、線幅を別の情報として読む。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "尺度の数と実寸",
          "textJa": "この資料の倍尺の例は2:1、5:1、10:1、20:1、50:1です。縮尺の例は1:2、1:5、1:10、1:20、1:50、1:100、1:200、1:500、1:1000、1:2000、1:5000、1:10000です。図に書かれた寸法は原則として対象の実寸であり、印刷倍率が変わっても数値を勝手に変更しません。"
        },
        {
          "id": "section-2",
          "titleJa": "太さと線の繰返し",
          "textJa": "細線・太線・極太線の比1:2:4という説明と、筆記具0.3・0.5・0.7mmという例は別です。後者三本が1:2:4だとはしません。太い実線の外形線、細い実線の寸法線と寸法補助線、破線の隠れ線は、何を指す線かまで読みます。"
        },
        {
          "id": "section-3",
          "titleJa": "残る線の意味",
          "textJa": "一点鎖線の中心線、二点鎖線の想像線、波形やジグザグの破断線、切断位置を示す切断線、切り口のハッチングも区別します。見た目が同じ細い実線でも寸法線、補助線、ハッチングの役割は異なります。複写や縮小で見分けにくい図は原図を確認します。"
        }
      ]
    },
    "mfg1-mechanical-completion37-lesson-008": {
      "sourceHash": "137f3c0b3bd175a5c0c0a65b18a2471757a12690e429f86b2cdf6daaf3508713",
      "titleJa": "鋼材名の例と工作機械の部位を仕様へ照合する",
      "summaryJa": "名称、数字、部位の位置を仕様に結び付け、作業権限とは分ける。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "数字を使用許可にしない",
          "textJa": "資料は一般構造用圧延鋼材SS330を、引張強さ330N/mm²以上という名称の読み方の例として扱います。これは降伏強さや許容荷重が330という意味ではありません。実材料の規格版、寸法区分、検査証明、用途の要求を担当者と確認し、名称だけで設計や受入を承認しません。"
        },
        {
          "id": "section-2",
          "titleJa": "旋盤の部位を言い分ける",
          "textJa": "資料の旋盤では、主軸台、チャック、刃物台、心押し台、往復台を図で区別します。サドルとエプロンは往復台に関係する部位名で、エプロンをチャックのつめと同一にしません。教材の位置関係は機種の一例で、ハンドルや操作部の実際の機能はその設備の説明と教育で確認します。"
        },
        {
          "id": "section-3",
          "titleJa": "工具を回す設備の違い",
          "textJa": "立形フライス盤の例では主軸頭、主軸、コラム、操作盤、テーブル、ベッドがあります。ボール盤の例ではコラム、チャック、ドリル、テーブル、ベース、主軸まわりのハンドルを区別します。マシニングセンタは工具自動交換の機能を持ちますが、軸構成や加工可能面は機種・保持条件によって異なります。"
        }
      ]
    },
    "mfg1-surface-completion37-lesson-006": {
      "sourceHash": "0d2ac0c7e94acd39886ad536f83d38d29fda29b4c60fd1678bf53c04da98c587",
      "titleJa": "独立した工程記録から管理項目と異常を読み取る",
      "summaryJa": "分母、期間、測定量、時間順を確認する。管理限界と仕様限界、原因候補と確認された原因を分ける。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "管理表を四つの問いで読む",
          "textJa": "学習用記録を「工程：外観確認、管理項目：異物の付着、方法：指定照明と限度見本、頻度：ロット開始時と変更後、異常時：対象品を区分し責任者へ連絡」と設定します。何を、どう、いつ、異常ならどうするかを分けて読みます。確認頻度を作業者の都合で省略したり、記録だけを後でまとめて作ったりしません。この記録は独立した紙上例で、実職場の標準ではありません。"
        },
        {
          "id": "section-2",
          "titleJa": "チェックシートから優先課題へ進む",
          "textJa": "架空の一日分の件数を、異物12件、色むら6件、傷4件、その他2件とします。合計24件なので、異物は50%、異物と色むらまでの累積は75%です。パレート図では件数の棒と累積比率の線を読み分けます。「異物が50%」は今回分類した件数の割合で、全製品の半分が不良という意味ではありません。分母と集計期間を必ず確認します。"
        },
        {
          "id": "section-3",
          "titleJa": "分布・時間順・関係を混同しない",
          "textJa": "ヒストグラムは測定値を区間に分けた度数分布、管理図は時間順の変化、散布図は二つの量の組合せを見る道具です。特性要因図は結果に関わる原因候補を整理しますが、図に書いた候補が実証された原因になったわけではありません。散布図の関連から因果を断定したり、時間順を捨てた分布だけで発生時刻を特定したりしません。"
        },
        {
          "id": "section-4",
          "titleJa": "工程の変化と製品の合否を分ける",
          "textJa": "独立した紙上例で、製品仕様を20～30、工程の管理限界を23～26と与えます。測定値26.8は仕様範囲内でも上側管理限界を超えています。製品が直ちに不合格と断定することと、工程の異常を調べることは別です。管理限界を超えたら、指定された異常対応と対象品の扱いを確認し、限界線を勝手に広げて帳尻を合わせません。"
        }
      ]
    },
    "mfg1-surface-completion37-lesson-008": {
      "sourceHash": "e17a09d99688d56b781a52c0523a2c46f31254fed711cf30d62e2d0a1d544956",
      "titleJa": "皮膜・電子・塗装方式の説明範囲を分ける",
      "summaryJa": "模型は概念を区別する道具。電荷、移動経路、方式、実設備の条件を混同しない。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "腐食では金属側と液側を区別する",
          "textJa": "局部電池による腐食は、異種金属の接触や表面の状態差と、電解質を含む環境が関係します。電子は金属などの導電経路を通り、液中ではイオンの移動が電荷の移動に関わります。ピンホールがあると水などが基材へ届く経路になります。金属の反応しやすさの並びだけで、全ての環境での腐食速度や酸への溶け方を断定せず、保護皮膜と実際の液・温度も考えます。"
        },
        {
          "id": "section-2",
          "titleJa": "陽極酸化の二つの領域を読む",
          "textJa": "代表的な多孔質皮膜では、孔を含む領域と基材側の緻密なバリア層を分けて考えます。模式図のセル形状や孔の寸法は全ての実皮膜を同じ形で保証するものではありません。自然酸化膜の説明を、全ての酸・アルカリに耐えて反応しないという意味に広げず、処理皮膜とも区別します。塗装などによる被覆、電気防食、材料自体の耐食性改善も、それぞれ異なる防食の考え方です。"
        },
        {
          "id": "section-3",
          "titleJa": "反応式は役割を読むための模型",
          "textJa": "Al→Al³⁺＋3e⁻では電子を失う酸化、2H⁺＋2e⁻→H₂では電子を受け取る還元を読みます。ただし、陽極酸化の模式的な水や酸化物の式を、液中に存在する全化学種や反応機構の完全な説明にはしません。上付きの電荷が欠けた印刷や抽出結果は、そのまま反応式として採用せず、確認済みの資料へ戻ります。電子矢印を液中の電子の流れや実設備の配線図に読み替えません。"
        },
        {
          "id": "section-4",
          "titleJa": "塗装は付着・電着・硬化を分ける",
          "textJa": "静電塗装は帯電に関わる力を利用する方法ですが、全設備で基材へ正の電源を直接つなぐという配線指示ではありません。電着塗装にはアニオン方式とカチオン方式があり、品物がどちらの電極になるかは方式で異なります。粉体塗装は粉末状塗料の付着と加熱による塗膜形成、焼付けは塗膜を加熱して硬化させる工程として区別します。樹脂の系列、水性・溶剤系、一液・二液という名称だけで耐久性の順位や混合・温度条件を決めません。"
        }
      ]
    },
    "mfg1-mechanical-completion37-lesson-003": {
      "sourceHash": "de68dcd82c4cb4d3eea8cbe62374dc8d6fcaed154b3eda3430ebe9a949123b5d",
      "titleJa": "測定器の形・基準・一目盛を区別する",
      "summaryJa": "形の違いを目的に結び付け、一回転と一目盛、基準と差を区別する。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "支える道具と測る道具",
          "textJa": "直定規、スコヤ、内外パス、トースカン、金マス、マグネットベースは、案内、転写、保持など役割が異なります。資料のVブロックは90度の溝で円筒を支える例です。すべてのVブロックの角度を90度とせず、現物の仕様と接触条件を確認します。"
        },
        {
          "id": "section-2",
          "titleJa": "マイクロメータの一回転",
          "textJa": "外側マイクロメータは固定したアンビルと動くスピンドルの測定面で寸法を捉えます。ねじピッチ0.5mm・50等分なら一目盛0.01mm、1mm・100等分でも0.01mmです。独自例でスリーブ14.5mmとシンブル0.23mmなら14.73mmです。推定した桁を機種の保証精度と混同しません。"
        },
        {
          "id": "section-3",
          "titleJa": "比較値と合否の道具",
          "textJa": "プランジャ式の測定子は直線的に、てこ式は傾くように動き、シリンダゲージは穴内径を比較する形です。基準30.000mmとの差が−0.012mmという条件なら29.988mmです。プラグやスナップの限界ゲージは決められた通り・止りの条件で判定し、精密な実測値を直接表示する道具とは区別します。ねじプラグはめねじ、ねじリングはおねじに対応します。"
        }
      ]
    },
    "mfg1-electrical-l039": {
      "sourceHash": "c403b451ea4b43c5527d295a04898eaace52af2ff980ff247cbe36ae7bb982b2",
      "titleJa": "電気計器が測る量と条件を確認する",
      "summaryJa": "測定量に合う計器を選び、単位・接続・センサー条件を残す。熱電対の使用範囲は製品仕様で確認する。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "部品の値を測るLCRメーター",
          "textJa": "LCRメーターはコイルのインダクタンスL、コンデンサの静電容量C、抵抗Rやインピーダンスなどを測る計器です。抵抗・電圧だけを読むテスターとは測定対象や方法が異なります。部品の種類、接続、測定周波数などの条件を仕様と照合し、数値だけを見て合否を決めません。回路に接続したまま測れるかどうかも、機器と手順の条件で確認します。"
        },
        {
          "id": "section-2",
          "titleJa": "熱電対は温度差を利用する",
          "textJa": "熱電対は異なる金属の組合せで、接点の温度差に応じて生じる熱起電力を利用します。計測する側の温度だけでなく基準接点の扱いが関係します。種類、補償導線、極性、計器の設定が一致しているか確かめます。使用温度範囲は熱電対の種類だけで一律に保証せず、製品仕様・使用条件で判断します。"
        },
        {
          "id": "section-3",
          "titleJa": "光と磁界は別の量",
          "textJa": "照度計は受光部へ届く光に関する照度を測り、ガウスメーターはホール素子などを使って磁束密度を測ります。光が明るいことと磁界が強いことは別の評価です。センサーの向き、置く位置、外部の影響が結果に関係するため、比較するときは測定条件をそろえます。単位と計器名を測定記録へ併記すると取り違えを防げます。"
        }
      ]
    },
    "mfg1-electrical-l091": {
      "sourceHash": "6191040b40cd1b29a61a7ebd79c51d5fb6faa7021ab0eb8ef4d9f71191010e91",
      "titleJa": "測定の原理と目盛の分解能を区別する",
      "summaryJa": "測定の原理と目盛の分解能を区別するでは、名称だけでなく構造・用途・適用条件を照合する。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "機構と最小読取り",
          "textJa": "教材例のマイクロメータはねじ一回転0.5mm、シンブル50等分なので一目盛0.01mmです。表示の最小桁と測定の正確さは同一ではありません。ダイヤルゲージにも0.001mmを読める機種がありますが、全機種の値ではなく、測定範囲・接触・管理状態を合わせて確認します。"
        },
        {
          "id": "section-2",
          "titleJa": "温度と磁束密度の変換",
          "textJa": "熱電対は二種類の金属の接点間の温度差による熱起電力を使います。Kタイプの教材温度範囲は一例で、線径、保護管、雰囲気、計器で使用範囲は変わります。ホール素子では電流と垂直な磁界に対し両者と直交する向きに電圧が現れ、ガウスメーターで磁束密度を測る原理に使われます。"
        },
        {
          "id": "section-3",
          "titleJa": "電気量から別の量を知る",
          "textJa": "LCRメーターの自動平衡ブリッジなどは電圧・電流・位相を利用して素子値を求めます。静電容量は導体間に電荷を蓄える能力で、材料の厚さ、変位、液面等の変化の検出にも応用されます。対象量が何で、どの電気量へ変換しているかを区別し、容量の変化だけで原因を一つに断定しません。"
        }
      ]
    },
    "mfg1-mechanical-lesson-018": {
      "sourceHash": "ef7d6a94982c25a984c9480e920b2af82a1a00fa9bf3844e86e9877681db9cdb",
      "titleJa": "ノギスの測定面と副尺を使い分ける",
      "summaryJa": "測定面と最小読取値を先に確認する。主尺と副尺を足し、表示の細かさを精度と混同しない。",
      "paragraphs": [
        {
          "id": "principle",
          "titleJa": "仕組みと判断の基準",
          "textJa": "ノギスには外側用と内側用のジョウがあり、デプスバー付きなら深さも測れます。対象に応じた測定面を選び、測定面の汚れ、動き、がたつき、閉じたときのすき間とゼロ点を確認します。測定物も清掃し、ばりの処置は承認された方法で行います。強く挟めば正確になるわけではありません。"
        },
        {
          "id": "example",
          "titleJa": "現場の事例を整理する",
          "textJa": "最小読取値0.05 mmのノギスで、主尺の読みが18 mm、副尺の一致する線が4番目なら、副尺分は4×0.05＝0.20 mmです。合計は18.20 mmです。「4番目」を0.4 mmと読み替えないよう、使う器具の最小読取値を先に確認します。これは読み方の計算例で、実際の線の一致は器具を正面から見て確認します。"
        },
        {
          "id": "decision",
          "titleJa": "記録と誤りやすい点",
          "textJa": "外側寸法はできるだけジョウの根元で安定して挟み、傾いた状態で読まないようにします。内側寸法や深さも、対象との当たり方を確認します。デジタル表示の細かさと測定の正確さは別です。表示が細かいだけで、必要な公差の判定に使えるとは判断せず、指定の測定器を使います。"
        }
      ]
    },
    "mfg1-mechanical-lesson-075": {
      "sourceHash": "80a747f91c28b9340f03c953160e65d5a625d0342db5fe150a364ab708bc3eaa",
      "titleJa": "引張の特性値と五つの硬さ試験を区別する",
      "summaryJa": "引張の特性値と五つの硬さ試験を区別する。名称だけでなく対象・条件・記録をそろえる。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "対象と役割",
          "textJa": "引張強さは引張試験での最大応力、降伏強さは塑性変形が進み始める際の基準となる応力、破断伸びは破断後の標点間距離の増加率に関わる値です。ヤング率は弾性域の応力とひずみの関係を示します。荷重中のある一時点の伸びを、そのまま破断伸びや引張強さと呼ばないようにします。"
        },
        {
          "id": "section-2",
          "titleJa": "原理と区別",
          "textJa": "ロックウェル硬さはくぼみの深さを用い、HRの後にスケールを示します。ブリネル硬さは球によるくぼみの直径を用い、超硬合金球の例ではHBWと表します。ビッカース硬さHVは四角すいのくぼみの対角線、ヌープ硬さHKは細長いひし形のくぼみの長い対角線を用います。資料では薄い層などにはヌープを考える例があります。"
        },
        {
          "id": "section-3",
          "titleJa": "記録と確認",
          "textJa": "ショア硬さは落下させたハンマの跳ね返り高さを用います。深さ・直径・対角線・反発の高さという測る対象の違いを整理します。同じ数値でも尺度が異なれば直接比較できません。試験による圧痕の影響、試験片と製品の使い道、荷重等の条件は指定方法で確認します。"
        }
      ]
    },
    "mfg1-electrical-l006": {
      "sourceHash": "540a1c3e16efed961ad30a27dad230fa427d266bae80ff59db5decee27a6f492",
      "titleJa": "オームの法則を単位と一緒に使う",
      "summaryJa": "式に入れる前に A、Ω などへ単位をそろえる。\n計算と定格確認は別の確認である。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "三つの量の関係",
          "textJa": "一定温度でオームの法則に従う抵抗について、電圧 V、電流 I、抵抗 R の間には V = I × R の関係があります。ここで使う単位は V、A、Ω です。数字だけを式へ入れず、単位をそろえてから計算します。\n1 A は 1000 mA、1 kΩ は 1000 Ω です。例えば 8 mA は 0.008 A です。mA を A と同じ数字で代入すると、結果が 1000 倍違ってしまいます。"
        },
        {
          "id": "section-2",
          "titleJa": "計算結果を現場の判断につなぐ",
          "textJa": "同じ抵抗に加える電圧が上がると、電流も増えます。ただし、実際の機器には抵抗以外の部品や温度変化もあるため、単純な式だけで設備全体を判断しません。\n計算は定格や仕様を確認するための一つの手段です。計算上電流が求まっても、その部品が発熱に耐えられるか、電源の容量が足りるかは別に確認する必要があります。"
        },
        {
          "id": "formulae",
          "titleJa": "式と単位",
          "textJa": "V = I × R\nI = V / R\n12 / 2000 = 0.006 A = 6 mA"
        },
        {
          "id": "example",
          "titleJa": "現場での考え方",
          "textJa": "計算練習として、12 V の直流電源に 2.0 kΩ の理想抵抗を接続した場合を考える。\n1. 2.0 kΩ = 2000 Ω に換算する。\n2. I = V ÷ R = 12 ÷ 2000 = 0.006 A。\n3. 0.006 A = 6 mA に換算する。\n理想条件で電流は 6 mA。実際に接続する前には抵抗と電源の定格も確認する。"
        }
      ]
    },
    "mfg1-surface-lesson-006": {
      "sourceHash": "10d403ac5e6bd4cb3e079539984a41cb22aaedd6182600405f4ba79b81b9a4f7",
      "titleJa": "電流密度と品物の形から膜厚の違いを考える",
      "summaryJa": "平均電流密度は電流÷面積。\n局所の分布は平均値とは異なる。\n形状と条件を関連づけて膜厚を確認する。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "電流を面積で考える",
          "textJa": "同じ電流でも、処理する面積が変わると、単位面積当たりの電流は変わります。電流密度は、対象面積に対してどれだけ電流が流れるかを表す値です。計算ではAとdm²など、使う単位をそろえます。\n処理面積は、単純な片面の投影面積とは限りません。両面、側面、穴の内側、処理しないマスキング部などをどのように扱うかは、計算条件と工程の決まりを確認します。"
        },
        {
          "id": "section-2",
          "titleJa": "平均値と局所の分布",
          "textJa": "平均電流密度を計算しても、表面のすべての場所で同じ電流密度になるわけではありません。角や突出部とくぼみでは、電流の分布が変わり、膜厚に差が生じることがあります。\n一般に電流が集中する部分は厚くなりやすく、届きにくい部分は薄くなりやすい傾向があります。ただし浴の性質、配置、かくはんなども影響するので、形だけで最終膜厚を断定しません。"
        },
        {
          "id": "section-3",
          "titleJa": "値を大きくすればよいとは限らない",
          "textJa": "電流を増やすと必ず良くなるわけではありません。条件を超えると外観や析出の安定性を損なう場合があります。管理条件、掛け数、処理面積の変更を無断で行わないことが重要です。\n膜厚の偏りを見つけたら、位置ごとの測定結果、掛け方、処理条件を記録して報告します。配列や補助治具などの対策は、担当者が評価して決定します。"
        },
        {
          "id": "example",
          "titleJa": "現場での考え方",
          "textJa": "計算練習として、処理面積が2.4dm²、電流が7.2Aなら、平均電流密度は7.2÷2.4=3.0A/dm²です。処理面積だけが4.8dm²になり電流が同じなら1.5A/dm²です。この数値は計算練習で、実際の浴の推奨条件ではありません。"
        }
      ]
    },
    "mfg1-mechanical-lesson-011": {
      "sourceHash": "7c03413b76ee4823f4b9ac8ec818aa9003f657910af6dff216db2eb51c4ac24d",
      "titleJa": "作業標準とQC工程図を読み分ける",
      "summaryJa": "作業標準はやり方、QC工程図は管理の仕組みを示す。対象と改訂版を確認し、両方を守る。",
      "paragraphs": [
        {
          "id": "principle",
          "titleJa": "仕組みと判断の基準",
          "textJa": "作業標準は、作業内容、順序、設備、工具、重要な条件などを明確にし、人や時間が変わっても必要な品質を保つために使います。QC工程図は、工程ごとに何を、どの方法で、どの頻度で管理し、異常時にどう処置するかを整理したものです。同じ工程でも、作業のやり方と管理の仕組みは役割が違います。"
        },
        {
          "id": "example",
          "titleJa": "現場の事例を整理する",
          "textJa": "架空の切断工程では、作業標準に材料の固定方法と使用工具が示されています。QC工程図には、切断長さを指定の測定器で開始時と30分ごとに確認し、範囲外なら対象品を区分して責任者へ連絡するとあります。作業が手順どおりにできたことだけで、30分ごとの測定を省いてはいけません。逆に、測定をしただけでは、固定方法を省いてよい理由になりません。"
        },
        {
          "id": "decision",
          "titleJa": "記録と誤りやすい点",
          "textJa": "文書を読むときは、対象品、工程、文書番号、改訂版を合わせて確認します。古い版と新しい版の条件が違うときは、経験で一方を選ばず確認します。異常品の処置、記録先、連絡先まで把握してから作業を始めます。ここでの頻度は架空の例で、実際には自工程の指定を使います。"
        }
      ]
    },
    "mfg1-electrical-l005": {
      "sourceHash": "ba42f6ec0d94216505cb723ceaf4b2e98b9f274eab63d4104ce63bb52af4a3fe",
      "titleJa": "テスターは測定量と接続方法を先に決める",
      "summaryJa": "電圧は並列、電流は直列。\n抵抗は無通電かつ必要な処置後に測る。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "何を測るかを決める",
          "textJa": "電圧は二点間の電位差なので、電圧計を対象の二点間に並列に接続します。電流は枝路を流れる量なので、電流計をその枝路に直列に入れます。電流レンジの計器を電源の両端に当てると、短絡や計器破損につながります。\n測定器には用途、入力端子、最大入力、安全定格があります。レンジを大きくしただけで、どの設備でも安全に測れるわけではありません。実際の設備で測定するには、担当資格・教育、設備の手順、適合する測定器を確認します。"
        },
        {
          "id": "section-2",
          "titleJa": "抵抗測定と作業後の確認",
          "textJa": "抵抗測定は測定器内の電源を使うため、通電中の回路には行いません。電源を切るだけでなく、残留電荷の処置などを指定手順で行い、必要なら対象を回路から切り離します。\n測定後は、リードが電流用端子に残っていないかを確認します。次の人が電圧を測るときの事故を防ぐため、測定器を職場で決められた状態に戻します。アナログ式の抵抗測定では、レンジごとのゼロ調整も必要です。"
        },
        {
          "id": "example",
          "titleJa": "現場での考え方",
          "textJa": "教育用の低電圧直流回路の電圧を測ろうとしたが、赤リードが電流入力端子に入っている。\n1. まだ回路に接続しない。\n2. 取扱説明書に従い、電圧測定用の端子と直流電圧機能、適切なレンジを確認する。\n3. 指導者の確認後、指定された二点間に並列接続する。\n測定量、端子、機能、レンジ、接続方法を一組で確認する。"
        }
      ]
    }
  },
