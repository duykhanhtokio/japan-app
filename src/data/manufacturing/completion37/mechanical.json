    {
      "id": "mfg1-mechanical-completion37-lesson-004",
      "specialty": "mechanical",
      "titleJa": "ノギスの部位と硬さ圧痕で測る位置を選ぶ",
      "objectiveJa": "部位の名称と、硬さ試験で読む線や方向を対応させる。",
      "paragraphs": [
        {
          "id": "section-1",
          "titleJa": "ノギスのどこを使うか",
          "textJa": "外側ジョウは外径や厚さ、内側ジョウは内径、デプスバーは深さの測定に対応します。主尺に沿ってスライダが動き、副尺式では主尺と副尺の一致線から読みます。スライダは動く部位の名称で、内側測定面やデプスバーと同じ名称ではありません。"
        },
        {
          "id": "section-2",
          "titleJa": "くぼみの輪郭と読む長さ",
          "textJa": "ビッカースの模式圧痕は上から見たほぼ正方形で、向かい合う角を結ぶ二本が対角線です。辺と対角線を取り違えず、規定方法で両方向を確認します。ヌープの細長いひし形では長い対角線を区別します。輪郭が似ていても試験法や荷重を勝手に置き換えません。"
        },
        {
          "id": "section-3",
          "titleJa": "硬さ以外の量と区別する",
          "textJa": "ロックウェルはくぼみの深さ、ブリネルは球のくぼみの直径、ショアは跳ね返り高さが関わります。硬さ数値を引張強さそのものとせず、試験条件と記号を記録します。小さい圧痕でも製品への影響は別に判断し、検査したから出荷してよいとは決めません。"
        }
      ],
      "terms": [
        {
          "ja": "スライダ",
          "reading": "すらいだ",
          "meaningJa": "ノギスの主尺に沿って動く部分。"
        },
        {
          "ja": "対角線",
          "reading": "たいかくせん",
          "meaningJa": "四角形で隣り合わない二つの角を結ぶ線。"
        }
      ],
      "activityJa": "ノギスの三つの測定箇所を紙上で指す。正方形の二対角線と細長いひし形の長対角線を別々に描く。",
      "safetyJa": [
        "動いている製品を測らず、圧痕のある製品の扱いは指定の判定に従う。"
      ],
      "summaryJa": "測定面、対角線、深さ、直径、反発高さを目的に合わせて区別する。",
