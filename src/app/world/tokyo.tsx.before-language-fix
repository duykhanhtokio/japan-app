function LocationCard({
    location,
    onPress,
}: {
    location: TokyoLocation;

    onPress: () => void;
}) {
    return (
        <Pressable
            onPress={onPress}
            style={({ pressed }) => [
                styles.card,

                location.unlocked
                    ? styles.cardUnlocked
                    : styles.cardLocked,

                pressed &&
                styles.cardPressed,
            ]}
        >
            <ImageBackground
                source={location.image}
                style={styles.cardImage}
                imageStyle={styles.cardRadius}
                resizeMode="cover"
            >
                {/* IMAGE SHADE */}

                <View
                    pointerEvents="none"
                    style={[
                        styles.cardShade,

                        !location.unlocked &&
                        styles.cardShadeLocked,
                    ]}
                />

                {/* TOP BADGE */}

                <View
                    style={
                        styles.cardTop
                    }
                >
                    {location.unlocked ? (
                        <View
                            style={
                                styles.openBadge
                            }
                        >
                            <Text
                                style={
                                    styles.openBadgeText
                                }
                            >
                                OPEN
                            </Text>
                        </View>
                    ) : (
                        <View
                            style={
                                styles.lockBadge
                            }
                        >
                            <Text
                                style={
                                    styles.lockBadgeText
                                }
                            >
                                🔒 LOCK
                            </Text>
                        </View>
                    )}

                    <View
                        style={
                            styles.cardProgressBadge
                        }
                    >
                        <Text
                            style={
                                styles.cardProgressText
                            }
                        >
                            {
                                location.progress
                            }
                        </Text>
                    </View>
                </View>

                {/* BOTTOM */}

                <View
                    style={
                        styles.cardBottom
                    }
                >
                    <Text
                        style={
                            styles.cardJa
                        }
                    >
                        {location.ja}
                    </Text>

                    <Text
                        style={
                            styles.cardEn
                        }
                    >
                        {location.en}
                    </Text>

                    <Text
                        style={
                            styles.cardDescriptionJa
                        }
                        numberOfLines={1}
                    >
                        {
                            location.descriptionJa
                        }
                    </Text>

                    <Text
                        style={
                            styles.cardDescriptionVi
                        }
                        numberOfLines={1}
                    >
                        {
                            language === 'vi'
                                ? location.descriptionVi
                                : location.en
                        }
                    </Text>

                    {location.unlocked && (
                        <View
                            style={
                                styles.startRow
                            }
                        >
                            <Text
                                style={
                                    styles.startText
                                }
                            >
                                会話を始める
