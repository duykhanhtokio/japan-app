/*
 * =========================================================
 * TIME
 * =========================================================
 */

function formatRemainingTime(
    seconds:
        number
) {
    const safeSeconds =
        Math.max(
            0,
            seconds
        );

    const hours =
        Math.floor(
            safeSeconds /
            3600
        );

    const minutes =
        Math.floor(
            (
                safeSeconds %
                3600
            ) /
            60
        );

    const secs =
        safeSeconds %
        60;

    if (
        hours >
        0
    ) {
        return `${hours}時間${minutes}分`;
    }

    if (
        minutes >
        0
    ) {
        return `${minutes}分${secs}秒`;
    }

    return `${secs}秒`;
}

/*
 * =========================================================
 * VISUAL
 * =========================================================
 */

function getCropVisual(
    plot:
        FarmPlotState,

    now:
        number
) {
    if (
        plot.status ===
        'locked'
    ) {
        return {
            icon:
                '🔒',

            label:
                '未開放',

            urgent:
                false,

            watered:
                false,

            progress:
                0,
        };
    }

    if (
        plot.status ===
        'empty'
    ) {
        return {
            icon:
                undefined,

            label:
                '空き畑',

            urgent:
                false,

            watered:
                false,

            progress:
                0,
        };
    }

    if (
        plot.status ===
        'cleanup_required'
    ) {
        return {
            icon:
                '🪏',

            label:
                '古い株を抜く',

            urgent:
                true,

            watered:
                false,

            progress:
                1,
        };
    }

    if (
        plot.status ===
        'fertilizer_required'
    ) {
        return {
            icon:
                '🟤',

            label:
                '肥料をまく',

            urgent:
                true,

            watered:
                false,

            progress:
                0,
        };
    }

    if (
        plot.status ===
        'ready'
    ) {
        return {
            icon:
                '🌾',

            label:
                '収穫できます！',

            urgent:
                true,

            watered:
                true,

            progress:
                1,
        };
    }

    const production =
        plot.production;

    if (!production) {
        return {
            icon:
                '🌱',

            label:
                '成長中',

            urgent:
                false,

            watered:
                false,

            progress:
                0,
        };
    }

    const progress =
        getProductionProgress(
            production,
            now
        );

    const remainingSeconds =
        getProductionRemainingSeconds(
            production,
            now
        );

    if (
        production.status ===
        'care_required'
    ) {
        const requirement =
            production
                .careRequirements
                .find(
                    current =>
                        !current.completed &&
                        current.dueAt <=
                        now
                );

        const careLabel =
            requirement?.type ===
                'fertilizer'
                ? '肥料が必要！'
                : requirement?.type ===
                    'feed'
                    ? 'エサが必要！'
                    : requirement?.type ===
                        'drink'
                        ? '水を飲ませる！'
                        : '水やりが必要！';

        return {
            icon:
                '💧',

            label:
                careLabel,

            urgent:
                true,

            watered:
                true,

            progress,
        };
    }

    return {
        icon:
            progress >=
                0.66
                ? '🌿'
                : '🌱',

        label:
            formatRemainingTime(
                remainingSeconds
            ),

        urgent:
            false,

        /*
         * Đất tối hơn khi đã bước vào
         * nửa sau của growth cycle.
         *
         * Đây chỉ là visual.
         * Không phải legacy plot.watered.
         */
        watered:
            progress >=
            0.5,

        progress,
    };
}

/*
 * =========================================================
 * COMPONENT
 * =========================================================
 */

export default function FarmPlot({
    plot,
    number,
    selected,
    now =
    Date.now(),
    onPress,
}: FarmPlotProps) {
    const visual =
        getCropVisual(
            plot,
            now
        );

    const progressPercent =
        Math.round(
            visual.progress *
            100
        );

    return (
        <Pressable
            disabled={
                plot.status ===
                'locked'
            }
            onPress={
                onPress
            }
            style={({
                pressed,
            }) => [
                    styles.touchArea,

                    pressed &&
                    styles.pressed,
                ]}
        >
            <View
                style={[
                    styles.soilShadow,

                    selected &&
                    styles.soilShadowSelected,
                ]}
            >
                <View
                    style={[
                        styles.soil,

                        visual.watered &&
                        styles.soilMoist,

                        plot.status ===
                        'locked' &&
                        styles.soilLocked,
                    ]}
                >
                    <View
                        style={[
                            styles.furrow,
                            styles.furrowOne,
                        ]}
                    />

                    <View
                        style={[
                            styles.furrow,
                            styles.furrowTwo,
                        ]}
                    />

                    <View
                        style={[
                            styles.furrow,
                            styles.furrowThree,
                        ]}
                    />

                    {visual.icon && (
                        <View
                            style={
                                styles.cropLayer
                            }
                        >
                            <Text
                                style={
                                    styles.cropIcon
                                }
                            >
                                {
                                    visual.icon
                                }
                            </Text>
                        </View>
                    )}

                    {plot.status ===
                        'growing' &&
                        plot.production && (
                            <View
                                style={
                                    styles.progressTrack
                                }
                            >
                                <View
                                    style={[
                                        styles.progressFill,

                                        {
                                            width:
                                                `${progressPercent}%`,
                                        },
                                    ]}
                                />
                            </View>
                        )}
                </View>
            </View>

            <View
                style={
                    styles.plotNumber
                }
            >
                <Text
                    style={
                        styles.plotNumberText
                    }
                >
                    {number}
                </Text>
            </View>

            {/*
             * Không còn dấu ✓ ở góc.
             *
             * Selection chỉ thể hiện bằng
             * viền vàng của plot.
             */}

            {visual.label && (
                <View
                    style={[
                        styles.statusBubble,

                        visual.urgent &&
                        styles.statusBubbleUrgent,
                    ]}
                >
                    <Text
                        numberOfLines={
                            1
                        }
                        style={[
                            styles.statusText,

                            visual.urgent &&
                            styles.statusTextUrgent,
                        ]}
                    >
                        {
                            visual.label
                        }
                    </Text>
                </View>
            )}
        </Pressable>
    );
}

