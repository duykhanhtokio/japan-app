export default function FarmMapWorld({
    onSelect,
}: FarmMapWorldProps) {
    const {
        width,
    } =
        useWindowDimensions();

    const mapHeight =
        Math.max(
            560,
            width *
                1.30
        );

    return (
        <View
            style={
                styles.frame
            }
        >
            <ImageBackground
                source={
                    require(
                        '../../../../assets/game/farm/background/farm_map_master.png'
                    )
                }
                resizeMode="cover"
                style={[
                    styles.map,
                    {
                        height:
                            mapHeight,
                    },
                ]}
                imageStyle={
                    styles.image
                }
            >
                {HOTSPOTS.map(
                    hotspot => (
                        <Pressable
                            key={
                                hotspot.id
                            }
                            accessibilityRole="button"
                            accessibilityLabel={
                                hotspot.label
                            }
                            onPress={() =>
                                onSelect(
                                    hotspot.id
                                )
                            }
                            style={({
                                pressed,
                            }) => [
                                styles.hotspot,
                                {
                                    left:
                                        hotspot.left,
                                    top:
                                        hotspot.top,
                                    width:
                                        hotspot.width,
                                    height:
                                        hotspot.height,
                                },
                                pressed &&
                                    styles.hotspotPressed,
                            ]}
                        >
                            <View
                                pointerEvents="none"
                                style={
                                    styles.debugLabel
                                }
                            >
                                <Text
                                    style={
                                        styles.debugLabelText
                                    }
                                >
                                    {
                                        hotspot.label
                                    }
                                </Text>
                            </View>
                        </Pressable>
                    )
                )}
            </ImageBackground>
        </View>
    );
}

