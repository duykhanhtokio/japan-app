import {
    StyleSheet,
    Text,
    View,
} from 'react-native';

import type {
    FarmPlotState,
} from '@/game/core/game-types';

import FarmPlot from './FarmPlot';

import {
    FARM_COLORS,
    FARM_PLOT_POSITIONS,
} from './farm-theme';

type FarmWorldProps = {
    plots:
    readonly FarmPlotState[];

    selectedPlotId:
    string | null;

    onSelectPlot:
    (
        plotId:
            string
    ) => void;
};

export default function FarmWorld({
    plots,
    selectedPlotId,
    onSelectPlot,
}: FarmWorldProps) {
    return (
        <View
            style={
                styles.frame
            }
        >
            <View
                style={
                    styles.world
                }
            >
                {/*
                 * =============================================
                 * ENVIRONMENT LAYER
                 * =============================================
                 */}

                <View
                    pointerEvents="none"
                    style={
                        StyleSheet
                            .absoluteFill
                    }
                >
                    <View
                        style={
                            styles.skyLand
                        }
                    />

                    <View
                        style={
                            styles.distantHillLeft
                        }
                    />

                    <View
                        style={
                            styles.distantHillRight
                        }
                    />

                    <View
                        style={
                            styles.river
                        }
                    />

                    <View
                        style={
                            styles.path
                        }
                    />

                    <View
                        style={[
                            styles.tree,
                            styles.treeOne,
                        ]}
                    >
                        <Text
                            style={
                                styles.treeEmoji
                            }
                        >
                            🌳
                        </Text>
                    </View>

                    <View
                        style={[
                            styles.tree,
                            styles.treeTwo,
                        ]}
                    >
                        <Text
                            style={
                                styles.treeEmoji
                            }
                        >
                            🌳
                        </Text>
                    </View>

                    <View
                        style={[
                            styles.tree,
                            styles.treeThree,
                        ]}
                    >
                        <Text
                            style={
                                styles.treeEmoji
                            }
                        >
                            🌲
                        </Text>
                    </View>

                    <Text
                        style={
                            styles.flowerOne
                        }
                    >
                        🌼
                    </Text>

                    <Text
                        style={
                            styles.flowerTwo
                        }
                    >
                        🌻
                    </Text>
                </View>

                {/*
                 * =============================================
                 * BUILDING LAYER
                 *
                 * Đây là placeholder về vị trí.
                 * Building artwork thật sẽ thay các View này.
                 * =============================================
                 */}

                <WorldBuilding
                    style={
                        styles.farmHouse
                    }
                    icon="🏡"
                    label="農家"
                />

                <WorldBuilding
                    style={
                        styles.chickenCoop
                    }
                    icon="🐔"
                    label="鶏小屋"
                    small
                />

                <WorldBuilding
                    style={
                        styles.feedMill
                    }
                    icon="🏭"
                    label="飼料工場"
                    small
                />

                {/*
                 * =============================================
                 * PLOT LAYER
                 * =============================================
                 */}

                {plots.map(
                    (
                        plot,
                        index
                    ) => {
                        const position =
                            FARM_PLOT_POSITIONS[
                            index
                            ];

                        if (!position) {
                            return null;
                        }

                        return (
                            <View
                                key={
                                    plot.id
                                }
                                style={[
                                    styles.plotPosition,

                                    {
                                        left:
                                            position.left,

                                        top:
                                            position.top,

                                        width:
                                            position.width,
                                    },
                                ]}
                            >
                                <FarmPlot
                                    plot={
                                        plot
                                    }
                                    number={
                                        index +
                                        1
                                    }
                                    selected={
                                        selectedPlotId ===
                                        plot.id
                                    }
                                    onPress={() =>
                                        onSelectPlot(
                                            plot.id
                                        )
                                    }
                                />
                            </View>
                        );
                    }
                )}

                {/*
                 * Decorative foreground.
                 */}

                <View
                    pointerEvents="none"
                    style={
                        styles.foregroundFence
                    }
                >
                    <Text
                        style={
                            styles.fenceText
                        }
                    >
                        🪵  🪵  🪵
                    </Text>
                </View>
            </View>
        </View>
    );
}

/*
 * =========================================================
 * WORLD BUILDING PLACEHOLDER
 * =========================================================
 */

function WorldBuilding({
    icon,
    label,
    style,
    small = false,
}: {
    icon:
    string;

    label:
    string;

    style:
    object;

    small?:
    boolean;
}) {
    return (
        <View
            pointerEvents="none"
            style={[
                styles.building,
                small &&
                styles.buildingSmall,
                style,
            ]}
        >
            <Text
                style={[
                    styles.buildingIcon,
                    small &&
                    styles.buildingIconSmall,
                ]}
            >
                {icon}
            </Text>

            <View
                style={
                    styles.buildingLabel
                }
            >
                <Text
                    style={
                        styles.buildingLabelText
                    }
                >
                    {label}
                </Text>
            </View>
        </View>
    );
}

