import {
    ImageBackground,
    Pressable,
    StyleSheet,
    View,
} from 'react-native';

export type FarmMapDestination =
    | 'rice'
    | 'orchard'
    | 'chicken'
    | 'cow'
    | 'shop'
    | 'produce';

type FarmMapWorldProps = {
    onSelect:
        (
            destination:
                FarmMapDestination
        ) => void;
};

type Hotspot = {
    id:
        FarmMapDestination;

    left:
        `${number}%`;

    top:
        `${number}%`;

    width:
        `${number}%`;

    height:
        `${number}%`;
};

/*
 * Hotspots normalized to the approved full-screen portrait map.
 * Coordinates intentionally track the visible building/area footprint.
 */
const HOTSPOTS:
    readonly Hotspot[] = [
        {
            id:
                'orchard',
            left:
                '28%',
            top:
                '28%',
            width:
                '34%',
            height:
                '18%',
        },
        {
            id:
                'chicken',
            left:
                '3%',
            top:
                '39%',
            width:
                '28%',
            height:
                '16%',
        },
        {
            id:
                'cow',
            left:
                '65%',
            top:
                '32%',
            width:
                '31%',
            height:
                '20%',
        },
        {
            id:
                'rice',
            left:
                '0%',
            top:
                '58%',
            width:
                '34%',
            height:
                '22%',
        },
        {
            id:
                'produce',
            left:
                '37%',
