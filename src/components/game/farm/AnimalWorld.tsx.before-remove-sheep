                <View
                    pointerEvents="none"
                    style={
                        styles.titleBox
                    }
                >
                    <Text
                        style={
                            styles.title
                        }
                    >
                        {icon}{' '}
                        {
                            animal
                                ?.name
                                .textJa ??
                            buildingName
                        }
                    </Text>
                </View>

                {/*
                 * =========================================
                 * ANIMAL AREA
                 * =========================================
                 */}

                <View
                    style={
                        styles.slotArea
                    }
                >
                    {animalSlots.length ===
                        0 ? (
                        <View
                            style={
                                styles.emptyBox
                            }
                        >
                            <Text
                                style={
                                    styles.emptyIcon
                                }
                            >
                                {icon}
                            </Text>

                            <Text
                                style={
                                    styles.emptyText
