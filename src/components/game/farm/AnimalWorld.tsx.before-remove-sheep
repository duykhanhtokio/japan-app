/*
 * =========================================================
 * ANIMAL WORLD
 * =========================================================
 *
 * Presentation layer only.
 *
 * - Mỗi AnimalSlotState = một con vật.
 * - Chicken có ổ rơm riêng.
 * - Cow có ô chuồng + máng riêng.
 * - Sheep có ô chuồng riêng.
 * - Care requirement hiện trên đầu con vật.
 * - Product xuất hiện tại chính slot đó.
 * - Không thay đổi gameplay state.
 * =========================================================
 */

type AnimalWorldProps = {
    animalId:
    AnimalId;

    slots:
    readonly AnimalSlotState[];

    selectedSlotId:
    string | null;

    now:
    number;

    onSelectSlot:
    (
        slotId:
            string
    ) => void;

    onFeed:
    (
        slotId:
            string
    ) => void;

    onCare:
    (
        slotId:
            string
    ) => void;

    onCollect:
    (
        slotId:
            string
    ) => void;
};

/*
 * =========================================================
 * HELPERS
 * =========================================================
 */

function formatRemainingTime(
    readyAt:
        number | undefined,

    now:
        number
): string {
    if (
        readyAt ===
        undefined
    ) {
        return '';
    }

    const totalSeconds =
        Math.max(
            0,
            Math.ceil(
                (
                    readyAt -
                    now
                ) /
                1000
            )
        );

    const hours =
        Math.floor(
            totalSeconds /
            3600
        );

    const minutes =
        Math.floor(
            (
                totalSeconds %
                3600
            ) /
            60
        );

    const seconds =
        totalSeconds %
        60;

    if (
        hours >
        0
    ) {
        return (
            `${hours}:` +
            `${String(
                minutes
            ).padStart(
                2,
                '0'
            )}:` +
            `${String(
                seconds
            ).padStart(
                2,
                '0'
            )}`
        );
    }

    return (
        `${minutes}:` +
        `${String(
            seconds
        ).padStart(
            2,
            '0'
        )}`
    );
}

function getAnimalIcon(
    animalId:
        AnimalId
): string {
    switch (
    animalId
    ) {
        case 'chicken':
            return '🐔';

        case 'cow':
            return '🐄';

        case 'sheep':
            return '🐑';

        default:
            return '🐾';
    }
}

function getBuildingName(
    animalId:
        AnimalId
): string {
    switch (
    animalId
    ) {
        case 'chicken':
            return '鶏小屋';

        case 'cow':
            return '牛舎';

        case 'sheep':
            return '羊小屋';

        default:
            return '牧場';
    }
}

function getReadyProductIcon(
    animalId:
        AnimalId
): string {
    switch (
    animalId
    ) {
        case 'chicken':
            return '🥚';

        case 'cow':
            return '🥛';

        case 'sheep':
            return '🧶';

        default:
            return '📦';
    }
}

/*
 * =========================================================
 * WIND VEGETATION
 * =========================================================
 */

function WindTree({
    children,
    style,
    delay = 0,
}: {
    children:
    string;

    style:
    object;

    delay?:
    number;
}) {
    const sway =
        useRef(
            new Animated.Value(
                0
            )
        ).current;

    useEffect(
        () => {
            const animation =
                Animated.loop(
                    Animated.sequence([
                        Animated.delay(
                            delay
                        ),

                        Animated.timing(
                            sway,
                            {
                                toValue:
                                    1,

                                duration:
                                    1800,

                                easing:
                                    Easing.inOut(
                                        Easing.sin
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),

                        Animated.timing(
                            sway,
                            {
                                toValue:
                                    -1,

                                duration:
                                    2200,

                                easing:
                                    Easing.inOut(
                                        Easing.sin
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),

                        Animated.timing(
                            sway,
                            {
                                toValue:
                                    0,

                                duration:
                                    1800,

                                easing:
                                    Easing.inOut(
                                        Easing.sin
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),
                    ])
                );

            animation.start();

            return () => {
                animation.stop();
            };
        },
        [
            delay,
            sway,
        ]
    );

    const rotate =
        sway.interpolate({
            inputRange: [
                -1,
                0,
                1,
            ],

            outputRange: [
                '-2deg',
                '0deg',
                '2deg',
            ],
        });

    const translateX =
        sway.interpolate({
            inputRange: [
                -1,
                0,
                1,
            ],

            outputRange: [
                -1.5,
                0,
                1.5,
            ],
        });

    return (
        <Animated.Text
            pointerEvents="none"
            style={[
                style,

                {
                    transform: [
                        {
                            translateX,
                        },
                        {
                            rotate,
                        },
                    ],
                },
            ]}
        >
            {children}
        </Animated.Text>
    );
}

/*
 * =========================================================
 * ANIMATED ANIMAL
 * =========================================================
 *
 * Không di chuyển animal khỏi slot.
 *
 * Chỉ tạo:
 * - breathing
 * - cúi đầu ăn / mổ thóc
 * - nghỉ
 *
 * Các con lệch phase để không animate đồng loạt.
 * =========================================================
 */

function AnimatedAnimal({
    animalId,
    slotIndex,
    producing,
}: {
    animalId:
    AnimalId;

    slotIndex:
    number;

    producing:
    boolean;
}) {
    const movement =
        useRef(
            new Animated.Value(
                0
            )
        ).current;

    const breathe =
        useRef(
            new Animated.Value(
                0
            )
        ).current;

    useEffect(
        () => {
            const breathing =
                Animated.loop(
                    Animated.sequence([
                        Animated.timing(
                            breathe,
                            {
                                toValue:
                                    1,

                                duration:
                                    1500 +
                                    slotIndex *
                                    130,

                                easing:
                                    Easing.inOut(
                                        Easing.sin
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),

                        Animated.timing(
                            breathe,
                            {
                                toValue:
                                    0,

                                duration:
                                    1500 +
                                    slotIndex *
                                    130,

                                easing:
                                    Easing.inOut(
                                        Easing.sin
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),
                    ])
                );

            breathing.start();

            return () => {
                breathing.stop();
            };
        },
        [
            breathe,
            slotIndex,
        ]
    );

    useEffect(
        () => {
            if (
                !producing
            ) {
                movement.setValue(
                    0
                );

                return;
            }

            /*
             * Chicken:
             * cúi xuống nhanh hơn giống mổ thóc.
             *
             * Cow / Sheep:
             * cúi chậm hơn giống ăn cỏ / ăn máng.
             */
            const isChicken =
                animalId ===
                'chicken';

            const animation =
                Animated.loop(
                    Animated.sequence([
                        Animated.delay(
                            900 +
                            slotIndex *
                            420
                        ),

                        Animated.timing(
                            movement,
                            {
                                toValue:
                                    1,

                                duration:
                                    isChicken
                                        ? 180
                                        : 650,

                                easing:
                                    Easing.inOut(
                                        Easing.quad
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),

                        Animated.timing(
                            movement,
                            {
                                toValue:
                                    0,

                                duration:
                                    isChicken
                                        ? 180
                                        : 650,

                                easing:
                                    Easing.inOut(
                                        Easing.quad
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),

                        /*
                         * Chicken mổ thêm một lần.
                         */
                        ...(isChicken
                            ? [
                                Animated.delay(
                                    130
                                ),

                                Animated.timing(
                                    movement,
                                    {
                                        toValue:
                                            1,

                                        duration:
                                            160,

                                        useNativeDriver:
                                            true,
                                    }
                                ),

                                Animated.timing(
                                    movement,
                                    {
                                        toValue:
                                            0,

                                        duration:
                                            160,

                                        useNativeDriver:
                                            true,
                                    }
                                ),
                            ]
                            : []),

                        Animated.delay(
                            1800 +
                            slotIndex *
                            250
                        ),
                    ])
                );

            animation.start();

            return () => {
                animation.stop();
            };
        },
        [
            animalId,
            movement,
            producing,
            slotIndex,
        ]
    );

    const translateY =
        movement.interpolate({
            inputRange: [
                0,
                1,
            ],

            outputRange:
                animalId ===
                    'chicken'
                    ? [
                        0,
                        7,
                    ]
                    : [
                        0,
                        5,
                    ],
        });

    const rotate =
        movement.interpolate({
            inputRange: [
                0,
                1,
            ],

            outputRange:
                animalId ===
                    'chicken'
                    ? [
                        '0deg',
                        '10deg',
                    ]
                    : [
                        '0deg',
                        '5deg',
                    ],
        });

    const scale =
        breathe.interpolate({
            inputRange: [
                0,
                1,
            ],

            outputRange: [
                1,
                1.025,
            ],
        });

    return (
        <Animated.Text
            style={[
                styles.animalIcon,

                animalId ===
                'cow' &&
                styles.cowIcon,

                {
                    transform: [
                        {
                            translateY,
                        },
                        {
                            rotate,
                        },
                        {
                            scale,
                        },
                    ],
                },
            ]}
        >
            {
                getAnimalIcon(
                    animalId
                )
            }
        </Animated.Text>
    );
}

/*
 * =========================================================
 * CARE BUBBLE
 * =========================================================
 */

function CareBubble({
    type,
}: {
    type:
    'feed' |
    'drink' |
    'other';
}) {
    const pulse =
        useRef(
            new Animated.Value(
                0
            )
        ).current;

    useEffect(
        () => {
            const animation =
                Animated.loop(
                    Animated.sequence([
                        Animated.timing(
                            pulse,
                            {
                                toValue:
                                    1,

                                duration:
                                    550,

                                useNativeDriver:
                                    true,
                            }
                        ),

                        Animated.timing(
                            pulse,
                            {
                                toValue:
                                    0,

                                duration:
                                    550,

                                useNativeDriver:
                                    true,
                            }
                        ),
                    ])
                );

            animation.start();

            return () => {
                animation.stop();
            };
        },
        [
            pulse,
        ]
    );

    const translateY =
        pulse.interpolate({
            inputRange: [
                0,
                1,
            ],

            outputRange: [
                0,
                -4,
            ],
        });

    const icon =
        type ===
            'feed'
            ? '🌾'
            : type ===
                'drink'
                ? '💧'
                : '❗';

    return (
        <Animated.View
            pointerEvents="none"
            style={[
                styles.careBubble,

                {
                    transform: [
                        {
                            translateY,
                        },
                    ],
                },
            ]}
        >
            <Text
                style={
                    styles.careIcon
                }
            >
                {icon}
            </Text>

            <View
                style={
                    styles.careAlert
                }
            >
                <Text
                    style={
                        styles.careAlertText
                    }
                >
                    !
                </Text>
            </View>
        </Animated.View>
    );
}

/*
 * =========================================================
 * READY PRODUCT
 * =========================================================
 */

function ReadyProduct({
    animalId,
}: {
    animalId:
    AnimalId;
}) {
    const bounce =
        useRef(
            new Animated.Value(
                0
            )
        ).current;

    useEffect(
        () => {
            const animation =
                Animated.loop(
                    Animated.sequence([
                        Animated.timing(
                            bounce,
                            {
                                toValue:
                                    1,

                                duration:
                                    700,

                                easing:
                                    Easing.out(
                                        Easing.quad
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),

                        Animated.timing(
                            bounce,
                            {
                                toValue:
                                    0,

                                duration:
                                    700,

                                easing:
                                    Easing.in(
                                        Easing.quad
                                    ),

                                useNativeDriver:
                                    true,
                            }
                        ),
                    ])
                );

            animation.start();

            return () => {
                animation.stop();
            };
        },
        [
            bounce,
        ]
    );

    const translateY =
        bounce.interpolate({
            inputRange: [
                0,
                1,
            ],

            outputRange: [
                0,
                -5,
            ],
        });

    return (
        <Animated.View
            pointerEvents="none"
            style={[
                styles.readyProduct,

                {
                    transform: [
                        {
                            translateY,
                        },
                    ],
                },
            ]}
        >
            <Text
                style={
                    styles.productGlow
                }
            >
                ✨
            </Text>

            <Text
                style={
                    styles.productIcon
                }
            >
                {
                    getReadyProductIcon(
                        animalId
                    )
                }
            </Text>
        </Animated.View>
    );
}

/*
 * =========================================================
 * ANIMAL SLOT
 * =========================================================
 */

function AnimalSlot({
    slot,
    animalId,
    selected,
    now,
    index,
    onSelect,
    onFeed,
    onCare,
    onCollect,
}: {
    slot:
    AnimalSlotState;

    animalId:
    AnimalId;

    selected:
    boolean;

    now:
    number;

    index:
    number;

    onSelect:
    () => void;

    onFeed:
    () => void;

    onCare:
    () => void;

    onCollect:
    () => void;
}) {
    const dueCare =
        slot.production
            ?.careRequirements
            .find(
                requirement =>
                    !requirement.completed &&
                    requirement.dueAt <=
                    now
            );

    const careRequired =
        slot.status ===
        'producing' &&
        slot.production
            ?.status ===
        'care_required';

    let careType:
        'feed' |
        'drink' |
        'other' |
        null =
        null;

    if (
        careRequired
    ) {
        if (
            dueCare?.type ===
            'feed'
        ) {
            careType =
                'feed';
        } else if (
            dueCare?.type ===
            'drink'
        ) {
            careType =
                'drink';
        } else {
            careType =
                'other';
        }
    }

    const remainingText =
        formatRemainingTime(
            slot.production
                ?.readyAt ??
            slot.readyAt,
            now
        );

    const ready =
        slot.status ===
        'ready';

    const producing =
        slot.status ===
        'producing';

    return (
        <Pressable
            onPress={
                onSelect
            }
            style={({
                pressed,
            }) => [
                    styles.slot,

                    animalId ===
                        'chicken'
                        ? styles.chickenSlot
                        : styles.barnSlot,

                    selected &&
                    styles.selectedSlot,

                    pressed &&
                    styles.pressed,
                ]}
        >
            {/*
             * Care icon nằm phía trên đầu.
             */}
            {careType && (
                <Pressable
                    onPress={event => {
                        event.stopPropagation();
                        onCare();
                    }}
                    style={styles.careButton}
                    hitSlop={8}
                >
                    <CareBubble type={careType} />
                </Pressable>
            )}

            {/*
             * Phần phía sau animal.
             */}
            {animalId ===
                'chicken' ? (
                <>
                    <View
                        pointerEvents="none"
                        style={
                            styles.nestBack
                        }
                    >
                        <Text
                            style={
                                styles.strawBack
                            }
                        >
                            🌾🌾
                        </Text>
                    </View>

                    <View
                        pointerEvents="none"
                        style={
                            styles.chickenFeedGround
                        }
                    >
                        <Text
                            style={
                                styles.feedGroundText
                            }
                        >
                            · · ·
                        </Text>
                    </View>
                </>
            ) : (
                <>
                    <View
                        pointerEvents="none"
                        style={
                            styles.barnBack
                        }
                    />

                    <View
                        pointerEvents="none"
                        style={
                            styles.trough
                        }
                    >
                        <Text
                            style={
                                styles.troughFood
                            }
                        >
                            🌾
                        </Text>
                    </View>
                </>
            )}

            {/*
             * Animal.
             */}
            <View
                pointerEvents="none"
                style={
                    styles.animalPosition
                }
            >
                <AnimatedAnimal
                    animalId={
                        animalId
                    }
                    slotIndex={
                        index
                    }
                    producing={
                        producing &&
                        !careRequired
                    }
                />
            </View>

            {/*
             * Product của chính con vật.
             *
             * Click slot này vẫn gọi đúng slotId
             * qua onSelectSlot của parent.
             */}
            {ready && (
                <Pressable
                    onPress={event => {
                        event.stopPropagation();
                        onCollect();
                    }}
                    style={styles.productButton}
                    hitSlop={8}
                >
                    <ReadyProduct animalId={animalId} />
                </Pressable>
            )}

            {/*
             * Countdown.
             */}
            {producing &&
                !careRequired &&
                remainingText !==
                '' && (
                    <View
                        pointerEvents="none"
                        style={
                            styles.timerBadge
                        }
                    >
                        <Text
                            style={
                                styles.timerText
                            }
                        >
                            ⏱{' '}
                            {
                                remainingText
                            }
                        </Text>
                    </View>
                )}

            {/*
             * Idle hint.
             */}
            {slot.status ===
                'idle' && (
                    <Pressable
                        onPress={event => {
                            event.stopPropagation();
                            onFeed();
                        }}
                        style={styles.idleBadge}
                        hitSlop={6}
                    >
                        <Text
                            style={
                                styles.idleText
                            }
                        >
                            🌾 えさ
                        </Text>
                    </Pressable>
                )}

        </Pressable>
    );
}

/*
 * =========================================================
 * MAIN
 * =========================================================
 */

