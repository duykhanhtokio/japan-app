    const icon =
        getAnimalIcon(
            animalId
        );

    const buildingName =
        getBuildingName(
            animalId
        );

    return (
        <View
            style={
                styles.frame
            }
        >
            <View
                style={
                    styles.world
                }
            >
                {/*
                 * =========================================
                 * BACKGROUND
                 * =========================================
                 */}

                <View
                    pointerEvents="none"
                    style={
                        StyleSheet.absoluteFill
                    }
                >
                    <View
                        style={
                            styles.sky
                        }
                    />

                    <View
                        style={
                            styles.grass
                        }
                    />

                    <View
                        style={
                            styles.hillLeft
                        }
                    />

                    <View
                        style={
                            styles.hillRight
                        }
                    />

                    <View
                        style={
                            styles.path
                        }
                    />

                    <WindTree
                        style={
                            styles.treeLeft
                        }
                    >
                        🌳
                    </WindTree>

                    <WindTree
                        delay={
                            350
                        }
                        style={
                            styles.treeRight
                        }
                    >
                        🌲
                    </WindTree>

                    <WindTree
                        delay={
                            180
                        }
                        style={
                            styles.bushLeft
                        }
                    >
                        🌿
                    </WindTree>

                    <WindTree
                        delay={
                            600
                        }
                        style={
                            styles.bushRight
                        }
                    >
                        🌿
                    </WindTree>

                    <Text
                        style={
                            styles.flowerLeft
                        }
                    >
                        🌼
                    </Text>

                    <Text
                        style={
                            styles.flowerRight
                        }
                    >
                        🌻
                    </Text>
                </View>

                {/*
                 * =========================================
                 * BUILDING
                 * =========================================
                 */}

                <View
                    pointerEvents="none"
                    style={
                        styles.building
                    }
                >
                    <Text
