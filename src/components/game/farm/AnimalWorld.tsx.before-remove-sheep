                                        animalId
                                    }
                                    selected={
                                        slot.id ===
                                        selectedSlotId
                                    }
                                    now={
                                        now
                                    }
                                    index={
                                        index
                                    }
                                    onSelect={() => onSelectSlot(slot.id)}
                                    onFeed={() => onFeed(slot.id)}
                                    onCare={() => onCare(slot.id)}
                                    onCollect={() => onCollect(slot.id)}
                                />
                            )
                        )
                    )}
                </View>
            </View>
        </View>
    );
}

