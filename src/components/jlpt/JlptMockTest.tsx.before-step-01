import { useEffect, useMemo, useState } from 'react';
import { Pressable, StyleSheet, Text, View } from 'react-native';
import * as Speech from 'expo-speech';
import { generatedGrammar, generatedScenarios, generatedVocabulary, type JlptLevel } from '@/data/jlpt-learning';
import { saveSectionScore } from '@/services/jlpt-progress-storage';

type Kind='vocabulary'|'grammar'|'reading'|'listening';
type Question={id:string;kind:Kind;prompt:string;passage?:string;audioText?:string;options:{id:string;label:string}[];correctId:string;explanation:string;example?:string};
const EXAM_MINUTES:Record<JlptLevel,number>={N1:165,N2:155,N3:140,N4:115,N5:90};
const COUNTS:Record<JlptLevel,Record<Kind,number>>={
 N1:{vocabulary:25,grammar:20,reading:25,listening:20},N2:{vocabulary:25,grammar:20,reading:20,listening:20},
 N3:{vocabulary:30,grammar:20,reading:15,listening:20},N4:{vocabulary:30,grammar:20,reading:10,listening:20},N5:{vocabulary:25,grammar:20,reading:10,listening:20},
};
function circular<T>(items:T[],start:number,count:number){return Array.from({length:count},(_,i)=>items[(start+i)%items.length]).filter(Boolean);}
function options<T extends {id:string}>(pool:T[],correct:T,index:number,label:(item:T)=>string){const wrong=circular(pool,index+1,8).filter(x=>x.id!==correct.id).slice(0,3);return circular([correct,...wrong],index%4,4).map(x=>({id:x.id,label:label(x)}));}
function build(level:JlptLevel,testNumber:number):Question[]{
 const words=generatedVocabulary.filter(x=>x.jlpt===level&&x.status!=='Rejected'); const grammar=generatedGrammar.filter(x=>x.jlpt===level&&x.status!=='Rejected'); const scenarios=generatedScenarios.filter(x=>x.difficulty===level&&x.status!=='Rejected'); const seed=(testNumber-1)*97; const counts=COUNTS[level];
 const v=circular(words,seed,counts.vocabulary).map((x,i)=>({id:`${testNumber}-v-${x.id}`,kind:'vocabulary' as const,prompt:`「${x.word}」（${x.reading}）の意味はどれですか。`,options:options(words,x,seed+i,y=>y.meaningVi),correctId:x.id,explanation:`${x.word}（${x.reading}）: ${x.meaningVi}`,example:x.exampleJa?`${x.exampleJa} — ${x.exampleVi??''}`:undefined}));
 const g=circular(grammar,seed,counts.grammar).map((x,i)=>({id:`${testNumber}-g-${x.id}`,kind:'grammar' as const,prompt:`“${x.meaningVi}”に合う文法はどれですか。`,options:options(grammar,x,seed+i,y=>y.name),correctId:x.id,explanation:`${x.name}: ${x.meaningVi}${x.pattern?`\nCấu trúc: ${x.pattern}`:''}${x.formation?`\nCách tạo: ${x.formation}`:''}`,example:x.exampleJa?`${x.exampleJa} — ${x.exampleVi??''}`:undefined}));
 const r=circular(scenarios,seed,counts.reading).map((x,i)=>({id:`${testNumber}-r-${x.id}`,kind:'reading' as const,prompt:'この場面で、学習者は何をする必要がありますか。',passage:x.situation??x.name,options:options(scenarios,x,seed+i,y=>y.playerGoal??y.learningObjective??y.name),correctId:x.id,explanation:`Mục tiêu: ${x.playerGoal??x.learningObjective??x.name}`}));
 const l=circular(words,seed+41,counts.listening).map((x,i)=>({id:`${testNumber}-l-${x.id}`,kind:'listening' as const,prompt:'音声を聞いて、正しい意味を選んでください。',audioText:x.exampleJa??x.word,options:options(words,x,seed+i+41,y=>y.meaningVi),correctId:x.id,explanation:`Bạn đã nghe: ${x.exampleJa??x.word}\n${x.exampleVi??x.meaningVi}`,example:`Từ khóa: ${x.word}（${x.reading}）`}));
 return [...v,...g,...r,...l];
}
function clock(seconds:number){const m=Math.floor(seconds/60);const s=seconds%60;return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;}

export default function JlptMockTest({level}:{level:JlptLevel}){
 const [testNumber,setTestNumber]=useState<number|null>(null); const [index,setIndex]=useState(0); const [answers,setAnswers]=useState<Record<string,string>>({}); const [remaining,setRemaining]=useState(0); const [finished,setFinished]=useState(false);
 const questions=useMemo(()=>testNumber?build(level,testNumber):[],[level,testNumber]); const current=questions[index];
 useEffect(()=>{if(!testNumber||finished)return;const timer=setInterval(()=>setRemaining(value=>{if(value<=1){clearInterval(timer);setFinished(true);return 0;}return value-1;}),1000);return()=>clearInterval(timer);},[testNumber,finished]);
 const correct=questions.filter(q=>answers[q.id]===q.correctId).length; const wrong=questions.filter(q=>answers[q.id]&&answers[q.id]!==q.correctId); const unanswered=questions.filter(q=>!answers[q.id]).length;
 function start(number:number){setTestNumber(number);setIndex(0);setAnswers({});setRemaining(EXAM_MINUTES[level]*60);setFinished(false);}
 function choose(id:string){if(!current)return;setAnswers(value=>({...value,[current.id]:id}));}
 async function submit(){await saveSectionScore(level,'test',Math.round(correct/Math.max(questions.length,1)*100));setFinished(true);}
 if(!testNumber)return <View><View style={s.info}><Text style={s.infoTitle}>JLPT模擬試験 {level}</Text><Text style={s.infoText}>15 đề nguyên bản • cấu trúc Vocabulary, Grammar, Reading và Listening • thời gian {EXAM_MINUTES[level]} phút.</Text><Text style={s.note}>Số câu thực tế của JLPT có thể thay đổi theo kỳ; thời lượng và loại câu hỏi bám cấu trúc chính thức hiện hành.</Text></View><View style={s.grid}>{Array.from({length:15},(_,i)=><Pressable key={i} style={s.testButton} onPress={()=>start(i+1)}><Text style={s.testNumber}>Đề {String(i+1).padStart(2,'0')}</Text><Text style={s.testMeta}>{Object.values(COUNTS[level]).reduce((a,b)=>a+b,0)} câu</Text></Pressable>)}</View></View>;
 if(finished)return <View><View style={s.result}><Text style={s.resultTitle}>Kết quả đề {String(testNumber).padStart(2,'0')}</Text><Text style={s.score}>{correct}/{questions.length}</Text><Text>Sai {wrong.length} • Chưa trả lời {unanswered}</Text></View>{wrong.map((q,i)=><View key={q.id} style={s.review}><Text style={s.reviewTitle}>Câu sai {i+1} • {q.kind}</Text>{!!q.passage&&<Text style={s.passage}>{q.passage}</Text>}<Text style={s.prompt}>{q.prompt}</Text><Text style={s.explain}>{q.explanation}</Text>{!!q.example&&<Text style={s.example}>{q.example}</Text>}</View>)}<Pressable style={s.primary} onPress={()=>setTestNumber(null)}><Text style={s.primaryText}>Chọn đề khác</Text></Pressable></View>;
 return <View><View style={s.examHeader}><View><Text style={s.examName}>{level} • Đề {String(testNumber).padStart(2,'0')}</Text><Text>Câu {index+1}/{questions.length} • {current.kind}</Text></View><Text style={[s.timer,remaining<300&&s.timerDanger]}>{clock(remaining)}</Text></View><View style={s.progress}><View style={[s.progressFill,{width:`${(index+1)/questions.length*100}%`}]} /></View><View style={s.card}>{!!current.passage&&<Text style={s.passage}>{current.passage}</Text>}<Text style={s.prompt}>{current.prompt}</Text>{!!current.audioText&&<Pressable style={s.audio} onPress={()=>Speech.speak(current.audioText!,{language:'ja-JP',rate:0.76})}><Text style={s.primaryText}>🔊 Phát audio</Text></Pressable>}{current.options.map((o,i)=><Pressable key={`${o.id}-${i}`} style={[s.option,answers[current.id]===o.id&&s.selected]} onPress={()=>choose(o.id)}><Text style={s.optionLetter}>{i+1}</Text><Text style={s.optionText}>{o.label}</Text></Pressable>)}</View><View style={s.nav}>{<Pressable disabled={index===0} style={[s.secondary,index===0&&s.disabled]} onPress={()=>setIndex(v=>v-1)}><Text>← Trước</Text></Pressable>}{index<questions.length-1?<Pressable style={s.primarySmall} onPress={()=>setIndex(v=>v+1)}><Text style={s.primaryText}>Tiếp →</Text></Pressable>:<Pressable style={s.submit} onPress={()=>void submit()}><Text style={s.primaryText}>Nộp bài</Text></Pressable>}</View></View>;
}
const s=StyleSheet.create({info:{backgroundColor:'#fff',padding:18,borderRadius:16,marginBottom:14},infoTitle:{fontSize:22,fontWeight:'900'},infoText:{fontSize:15,lineHeight:22,marginTop:8},note:{fontSize: 16,color:'#667085',lineHeight:19,marginTop:8},grid:{flexDirection:'row',flexWrap:'wrap',gap:9},testButton:{width:'31%',backgroundColor:'#fff',padding:14,borderRadius:13,alignItems:'center'},testNumber:{fontWeight:'900',color:'#4263eb'},testMeta:{fontSize: 15,color:'#667085',marginTop:4},examHeader:{flexDirection:'row',justifyContent:'space-between',alignItems:'center',backgroundColor:'#fff',padding:14,borderRadius:14},examName:{fontWeight:'900',fontSize:17},timer:{fontSize:23,fontWeight:'900',color:'#2b8a3e'},timerDanger:{color:'#c92a2a'},progress:{height:7,backgroundColor:'#e9ecef',borderRadius:5,marginVertical:12,overflow:'hidden'},progressFill:{height:'100%',backgroundColor:'#4263eb'},card:{backgroundColor:'#fff',padding:17,borderRadius:17},passage:{backgroundColor:'#f8f9fa',padding:14,borderRadius:11,fontSize:16,lineHeight:25,marginBottom:13},prompt:{fontSize:19,fontWeight:'800',lineHeight:27},audio:{backgroundColor:'#7048e8',padding:13,borderRadius:11,alignItems:'center',marginTop:13},option:{flexDirection:'row',alignItems:'center',gap:10,backgroundColor:'#f1f3f5',padding:13,borderRadius:11,marginTop:9},selected:{backgroundColor:'#dbe4ff',borderWidth:2,borderColor:'#4263eb'},optionLetter:{width:26,height:26,borderRadius:13,backgroundColor:'#fff',textAlign:'center',lineHeight:26,fontWeight:'900'},optionText:{flex:1,fontSize:15},nav:{flexDirection:'row',justifyContent:'space-between',marginTop:13},secondary:{backgroundColor:'#e9ecef',paddingHorizontal:18,paddingVertical:13,borderRadius:11},disabled:{opacity:.35},primarySmall:{backgroundColor:'#4263eb',paddingHorizontal:22,paddingVertical:13,borderRadius:11},submit:{backgroundColor:'#2b8a3e',paddingHorizontal:22,paddingVertical:13,borderRadius:11},primary:{backgroundColor:'#4263eb',padding:15,borderRadius:12,alignItems:'center',marginTop:16},primaryText:{color:'#fff',fontWeight:'900'},result:{backgroundColor:'#fff',padding:24,borderRadius:17,alignItems:'center',marginBottom:13},resultTitle:{fontSize:21,fontWeight:'900'},score:{fontSize:38,fontWeight:'900',color:'#4263eb',marginVertical:8},review:{backgroundColor:'#fff',padding:16,borderRadius:14,marginBottom:10},reviewTitle:{fontWeight:'900',color:'#c92a2a'},explain:{marginTop:10,lineHeight:22},example:{backgroundColor:'#f6f8fc',padding:11,borderRadius:9,marginTop:8}});
