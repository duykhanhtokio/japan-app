        },
        {
          "playerTurn": 6,
          "precedingNpcTurn": 5,
          "intent": "report_echo_sensation_without_self_diagnosis",
          "goal": "時々音が響く感じがあり、耳鳴りか分からないので自分の表現で伝えたいと答える。"
        },
        {
          "playerTurn": 8,
          "precedingNpcTurn": 7,
          "intent": "separate_persistent_and_intermittent_sensations",
          "goal": "詰まりは昨日から続き音の響きは時々だと区別し、二つに分けて記入する。"
        },
        {
          "playerTurn": 10,
          "precedingNpcTurn": 9,
          "intent": "restate_term_and_reserve_cause_for_consultation",
          "goal": "随伴は一緒に出るほかの症状という意味だと確認し、音の原因は診察で尋ねたいと伝える。"
        }
