    "SC-LOC-JP-45206-01-001": {
      "title": "運転再開の見込みと乗れる列車を区別する",
      "causalProgression": "日向市に配置した架空の駅運行相談窓口。遅延中に「再開見込み」の表示を見た客が、自分の列車にもすぐ乗れると思っている。対象列車と乗車案内を区別し、仕事先から届くオンライン参加の提案を受けて、移動の必要を再確認する。実在の運行・設備・払戻条件は示さない。",
      "playerTurnNumbers": [
        2,
        4,
        6,
        8,
        10
      ],
      "closureTurn": 11,
      "taskAlignment": [
        {
          "playerTurn": 2,
          "precedingNpcTurn": 1,
          "intent": "ask_if_restart_estimate_allows_platform_boarding_wait",
          "goal": "仕事先への列車が停止中で、再開見込みの表示を見てホームで乗車待ちしてよいか尋ねる。"
        },
        {
          "playerTurn": 4,
          "precedingNpcTurn": 3,
          "intent": "show_ticket_and_admit_routewide_notice_misread",
          "goal": "切符を示し、路線全体の表示を自分の列車に乗れる意味と取り違えたと説明する。"
