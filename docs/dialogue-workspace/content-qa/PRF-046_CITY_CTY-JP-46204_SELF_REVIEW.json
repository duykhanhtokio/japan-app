        {
          "playerTurn": 4,
          "precedingNpcTurn": 3,
          "intent": "show_collection_station_note_and_unheard_stops",
          "goal": "受取先の駅のメモと切符を示し、放送の行先だけ聞いて途中の停車駅は未確認と伝える。"
        },
        {
          "playerTurn": 6,
          "precedingNpcTurn": 5,
          "intent": "call_recipient_to_check_collection_window_before_choice",
          "goal": "午後対応可能と聞いたが終了時刻は不明で、遅延可能性と受取可能時間を電話で確認すると述べる。"
        },
        {
          "playerTurn": 8,
          "precedingNpcTurn": 7,
          "intent": "report_flexible_collection_reply_and_avoid_rushed_boarding",
          "goal": "急がず見込みが立ったら連絡してよいとの返事を伝え、慌てて先発へ乗るのをやめる。"
