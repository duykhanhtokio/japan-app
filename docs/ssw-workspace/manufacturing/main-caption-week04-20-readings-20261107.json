          "width": 1536,
          "height": 1024,
          "sha256": "6cf5abc36e5a3cf0740369aa0182bdfc37f11212a6d733dcfd6ef285640bb263",
          "captionSourceHash": "c1fc6b65ceabfb7393734c915952f6c04f04f07b9c2df8d1cbbc998e88aec929"
