    "mfg1-electrical-weekly-13-q01": {
      "sourceHash": "0413ffbb4f4361f8e04d87cfd23dea0c9f0d84d5a2d646a3e844c4a811d25222",
      "translatedDirectlyFrom": "ja",
      "nativeReviewed": false,
      "domainReviewed": false,
      "status": "ai_translated_draft",
      "stem": "兩手操作固定一邊只按另一邊，危險說明正確是？",
