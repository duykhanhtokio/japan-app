    "mfg1-electrical-formative-001": {
      "sourceHash": "9a0c42c8521e35caeaafc8db30a3e3d5cb70e06d55888e9da4a78e0e67a842ab",
      "translatedDirectlyFrom": "ja",
      "nativeReviewed": false,
      "domainReviewed": false,
      "status": "ai_translated_draft",
      "stem": "絞線標示1.25 mm²，工具標示單線直徑1.25 mm。正確選擇方法是哪項？",
      "options": [
        "數字1.25相同，直接使用。",
        "區分截面積與直徑，按電線和工具適用表核對。",
        "將mm²改寫為mm使用。",
        "粗細不影響品質，不必管。"
      ],
      "reasons": [
        "混淆了不同物理量與單位。",
        "mm²是截面積，mm是長度，數字相同不表示工具設定相同。",
        "僅改單位不等於換算了規格。",
        "電線與工具適配關係到損傷及連接品質。"
      ]
    },
    "mfg1-electrical-formative-002": {
      "sourceHash": "6d7f70017d28d08333f99dbbb95db515cc8b7c2299605936db075aa70e43e2d8",
      "translatedDirectlyFrom": "ja",
      "nativeReviewed": false,
      "domainReviewed": false,
      "status": "ai_translated_draft",
      "stem": "剝線後發現部分細絲切斷，如何處理？",
      "options": [
        "絕緣層去掉就好，導體損傷無妨。",
        "掩蓋斷絲後裝端子。",
        "改用適用性不明的刀口繼續正式加工。",
        "按作業標準處理不符合項，檢查工具適配和加工條件。"
      ],
      "reasons": [
        "加工後還需檢查導體損傷和斷絲。",
        "留下損傷，妨礙檢查和適當處理。",
        "未核實適配的更改不能消除原因。",
        "斷絲屬於確認項目，不能只因剝皮成功就認定良品。"
      ]
    },
    "mfg1-electrical-formative-003": {
