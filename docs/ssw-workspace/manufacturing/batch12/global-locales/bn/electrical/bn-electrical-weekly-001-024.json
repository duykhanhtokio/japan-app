        "mm²-কে mm লিখে নেওয়া।",
        "মাপ গুণমানে প্রভাব নেই বলে বাদ।"
      ],
      "reasons": [
        "ভিন্ন রাশি-একক মেশানো।",
        "mm² ক্ষেত্রফল,mm দৈর্ঘ্য;সংখ্যা এক হলেও সেটিং এক নয়।",
        "শুধু লেখা বদল রূপান্তর নয়।",
        "টুল-তার সামঞ্জস্য ক্ষতি ও সংযোগের গুণমানে প্রভাব ফেলে।"
      ]
    },
    "mfg1-electrical-formative-002": {
