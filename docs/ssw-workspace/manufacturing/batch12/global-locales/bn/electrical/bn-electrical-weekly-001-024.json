        "বেশি মানেই ভালো।",
        "চকচকে হলে সেতু বাদ।",
        "অপ্রয়োজনীয় সেতু হিসেবে মানদণ্ডে অমিল ব্যবস্থা।",
        "উপাদাননাম মিললে সংযোগ প্রাসঙ্গিক নয়।"
      ],
      "reasons": [
        "অতিরিক্তে অবাঞ্ছিত পরিবাহিতা হয়।",
        "এক বৈশিষ্ট্যে সংযোগ বাদ নয়।",
        "পাশে সেতু পরীক্ষার বিষয়;নিজে পাশ নয়।",
        "সঠিক উপাদানেও ফলের পরীক্ষা দরকার।"
      ]
    },
    "mfg1-electrical-formative-005": {
