      "sourceHash": "763c13c82a84c8beb01da4c3e6a9d2272452b67ee6be24a38fe72e0b224e26c6",
      "translatedDirectlyFrom": "ja",
      "nativeReviewed": false,
      "domainReviewed": false,
      "status": "ai_translated_draft",
      "stem": "বাহ্যিক ও কার্যকারিতা পরীক্ষা পাশ,কিন্তু নির্দিষ্ট আর্দ্রতা পরীক্ষা হয়নি। রেকর্ড কীভাবে?",
      "options": [
        "বাহ্যিক পাশেই সব পরীক্ষা পাশ লিখবেন।",
        "সাধারণ টেস্টারেই ভোল্টেজ সহন ও আয়ু পরীক্ষার বদলি।",
        "যোগ্যতা ও অনুমোদন ছাড়া আর্দ্রতা পরীক্ষা যোগ করবেন।",
        "সম্পন্ন ফল ও অসম্পন্ন চাহিদা আলাদা করবেন।"
      ],
      "reasons": [
        "পরীক্ষার উদ্দেশ্য একে অন্যের বদলি নয়।",
        "প্রয়োজনীয় সরঞ্জাম ও শর্ত ভিন্ন।",
        "আগে অনুমোদন ও দায়িত্ব যাচাই।",
        "প্রতি চাহিদার প্রমাণ দরকার।"
      ]
    },
    "mfg1-electrical-weekly-12-q04": {
      "sourceHash": "d500f32b7157b3fb541b67fb55bc12bedff4d87a4ea3f830c4635c42a9707fad",
      "translatedDirectlyFrom": "ja",
      "nativeReviewed": false,
      "domainReviewed": false,
      "status": "ai_translated_draft",
      "stem": "মাসে100ঘণ্টায়2বিকল ও300ঘণ্টায়3বিকল। চলার সময় অনুযায়ী তুলনা কী?",
      "options": [
