      "translatedDirectlyFrom": "ja",
      "nativeReviewed": false,
      "domainReviewed": false,
      "status": "ai_translated_draft",
      "stem": "টার্মিনাল তাকে নিচসীমা8টি,বাস্তবে5টি ও এক ভিন্ন অংশনম্বরও মিশেছে। কী করবেন?",
      "options": [
        "সব অন্য খালি তাকে সরাবেন।",
        "তিন নির্ধারণ শুধু স্থান বলে সংখ্যা নয়।",
        "ভিন্নটি নির্দিষ্ট পণ্যের সংখ্যায় যোগ।",
        "ঘাটতি ও মিশ্রণ আলাদা শনাক্ত,মিলিয়ে রিপোর্ট।"
      ],
      "reasons": [
        "শুধু স্থান বদলে কারণ বা পরিচয় মেটে না।",
        "তিন নির্ধারণে পণ্য ও সংখ্যাও আছে।",
        "ভিন্নটি নির্দিষ্ট পণ্যের মজুত নয়।",
        "নির্দিষ্ট পণ্য ও পরিমাণ দুই বিচ্যুতি দেখা হয়।"
      ]
    },
    "mfg1-electrical-weekly-07-q04": {
