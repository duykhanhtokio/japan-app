      "translatedDirectlyFrom": "ja",
      "nativeReviewed": false,
      "domainReviewed": false,
      "status": "ai_translated_draft",
      "stem": "নতুন যন্ত্রেরOJTতে শুধু প্রদর্শন দেখেছেন। দায়িত্ব শুরুর আগে কী দেখবেন?",
      "options": [
        "প্রদর্শন দেখলেই সব আইনগত শর্ত পূরণ।",
        "সব কাজে একই গ্লাভস যথেষ্ট।",
        "না-জানা চালনা একা চেষ্টা।",
        "প্রয়োজনীয় শিক্ষা-যোগ্যতা,অনুমতির সীমা ও বোঝা পদ্ধতি যাচাই।"
      ],
      "reasons": [
        "OJTস্বয়ংক্রিয়ভাবে প্রয়োজনীয় যোগ্যতার বদলি নয়।",
        "ঘূর্ণন ইত্যাদি কাজে গ্লাভস বিপজ্জনক হতে পারে।",
        "অজানা শুরুর আগেই নিশ্চিত করবেন।",
        "OJTও প্রতিটি শর্ত-বোঝা যাচাই আলাদা।"
      ]
    },
    "mfg1-electrical-weekly-07-q05": {
