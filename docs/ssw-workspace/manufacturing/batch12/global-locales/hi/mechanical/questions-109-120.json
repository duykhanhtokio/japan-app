        "बड़ी रेटिंग खुद लें।"
      ],
      "reasons": [
        "अपुष्ट वापसी दोष में फिर बिजली देती है।",
        "कारण बिना वापसी जारी नहीं।",
        "सुरक्षा हटने से दोष कटना खोता है।",
        "रेटिंग/दशा बिना मेल खराब होता है।"
      ]
