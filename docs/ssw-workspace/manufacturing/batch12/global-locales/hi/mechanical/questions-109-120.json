    "mfg1-mechanical-weekly-10-q01": {
      "sourceHash": "3c60ebcff7749e3cc7fca2dc713a03a24d9d6d0da2b8dfeb30efca5160fe6fcc",
      "translatedDirectlyFrom": "ja",
      "nativeReviewed": false,
      "domainReviewed": false,
      "status": "ai_translated_draft",
      "stem": "झटका संदेह वाले के पास पहले क्या करें?",
      "options": [
        "हाथ खींचें।",
        "लकड़ी हमेशा सुरक्षित।",
        "छूकर जाँचें।",
        "सीधे न छुएँ; सुरक्षित जगह से सूचना और संभव रोकें।"
      ],
      "reasons": [
        "छूने से बचाने वाला भी झटका ले सकता है।",
        "पास लकड़ी जरूरी शर्त नहीं; अज्ञात चालू पास न जाएँ।",
        "शरीर से जाँचना खुद खतरा।",
        "दूसरी दुर्घटना रोकें; अज्ञात चालू न छुएँ।"
      ]
    },
    "mfg1-mechanical-weekly-10-q02": {
