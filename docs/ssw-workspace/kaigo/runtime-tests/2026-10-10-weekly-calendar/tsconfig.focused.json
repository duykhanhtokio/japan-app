{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "../../../../../src/*"
      ]
    },
    "types": [
      "react"
    ]
  },
  "include": [
    "../../../../../src/components/kaigo/WeeklyKaigo.tsx",
    "../../../../../src/components/kaigo/KaigoCourse.tsx",
    "../../../../../src/data/kaigo/weekly-learning.ts"
  ]
}
