      "existingPointIds": [
        "kaigo-atomic-body-mechanics-1",
        "kaigo-atomic-body-mechanics-2",
        "kaigo-atomic-body-mechanics-3",
        "kaigo-atomic-body-mechanics-4",
        "kaigo-atomic-body-mechanics-5",
        "kaigo-atomic-body-mechanics-9",
        "kaigo-atomic-body-mechanics-10",
        "kaigo-atomic-body-mechanics-11"
      ],
      "gapKind": "practice-depth-not-new-source-fact",
      "points": [
        {
          "id": "kaigo-completeness-worker-capacity-1",
          "explanationVi": "Tư thế chỉ là một phần của giảm tải. Trước một việc hỗ trợ di chuyển, cần biết khả năng người sử dụng, môi trường, dụng cụ và phân công; không suy rằng chân đứng rộng là đủ để thực hiện một mình."
        },
        {
          "id": "kaigo-completeness-worker-capacity-2",
          "explanationVi": "Nhận thấy bản thân đau, mệt hoặc thiếu khả năng thực hiện an toàn là thông tin phải báo để phối hợp. Cố tiếp tục bằng sức riêng có thể làm tăng nguy cơ cho cả nhân viên và người sử dụng."
        },
        {
          "id": "kaigo-completeness-worker-capacity-3",
          "explanationVi": "Máy nâng hoặc tấm trượt cần phù hợp với người và công việc, được kiểm và dùng bởi người đã huấn luyện. Có dụng cụ trong phòng chưa đủ nếu chưa xác nhận cách dùng và người phối hợp."
        }
      ],
      "newCaseReviewVi": "Tình huống mới xét dữ kiện, giới hạn kết luận và bước xác nhận; không dùng nhân vật, hình hoặc cốt truyện ví dụ nguồn."
    },
    {
      "unitId": "kaigo-completeness-drill-followup",
      "runtimeDay": 173,
      "printedPages": [
        40
      ],
      "pdfPages": [
        42
      ],
      "existingPointIds": [
        "kaigo-atomic-disaster-1",
        "kaigo-atomic-disaster-2",
