      "existingPointIds": [
        "kaigo-atomic-hand-coverage-1",
        "kaigo-atomic-hand-coverage-2",
        "kaigo-atomic-hand-coverage-3",
        "kaigo-atomic-hand-coverage-4",
        "kaigo-atomic-hand-coverage-8",
        "kaigo-atomic-hand-coverage-9"
      ],
      "gapKind": "practice-depth-not-new-source-fact",
      "points": [
        {
          "id": "kaigo-completeness-hand-choice-1",
          "explanationVi": "Trước vệ sinh tay, kiểm có bẩn nhìn thấy và công việc sắp làm. Rửa bằng nước với xà phòng và chà dung dịch phù hợp là hai cách khác nhau; không lựa chọn chỉ vì một cách nhanh hơn hoặc có chai gần hơn."
        },
        {
          "id": "kaigo-completeness-hand-choice-2",
          "explanationVi": "Một lần vệ sinh tay cần kiểm đủ bề mặt của cả hai tay và điểm kết thúc phù hợp: rửa thì xả và làm khô; chà dung dịch thì làm tới khô theo hướng dẫn sản phẩm. Không dùng số lần chà thay cho kiểm bao phủ."
        },
        {
          "id": "kaigo-completeness-hand-choice-3",
          "explanationVi": "Tay đã vệ sinh có thể lại bị nhiễm bẩn khi chạm một bề mặt bẩn. Cần nhận diện tiếp xúc mới và vệ sinh đúng thời điểm; đeo găng không thay việc vệ sinh tay theo chỉ định của cơ sở."
        }
      ],
      "newCaseReviewVi": "Tình huống mới xét dữ kiện, giới hạn kết luận và bước xác nhận; không dùng nhân vật, hình hoặc cốt truyện ví dụ nguồn."
    },
    {
