      ],
      "gapKind": "practice-depth-not-new-source-fact",
      "points": [
        {
          "id": "kaigo-completeness-emotion-confirm-1",
          "explanationVi": "Biểu cảm giúp nhận ra cần hỏi thêm, nhưng một người im lặng chưa tự là buồn, giận hoặc không muốn tham gia. Hỏi theo cách không dẫn dắt giúp người đó nêu cảm xúc và mong muốn riêng."
        },
        {
          "id": "kaigo-completeness-emotion-confirm-2",
          "explanationVi": "Cần phân biệt muốn tham gia với điều kiện khiến việc tham gia khó. Tiếng ồn, đói, mệt hoặc lo lắng có thể cùng tồn tại; ghi điều đã xác nhận, không chọn một nguyên nhân để giải thích mọi phản ứng."
        },
        {
          "id": "kaigo-completeness-emotion-confirm-3",
          "explanationVi": "Giữ động lực có thể bắt đầu bằng một lựa chọn nhỏ có ý nghĩa với người sử dụng. Không dùng số hoạt động được tổ chức hoặc lời khen của nhân viên thay cho mong muốn và sự hài lòng của người đó."
        }
      ],
      "newCaseReviewVi": "Tình huống mới xét dữ kiện, giới hạn kết luận và bước xác nhận; không dùng nhân vật, hình hoặc cốt truyện ví dụ nguồn."
    },
