    },
    {
      "printedPage": 231,
      "pdfPage": 233,
      "runtimeTaskId": "kaigo-reading-new-231",
      "runtimeDay": 149,
      "kind": "dialogue",
      "goalVi": "So sánh nào đã có căn cứ? Điều gì chưa kiểm? Có thể báo toàn bộ biển chỉ dẫn đã tốt hơn không?",
      "independentSceneReview": "Compares signage revisions and incomplete accessibility feedback, not an itchy/red back, pain inference or bathing decision requiring nurse assessment.",
      "humanReviewed": false
    },
    {
      "printedPage": 232,
      "pdfPage": 234,
      "runtimeTaskId": "kaigo-reading-new-232",
      "runtimeDay": 149,
      "kind": "dialogue",
      "goalVi": "Tách ngày niêm yết, ngày đổi địa điểm và thời điểm bác muốn thực hiện. Điều gì chưa xảy ra?",
      "independentSceneReview": "Notice effective date and requested washing time, no yesterday cough, nurse clearance or hair washing after a week.",
      "humanReviewed": false
    },
    {
      "printedPage": 233,
      "pdfPage": 235,
      "runtimeTaskId": "kaigo-reading-new-233",
      "runtimeDay": 150,
      "kind": "dialogue",
      "goalVi": "Bác mô tả mức độ nào? Hãy báo lại mà không phóng đại thành mất khả năng nhìn toàn bộ.",
      "independentSceneReview": "Visibility versus comprehension of locker labels; no bath-water comfort, slippery floor or exit instruction.",
      "humanReviewed": false
    },
    {
      "printedPage": 234,
      "pdfPage": 236,
      "runtimeTaskId": "kaigo-reading-new-234",
      "runtimeDay": 150,
      "kind": "dialogue",
      "goalVi": "Xác định điểm đi, điểm đến và ý nghĩa hai ký hiệu trong lời mô tả. Có thể suy luôn hướng về không?",
      "independentSceneReview": "Symbol-defined origin/destination and a separate return map; no eye anatomy, warm towel or wiping technique. No source illustration reconstructed.",
      "humanReviewed": false
    },
    {
