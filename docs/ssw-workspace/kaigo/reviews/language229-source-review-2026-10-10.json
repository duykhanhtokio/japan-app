    },
    {
      "printedPage": 236,
      "pdfPage": 238,
      "runtimeTaskId": "kaigo-reading-new-236",
      "runtimeDay": 150,
      "kind": "dialogue",
      "goalVi": "Tách mong muốn về rèm trong lúc nghe giải thích với việc xem thông báo sau đó. Có mâu thuẫn giữa hai mong muốn không?",
      "independentSceneReview": "Privacy during an explanation and later hallway notice viewing; no sweating, room coldness or air-conditioner adjustment.",
      "humanReviewed": false
    },
    {
      "printedPage": 237,
      "pdfPage": 239,
      "runtimeTaskId": "kaigo-reading-new-237",
      "runtimeDay": 151,
      "kind": "dialogue",
      "goalVi": "Ai đã xác nhận điều gì? Ai phải được hỏi về mong muốn? Vì sao lịch chưa đủ để kết luận đồng ý?",
      "independentSceneReview": "Inventory quantity versus personal choice, not nurse confirmation for yesterday cough followed by a current-health check.",
