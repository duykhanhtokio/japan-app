  "decisionsVi": [
    "Dịch trực tiếp từ bản Nhật tuần21; chỉ tra lại bản Việt đã kiểm của chính mình khi chuỗi Nhật trùng hoàn toàn. Giữ nguyên70chuỗi cũ, dịch67chuỗi mới.",
    "Rà đủ140bản ghi đoạn,7bộmetadata và16câu hỏi/64lựa chọn/64lời giải;12bài đọc không rỗng khớp đúng hội thoại trong section,4override rỗng giữ nguyên.",
    "Giữ rõ gật đầu không đồng nghĩa với đã hiểu và đồng ý; mong muốn cá nhân không bị thay bằng nhận định văn hóa.",
    "Tách nguồn thông tin, lời mô tả, quan sát, số đo, người đánh giá và điều chưa xác nhận; không tự chẩn đoán từ vị trí đau hoặc chữ nhìn không rõ.",
    "Trong12hội thoại, giữ đúng người mở túi/người đọc, người ghi/người kiểm tra/người sẽ ký, nơi tiếp nhận, thứ tự sau sửa, thời điểm hỏi và thực hiện. Không thêm tuổi hoặc giới tính cho người được chăm sóc vô danh.",
    "Giữ cả giấy và chữ lớn, thứTư với hỏi chỗ ngồi mỗi ngày, phạm vi giải thích nút hiện tại với phần để ngàymai, chức năng thông báo với nhân viên đã đến.",
    "Các bảng từ vựng vẫn là phần tra cứu khi cần, không coi số bản ghi là số khái niệm độc lập hoặc yêu cầu học thuộc trong một buổi."
  ],
  "focusedQualifierCheckVi": {
    "scope": "Toàn bộ nội dung tuần21, gồm hội thoại nhiều dòng và bài đọc hiệu lực của từng câu hỏi.",
    "recipientAndAgency": "Giữ người được chăm sóc, nhân viên, người đi trước, quầy tiếp nhận, người phụ trách; dự định báo cho đồng nghiệp khác với báo kết quả cho người được chăm sóc.",
    "consentAndPlans": "Giữ đồng ý với phạm vi tiếp xúc/giải thích cụ thể, điều kiện kế hoạch chăm sóc cá nhân và phương pháp được huấn luyện tại cơ sở; từ chối nơi nói không phải từ chối trao đổi.",
    "conditions": "Giữ trước–sau, chưa kiểm tra–đã kiểm tra, dự định–đã xong;誤嚥 đi vào đường thở phía dưới dây thanh âm, không đồng nhất với mọi khó nuốt.",
