      "pageMappingStatus": "printed_labels_checked_in_text_and_rendered_pages",
      "verificationStatus": "ai_source_comparison_only",
      "corroboratingSourceIds": [
        "nhlbi-measurement"
      ],
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-pressure-context",
      "paragraphIndex": 3,
      "knowledgePointJa": "興奮、緊張、寝不足、急な運動や温度変化は、血圧が変わるときの状況として確認します。排便時に強くいきむことや、尿意・便意を我慢することも関わります。職員の予定のために、本人へ排泄の我慢を求めません。",
      "evidenceType": "source_concept_independent_expression_with_editorial_limits",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
