        142,
        143,
        144
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-curb",
      "paragraphIndex": 3,
