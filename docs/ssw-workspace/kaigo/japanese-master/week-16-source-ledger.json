      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-food-devices",
      "paragraphIndex": 6,
      "knowledgePointJa": "コップを持てるのは手の動作の情報で、中の飲み物の性状が嚥下の計画に合うことを示す証拠ではありません。道具が合うか、食物が合うか、姿勢が合うかをそれぞれ確かめます。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
