      ],
      "pdfPages": [
        131,
        134,
        135,
        136,
        137
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-transfer",
      "paragraphIndex": 0,
      "knowledgePointJa": "ベッドから車いすへの移乗と、座った後に車いすを押す移動は別の行為です。体調、必要な人数、本人ができること、用具と方法を確認して説明し、同意を得ます。車いすの準備が済んだことを、移乗が終わったこととして記録しないようにします。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        129,
        136,
        137,
        138,
        139
      ],
      "pdfPages": [
        131,
        138,
        139,
        140,
        141
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-transfer",
      "paragraphIndex": 1,
      "knowledgePointJa": "資料の片麻痺の例では車いすを健側に置き、止まっている車いすのブレーキをかけます。健側の手で使う支えと、患側の膝折れを防ぐ支援をあらかじめ確認します。車いすや床の状態も確認し、配置だけで安全が整ったと判断しません。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        129,
        136,
        137,
        138,
        139
      ],
      "pdfPages": [
        131,
        138,
        139,
        140,
        141
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-transfer",
      "paragraphIndex": 2,
      "knowledgePointJa": "資料は、健側の手で遠い側のアームサポートを持ち、上体を前へ移しながら立ち上がり、車いすへ身体を向けて座る例を示しています。立つ・向きを変える・座る動作を一人ひとりの能力と方法に合わせて支える必要があり、荷重できない人を自己判断で立たせたり回したりする指示ではありません。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        129,
        136,
        137,
        138,
        139
      ],
      "pdfPages": [
        131,
        138,
        139,
        140,
        141
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-transfer",
      "paragraphIndex": 3,
      "knowledgePointJa": "座った後も、座る深さ、身体の支え、足の位置、手や衣類の状態を確認します。本人の気分と体調を聞き、移乗の直後の状態を確かめます。「座ったから完了」とせず、楽に保てるかやずれなどの観察を計画につなげます。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        129,
        136,
        137,
        138,
        139
      ],
      "pdfPages": [
        131,
        138,
        139,
        140,
        141
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-transfer",
      "paragraphIndex": 4,
      "knowledgePointJa": "車いすを押す場面では、足をフットサポートに置けるか、手や衣類が車輪へ巻き込まれないかを確認します。資料では健側の手はアームサポート、患側の手はその内側に収める例です。この例を本人の保持できる姿勢と用具の条件に合わせて確認します。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        129,
        136,
        137,
        138,
        139
      ],
      "pdfPages": [
        131,
        138,
        139,
        140,
        141
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-transfer",
      "paragraphIndex": 5,
      "knowledgePointJa": "発進するときは、動くことを本人に伝え、確認した手順でブレーキを解除してから移動します。止めるときのブレーキ、周囲、本人の状態も確認します。実際の移乗と移動は、個別の計画、車いすの説明と訓練に従い、まだ行っていない段階を済んだことにしません。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        129,
        136,
        137,
        138,
        139
      ],
      "pdfPages": [
        131,
        138,
        139,
        140,
        141
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-curb",
      "paragraphIndex": 0,
      "knowledgePointJa": "段差の前では一度止まり、本人へこれからのことを説明します。資料の上がる例では、ティッピングレバーに足を掛け、手押しハンドルを斜め下へ動かして、前方を持ち上げる動きを示しています。前輪を段へゆっくり置き、その後に後輪を上げる順序として読み取ります。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        136,
        137,
        140,
        141,
        142
      ],
      "pdfPages": [
        138,
        139,
        142,
        143,
        144
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-curb",
      "paragraphIndex": 1,
      "knowledgePointJa": "下りる例は後ろ向きです。後輪を先にゆっくり下ろし、後輪が段を離れた後に前輪を制御しながら下ろす図になっています。図では下りる側でもティッピングレバーとハンドルで車いすの傾きを制御しており、上がるときと同じ前輪・後輪の順ではありません。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        136,
        137,
        140,
        141,
        142
      ],
      "pdfPages": [
        138,
        139,
        142,
        143,
        144
      ],
      "pageMappingStatus": "printed_labels_text_and_selected_rendered_pages_checked",
      "corroboratingSourceIds": [],
      "verificationStatus": "ai_source_comparison_only",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-wheelchair-curb",
      "paragraphIndex": 2,
      "knowledgePointJa": "急な下り坂の例では、本人が座面から前へ滑ることを防ぐため、後ろ向きで進む方法が示されています。介護職員は後方の安全を確認し、足を前後に開いて支える位置を取ります。車いすの種類、坂の状態、支援する人の力や人数によって、実際に通れるかと方法を確認します。",
      "evidenceType": "source_concept_independent_expression_with_conditions",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March 2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
