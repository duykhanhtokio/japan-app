      ],
      "evidenceType": "source_concept_independent_explanation_with_scope_limits",
      "aiReviewStatus": "AI_editorial_alignment_not_human_approval",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false,
