    {
      "sectionId": "kaigo-atomic-skeleton-labels",
      "paragraphIndex": 1,
      "japaneseParagraphId": "kaigo-atomic-skeleton-labels:p2",
      "knowledgePointJa": "上腕には上腕骨、前腕には橈骨と尺骨があります。大腿には大腿骨があり、大腿骨頸部は股関節の近くの一部分です。前腕の二本の骨と、大腿の骨を区別して位置を確認します。",
      "evidenceType": "source_concept_independent_explanation",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
