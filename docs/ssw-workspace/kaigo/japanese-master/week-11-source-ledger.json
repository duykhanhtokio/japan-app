        59
      ],
      "mappingVerified": true,
      "aiEditorialChecked": true,
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-muscle-labels",
      "paragraphIndex": 1,
      "japaneseParagraphId": "kaigo-atomic-muscle-labels:p2",
      "knowledgePointJa": "股関節の運動に関わる腸腰筋や、臀部の大臀筋、太ももの前側の大腿四頭筋、後ろ側の大腿二頭筋などを位置と合わせて学びます。「二頭筋」だけでは上腕か大腿かがわからないため、必要な部位名を省きません。",
      "evidenceType": "source_concept_independent_explanation",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        57
