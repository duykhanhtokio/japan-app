    {
      "sectionId": "kaigo-atomic-senses",
      "paragraphIndex": 0,
      "japaneseParagraphId": "kaigo-atomic-senses:p1",
      "knowledgePointJa": "目で光、耳で音を受けるほか、においを感じる嗅覚、味を感じる味覚、触れたものを感じる触覚があります。感覚器で受けた刺激は神経を通って脳へ伝わり、情報として処理されます。",
      "evidenceType": "source_concept_independent_explanation",
      "source": {
