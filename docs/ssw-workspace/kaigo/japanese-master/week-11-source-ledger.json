      ],
      "mappingVerified": true,
      "aiEditorialChecked": true,
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-senses",
      "paragraphIndex": 2,
      "japaneseParagraphId": "kaigo-atomic-senses:p3",
      "knowledgePointJa": "水晶体は両面がふくらんだ形の構造です。断面図の曲線を、眼の中に別の球が入っているという意味で読まないようにします。網膜は眼の奥に広がる膜状の組織です。図の形と、実際の位置・役割を結び付けます。",
      "evidenceType": "source_concept_independent_explanation",
      "source": {
