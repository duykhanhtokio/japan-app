    },
    {
      "sectionId": "kaigo-atomic-skeleton-functions",
      "paragraphIndex": 3,
      "japaneseParagraphId": "kaigo-atomic-skeleton-functions:p4",
      "knowledgePointJa": "【学習用の比較】「骨は歩くためだけにある」という説明では、臓器の保護や造血、カルシウムの貯蔵が抜けます。歩行の援助が必要な人でも、これらの働きが不要になることはありません。",
      "evidenceType": "project_authored_comparison",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
