      ],
      "mappingVerified": true,
      "aiEditorialChecked": true,
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-skeleton-labels",
      "paragraphIndex": 2,
      "japaneseParagraphId": "kaigo-atomic-skeleton-labels:p3",
      "knowledgePointJa": "高齢者に多い骨折部位として、教材では上腕骨、橈骨、脊柱、大腿骨頸部を挙げています。部位の名称を学ぶことと、痛みから骨折を診断することは別です。記録や図で確認できた位置を、広い呼び方へ勝手に置き換えません。",
      "evidenceType": "source_concept_independent_explanation",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        56,
        79
      ],
      "pdfPages": [
        58,
        81
      ],
      "mappingVerified": true,
      "aiEditorialChecked": true,
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-skeleton-labels",
      "paragraphIndex": 3,
      "japaneseParagraphId": "kaigo-atomic-skeleton-labels:p4",
      "knowledgePointJa": "骨粗鬆症では骨の強さが低下し、骨折しやすくなります。長期間の活動不足や栄養、ホルモンの変化などが関係します。閉経後の女性はリスクが高くなることがありますが、男性にも起こります。年齢や性別だけで本人の病状を決めません。",
      "evidenceType": "source_concept_independent_explanation",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
        56,
        79
      ],
      "pdfPages": [
        58,
        81
      ],
      "mappingVerified": true,
      "aiEditorialChecked": true,
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-skeleton-labels",
      "paragraphIndex": 4,
      "japaneseParagraphId": "kaigo-atomic-skeleton-labels:p5",
      "knowledgePointJa": "背中の曲がり、身長の低下、腰背部の痛みは評価につながる情報ですが、それだけで骨粗鬆症と確定しません。カルシウムを含む食事、身体活動、日光に触れる機会などは、本人の必要性と安全条件を確認して支援します。転倒を防ぐ環境も大切です。",
      "evidenceType": "source_concept_independent_explanation",
      "source": {
        "document": "介護ー特定技能ーベトナム語.pdf",
        "edition": "second revision March2025",
        "sha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54"
      },
      "printedPages": [
