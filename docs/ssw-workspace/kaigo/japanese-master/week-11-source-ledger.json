      ],
      "mappingVerified": true,
      "aiEditorialChecked": true,
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false
    },
    {
      "sectionId": "kaigo-atomic-muscle-labels",
      "paragraphIndex": 3,
      "japaneseParagraphId": "kaigo-atomic-muscle-labels:p4",
      "knowledgePointJa": "【学習用の確認】上腕二頭筋と大腿二頭筋は別の筋肉です。同じ語の一部があっても、位置と図の向きを確かめて読みます。筋肉名を知ったことだけで、本人への負荷や訓練内容は決められません。",
      "evidenceType": "project_authored_comparison",
      "source": {
