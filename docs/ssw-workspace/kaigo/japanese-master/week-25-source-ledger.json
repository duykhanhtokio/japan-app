      "aiReviewStatus": "AI_editorial_concept_alignment_checked",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false,
      "releaseReady": false
    },
    {
      "sectionId": "kaigo-depth-team-handoff",
      "paragraphIndex": 4,
      "day": 169,
      "knowledgePointJa": "本人の希望を中心に置き、必要な相手へ必要な範囲で情報を共有します。この学習は役割と相談内容を整理するためのものです。介護職員が診断したり、リハビリの運動を独自に組み立てたり、報告だけを根拠に食形態や飲み物を変えたりする指示ではありません。",
      "sourceEdition": "second revision March2025",
      "sourceSha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54",
      "printedPages": [
        19,
