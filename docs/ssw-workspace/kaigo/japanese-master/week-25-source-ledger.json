        34,
        35
      ],
      "evidenceType": "independent_explanation_of_source_concept_and_scope_limit",
      "aiReviewStatus": "AI_editorial_concept_alignment_checked",
      "humanReviewed": false,
      "domainReviewed": false,
      "nativeReviewed": false,
      "releaseReady": false,
      "additionalSourceIds": [
        "cdc-hand-hygiene",
        "cdc-sanitizer"
      ]
    },
    {
      "sectionId": "kaigo-completeness-hand-choice",
      "paragraphIndex": 2,
      "day": 171,
      "knowledgePointJa": "石けんで洗った後は、流水ですすぎ、適切な方法で乾かすところまで確認します。擦式消毒を用いる場合は、製品で指定された量と方法で行き渡らせ、乾くまで擦り込みます。乾く前に紙などで製剤を拭き取って終了しません。",
      "sourceEdition": "second revision March2025",
      "sourceSha256": "997bf386ba8344e19c644c3cbd6ae2d40760bfb32ed882db999ad8e17068aa54",
      "printedPages": [
