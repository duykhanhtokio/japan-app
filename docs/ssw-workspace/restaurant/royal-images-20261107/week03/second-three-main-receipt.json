  "sourceSupport": [
    {
      "lessonId": "rst-1-hyg-12",
      "sourceHash": "22db90e5da563805fca26118dad59ad82129a8221672b92c893880589a41b18b",
      "objectiveJa": "片付けと計画清掃を実行し、廃棄物を食品から区別して管理できる。",
      "sourceRefs": [
        {
          "documentId": "rst-1-hygiene",
          "pdfPages": [
            17,
            18
          ],
          "section": "2(8) 清掃管理・廃棄物処理"
        }
      ],
      "paragraphsJa": [
        {
          "id": "knowledge",
          "textJa": "必要な物を選ぶ整理、置き場所を決める整頓、汚れを取る清掃、清潔な状態の維持、正しく続ける習慣を組み合わせます。毎日の清掃に加え、冷蔵庫内や排水設備など、頻度を決めて行う清掃も必要です。"
        },
        {
          "id": "procedure",
          "textJa": "担当範囲と実施時期を確認し、食品を守ってから清掃します。生ごみはふた付きの専用容器に入れ、作業の妨げにならない指定場所で管理します。可燃ごみ、びん、缶、廃油などは自治体と店の区分に従って分別します。"
        },
        {
          "id": "mistakes",
          "textJa": "見える床だけを掃いて終わりにせず、汚れがたまる場所も確認します。ごみ容器を開けたままにすると虫やねずみを招くおそれがあります。ふぐの処理に伴う廃棄物などは特別な管理が必要で、通常の生ごみへ混ぜません。"
        },
        {
          "id": "scenario",
          "textJa": "排水溝の清掃日ですが、営業が忙しく担当が未定です。「誰かがする」と考えず、責任者へ実施状況を確認します。食品を扱う時間帯との重なりを避け、完了後に確認できるようにします。"
        },
        {
          "id": "five-s-prevention-purposes",
          "textJa": "5Sで職場を整えるのは、見た目のためだけではない。汚れを残さないことで食中毒を防ぎ、不要品や散らかった道具を減らして異物混入を防ぐ。通路や床を整えることは労働災害の予防にもつながる。整理・整頓・清掃を続けて清潔を保ち、習慣にする。"
        },
        {
          "id": "cleaning-schedule-source-example",
          "textJa": "資料の清掃計画例では、日常作業に手洗い場、シンク、作業台、レンジ周辺、床の掃き掃除、排水溝を割り当てる。毎週の例は冷蔵・冷凍庫内、ダクト内、床のブラシ洗浄、グリストラップで、毎月の例は壁、照明、通常は届かない場所である。これは一律の安全基準ではなく計画例であり、汚れや設備に合わせて自店で具体化する。危険な高所や専門設備は安全に作業できる担当へ依頼する。"
        }
      ]
    },
    {
      "lessonId": "rst-1-hyg-15",
      "sourceHash": "0adcd61fb4db833797394e70e1008489807825ed0f440ef183b71369d878031f",
      "objectiveJa": "加熱後に放置する危険を理解し、冷却・保存・再加熱の記録をつなげられる。",
      "sourceRefs": [
        {
          "documentId": "rst-1-hygiene",
          "pdfPages": [
            25,
            34,
            37,
            38
          ],
          "section": "3(5) 加熱と冷却をくりかえすもの、参考資料"
        }
      ],
      "paragraphsJa": [
        {
          "id": "knowledge",
          "textJa": "加熱後に保存するカレーやスープなどは、冷ます工程も重要です。資料では10〜60℃を危険温度帯として説明しています。この範囲に長く置かないため、加熱、冷却、冷蔵、再加熱の流れを決めて管理します。"
        },
        {
          "id": "procedure",
          "textJa": "冷却に使う清潔な容器や機器を先に準備します。加熱後は量や深さを調整するなど店の方法で速やかに冷やし、時刻と温度を確認します。保存中も指定条件を守り、再加熱時は食品の中心まで必要な加熱ができたか確かめます。"
        },
        {
          "id": "mistakes",
          "textJa": "大鍋を室温で一晩置くことは適切な冷却ではありません。冷蔵庫へ入れただけで中心まで冷えたとも限りません。資料の冷却時間には対象や出典の異なる例があるため、数字を混ぜず、店が採用した検証済みの計画を使います。"
        },
        {
          "id": "scenario",
          "textJa": "翌日用のスープが予定の冷却時間を過ぎても温かいままです。容器の大きさや機器の使い方を確認し、実際の時刻と温度を責任者へ伝えます。記録だけを予定の値に直してはいけません。"
        }
      ]
    },
    {
      "lessonId": "rst-2-hyg-13",
      "sourceHash": "d5bdfa53f2cc13f3380d5d0df42d6337ea3a3c5c461a9e43b15e89b336122c88",
      "objectiveJa": "作業区域と順序を設計し、加熱しない食品への汚染を防げる。",
      "sourceRefs": [
        {
          "documentId": "rst-2-hygiene",
          "pdfPages": [
            15,
            16,
            17,
            18,
            19,
            35,
            36,
            37
          ],
          "section": "5章(1)(2)(4)"
        }
      ],
      "paragraphsJa": [
        {
          "id": "knowledge",
          "textJa": "生肉や魚、泥付き野菜の下処理は汚染を広げる可能性がある。サラダや刺身のように後から加熱しない食品は、付着した微生物を加熱で減らせない。責任者は用途別の器具、蓋付き容器、作業区域と順序を決め、調理済み食品と未処理原料を分ける。"
        },
        {
          "id": "procedure",
          "textJa": "生食用など清潔に扱う作業を先に行い、切り替え時は設備と器具を洗浄・消毒する。解凍は食材に適した低温条件で計画し、ドリップを受けて他の食材へ落とさない。冷蔵、流水、電子レンジでは時間、温度むら、品質への影響が異なるため、製品指示と後の工程に合わせて選ぶ。"
        },
        {
          "id": "mistakes",
          "textJa": "室温へ長く放置して解凍すると、中心が凍ったままでも表面で細菌が増え得る。生肉処理の横でサラダを盛ったり、同じ布巾で汚染側と清潔側を拭いたりしない。洗浄した野菜もその後に汚染されるため、覆いと冷蔵管理を続ける。"
        },
        {
          "id": "scenario",
          "textJa": "修理で作業台が減った。主任はサラダの準備を先に終えて蓋をし冷蔵し、その後に生肉を処理する計画へ変更する。器具と布巾の区分、作業切替時の清掃担当を決める。予定量を安全に作れない場合は、提供数を調整して無理な同時作業を避ける。"
        },
        {
          "id": "detail-raw-flow",
          "textJa": "肉、魚、野菜、加熱済み食品で包丁・まな板・布を分け、交換分も用意する。流し用の用具を食品用へ回さない。非加熱の野菜は流水で洗い、必要な処理は製品条件に従い、すすいだ後の再汚染も防ぐ。和える作業は清潔な手袋で行う。冷蔵解凍は時間を見込み、流水は水の管理、電子レンジはむらと品質を確認し、次の工程へつなぐ。"
        },
        {
          "id": "detail-thaw-comparison",
          "textJa": "冷蔵庫解凍は時間がかかるが、低温を保ち品質と細菌増殖の抑制に向く。低温ではドリップも抑えやすい。流水解凍は比較的速い一方、温度上昇、鮮度低下とドリップを確認する。電子レンジは速いがむらが出やすい。室温へ置く自然解凍は、表面での増殖と内外の温度差による品質低下を招くため、この工程の方法として選ばない。必要に応じ食品に使える消毒剤で野菜を処理し、流水ですすぐ。和える時は使い捨て手袋を用いる。"
        }
      ]
    }
  ],
