    {
      "locale": "en",
      "id": "food-2-q388",
      "field": "prompt",
      "ja": "架空のラインは計画300分、標準10kg/分です。実績良品は2400kgで不良はありません。標準の計画出来高に対する実績の割合はどれですか。丸めは不要です。",
      "target": "A hypothetical line has 300 planned minutes and a standard speed of 10 kg/min. Actual good output is 2,400 kg with no defects. What percentage of standard planned output was achieved? No rounding is needed."
    },
    {
      "locale": "en",
      "id": "food-2-q388",
      "field": "explanation",
      "ja": "計画出来高は300×10=3000kg、2400÷3000×100=80％です。",
      "target": "Planned output is 300 × 10 = 3,000 kg; 2,400 ÷ 3,000 × 100 = 80%."
    },
    {
      "locale": "en",
      "id": "food-2-q388",
      "field": "reason0",
      "ja": "3000÷2400は計画と実績の順序が逆です。",
      "target": "3,000 ÷ 2,400 reverses planned and actual output."
    },
    {
      "locale": "en",
      "id": "food-2-q388",
      "field": "reason1",
      "ja": "2400kgを速度だけで割っても計画達成の割合ではありません。",
      "target": "Dividing 2,400 kg by speed alone does not give the percentage of planned output achieved."
    },
    {
      "locale": "en",
      "id": "food-2-q388",
      "field": "reason2",
      "ja": "計画出来高は300×10=3000kg、2400÷3000×100=80％です。",
      "target": "Planned output is 300 × 10 = 3,000 kg; 2,400 ÷ 3,000 × 100 = 80%."
