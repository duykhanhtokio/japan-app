  "clusters": [
    {
      "id": "kensetsu-common-session-194-cluster-1",
      "titleJa": "接続を収める場所",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-194-cluster-1-p1",
          "ja": "クロージャは通信ケーブルの接続部分などを収容・保護するための部材です。光クロージャには架空用だけでなく地中用もあります。名称を聞いただけで設置場所を電柱上に限定しません。"
        },
        {
          "id": "kensetsu-common-session-194-cluster-1-p2",
          "ja": "架空の経路一覧に地中区間の接続点がある場合も、クロージャの用途と型式を確認します。接続するファイバ、内部の収容、入口の適合などは、箱の外形だけでは分かりません。"
        }
      ],
      "applicationPromptJa": "「クロージャは必ず電柱上」という説明では、どの種類が見落とされますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-194-cluster-2",
      "titleJa": "箱と内部の接続は別",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-194-cluster-2-p1",
          "ja": "クロージャの外側が所定位置にあることと、内部の心線の対応や接続が確認済みであることは別です。外部の設置記録と、内部の接続に関する記録を分けて考えます。"
        },
        {
          "id": "kensetsu-common-session-194-cluster-2-p2",
          "ja": "説明用の記録例では「接続点の番号は確認済み。心線の対応表は未受領」と示します。内部を開けたり接続状態を変えたりする方法を、位置の確認から導き出しません。"
        }
      ],
      "applicationPromptJa": "設置記録だけある接続点について、何の記録を未確認として残しますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-194-cluster-3",
      "titleJa": "張る機能とつかむ機能",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-194-cluster-3-p1",
          "ja": "張線器は線を張るための力を与える用具、掴線器は対象の線を把持する用具として機能を分けます。この組合せは、線をつかむことと張力を加えることの違いを理解するための基本例です。"
        },
        {
          "id": "kensetsu-common-session-194-cluster-3-p2",
          "ja": "両方の機能を備えた特定製品もあるため、必ず別々の二台を使うと一般化しません。製品名と機能を対応させる学習であり、活線や高所で使う方法、力の設定、操作順は扱いません。"
        }
      ],
      "applicationPromptJa": "把持と張線の二つの機能が一体の製品でも、役割を分けて理解する意義は何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-194-cluster-4",
      "titleJa": "接続の保護と機械的支持",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-194-cluster-4-p1",
          "ja": "クロージャは接続部分の収容・保護、支持線はケーブルの支持という関係で整理します。接続部分が保護されていることだけを、支持の構成や張力条件の確認完了にはしません。"
        },
        {
          "id": "kensetsu-common-session-194-cluster-4-p2",
          "ja": "独立した資料照合の例は「地中区間の接続用箱は特定できました。架空区間の支持の資料は別件として確認中」です。違う区間と部材の確認を一つの「全部確認済み」にまとめません。"
        }
      ],
      "applicationPromptJa": "地中の接続用箱と架空の支持を別件として伝える報告を作ってください。",
      "graded": false
    }
  ],
