  "clusters": [
    {
      "id": "kensetsu-common-session-196-cluster-1",
      "titleJa": "つなぐ方法の区別",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-196-cluster-1-p1",
          "ja": "融着接続は、光ファイバの接続部を加熱して一体につなぐ方法です。融着接続機はこのための機器です。ケーブルの外被全体を溶かしてつなぐという説明とは区別します。"
        },
        {
          "id": "kensetsu-common-session-196-cluster-1-p2",
          "ja": "光の接続にはメカニカルスプライスやコネクタを用いる方法もあります。方法の名称を知ることと、対象ファイバに適した方法や機器が確定することは別で、加工条件をここで選びません。"
        }
      ],
      "applicationPromptJa": "「ケーブル全体を溶かす」という説明を、何をつなぐ方法かが分かる文へ直してください。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-196-cluster-2",
      "titleJa": "接続部の保護",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-196-cluster-2-p1",
          "ja": "保護スリーブは、融着した部分の保護・補強に用いる部材です。ファイバの心数や構成などに応じた種類があります。保護部材の名称が同じでも、どれでも同じ条件で使えるとは限りません。"
        },
        {
          "id": "kensetsu-common-session-196-cluster-2-p2",
          "ja": "資料上でスリーブが記載されていても、適合や接続の品質を確認したことにはなりません。加熱条件、挿入の順序や長さは対象品の指示に関わるため、本講では共通の施工手順にしません。"
        }
      ],
      "applicationPromptJa": "スリーブの手配が済んだことと、接続品質が確認できたことを分ける理由は何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-196-cluster-3",
      "titleJa": "保持と被覆除去",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-196-cluster-3-p1",
          "ja": "ファイバホルダは、ファイバを対応する機器や工具で保持・位置決めするための用具です。ジャケットリムーバなどの被覆除去用具は、対象の被覆を取り除くためのもので、保持用具とは役割が違います。"
        },
        {
          "id": "kensetsu-common-session-196-cluster-3-p2",
          "ja": "例えば工具の組合せ一覧なら、保持側、被覆除去側、接続機側をそれぞれ照合します。同じホルダを使えるか、対象被覆に対応するかは型式ごとの情報で、見た目の一致では判断しません。"
        }
      ],
      "applicationPromptJa": "保持する用具と被覆を除去する用具では、対象へ何をする機能が違いますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-196-cluster-4",
      "titleJa": "接続の有無と確認結果",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-196-cluster-4-p1",
          "ja": "機器にセットしたこと、接続したこと、保護したこと、接続損失などの確認結果があることは別の記録です。接続が見えるだけで、伝送の状態が良好と結論づけないようにします。"
        },
        {
          "id": "kensetsu-common-session-196-cluster-4-p2",
          "ja": "架空の整理例では「接続方法の記載は融着。保護部材の型式は照合中。伝送の確認記録は未受領」と書きます。方法、部材、品質の記録を分ければ、未了の範囲が具体的になります。"
        }
      ],
      "applicationPromptJa": "接続方法・保護部材・品質の記録が別々に進んでいる状態を、短く引き継いでください。",
      "graded": false
    }
  ],
