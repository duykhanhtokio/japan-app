  "clusters": [
    {
      "id": "kensetsu-common-session-363-cluster-1",
      "titleJa": "回転と送水の違い",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-363-cluster-1-p1",
          "ja": "性能試験は必要な送水の性能へ関わる確認です。電動機が回ることだけで定格の送水性能は分かりません。作動の確認と性能の結果を分けます。"
        },
        {
          "id": "kensetsu-common-session-363-cluster-1-p2",
          "ja": "始動した動画だけが届いた引継ぎでは、担当者は送水の測定結果を尋ねます。動いたことを設備全体の合格と扱わない場面です。"
        }
      ],
      "applicationPromptJa": "始動動画だけでは、どの性能の確認が不足しますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-363-cluster-2",
      "titleJa": "流量を読む",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-363-cluster-2-p1",
          "ja": "流量計は流れる水の量に関わる計器です。単位と測定対象を対応させます。数値が表示されることだけで必要な流量に達したとは決まりません。"
        },
        {
          "id": "kensetsu-common-session-363-cluster-2-p2",
          "ja": "試験票に数だけあり単位がない場合、担当者は元の測定資料を確かめます。数字の大きさだけを定格への一致として判断しない例です。"
        }
      ],
      "applicationPromptJa": "単位がない流量の記録をどう扱いますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-363-cluster-3",
      "titleJa": "揚程と流量の関係",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-363-cluster-3-p1",
          "ja": "揚程と流量はポンプの性能を読む異なる情報です。測定条件と指定された評価を対応させます。一つの圧力値を全性能の結果として扱いません。"
        },
        {
          "id": "kensetsu-common-session-363-cluster-3-p2",
          "ja": "圧力の記録しか届かない場合、受取側は流量などの確認範囲を分けます。圧力が出たことを要求される送水量の確認済みにしない例です。"
        }
      ],
      "applicationPromptJa": "圧力の記録だけある場合、何を別に確認しますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-363-cluster-4",
      "titleJa": "表示の対象",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-363-cluster-4-p1",
          "ja": "ユニットでは流量や電流などの表示がある製品があります。表示の項目と対象を識別します。全製品の同じ位置に同じ方式の計器があるとは限りません。"
        },
        {
          "id": "kensetsu-common-session-363-cluster-4-p2",
          "ja": "別品番の制御盤へ替わった場合、担当者は表示項目を資料で照合します。前の画面の位置だけを頼りに電流を流量として転記しない例です。"
        }
      ],
      "applicationPromptJa": "制御盤が変わったとき、表示の何を照合しますか。",
      "graded": false
    }
  ],
