  "clusters": [
    {
      "id": "kensetsu-common-session-011-cluster-1",
      "titleJa": "法定と所定",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-011-cluster-1-p1",
          "ja": "労働時間の基本的な法定基準は、一日8時間、一週40時間です。契約や就業規則で定めた所定労働時間は、これとは別の言葉です。所定時間を超えた時間と、法定時間を超えた時間が、必ず同じ長さになるわけではありません。"
        },
        {
          "id": "kensetsu-common-session-011-cluster-1-p2",
          "ja": "例えば所定7時間の勤務に1時間が追加された場面では、所定時間との差と法定基準との差を別々に考えます。週の合計や適用される制度も必要なので、この一日だけで割増賃金を決めません。"
        }
      ],
      "learningActivity": {
        "ja": "用語と適用条件を確認し、区別する情報を自分の言葉で説明する。",
        "graded": false
      }
    },
    {
      "id": "kensetsu-common-session-011-cluster-2",
      "titleJa": "休憩の境界",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-011-cluster-2-p1",
          "ja": "労働時間が6時間を超えるときは少なくとも45分、8時間を超えるときは少なくとも1時間の休憩を、勤務の途中に設ける基準があります。「超える」という条件を読み落とさないことが大切です。"
        },
        {
          "id": "kensetsu-common-session-011-cluster-2-p2",
          "ja": "休憩は、仕事から離れて自由に利用できる時間として考えます。指示があればすぐ仕事に戻らなければならない待機を、名前だけで休憩と決めません。一斉付与の原則と、労使協定等による例外の扱いも分けます。"
        }
      ],
      "learningActivity": {
        "ja": "用語と適用条件を確認し、区別する情報を自分の言葉で説明する。",
        "graded": false
      }
    },
    {
      "id": "kensetsu-common-session-011-cluster-3",
      "titleJa": "法定休日と曜日",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-011-cluster-3-p1",
          "ja": "休日の基本は毎週少なくとも一日です。四週間を通じて四日以上とする制度もあります。土曜日や日曜日という曜日だけで、その日が法律上の休日労働に当たるかを判断しません。"
        },
        {
          "id": "kensetsu-common-session-011-cluster-3-p2",
          "ja": "会社の休日の指定と勤務予定を確認します。「日曜に働いた」という事実に加え、どの日が法定休日か、時間の合計はどうかという情報が必要です。休日と休暇という言葉も区別して読みます。"
        }
      ],
      "learningActivity": {
        "ja": "用語と適用条件を確認し、区別する情報を自分の言葉で説明する。",
        "graded": false
      }
    },
    {
      "id": "kensetsu-common-session-011-cluster-4",
      "titleJa": "実際の時間を残す",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-011-cluster-4-p1",
          "ja": "労働時間は、使用者の指揮命令下にあるかで考えます。指示された研修や準備、後片付けなどは、実態に応じて労働時間に当たります。移動や待機も、すべて同じ扱いとせず、指示や自由利用の実態を確認します。"
        },
        {
          "id": "kensetsu-common-session-011-cluster-4-p2",
          "ja": "始業・終業と休憩を別々に記録し、作業名だけで時間を除外しないようにします。この教材の読み取り例は、個別の移動時間を一律に労働時間と判定するものではありません。"
        }
      ],
      "learningActivity": {
        "ja": "用語と適用条件を確認し、区別する情報を自分の言葉で説明する。",
        "graded": false
      }
    }
  ],
