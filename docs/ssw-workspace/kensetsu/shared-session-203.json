  "clusters": [
    {
      "id": "kensetsu-common-session-203-cluster-1",
      "titleJa": "ねじ部のシール",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-203-cluster-1-p1",
          "ja": "シール材は、対応するねじ接合部などで流体が漏れる経路を封じるために用いる材料です。液状のシール材やシールテープなどがあります。形態と対象の接合部を対応させて読みます。"
        },
        {
          "id": "kensetsu-common-session-203-cluster-1-p2",
          "ja": "材料名がシール材でも、流体や温度、管材などの適用条件は製品ごとに違います。水用の資料をガス用へそのまま転用せず、対象系統に適合するかを独立した確認事項として残します。"
        }
      ],
      "applicationPromptJa": "水用として確認したシール材を、ガスの系統へそのまま転用できない理由を説明してください。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-203-cluster-2",
      "titleJa": "樹脂管の接合材料",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-203-cluster-2-p1",
          "ja": "塩化ビニル管の接合に使う接着剤は、対応する管と継手を接合するための材料です。管の種類や接合条件に対応する品種があります。ねじ部を封じる材料と同じ役割とは限りません。"
        },
        {
          "id": "kensetsu-common-session-203-cluster-2-p2",
          "ja": "例えば材料表に管、継手、接着剤の品種を別々に記すと、接合する組合せを読み取れます。色が同じことや容器が届いたことを適合の証拠にはせず、塗布や乾燥の条件は対象品の資料へ分けて残します。"
        }
      ],
      "applicationPromptJa": "管・継手・接着剤を別々に記載すると、どの組合せを確認しやすくなりますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-203-cluster-3",
      "titleJa": "圧力を加える側と測る側",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-203-cluster-3-p1",
          "ja": "水圧試験器やテストポンプは、配管の試験に用いる装置です。ポンプは水の供給や加圧に関わり、圧力計は圧力の状態を示します。同じ装置に組み合わされていても機能は別です。"
        },
        {
          "id": "kensetsu-common-session-203-cluster-3-p2",
          "ja": "製品に記載された最高圧力は、その装置の能力に関する情報です。どの管もその数値で試験するという意味ではありません。試験対象の系統、指定条件、測定記録と装置の情報を分けて整理します。"
        }
      ],
      "applicationPromptJa": "装置の最高圧力と、対象配管に指定された試験圧力を同一視できないのはなぜですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-203-cluster-4",
      "titleJa": "接合したことと試験の結果",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-203-cluster-4-p1",
          "ja": "接合材料が用意されたこと、接合が行われたこと、試験を実施したこと、結果が判定されたことは異なる段階です。試験の記録には対象と実施条件、結果との対応が必要です。"
        },
        {
          "id": "kensetsu-common-session-203-cluster-4-p2",
          "ja": "架空の引継ぎ文は「接合した区間の一覧はありますが、水圧試験の条件と結果はまだ受領していません」です。本講では試験圧力や保持時間、加圧・減圧の操作、漏れへの対処を指示しません。"
        }
      ],
      "applicationPromptJa": "接合した区間の一覧だけある状態を、試験済みと誤解させない報告にしてください。",
      "graded": false
    }
  ],
