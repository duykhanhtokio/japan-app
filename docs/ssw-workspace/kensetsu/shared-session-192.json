  "clusters": [
    {
      "id": "kensetsu-common-session-192-cluster-1",
      "titleJa": "金属の導体で伝える",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-192-cluster-1-p1",
          "ja": "メタルケーブルでは金属の導体を使って電気信号を伝えます。同軸やツイストペアは構造の異なる例です。「メタル」という広い呼び方だけでは、端末や用途を特定できません。"
        },
        {
          "id": "kensetsu-common-session-192-cluster-1-p2",
          "ja": "銅を使う例があっても、全製品の材料や寸法を同じと考えません。架空の材料一覧で「メタル」しか記載されていなければ、同軸なのかツイストペアなのか、品種の記載を追加する必要があります。"
        }
      ],
      "applicationPromptJa": "一覧の「メタル」だけでは不足する情報を二つ挙げてください。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-192-cluster-2",
      "titleJa": "同軸の層を読む",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-192-cluster-2-p1",
          "ja": "同軸ケーブルは中心導体の外側に絶縁体を置き、その周りに外部導体を設ける構造で理解します。外部導体と最外側のシースは同じものではありません。テレビアンテナの配線は用途の一例です。"
        },
        {
          "id": "kensetsu-common-session-192-cluster-2-p2",
          "ja": "断面資料では中心導体、絶縁体、外部導体、外側の保護を区別します。テレビ用という用途だけで、同軸の全製品の寸法、特性、接続部品が同じだとは決めません。"
        }
      ],
      "applicationPromptJa": "同軸の外部導体と外側の保護層を混同すると、どの説明が曖昧になりますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-192-cluster-3",
      "titleJa": "ツイストペアとシールド",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-192-cluster-3-p1",
          "ja": "ツイストペアは二本の導線を一組としてより合わせた構成です。UTPはシールドを持たない種類を指します。ペアの構成とシールドの有無は、別々に読み取る情報です。"
        },
        {
          "id": "kensetsu-common-session-192-cluster-3-p2",
          "ja": "「UTPだから同軸より必ず安く柔らかい」と一律には比べません。価格や柔軟性は具体的な品種と条件に依存します。通信方式、シールド、形状を分けると比較の条件をそろえられます。"
        }
      ],
      "applicationPromptJa": "ペアの構成とシールドの有無は、それぞれ何の違いを示しますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-192-cluster-4",
      "titleJa": "カテゴリと実際の通信",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-192-cluster-4-p1",
          "ja": "カテゴリはLANケーブルの性能を区分するための表示です。数字を読むだけで、機器を含む通信系全体の実際の速度や、すべての使用条件が確認できたことにはなりません。"
        },
        {
          "id": "kensetsu-common-session-192-cluster-4-p2",
          "ja": "独立した確認例として「指定カテゴリの品番は一致しています。接続先機器と経路条件の照合は残っています」と報告します。カテゴリを、ケーブルの色や接続完了の表示に置き換えません。"
        }
      ],
      "applicationPromptJa": "品番の一致と通信系全体の確認を分けて報告する文を作ってください。",
      "graded": false
    }
  ],
