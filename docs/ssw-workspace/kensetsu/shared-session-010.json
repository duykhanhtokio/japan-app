  "clusters": [
    {
      "id": "kensetsu-common-session-010-cluster-1",
      "titleJa": "支払いの原則",
      "minutes": 7,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-010-cluster-1-p1",
          "ja": "賃金の支払いには、通貨、直接、全額、毎月一回以上、一定期日という原則があります。基本の仕組みを理解した上で、認められる例外を別に確認します。原則だけを読んで、銀行振込がすべて禁止されると考えないようにします。"
        },
        {
          "id": "kensetsu-common-session-010-cluster-1-p2",
          "ja": "銀行振込などは、労働者の同意などの要件を満たす取扱いがあります。ここでは個別の口座や支払方法を設定するのではなく、給与の支払いがどのように説明されているかを契約と照合します。"
        }
      ],
      "learningActivity": {
        "ja": "用語と適用条件を確認し、区別する情報を自分の言葉で説明する。",
        "graded": false
      }
    },
    {
      "id": "kensetsu-common-session-010-cluster-2",
      "titleJa": "控除と全額払い",
      "minutes": 8,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-010-cluster-2-p1",
          "ja": "全額払いの原則があっても、税や社会保険など法令に基づく控除があります。労使協定による控除なども、根拠を確認する必要があります。給与明細の控除欄を見て、すべてが違法とも、すべてが自由とも判断しません。"
        },
        {
          "id": "kensetsu-common-session-010-cluster-2-p2",
          "ja": "明細で確認する情報を、総支給、控除項目、差引支給に分けます。分からない控除は、名称だけで判断せず、何の費用で、どの根拠により控除するのかを尋ねる材料にします。"
        }
      ],
      "learningActivity": {
        "ja": "用語と適用条件を確認し、区別する情報を自分の言葉で説明する。",
        "graded": false
      }
    },
    {
      "id": "kensetsu-common-session-010-cluster-3",
      "titleJa": "締め日と支払日",
      "minutes": 7,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-010-cluster-3-p1",
          "ja": "締め日は、給与計算の対象期間を区切る日です。支払日は、給与を受け取る日です。同じ日とは限りません。働いた日の記録を、どの計算期間に入るかという視点で見直します。"
        },
        {
          "id": "kensetsu-common-session-010-cluster-3-p2",
          "ja": "教材用の例として、月末締め、翌月の決まった日払いの説明を考えます。月末の勤務がどの給与に含まれるかを、契約の記載と照合します。この例は実際の会社の締め日や支払日を指定するものではありません。"
        }
      ],
      "learningActivity": {
        "ja": "用語と適用条件を確認し、区別する情報を自分の言葉で説明する。",
        "graded": false
      }
    },
    {
      "id": "kensetsu-common-session-010-cluster-4",
      "titleJa": "数字を照合する習慣",
      "minutes": 8,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-010-cluster-4-p1",
          "ja": "勤務記録、給与明細、支払の記録は、それぞれ異なる情報です。時間数が明細のどの欄に反映されているかを確認します。不一致に気づいたときは、対象の月と項目を具体的に説明します。"
        },
        {
          "id": "kensetsu-common-session-010-cluster-4-p2",
          "ja": "「給与が少ない」という感想だけでなく、「記録した時間と明細の時間が違う」と分けて説明する練習をします。賃金額や控除の適否は、必要な資料をそろえて個別に確認する事項です。"
        }
      ],
      "learningActivity": {
        "ja": "用語と適用条件を確認し、区別する情報を自分の言葉で説明する。",
        "graded": false
      }
    }
  ],
