  "clusters": [
    {
      "id": "kensetsu-common-session-201-cluster-1",
      "titleJa": "切断する用具",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-201-cluster-1-p1",
          "ja": "チューブカッターとパイプカッターは、管を切断するための用具です。対象材料や管径、肉厚、替刃などの条件は製品ごとにあります。名称だけから必ず薄い管用・厚い管用と二分しません。"
        },
        {
          "id": "kensetsu-common-session-201-cluster-1-p2",
          "ja": "架空の選定欄には、管の材料、寸法、表面の構成、工具の型式を分けて記せます。大きい用具ならどの管でも切れるという判断を避け、切断対象と対応する用具の情報を照合します。"
        }
      ],
      "applicationPromptJa": "「パイプカッターなら必ず厚い管が切れる」という説明に、何の確認が欠けていますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-201-cluster-2",
      "titleJa": "切り離すことと端部を整えること",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-201-cluster-2-p1",
          "ja": "切断は管を所定の部分で分ける加工です。面取り器やバリ取り用具は、端部の形や加工で生じたバリを整えるための用具です。切断済みという情報だけでは、端部処理の状態は分かりません。"
        },
        {
          "id": "kensetsu-common-session-201-cluster-2-p2",
          "ja": "端部の処理には対象の材質や接合方式に対応する条件があります。例えば部材の一覧で切断欄のみ記入済みなら、端部の状態と確認欄を別に残します。すべての端部を同じ形にする指示にはしません。"
        }
      ],
      "applicationPromptJa": "切断欄だけ記入済みの管について、端部処理の確認をどう残しますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-201-cluster-3",
      "titleJa": "ねじを形成する機械",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-201-cluster-3-p1",
          "ja": "パイプねじ切機は、管の接合に用いるねじを加工する機械です。ねじを形成すること、既にあるねじを使って接合すること、ねじの状態を検査することは違う作業です。"
        },
        {
          "id": "kensetsu-common-session-201-cluster-3-p2",
          "ja": "指定されたねじの種類と、機械や加工部品の対応を読み分けます。管の太さだけで加工条件が決まるとはせず、ここでは回転や送り、刃の設定、油の使用などの操作手順を定めません。"
        }
      ],
      "applicationPromptJa": "ねじを形成することと、既存のねじを使って接合することの違いを説明してください。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-201-cluster-4",
      "titleJa": "加工と接合の引継ぎ",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-201-cluster-4-p1",
          "ja": "切断、端部処理、ねじ加工、接合は、それぞれ確認対象が違います。ある加工が終わった部材を、接合や試験まで完了した部材として引き継がないようにします。"
        },
        {
          "id": "kensetsu-common-session-201-cluster-4-p2",
          "ja": "独立した報告例は「切断した部材の番号は照合済み。端部とねじの確認記録は別に受け取る予定です」です。部材番号を軸にすると、加工段階の違う部材を取り違えにくくなります。"
        }
      ],
      "applicationPromptJa": "加工段階の異なる二本の管を、部材番号を使って区別する報告を作ってください。",
      "graded": false
    }
  ],
