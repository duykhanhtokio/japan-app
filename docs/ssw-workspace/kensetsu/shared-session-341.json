  "clusters": [
    {
      "id": "kensetsu-common-session-341-cluster-1",
      "titleJa": "角形の空気の経路",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-341-cluster-1-p1",
          "ja": "角ダクトは角形の断面を持つ空気の経路です。断面の形と接続方式は異なる情報です。角形であることだけで、どのフランジを使うかは決まりません。"
        },
        {
          "id": "kensetsu-common-session-341-cluster-1-p2",
          "ja": "用品票に断面と接続指定を別欄で残せます。外形図だけを、接続用品の品番確認へ置き換えない例です。"
        }
      ],
      "applicationPromptJa": "角ダクトの形状以外に、接続についてどの指定を読みますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-341-cluster-2",
      "titleJa": "別に作る枠",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-341-cluster-2-p1",
          "ja": "アングルフランジは形鋼などの枠を接続に用いる方式として読みます。ダクト本体と枠を区別します。枠があることだけで本体との接続や全体の強度は分かりません。"
        },
        {
          "id": "kensetsu-common-session-341-cluster-2-p2",
          "ja": "模式図に本体と枠を別に示せます。枠の材料票を、接続した状態の検査票にしない比較例です。"
        }
      ],
      "applicationPromptJa": "フランジの枠とダクト本体を別に確認する理由は何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-341-cluster-3",
      "titleJa": "固定と密封の働き",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-341-cluster-3-p1",
          "ja": "ボルトやナットの固定とパッキンなどの密封は働きが異なります。締まった外観だけで気密性を確認済みとはしません。材料、接続と試験を対応させます。"
        },
        {
          "id": "kensetsu-common-session-341-cluster-3-p2",
          "ja": "検査欄を締結と密封に分けられます。ボルトの写真を、空気の漏れ試験の結果へ広げない例です。"
        }
      ],
      "applicationPromptJa": "フランジの締結と気密の確認の違いを説明してください。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-341-cluster-4",
      "titleJa": "用途と接続の条件",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-341-cluster-4-p1",
          "ja": "空調や排煙などの用途では必要な条件を指定へ対応させます。アングルフランジという名称だけで排煙への適合が成立するとは分かりません。方式名と系統の設計を分けます。"
        },
        {
          "id": "kensetsu-common-session-341-cluster-4-p2",
          "ja": "報告例は「接続方式を識別。用途の指定は未受領」です。強度の順位や排煙の合否をこの例から判断しません。"
        }
      ],
      "applicationPromptJa": "フランジ方式だけ識別できた場合、用途の確認状況を報告してください。",
      "graded": false
    }
  ],
