  "clusters": [
    {
      "id": "kensetsu-common-session-365-cluster-1",
      "titleJa": "記録の対象",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-365-cluster-1-p1",
          "ja": "労働災害の集計は対象期間と範囲に対応します。死亡災害の数と全てのけがの数は異なります。昔の表を現在の現場の発生率として読みません。"
        },
        {
          "id": "kensetsu-common-session-365-cluster-1-p2",
          "ja": "担当者が古い表を朝礼資料へ使う場合、年と対象を示します。表の数だけを今年の事故件数として紹介しない例です。"
        }
      ],
      "applicationPromptJa": "古い集計を紹介するとき、何を一緒に示しますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-365-cluster-2",
      "titleJa": "数と発生率",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-365-cluster-2-p1",
          "ja": "件数と発生率は別の情報です。働く人数や作業の量などの分母がない比較は条件を限定します。数が多い分類を全員の個人的な危険の順位と読みません。"
        },
        {
          "id": "kensetsu-common-session-365-cluster-2-p2",
          "ja": "二つの職種の死亡件数を比べる担当者は、人数の情報がないことを伝えます。件数の差だけで一人当たりの危険が決まるとは説明しない場面です。"
        }
      ],
      "applicationPromptJa": "件数だけの比較で分からないものは何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-365-cluster-3",
      "titleJa": "型と原因",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-365-cluster-3-p1",
          "ja": "事故の型は起きた事象を分ける分類です。原因はその事象へ至る条件などです。同じ型の災害にも違う原因が関わります。"
        },
        {
          "id": "kensetsu-common-session-365-cluster-3-p2",
          "ja": "二件の転倒記録では、一件は床の障害物、もう一件は姿勢の変化が関わる場合があります。同じ型の名前で原因調査を終わらせない例です。"
        }
      ],
      "applicationPromptJa": "同じ型の災害でも原因を別に確認する理由は何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-365-cluster-4",
      "titleJa": "分類から場面へ",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-365-cluster-4-p1",
          "ja": "分類の名称と現場の場所を対応させます。表の中で少ない型も現場で無視してよいとは限りません。実際の作業条件へ戻って考えます。"
        },
        {
          "id": "kensetsu-common-session-365-cluster-4-p2",
          "ja": "水に近い現場へ配属された担当者は、全体集計で少なく見えるおぼれも確認します。表の順位だけで現場の対象を除外しない例です。"
        }
      ],
      "applicationPromptJa": "集計で少ない型でも現場で確認する理由は何ですか。",
      "graded": false
    }
  ],
