  "clusters": [
    {
      "id": "kensetsu-common-session-331-cluster-1",
      "titleJa": "光を伝える部分",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-331-cluster-1-p1",
          "ja": "光ケーブルは光ファイバなどを外側の層で保護する構造です。外被と光を伝える部分は役割が異なります。外観が無傷でも内部の伝送状態は別に確認します。"
        },
        {
          "id": "kensetsu-common-session-331-cluster-1-p2",
          "ja": "断面図に外側の保護と内側の経路を示せます。外被の写真だけを、光の伝送結果にしない識別例です。"
        }
      ],
      "applicationPromptJa": "光ケーブルの外観と内部の伝送の確認の違いは何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-331-cluster-2",
      "titleJa": "急な折れ曲がり",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-331-cluster-2-p1",
          "ja": "キンクは急な折れ曲がりなどの状態を示す呼び方です。断線だけでなく、曲がりは光の伝送にも関わります。見える切断がないことだけで必要な伝送性能を満たすとは判断しません。"
        },
        {
          "id": "kensetsu-common-session-331-cluster-2-p2",
          "ja": "確認票に外観と伝送測定を別欄で残せます。つながった形に見えることを、信号の適合の証拠へ広げない例です。"
        }
      ],
      "applicationPromptJa": "切れていない外観だけで、光の伝送を確認済みとできない理由は何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-331-cluster-3",
      "titleJa": "曲げと引く力",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-331-cluster-3-p1",
          "ja": "曲げ半径と張力は異なる条件です。許容される値はケーブルや状態の指定で読みます。柔らかく感じることだけで、どの曲がりや引く力にも対応するとは言えません。"
        },
        {
          "id": "kensetsu-common-session-331-cluster-3-p2",
          "ja": "用品表に曲げと張力を別欄で示せます。小さい収納箱に入ることを、指定状態で収納できた判定へ変えない例です。"
        }
      ],
      "applicationPromptJa": "光ケーブルの曲げ半径と張力を、なぜ別に照合しますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-331-cluster-4",
      "titleJa": "接続部と移動の条件",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-331-cluster-4-p1",
          "ja": "接続部や収納部分はケーブルが動く場合の条件へ対応させます。余長があることだけで、設備全体の変位への適合は分かりません。接続と通過する部分を区別して読みます。"
        },
        {
          "id": "kensetsu-common-session-331-cluster-4-p2",
          "ja": "報告例は「接続部の型式あり。動きと収納の資料はなし」です。引く量や輪の形、接続操作をこの例から指定しません。"
        }
      ],
      "applicationPromptJa": "接続部の型式だけある光ケーブルについて、移動への確認を報告してください。",
      "graded": false
    }
  ],
