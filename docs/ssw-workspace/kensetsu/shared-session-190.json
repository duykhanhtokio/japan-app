  "clusters": [
    {
      "id": "kensetsu-common-session-190-cluster-1",
      "titleJa": "何が情報を運ぶのか",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-190-cluster-1-p1",
          "ja": "光信号を伝える光ファイバと、金属の導体を使って電気信号を伝える通信ケーブルでは、伝送の仕組みが違います。外から見える被覆の色だけでは、この区別はできません。"
        },
        {
          "id": "kensetsu-common-session-190-cluster-1-p2",
          "ja": "架空の改修図で、建物間は光、室内の一部はメタルと指定されている例を考えます。両方を「通信線」とだけ書き直すと、必要な機器や接続先の違いが見えなくなります。"
        }
      ],
      "applicationPromptJa": "建物間と室内で媒体が違う図面に、どの二つの情報を残しますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-190-cluster-2",
      "titleJa": "伝送と支持は別の役割",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-190-cluster-2-p1",
          "ja": "支持線は架空のケーブルを支える部分です。情報を運ぶ部分と、機械的に支持する部分を分けて考えます。支持線があることだけでは、伝送方式も通信の良否も決まりません。"
        },
        {
          "id": "kensetsu-common-session-190-cluster-2-p2",
          "ja": "資料に支持線と接続部の両方が描かれていたら、支え方を示す情報と、通信経路をつなぐ情報に整理します。同じ経路にある部材でも、担当する役割は同じではありません。"
        }
      ],
      "applicationPromptJa": "支持線の記載を通信方式の記載と分けると、何が分かりやすくなりますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-190-cluster-3",
      "titleJa": "通信機器にも電源がある",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-190-cluster-3-p1",
          "ja": "通信機器が情報を扱うことと、その機器へ電源を供給することは別の関係です。電源装置や蓄電池の説明は、光やメタルの伝送経路の説明にそのまま置き換えられません。"
        },
        {
          "id": "kensetsu-common-session-190-cluster-3-p2",
          "ja": "例えば機器一覧で通信ポートは記載済み、電源の接続先は空欄だったとします。「通信線の記載はありますが、電源欄の照合が残っています」と伝えれば、確認対象を限定できます。"
        }
      ],
      "applicationPromptJa": "通信ポートだけ記載された一覧を、電源も確認済みとしてよいでしょうか。理由を説明してください。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-190-cluster-4",
      "titleJa": "経路図を読む練習",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-190-cluster-4-p1",
          "ja": "一つの経路について、伝送媒体、接続部、支持の構成、関連する電源を分けて整理します。この整理は部材の関係を理解するためで、施工や通電の指示を決めるものではありません。"
        },
        {
          "id": "kensetsu-common-session-190-cluster-4-p2",
          "ja": "架空の引継ぎメモには「光の経路番号は確認済み。支持方式の資料と機器の電源資料は未受領」と書けます。図面に記載があることと、現場の状態が確認済みであることを区別します。"
        }
      ],
      "applicationPromptJa": "経路番号が分かった段階で未受領の資料をどう具体的に伝えますか。",
      "graded": false
    }
  ],
