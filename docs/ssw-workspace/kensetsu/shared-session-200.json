  "clusters": [
    {
      "id": "kensetsu-common-session-200-cluster-1",
      "titleJa": "何を通す経路か",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-200-cluster-1-p1",
          "ja": "配管は水やガスなどの流体を通す管の経路として理解します。空調のダクトは空気を送る経路です。配管には空気を扱う用途もあるため、「空気ならすべてダクト」とは分類しません。"
        },
        {
          "id": "kensetsu-common-session-200-cluster-1-p2",
          "ja": "架空の設備一覧に給水、圧縮空気、換気が並んでいたら、同じ空気という語があっても系統の用途を分けて読みます。外形の似た管を、用途の記載なしに同じ設備としてまとめません。"
        }
      ],
      "applicationPromptJa": "圧縮空気の系統と換気の系統を、空気という語だけで同一分類にしない理由は何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-200-cluster-2",
      "titleJa": "形と構造の情報",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-200-cluster-2-p1",
          "ja": "角ダクトと丸ダクトは断面の形の違いです。スパイラルダクトは丸ダクトに含まれる構造の例として区別します。丸い断面であることだけから、すべてをスパイラル構造とは決めません。"
        },
        {
          "id": "kensetsu-common-session-200-cluster-2-p2",
          "ja": "形の欄が丸、材料の欄が未記入の資料なら、断面の形だけが分かった状態です。形、材料、構造、系統の用途は別の欄にでき、支持や接合の条件も形だけでは確定しません。"
        }
      ],
      "applicationPromptJa": "形が丸いと分かったダクトについて、材料や構造も確認済みとしない説明をしてください。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-200-cluster-3",
      "titleJa": "加工のために保持する",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-200-cluster-3-p1",
          "ja": "パイプ万力は、管を加工する際に保持・固定するための用具で、パイプバイスとも呼ばれます。管の移動を抑える機能と、切断や接合をする機能は別です。"
        },
        {
          "id": "kensetsu-common-session-200-cluster-3-p2",
          "ja": "例えば工具の準備表では、保持用具と加工用具を別欄にします。鋼管用と外被覆鋼管用などの違いがあるため、名称の一致だけで表面や材質への適合まで確認したことにはなりません。"
        }
      ],
      "applicationPromptJa": "保持用具が用意できたことと加工用具が用意できたことを、どのように説明し分けますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-200-cluster-4",
      "titleJa": "方向を変える加工",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-200-cluster-4-p1",
          "ja": "チューブベンダーは、対応する管を曲げるための用具です。銅管を対象にする製品などがあり、加工の対象となる材料や寸法は用具ごとに異なります。管を切り分ける機能とは区別します。"
        },
        {
          "id": "kensetsu-common-session-200-cluster-4-p2",
          "ja": "管を曲げる方法と、曲がりの継手を用いて経路をつなぐ方法は、経路の構成として別の考え方です。本講では曲げ半径や角度、手順を決めず、図面の経路と指定された加工方法を対応させます。"
        }
      ],
      "applicationPromptJa": "管の曲げ加工と、曲がりの継手による経路構成をどう区別して説明しますか。",
      "graded": false
    }
  ],
