  "clusters": [
    {
      "id": "kensetsu-common-session-202-cluster-1",
      "titleJa": "管端を広げる目的",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-202-cluster-1-p1",
          "ja": "エキスパンダーは、対応する管の端を広げる加工に用いる用具で、拡管器とも呼ばれます。接合に使う形をつくる機能であり、管の途中を曲げて経路を変える用具とは別です。"
        },
        {
          "id": "kensetsu-common-session-202-cluster-1-p2",
          "ja": "例えば管端の構成を説明するときは、端部を広げる箇所と、相手側の管との関係を言葉にします。すべての管を広げて接合できるとはせず、対象の材料や加工条件を確認事項として残します。"
        }
      ],
      "applicationPromptJa": "拡管と管の途中の曲げ加工では、何を変える目的が違いますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-202-cluster-2",
      "titleJa": "フレア加工の形",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-202-cluster-2-p1",
          "ja": "フレアリングツールは、軟質管などの端部を接合に用いる広がった形に加工する用具です。拡管とフレアは、端を広げるという語が共通でも、指定される端部の形や接合の構成が異なります。"
        },
        {
          "id": "kensetsu-common-session-202-cluster-2-p2",
          "ja": "架空の接合部一覧で拡管用とフレア用が別欄にある場合、どちらも「端を広げる」だけに省略しません。要求する形と接合する相手の部材を対応させ、操作や仕上がり基準は本講で決めません。"
        }
      ],
      "applicationPromptJa": "拡管とフレアを同じ加工名に省略すると、どの情報が失われますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-202-cluster-3",
      "titleJa": "つかんで回す用具",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-202-cluster-3-p1",
          "ja": "パイプレンチは、管などの対象をつかんで回すための用具で、現場ではパイレンとも呼ばれます。加工のために管を保持する万力と、回転させるためのレンチでは機能が違います。"
        },
        {
          "id": "kensetsu-common-session-202-cluster-3-p2",
          "ja": "管や継手の材質、表面、寸法に対応する用具の条件を読みます。どの継手にもパイプレンチを使うと一般化せず、指定工具との照合を残します。締付けの力や方向などの操作方法はここで扱いません。"
        }
      ],
      "applicationPromptJa": "パイプ万力とパイプレンチでは、管に対する役割がどのように違いますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-202-cluster-4",
      "titleJa": "用具の機能を接合方式へ結びつける",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-202-cluster-4-p1",
          "ja": "端を広げる、ねじを形成する、対象をつかんで回すという機能は、それぞれ違います。接合方式を確認せず、準備してある用具から接合方法を逆に決めないことが大切です。"
        },
        {
          "id": "kensetsu-common-session-202-cluster-4-p2",
          "ja": "準備表の例では「フレアリングツールは手配済み。対象の軟質管と指定の継手の照合は残っています」と書けます。用具があることと、接合する組合せが確定したことを分けて示します。"
        }
      ],
      "applicationPromptJa": "用具が手配済みでも接合する組合せは未確定、という状態を具体的に伝えてください。",
      "graded": false
    }
  ],
