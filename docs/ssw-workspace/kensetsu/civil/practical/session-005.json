  "clusters": [
    {
      "id": "kensetsu-civil-practical-session-005-cluster-1",
      "titleJa": "掘る部分と押す部分",
      "paragraphs": [
        {
          "id": "kensetsu-civil-practical-session-005-cluster-1-p1",
          "ja": "推進工事の設備を見るときは、地中を掘り進む掘進機と、地中へ送り込まれる推進管を区別します。機械と管を同じものとして読むと、どの設備についての連絡か分からなくなります。"
        },
        {
          "id": "kensetsu-civil-practical-session-005-cluster-1-p2",
          "ja": "元押しジャッキは、掘進機や推進管を押し進める力に関わります。一方、推進台は、管を所定の高さや方向へ導くための架台です。管に関わる設備でも、押す働きと案内する働きは同じではありません。"
        },
        {
          "id": "kensetsu-civil-practical-session-005-cluster-1-p3",
          "ja": "発進立坑は設備を配置して地中へ送り出す側、到達立坑は掘進機などを回収する側として区別します。両方を単に「穴の場所」と呼ぶより、どちら側かを明示すると連絡の対象が定まります。"
        }
      ],
      "applicationPromptJa": "掘進機、元押しジャッキ、推進台の役割をそれぞれ整理してください。",
      "terms": [
        {
          "ja": "推進管",
          "reading": "すいしんかん"
        },
        {
          "ja": "掘進機",
          "reading": "くっしんき"
        },
        {
          "ja": "元押し",
          "reading": "もとおし"
        }
      ]
    },
    {
      "id": "kensetsu-civil-practical-session-005-cluster-2",
      "titleJa": "位置の言い違いを防ぐ",
      "paragraphs": [
        {
          "id": "kensetsu-civil-practical-session-005-cluster-2-p1",
          "ja": "【架空の場面】連絡票に「立坑に機材を届ける」とだけ書かれていました。担当者が確認すると、発進側の準備に使う機材でしたが、運搬先の欄には到達側の名称が記入されていました。どちらも立坑であることだけでは、正しい届け先を判断できません。"
        },
        {
          "id": "kensetsu-civil-practical-session-005-cluster-2-p2",
          "ja": "この場合は、機材の役割、工区の名称、発進側か到達側かを対応させて確認します。設備図にある名称を使って連絡すると、同じ現場に複数ある場所を区別しやすくなります。"
        },
        {
          "id": "kensetsu-civil-practical-session-005-cluster-2-p3",
          "ja": "本文は設備の役割を読む学習です。推進力の設定、地盤への対応、立坑内への立入りや回収の手順を示していません。設備の配置を理解したことを、作業開始の許可と取り違えないようにします。"
        }
      ],
      "applicationPromptJa": "「立坑へ届ける」という依頼を受けたとき、場所の特定に必要な質問を考えてください。",
      "terms": [
        {
          "ja": "架台",
          "reading": "かだい"
        },
        {
          "ja": "発進立坑",
          "reading": "はっしんたてこう"
        },
        {
          "ja": "到達立坑",
          "reading": "とうたつたてこう"
        }
      ]
    }
  ],
