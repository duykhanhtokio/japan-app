  "clusters": [
    {
      "id": "kensetsu-civil-practical-session-006-cluster-1",
      "titleJa": "船の外形だけで用途を決めない",
      "paragraphs": [
        {
          "id": "kensetsu-civil-practical-session-006-cluster-1-p1",
          "ja": "浚渫は、水底の土砂を取り除く仕事に関わります。グラブで土砂をつかむ方式の船と、土砂を水とともに吸い込む方式の船では、扱う仕組みが異なります。船が同じ海域にいるだけで同じ用途とは限りません。"
        },
        {
          "id": "kensetsu-civil-practical-session-006-cluster-1-p2",
          "ja": "起重機船は、クレーンを備え、重い構造物を持ち上げて移す仕事などに関わります。土砂を運ぶ土運船や、他の船を移動させる引船とは、計画の中で担う役割が違います。"
        },
        {
          "id": "kensetsu-civil-practical-session-006-cluster-1-p3",
          "ja": "海底の形などを調べるソナーや、水深を測る道具は、作業対象の状態を確かめるためのものです。測るための機器があることと、必要な土砂を取り除く作業が済んだことは別です。"
        }
      ],
      "applicationPromptJa": "浚渫船、起重機船、土運船の役割の違いを説明してください。",
      "terms": [
        {
          "ja": "浚渫",
          "reading": "しゅんせつ"
        },
        {
          "ja": "水底",
          "reading": "すいてい"
        },
        {
          "ja": "起重機船",
          "reading": "きじゅうきせん"
        }
      ]
    },
    {
      "id": "kensetsu-civil-practical-session-006-cluster-2",
      "titleJa": "調査結果と施工結果を分ける",
      "paragraphs": [
        {
          "id": "kensetsu-civil-practical-session-006-cluster-2-p1",
          "ja": "【架空の場面】岸壁の工事打合せで、水深の記録が配られました。新人は、その資料を見て「土砂を取り除く作業も終わっています」と説明しました。しかし、配られた資料は作業前の調査結果でした。"
        },
        {
          "id": "kensetsu-civil-practical-session-006-cluster-2-p2",
          "ja": "資料を読むときは、測った時点と対象の場所を確認します。作業前の状態を示す測定と、作業後の状態を確かめる測定を区別すれば、進捗についての誤った連絡を減らせます。"
        },
        {
          "id": "kensetsu-civil-practical-session-006-cluster-2-p3",
          "ja": "作業船の運用、つり上げ、係留や航行の条件は、それぞれの計画と担当者の確認に従う事項です。本単元では、船を動かす方法や水深の合否を判断する値は示していません。"
        }
      ],
      "applicationPromptJa": "水深の資料が施工の完了を示すか確かめるには、何を読み取る必要がありますか。",
      "terms": [
        {
          "ja": "土運船",
          "reading": "どうんせん"
        },
        {
          "ja": "引船",
          "reading": "ひきふね"
        },
        {
          "ja": "水深",
          "reading": "すいしん"
        }
      ]
    }
  ],
