  "clusters": [
    {
      "id": "kensetsu-civil-practical-session-003-cluster-1",
      "titleJa": "材料の動きを追って考える",
      "paragraphs": [
        {
          "id": "kensetsu-civil-practical-session-003-cluster-1-p1",
          "ja": "スクレーパは、土を取り込み、運び、所定の場所へ広げる仕事に関わる機械です。土を扱う工程の中でも、機械の内部へ取り込む段階と、別の場所へ広げる段階を分けて理解します。"
        },
        {
          "id": "kensetsu-civil-practical-session-003-cluster-1-p2",
          "ja": "モーターグレーダは、ブレードなどを使って地表や路盤材の形を整える仕事に関わります。材料を運ぶことと、広がった材料の面を整えることは、工程上の目的が異なります。"
        },
        {
          "id": "kensetsu-civil-practical-session-003-cluster-1-p3",
          "ja": "「均す」という言葉は、材料の面や形を整える意味で使います。一方、締め固める仕事は材料の状態を別の観点で変えるものです。平らに見えることだけを締固めの確認結果に置き換えないことが大切です。"
        }
      ],
      "applicationPromptJa": "材料を均す仕事と、材料を運ぶ仕事の違いを説明してください。",
      "terms": [
        {
          "ja": "敷均し",
          "reading": "しきならし"
        },
        {
          "ja": "散土",
          "reading": "さんど"
        },
        {
          "ja": "路盤材",
          "reading": "ろばんざい"
        }
      ]
    },
    {
      "id": "kensetsu-civil-practical-session-003-cluster-2",
      "titleJa": "次の班への引継ぎ",
      "paragraphs": [
        {
          "id": "kensetsu-civil-practical-session-003-cluster-2-p1",
          "ja": "【架空の場面】園路の下地を整える工区で、「土を入れました」という引継ぎがありました。次の班が確かめると、材料は届いていましたが、予定する範囲に均す作業はまだでした。到着と敷均しを同じ完了状態にすると、準備がずれます。"
        },
        {
          "id": "kensetsu-civil-practical-session-003-cluster-2-p2",
          "ja": "引継ぎでは、材料の到着、広げた範囲、面を整えた範囲を分けて伝えます。機械の用途を工程と結び付けると、どこまで進んでいるかを説明しやすくなります。"
        },
        {
          "id": "kensetsu-civil-practical-session-003-cluster-2-p3",
          "ja": "対象の高さや勾配、施工の順序は、その現場の資料と指示に基づく事項です。本単元の例は、機械の使い方や完成面の許容値を指定していません。"
        }
      ],
      "applicationPromptJa": "材料の到着だけを確認したとき、敷均しについてどのように報告すればよいですか。",
      "terms": [
        {
          "ja": "下地",
          "reading": "したじ"
        },
        {
          "ja": "工区",
          "reading": "こうく"
        },
        {
          "ja": "勾配",
          "reading": "こうばい"
        }
      ]
    }
  ],
