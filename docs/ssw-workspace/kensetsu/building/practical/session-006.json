  "clusters": [
    {
      "id": "kensetsu-building-practical-session-006-cluster-1",
      "titleJa": "接合する役割と調べる役割",
      "paragraphs": [
        {
          "id": "kensetsu-building-practical-session-006-cluster-1-p1",
          "ja": "ガス圧接の設備では、鉄筋を所定の位置で保持する部分、加圧に関わる装置、接合部を加熱する部分を分けて考えます。加熱する器具だけが見えていても、設備全体の働きを説明したことにはなりません。"
        },
        {
          "id": "kensetsu-building-practical-session-006-cluster-1-p2",
          "ja": "接合部の外側の形を測る器具と、超音波を使って内部の状態を調べる装置では、得られる情報が異なります。検査方法の名前を聞いたときは、何を調べる検査なのかも一緒に確認します。"
        },
        {
          "id": "kensetsu-building-practical-session-006-cluster-1-p3",
          "ja": "引張試験や曲げ試験も、接合部を調べる方法の一つです。装置が置かれていること、試験を実施したこと、結果が承認されたことは、それぞれ異なる情報です。"
        }
      ],
      "applicationPromptJa": "外観の測定と内部の検査は、なぜ同じ情報として扱えないのでしょうか。",
      "terms": [
        {
          "ja": "圧接",
          "reading": "あっせつ"
        },
        {
          "ja": "加圧",
          "reading": "かあつ"
        },
        {
          "ja": "加熱",
          "reading": "かねつ"
        }
      ]
    },
    {
      "id": "kensetsu-building-practical-session-006-cluster-2",
      "titleJa": "検査の報告を一段ずつ確認する",
      "paragraphs": [
        {
          "id": "kensetsu-building-practical-session-006-cluster-2-p1",
          "ja": "【架空の場面】工程の打合せで「圧接部の確認は済みました」と発言がありました。記録を開くと、外観を測った欄には記入がありましたが、別に予定された検査の欄は空白でした。ひとつの記録だけから、予定された確認がすべて完了したとは読めません。"
        },
        {
          "id": "kensetsu-building-practical-session-006-cluster-2-p2",
          "ja": "聞き手は、どの検査を行い、どの記録に結果があるのかを分けて確認します。結果の評価を担当する人が誰かも、検査の実施者と混同しないようにします。"
        },
        {
          "id": "kensetsu-building-practical-session-006-cluster-2-p3",
          "ja": "ここでは設備と検査の目的を区別します。圧力、温度、加熱時間、検査の判定値や装置の操作方法は示していません。数値が書かれていない本文から作業条件を補ってはいけません。"
        }
      ],
      "applicationPromptJa": "「確認済み」という報告を、検査記録と対応させるための質問を考えてください。",
      "terms": [
        {
          "ja": "外観",
          "reading": "がいかん"
        },
        {
          "ja": "超音波",
          "reading": "ちょうおんぱ"
        },
        {
          "ja": "引張試験",
          "reading": "ひっぱりしけん"
        }
      ]
    }
  ],
