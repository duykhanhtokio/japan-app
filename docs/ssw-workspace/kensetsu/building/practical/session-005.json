  "clusters": [
    {
      "id": "kensetsu-building-practical-session-005-cluster-1",
      "titleJa": "加工機械と小さな部材",
      "paragraphs": [
        {
          "id": "kensetsu-building-practical-session-005-cluster-1-p1",
          "ja": "鉄筋カッターは切断、鉄筋ベンダーは曲げ加工に関わります。一方、ハッカーや鉄筋結束機は結束のための工具です。鉄筋の近くで使う道具を、すべて同じ加工工具とまとめると、依頼内容を取り違えます。"
        },
        {
          "id": "kensetsu-building-practical-session-005-cluster-1-p2",
          "ja": "結束線は鉄筋どうしを結ぶための材料で、スペーサーは鉄筋の位置やかぶりの確保に関わる部材です。結束が終わっていることだけでは、必要な位置関係まで確認されたとはいえません。"
        },
        {
          "id": "kensetsu-building-practical-session-005-cluster-1-p3",
          "ja": "鉄筋の荷札には、寸法や本数、使用箇所などを識別する情報があります。形が似ている材料でも、荷札を確かめず別の使用箇所へ運ぶと、必要な材料との対応が分からなくなります。"
        }
      ],
      "applicationPromptJa": "結束線とスペーサーは、それぞれどのような目的に関わりますか。",
      "terms": [
        {
          "ja": "鉄筋",
          "reading": "てっきん"
        },
        {
          "ja": "切断",
          "reading": "せつだん"
        },
        {
          "ja": "結束線",
          "reading": "けっそくせん"
        }
      ]
    },
    {
      "id": "kensetsu-building-practical-session-005-cluster-2",
      "titleJa": "材料の札を残して受け渡す",
      "paragraphs": [
        {
          "id": "kensetsu-building-practical-session-005-cluster-2-p1",
          "ja": "【架空の場面】隣り合う二つの区画に、見た目が似た鉄筋の束が届きました。片方の荷札には別の区画名が書かれています。作業を急ぐために札を外して一か所へまとめると、使用箇所を確認する情報を失ってしまいます。"
        },
        {
          "id": "kensetsu-building-practical-session-005-cluster-2-p2",
          "ja": "受渡しでは、束の識別情報と予定する使用箇所を対応させて伝えます。材料の運搬が終わったこと、加工が終わったこと、配筋の確認が済んだことは、別の段階として扱います。"
        },
        {
          "id": "kensetsu-building-practical-session-005-cluster-2-p3",
          "ja": "かぶりの数値や加工形状は、対象に応じた図面や仕様を確認する事項です。本単元では共通の値を決めず、材料、工具、位置を保つ部材の役割を区別するところまでを扱います。"
        }
      ],
      "applicationPromptJa": "荷札の使用箇所と運び先が違うと気付いたとき、何を照合して伝えますか。",
      "terms": [
        {
          "ja": "荷札",
          "reading": "にふだ"
        },
        {
          "ja": "使用箇所",
          "reading": "しようかしょ"
        },
        {
          "ja": "配筋",
          "reading": "はいきん"
        }
      ]
    }
  ],
