  "clusters": [
    {
      "id": "kensetsu-building-practical-session-003-cluster-1",
      "titleJa": "同じ金属でも働きは異なる",
      "paragraphs": [
        {
          "id": "kensetsu-building-practical-session-003-cluster-1-p1",
          "ja": "足場には、作業する床になる部材、部材どうしをつなぐ金具、全体の安定に関わる部材などがあります。作業床となる板と、支柱間の補強に使う筋交いを、見た目の長さだけで同じものとして扱わないようにします。"
        },
        {
          "id": "kensetsu-building-practical-session-003-cluster-1-p2",
          "ja": "単管の接続に使うクランプと、足場を建物側へつなぐ壁つなぎは、目的が異なります。どちらも金具を含むからという理由で、一方があれば他方も不要になると考えることはできません。"
        },
        {
          "id": "kensetsu-building-practical-session-003-cluster-1-p3",
          "ja": "足場の形式によって部材の構成や接続の仕組みは変わります。手すり、作業床、壁つなぎなどの名前を覚えるときも、その部材がどの役割を担っているかを合わせて理解します。"
        }
      ],
      "applicationPromptJa": "作業床、筋交い、壁つなぎを、それぞれ何のための部材か説明してください。",
      "terms": [
        {
          "ja": "足場",
          "reading": "あしば"
        },
        {
          "ja": "作業床",
          "reading": "さぎょうゆか"
        },
        {
          "ja": "筋交い",
          "reading": "すじかい"
        }
      ]
    },
    {
      "id": "kensetsu-building-practical-session-003-cluster-2",
      "titleJa": "不足品の連絡を読み直す",
      "paragraphs": [
        {
          "id": "kensetsu-building-practical-session-003-cluster-2-p1",
          "ja": "【架空の場面】外壁の作業場所から「板が足りません」と連絡がありました。保管場所には、作業床の部材と、物の落下防止に関わる幅木がありました。どちらも板状だからといって、同じ不足品として受け取ることはできません。"
        },
        {
          "id": "kensetsu-building-practical-session-003-cluster-2-p2",
          "ja": "連絡を受けた人は、使う場所と部材の名称を職長に確認します。写真や形状は名称の確認を助けますが、別の部材を代用してよいという根拠にはなりません。"
        },
        {
          "id": "kensetsu-building-practical-session-003-cluster-2-p3",
          "ja": "この説明は部材の役割を読み分ける学習です。部材を取り外す、付け替える、現場で不足を補う方法までは示していません。足場の状態に疑問がある場合は、自己判断で変更せず担当者へ伝えます。"
        }
      ],
      "applicationPromptJa": "「板が足りない」という連絡で、確認したい情報を二つ挙げてください。",
      "terms": [
        {
          "ja": "壁つなぎ",
          "reading": "かべつなぎ"
        },
        {
          "ja": "幅木",
          "reading": "はばき"
        },
        {
          "ja": "金具",
          "reading": "かなぐ"
        }
      ]
    }
  ],
