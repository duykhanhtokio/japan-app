  "clusters": [
    {
      "id": "kensetsu-common-session-193-cluster-1",
      "titleJa": "支持を担う部分",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-193-cluster-1-p1",
          "ja": "つり線は、架空のケーブルを支えるための線で、メッセンジャーワイヤーとも呼ばれます。伝送部へかかる機械的な力を考える際に、支持の構成を分けて理解します。"
        },
        {
          "id": "kensetsu-common-session-193-cluster-1-p2",
          "ja": "支持があることを「ケーブルに力が一切かからない」とは言い換えません。対象ケーブル、支持方式、許容条件は個別の確認事項です。ここでは張力の数値や張設の手順を指定しません。"
        }
      ],
      "applicationPromptJa": "つり線があることと、ケーブルに加わる力がゼロであることを区別する理由は何ですか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-193-cluster-2",
      "titleJa": "支持線が一体の種類",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-193-cluster-2-p1",
          "ja": "自己支持ケーブルは、ケーブルを支える線を一体化した構成のものです。別のつり線と組み合わせる構成とは材料のまとめ方が違います。支持線と伝送部の役割の違いは残ります。"
        },
        {
          "id": "kensetsu-common-session-193-cluster-2-p2",
          "ja": "自己支持という名称は、取付けや設計の確認が不要という意味ではありません。架空の準備表で自己支持型と指定されていたら、対応品種と支持の資料を確認対象として整理します。"
        }
      ],
      "applicationPromptJa": "支持線が一体になっても、なぜ取付け条件の確認が残るのでしょうか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-193-cluster-3",
      "titleJa": "繰出しと金車の機能",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-193-cluster-3-p1",
          "ja": "ケーブル繰り出し機は、巻かれたケーブルを送り出すための用具です。金車は、延線でケーブルを案内する滑車・ローラーの用具として区別します。送り出す側と経路側の機能を混同しません。"
        },
        {
          "id": "kensetsu-common-session-193-cluster-3-p2",
          "ja": "繰出し用具にはケーブルドラムを支える型や巻き束に対応する型などがあり、形態は一つではありません。写真の色や脚の形だけで適合を判断せず、巻かれ方と対象品の情報を照合します。"
        }
      ],
      "applicationPromptJa": "繰出し用具と金車では、ケーブルのどの場面を補助する役割が違いますか。",
      "graded": false
    },
    {
      "id": "kensetsu-common-session-193-cluster-4",
      "titleJa": "用具名と適合情報",
      "minutes": null,
      "paragraphs": [
        {
          "id": "kensetsu-common-session-193-cluster-4-p1",
          "ja": "金車や繰出し用具は、対象のケーブル寸法や支持条件に対応する必要があります。同じ名称の用具を用意しただけでは、現場の条件へ適合したと判断できません。"
        },
        {
          "id": "kensetsu-common-session-193-cluster-4-p2",
          "ja": "例えば手配メモには「経路側の金車の候補は確認済み。繰出し側の巻き形態に対応する品種は照合中」と書けます。選定途中の状態を、設置済みや延線開始の指示と分けて伝えます。"
        }
      ],
      "applicationPromptJa": "候補品の手配と実際の使用可能の確認を、どう区別して引き継ぎますか。",
      "graded": false
    }
  ],
