    {
      "id": "agr-par11-general-cropping-calendar",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "掲載例から播種と収穫の季節を対応させる",
      "objectiveJa": "キュウリ三作型とキャベツ四作型の掲載例を、播種月・収穫季節・年のつながりを保って説明できる。",
      "paragraphs": [
        {
          "id": "agr-par11-general-cropping-calendar-p1",
          "titleJa": "年末をまたぐ促成の例",
          "textJa": "キュウリの促成の行では、9月の位置に播種の印があり、その後にハウスの印が置かれています。収穫の帯は年末側だけでなく年初側にも描かれ、冬から春へ続く作型の例として読めます。1月を左端とする図なので、12月で栽培が必ず終わると判断せず、年をまたぐ対応を考えます。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-02-01"
          ]
        },
        {
          "id": "agr-par11-general-cropping-calendar-p2",
          "titleJa": "露地キュウリの基準を置く",
          "textJa": "露地の普通栽培の行は4月の播種から始まり、夏側に収穫の表示があります。この行を基準にすると、促成は収穫を早い側へ、抑制は遅い側へ動かした例だと比較できます。普通栽培にもハウスが必ず必要だと考えず、各行に示された施設の印を個別に確認します。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-02-02"
          ]
        },
        {
          "id": "agr-par11-general-cropping-calendar-p3",
          "titleJa": "抑制の行は遅い側を見る",
          "textJa": "キュウリの抑制の行では7月に播種の印があり、その後にハウスの印と秋から年末側の収穫帯が並びます。促成の9月播種より月の数字が小さいから収穫も早い、と数字だけで比較してはいけません。作型名、播種点、施設の印、収穫帯を同じ行で追う必要があります。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-02-03"
          ]
        },
        {
          "id": "agr-par11-general-cropping-calendar-p4",
          "titleJa": "春まきと夏まきのキャベツ",
          "textJa": "キャベツの春まき夏どりの行では3月、夏まき冬どりの行では7月に播種の印があります。二つの行は、まく季節と収穫する季節の組合せが違います。春まきの行の収穫帯を夏まきの行に移して読まず、作型名に含まれる二つの季節を別々に記録してから横の帯を確かめます。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-02-04"
          ]
        },
        {
          "id": "agr-par11-general-cropping-calendar-p5",
          "titleJa": "秋まきと冬まきのキャベツ",
          "textJa": "秋まき春どりの行では10月、冬まき夏どりの行では12月に播種の印があり、収穫は翌年側に対応します。これらの播種点は図の右に、収穫の表示は左から中央側にあります。収穫が播種より先に行われるという意味ではなく、年末から次の年へ続く作型として読みます。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-02-05"
          ]
        },
        {
          "id": "agr-par11-general-cropping-calendar-p6",
          "titleJa": "例の月と作業指示を分ける",
          "textJa": "この作型図は、播種を点、収穫を期間の帯として示しています。帯の幅を一日の作業日へ置き換えたり、播種点だけから収穫の開始日を計算したりはしません。同じ作物でも地域や品種によって日程は変わるため、ここで整理した月は掲載例の比較に使い、現場の共通日程にはしないでください。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-02-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "促成栽培",
          "reading": "そくせいさいばい"
        },
        {
          "ja": "抑制栽培",
          "reading": "よくせいさいばい"
        },
        {
          "ja": "作型",
          "reading": "さくがた"
        }
      ],
      "activityJa": "キュウリ三作型とキャベツ四作型の播種月を一覧にし、収穫の季節と翌年に続くかを説明してください。掲載例の月と現場の日程を区別します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
