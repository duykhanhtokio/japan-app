  "lessons": [
    {
      "id": "agr-par11-general-gas-transport",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "化学式と移動の向きで作物の働きを区別する",
      "objectiveJa": "CO2・H2O・O2の意味、光合成と呼吸のガスの向き、水と炭水化物の移動経路を区別できる。",
      "paragraphs": [
        {
          "id": "agr-par11-general-gas-transport-p1",
          "titleJa": "CO2を物質名に戻す",
          "textJa": "作物の働きを記録するメモにCO2とあれば、二酸化炭素と読み替えます。光合成の説明にある二酸化炭素と、図に付いたCO2は別の材料ではありません。矢印を見る前に、記号と物質名を一組にしておくと、光が入る線と物質が入る線も区別しやすくなります。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-01-01"
          ]
        },
        {
          "id": "agr-par11-general-gas-transport-p2",
          "titleJa": "H2OとO2を区別する",
          "textJa": "H2Oは水、O2は酸素を表します。どちらにもOが含まれますが、同じ物質として扱いません。例えば根から入る水にH2O、呼吸で取り込む酸素にO2と記すと、二つの経路を分けられます。ここでは図の表示を読むことが目的で、化学反応の量を計算する規則までは加えません。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-01-02"
          ]
        },
        {
          "id": "agr-par11-general-gas-transport-p3",
          "titleJa": "光合成の入口と出口",
          "textJa": "光合成の部分では、二酸化炭素の矢印が葉へ入り、酸素の矢印が葉から外へ出ています。二酸化炭素を取り込む向きと、酸素を出す向きを対にして説明します。光も必要ですが、太陽光の線を酸素の流入と読み替えないように、線のそばの名称を確認してください。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-01-03"
          ]
        },
        {
          "id": "agr-par11-general-gas-transport-p4",
          "titleJa": "呼吸では酸素が入る",
          "textJa": "呼吸の部分では、酸素が葉へ入る矢印と、二酸化炭素が外へ出る矢印が描かれています。光合成のガスの向きと比べると、同じ物質でも入口と出口が逆です。作物が呼吸をするという説明に、この酸素の取り込みと二酸化炭素の放出を加えると、働きの違いを具体的に説明できます。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-01-04"
          ]
        },
        {
          "id": "agr-par11-general-gas-transport-p5",
          "titleJa": "水と養分は根からたどる",
          "textJa": "根の周囲では、水と無機養分が土から根へ入ります。水の線は茎の中を通り、上の葉へ続いています。これに対して葉の外へ出る水蒸気の線は蒸散を示します。土からの入口、植物内の移動、葉からの出口を順に述べ、気体の酸素が根から水として入るという説明にしないでください。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-01-05"
          ]
        },
        {
          "id": "agr-par11-general-gas-transport-p6",
          "titleJa": "炭水化物の移動は別の線",
          "textJa": "光合成でできた炭水化物の線は、葉から茎を通って別の部分や根へ向かっています。根から上へ向かう水の線とは、運ばれるものと出発点が異なります。図を言葉で説明するときは「何が、どこから、どこへ」の順に記録しましょう。この模式図の線だけから、移動速度や運搬量の数値は決められません。",
          "knowledgeIds": [
            "AGR-K-PAR11-GENERAL-01-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "二酸化炭素",
          "reading": "にさんかたんそ"
        },
        {
          "ja": "酸素",
          "reading": "さんそ"
        },
        {
          "ja": "炭水化物",
          "reading": "たんすいかぶつ"
        }
      ],
      "activityJa": "三つの化学式を物質名に戻し、光合成と呼吸について、入る気体と出る気体を二列に整理してください。水と炭水化物は出発点と移動先も添えます。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
