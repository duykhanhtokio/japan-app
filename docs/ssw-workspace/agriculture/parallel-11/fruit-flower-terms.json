      "sourceHash": "66d3697d2712fc28626f95a6c96c7a7c7160e66ded8adb3c92a55514d2c8f4fc"
    },
    {
      "id": "agr-par11-flower-soil-profile",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "地表の管理と土の中の変化を結び付ける",
      "objectiveJa": "清耕法・草生法・マルチ法の模式的な比較を使い、有機物、団粒、雨水の違いを説明できる。",
      "paragraphs": [
        {
          "id": "agr-par11-flower-soil-profile-p1",
          "titleJa": "地表と地下を分けて比較する",
          "textJa": "地面の管理を比べるときは、表面の覆いだけでなく、その下の有機物を含む層と上層部の土の構造も見ます。資料の模式図は、有機物の多い部分、中程度の部分、少ない部分を区別し、その広がりを管理法ごとに示しています。この多・中・少は比較のための表示で、深さや含有率の実測値ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SOIL-PROFILE-01"
          ]
        },
        {
          "id": "agr-par11-flower-soil-profile-p2",
          "titleJa": "清耕法で示される流れやすさ",
          "textJa": "清耕法の比較例では、上層部の土に粗大な有機物が少なく、団粒化も乏しい状態が示されています。この状態では雨水によって表土が流れやすい、という関係を読み取ります。「裸地」という表面の状態と、「有機物が少なく土のまとまりが発達していない」という内部の説明をつなげて考えましょう。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SOIL-PROFILE-02"
          ]
        },
        {
          "id": "agr-par11-flower-soil-profile-p3",
          "titleJa": "草生法の層と団粒",
          "textJa": "草生法の模式例では、有機物を含む層が下の方まで広がっています。上層部には粗大な有機物が多く、団粒も発達した状態が示されています。有機物の層が広がることと、土の粒がまとまることを別々の観察点として整理すると、地表に草があるという説明だけで終わらずに比較できます。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SOIL-PROFILE-03"
          ]
        },
        {
          "id": "agr-par11-flower-soil-profile-p4",
          "titleJa": "有機物のマルチが変化する過程",
          "textJa": "わらや刈草など、有機物を使ったマルチでは、資材が腐植化し、その影響が下層まで広がると説明されています。その過程とともに団粒も多くなる、というのが資料の比較です。敷いた直後の資材の姿と、腐植化が進んだ後の土の状態を同じものとして扱わず、変化の過程を言葉にします。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SOIL-PROFILE-04"
          ]
        },
        {
          "id": "agr-par11-flower-soil-profile-p5",
          "titleJa": "水に対する団粒の性質",
          "textJa": "有機物マルチの上層部では、腐植化が進み、耐水性の団粒が多いと示されています。ここでの着目点は、水の作用を受けてもまとまりを保つという団粒の性質です。草生法の「団粒が発達する」という説明に加えて、有機物マルチでは耐水性という性質にも注目して比較します。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SOIL-PROFILE-05"
          ]
        },
        {
          "id": "agr-par11-flower-soil-profile-p6",
          "titleJa": "ポリエチレンは有機物と分ける",
          "textJa": "ポリエチレンフィルムなどで覆う場合は、雨水が土へ入るのを抑える働きが示されています。同じマルチ法でも、有機物が腐植化して下層へ広がる説明を、そのままフィルムへ移してはいけません。まとめると、裸地では流出、草生では有機物層と団粒、有機物マルチでは腐植化と耐水性、フィルムでは雨水の入り方を分けて読みます。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SOIL-PROFILE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "粗大有機物",
          "reading": "そだいゆうきぶつ"
        },
        {
          "ja": "団粒",
          "reading": "だんりゅう"
        },
        {
          "ja": "団粒化",
          "reading": "だんりゅうか"
        },
        {
          "ja": "腐植化",
          "reading": "ふしょくか"
        },
        {
          "ja": "耐水性",
          "reading": "たいすいせい"
        },
        {
          "ja": "下層",
          "reading": "かそう"
        }
      ],
      "activityJa": "清耕法、草生法、有機物マルチ、ポリエチレンフィルムの四欄を作り、有機物の変化、団粒、雨水について本文から分かる内容を書きます。書かれていない深さ・割合・変化にかかる日数は空欄にして、数値を推測しないでください。",
      "targetMinutes": 30,
