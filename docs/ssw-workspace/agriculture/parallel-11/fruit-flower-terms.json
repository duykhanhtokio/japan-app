  "questions": [
    {
      "id": "agr-par11-flower-q01",
      "stemJa": "根が広がる範囲に刈草を敷き、地面を覆ったという記録があります。管理法の説明として合うものはどれですか。",
      "optionsJa": [
        "刈草を資材として使うマルチ法",
        "生きた牧草を利用する草生法",
        "草のない地面を保つ清耕法",
        "複数の方法を組み合わせる折衷法"
      ],
      "correctIndex": 0,
      "optionReasonsJa": [
        "刈草を敷いて覆う記録に対応します。",
        "刈った草を敷くことと、そこで草を生育させることは異なります。",
        "地面を資材で覆っており、裸地を保つ記録ではありません。",
        "複数の管理方法を組み合わせた記録ではありません。"
      ],
      "lessonId": "agr-par11-flower-surface-methods",
      "lessonSourceHash": "66d3697d2712fc28626f95a6c96c7a7c7160e66ded8adb3c92a55514d2c8f4fc",
      "knowledgeIds": [
        "AGR-K-PAR11-FLOWER-SURFACE-METHODS-02"
      ],
      "levels": [
        "2"
      ],
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 115,
          "printedPage": 113
        }
      ],
      "nativeReviewed": false,
