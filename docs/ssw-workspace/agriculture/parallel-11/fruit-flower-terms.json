  "lessons": [
    {
      "id": "agr-par11-flower-surface-methods",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "果樹園の地面を管理する四つの方法",
      "objectiveJa": "清耕法・マルチ法・草生法・折衷法を区別し、草を残す場合の利点と注意点を説明できる。",
      "paragraphs": [
        {
          "id": "agr-par11-flower-surface-methods-p1",
          "titleJa": "草を生やさない清耕法",
          "textJa": "清耕法は裸地法とも呼ばれ、果樹園の土の表面に草がない状態を保つ管理です。単に草を一度刈ったという作業名ではなく、地面をどのような状態にしておくかを示します。覆う物がない表土は雨水で流れやすくなるため、草がないことだけを利点として評価しません。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SURFACE-METHODS-01"
          ]
        },
        {
          "id": "agr-par11-flower-surface-methods-p2",
          "titleJa": "根の広がる所を覆うマルチ法",
          "textJa": "マルチ法では、根が広がっている範囲の地面を、わら、刈草、ポリエチレンフィルムなどで覆います。土が流れることや、土の水分が蒸発することを防ぐ効果が示されています。生きた草を育てる方法とは、表面を覆う物の状態が異なります。資材名を記録してから管理法を判断しましょう。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SURFACE-METHODS-02"
          ]
        },
        {
          "id": "agr-par11-flower-surface-methods-p3",
          "titleJa": "草を育てて覆う草生法",
          "textJa": "草生法は、草を生やして果樹園の地表を覆う管理です。資料では、使われる草の主な例としてイネ科とマメ科の牧草が挙げられています。刈り取った草を敷くマルチ法と、そこで生育する草を利用する草生法を分けます。科の例だけから、どの園にも同じ草種が適するとは決められません。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SURFACE-METHODS-03"
          ]
        },
        {
          "id": "agr-par11-flower-surface-methods-p4",
          "titleJa": "果樹と草の養水分の競合",
          "textJa": "草生法の草も養分や水分を利用するので、果樹と競合する場合があります。地面が草で覆われているという見た目だけで、果樹に必要な水や養分が十分あるとは判断できません。管理記録では、被覆の状態に加え、果樹と草が同じ資源を使っている点を注意事項として残します。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SURFACE-METHODS-04"
          ]
        },
        {
          "id": "agr-par11-flower-surface-methods-p5",
          "titleJa": "病害虫と天敵の両方を見る",
          "textJa": "草は病害虫が発生する場所になることもあれば、益虫である天敵のすみかになることもあります。草があるという一つの条件から、有害な生物だけが増える、または必ず防除に役立つと結論を出さないことが大切です。どちらの可能性も残し、実際の発生状況の確認と管理法の名称を分けて考えます。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SURFACE-METHODS-05"
          ]
        },
        {
          "id": "agr-par11-flower-surface-methods-p6",
          "titleJa": "組合せを考える折衷法",
          "textJa": "折衷法は、これらの管理方法を組み合わせ、長所を生かしながら欠点を補う考え方です。一つの名称を全ての場所へ当てはめるのでなく、何を覆い、何を残す組合せなのかを説明します。まとめると、裸地を保つ、資材で覆う、草を生やすという違いを押さえたうえで、組合せの目的を考えます。",
          "knowledgeIds": [
            "AGR-K-PAR11-FLOWER-SURFACE-METHODS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "清耕法",
          "reading": "せいこうほう"
        },
        {
          "ja": "裸地",
          "reading": "らち"
        },
        {
          "ja": "草生法",
          "reading": "そうせいほう"
        },
        {
          "ja": "折衷法",
          "reading": "せっちゅうほう"
        },
        {
          "ja": "競合",
          "reading": "きょうごう"
        },
        {
          "ja": "天敵",
          "reading": "てんてき"
        }
      ],
      "activityJa": "裸地、敷いた刈草、生育中の牧草という三つの地面の記録を、それぞれ管理法に対応させます。草生法については養水分、病害虫、天敵の三欄を作り、判断の前に確認する点を短文で書いてください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
