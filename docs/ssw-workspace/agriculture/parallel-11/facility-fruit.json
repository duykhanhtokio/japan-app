  "lessons": [
    {
      "id": "agr-par11-facility-heat-cover-installation",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "1"
      ],
      "titleJa": "保温を材料・層・設置方法で整理する",
      "objectiveJa": "被覆の保温効果を枚数と材質から比較し、気密性、固定内張り、可動カーテン、温室内トンネルを区別する。",
      "paragraphs": [
        {
          "id": "agr-par11-facility-heat-cover-installation-p1",
          "titleJa": "冷やす装置と熱を保つ被覆",
          "textJa": "1号資料では、夏の高温時に冷房装置で温度を下げる場合があると説明しています。一方、保温は被覆などで熱を保つ考え方です。換気や冷房と、保温のための被覆を、同じ向きに温度を変える方法として並べないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR11-FACILITY-HEAT-COVER-INSTALLATION-01"
          ]
        },
        {
          "id": "agr-par11-facility-heat-cover-installation-p2",
          "titleJa": "枚数と材質を分けて比べる",
          "textJa": "被覆による保温効果には、材料の種類と重ねる枚数が関わります。資料は、同じ資材なら枚数が多いほど保温効果が高いとしています。違う材料を比べる場合まで、枚数だけで優劣を決める説明へ広げません。",
          "knowledgeIds": [
            "AGR-K-PAR11-FACILITY-HEAT-COVER-INSTALLATION-02"
          ]
        },
        {
          "id": "agr-par11-facility-heat-cover-installation-p3",
          "titleJa": "すき間と気密性を見る",
          "textJa": "被覆を付けても、すき間があるかどうかは別の確認点です。資料は、すき間を防いで気密性を高めることも保温に効果的だとしています。材料名や枚数を記録する欄に加え、すき間の状態を確認する欄を設けると、保温に関わる条件を分けられます。",
          "knowledgeIds": [
            "AGR-K-PAR11-FACILITY-HEAT-COVER-INSTALLATION-03"
          ]
        },
        {
          "id": "agr-par11-facility-heat-cover-installation-p4",
          "titleJa": "固定する内張りの位置",
          "textJa": "内張りの一つの方法は、外張りの内側に少し間隔を取り、保温資材を固定する方式です。外側の被覆を増やすという説明ではなく、外張りと内張りの位置関係を捉えます。この資料から、間隔の具体的な寸法や全施設共通の取付け方までは決めません。",
          "knowledgeIds": [
            "AGR-K-PAR11-FACILITY-HEAT-COVER-INSTALLATION-04"
          ]
        },
        {
          "id": "agr-par11-facility-heat-cover-installation-p5",
          "titleJa": "開閉できるカーテン",
          "textJa": "もう一つの内張り方法は、開閉できる可動式のカーテンです。固定式と比べると、開け閉めできる構造である点が違います。カーテンという装置の方式と、不織布などの資材の種類を別の分類として記録し、名前だけから材質まで決めないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR11-FACILITY-HEAT-COVER-INSTALLATION-05"
          ]
        },
        {
          "id": "agr-par11-facility-heat-cover-installation-p6",
          "titleJa": "温室の中に作るトンネル",
          "textJa": "資料には、温室内に一重又は二重のトンネルを設ける方法も示されています。温室全体を覆う外張り、内側のカーテン、株の周囲のトンネルは位置が異なります。何重かを説明するときは、どの部分を数えたのかも伝え、必要な枚数や温度設定を一律に処方する説明にはしません。",
          "knowledgeIds": [
            "AGR-K-PAR11-FACILITY-HEAT-COVER-INSTALLATION-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "気密性",
          "reading": "きみつせい"
        },
        {
          "ja": "固定式",
          "reading": "こていしき"
        },
        {
          "ja": "可動式",
          "reading": "かどうしき"
        },
        {
          "ja": "保温",
          "reading": "ほおん"
        }
      ],
      "activityJa": "外張り、固定内張り、可動カーテン、温室内トンネルを文字で配置します。同じ資材の枚数を比べる場合と、材質が違う場合を分け、すき間の確認も加えて説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
