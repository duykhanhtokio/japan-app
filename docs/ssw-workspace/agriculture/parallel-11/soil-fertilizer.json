{
  "schemaVersion": 1,
  "owner": "agri_2_soil_fertilizer",
  "status": "candidate_ai_authored_not_integrated",
  "lessons": [
    {
      "id": "agr-par11-soil-clay-percentage",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "粘土の割合から土性表の行を選ぶ",
      "objectiveJa": "両資料で一致する五つの粘土割合の範囲を読み、範囲内部の値と共有する境界値を区別できる。",
      "paragraphs": [
        {
          "id": "agr-par11-soil-clay-percentage-p1",
          "titleJa": "埴土は高い割合の側",
          "textJa": "両資料の土性表では、埴土の粘土割合を50.0%以上としています。例えば測定値を60%と仮定すれば、この行の範囲に入ります。ここで見ているのは粘土の割合であり、土に含まれる水の割合ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-CLAY-PERCENTAGE-01"
          ]
        },
        {
          "id": "agr-par11-soil-clay-percentage-p2",
          "titleJa": "埴壌土の二つの端",
          "textJa": "埴壌土の行に載るのは37.5～50.0%です。粘土割合40%という仮定値なら、この範囲の内部にあります。埴土と埴壌土は字が似ていますが、埴壌土の下端37.5と上端50.0を、埴土の50.0%以上という欄と分けて読みます。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-CLAY-PERCENTAGE-02"
          ]
        },
        {
          "id": "agr-par11-soil-clay-percentage-p3",
          "titleJa": "壌土は25.0～37.5%",
          "textJa": "壌土の行は、粘土割合25.0～37.5%です。例えば30%ならこの範囲の内部に入ります。土が褐色であるという観察だけでは30%という割合は得られず、土の色の記録と粘土割合の記録は別の情報です。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-CLAY-PERCENTAGE-03"
          ]
        },
        {
          "id": "agr-par11-soil-clay-percentage-p4",
          "titleJa": "砂壌土は12.5～25.0%",
          "textJa": "砂壌土の行には12.5～25.0%とあります。粘土割合15%という仮定値はこの範囲の内部です。名前に砂があっても、砂壌土を粘土の割合がゼロの土と読み替えません。表では砂土と別の行に置かれています。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-CLAY-PERCENTAGE-04"
          ]
        },
        {
          "id": "agr-par11-soil-clay-percentage-p5",
          "titleJa": "砂土の上限を読む",
          "textJa": "砂土の粘土割合は、表で12.5%以下と示されています。例えば10%という仮定値はこの欄に入ります。「以下」はその数値を含む表現です。ただし、表の隣の範囲にも12.5という端の値が載っている点は、次の比較で分けて考えます。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-CLAY-PERCENTAGE-05"
          ]
        },
        {
          "id": "agr-par11-soil-clay-percentage-p6",
          "titleJa": "内部の値と重なる端の値",
          "textJa": "表には、砂土の12.5%以下と砂壌土の12.5～25.0%のように、隣の行で同じ端の数値が現れます。25.0%、37.5%、50.0%にも同じ読み取り上の注意があります。この教材では端の扱いを勝手に未満や超へ書き替えず、行を一つ選ぶ練習には15%、30%、40%など範囲の内部の値を使います。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-CLAY-PERCENTAGE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "粘土",
          "reading": "ねんど"
        },
        {
          "ja": "埴土",
          "reading": "しょくど"
        },
        {
          "ja": "埴壌土",
          "reading": "しょくじょうど"
        },
        {
          "ja": "砂壌土",
          "reading": "さじょうど"
        },
        {
          "ja": "境界",
          "reading": "きょうかい"
        }
      ],
      "activityJa": "粘土割合が15%、30%、40%、60%という四つの仮定値を、表の行と対応させます。12.5%、25.0%、37.5%、50.0%の境界では、掲載範囲だけから一方の行を唯一の正解にしない理由も説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 16,
          "printedPage": 10
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 21,
          "printedPage": 19
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "a793f9cb98610805f1c6582c59ed7a63ce98fbce4a2d3bd1f1fba8a6dfae9501"
    },
    {
      "id": "agr-par11-soil-handtest-profile",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "握った状態と土層の説明を別々に記録する",
      "objectiveJa": "簡易握り試験の三状態を土性群へ対応させ、褐色低地土の層の範囲と灰色低地土の分布条件を別の記録として説明できる。",
      "paragraphs": [
        {
          "id": "agr-par11-soil-handtest-profile-p1",
          "titleJa": "まとまらない場合の対応",
          "textJa": "簡易な握り試験の図では、握ってもまとまりができない状態に、砂土から砂壌土という土性群が対応しています。まとまりがないという観察から、この二つのどちらか一つだけを確定したり、粘土割合の正確な数値を決めたりする説明ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-HANDTEST-PROFILE-01"
          ]
        },
        {
          "id": "agr-par11-soil-handtest-profile-p2",
          "titleJa": "少しまとまり割れ目がある場合",
          "textJa": "少しまとまるものの、ひびが入る状態には、壌土から埴壌土という対応が示されています。「まとまった」という一言で終えず、割れ目があるかも記録します。握ってもまとまらない状態と、十分にまとまりが保たれる状態の間にある例として比べます。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-HANDTEST-PROFILE-02"
          ]
        },
        {
          "id": "agr-par11-soil-handtest-profile-p3",
          "titleJa": "まとまりが保たれる場合",
          "textJa": "握った土が固まりとして保たれる例の土性名は、埴土です。割れ目のある小さなまとまりを、同じ埴土の例としてまとめないようにします。これらは掲載図による簡易な見分け方で、精密な粘土割合の測定とは別です。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-HANDTEST-PROFILE-03"
          ]
        },
        {
          "id": "agr-par11-soil-handtest-profile-p4",
          "titleJa": "褐色低地土では層の広がりも読む",
          "textJa": "褐色低地土の説明には、黄褐色という色だけでなく、全層またはほぼ全層がその色の土層だという範囲が付いています。表面に黄褐色の部分を一か所見ただけの記録と、土層全体についての説明を区別します。源資料の分布例は沖積低地の自然堤防などで、畑への利用も示されています。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-HANDTEST-PROFILE-04"
          ]
        },
        {
          "id": "agr-par11-soil-handtest-profile-p5",
          "titleJa": "灰色低地土の分布の条件",
          "textJa": "灰色低地土の分布には、扇状地や平野部という場所と、排水性がよいという条件が組み合わされています。灰色の土層で水田に利用されるという説明と一緒に読みます。この分布説明だけで、目の前の水田の排水状態まで良いと判定するものではありません。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-HANDTEST-PROFILE-05"
          ]
        },
        {
          "id": "agr-par11-soil-handtest-profile-p6",
          "titleJa": "二種類の観察を混ぜない報告",
          "textJa": "例えば「握ると少しまとまり、割れ目があった」という報告なら、簡易試験の対応は壌土～埴壌土です。一方、「土層の全体が黄褐色」という記録は、褐色低地土の説明と比べる情報です。握り方の結果を色の記録へ置き換えたり、黄褐色だから握り試験の一群が決まると考えたりせず、手触りと土層・地形を別欄に残します。",
          "knowledgeIds": [
            "AGR-K-PAR11-SOIL-HANDTEST-PROFILE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "土性",
          "reading": "どせい"
        },
        {
          "ja": "土層",
          "reading": "どそう"
        },
        {
          "ja": "褐色低地土",
          "reading": "かっしょくていちど"
        },
        {
          "ja": "灰色低地土",
          "reading": "はいいろていちど"
        },
        {
          "ja": "扇状地",
          "reading": "せんじょうち"
        }
      ],
      "activityJa": "握ってもまとまらない場合、少しまとまって割れ目がある場合、まとまりが保たれる場合を、それぞれ土性群へ対応させます。別欄に褐色低地土の層の範囲と灰色低地土の分布条件を書き、手触りだけで土壌群を確定しない報告文を作ってください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
