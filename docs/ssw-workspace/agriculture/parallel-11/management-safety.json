          "printedPage": 41
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "9253ae77428ab4eceab3ea9762efd71f8347a05e6d21efcae784874000ee63bf"
    },
    {
      "id": "agr-par11-management-physical-controls",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "光・粘着・熱で抑える方法の違い",
      "objectiveJa": "2号資料の物理的防除の具体例について、反射・照明・誘引捕殺・熱・周辺植栽の働きと対象を区別できる。",
      "paragraphs": [
        {
          "id": "agr-par11-management-physical-controls-p1",
          "titleJa": "反射する光を使う例",
          "textJa": "2号資料は、虫が光へ寄ったり光を避けたりする性質の利用を説明し、反射テープによるアブラムシの抑制を挙げています。1号にもアブラムシと反射テープの組合せがあります。粘着させて捕らえる説明とは分け、光を反射させる資材の例として覚えます。設置の高さや間隔までは、この例から決めません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-PHYSICAL-CONTROLS-01"
          ]
        },
        {
          "id": "agr-par11-management-physical-controls-p2",
          "titleJa": "黄色の灯りは捕獲材ではない",
          "textJa": "黄色灯について、1号は害虫を防ぐ方法として挙げ、2号はオオタバコガやハスモンヨトウなどの夜行性のガを抑える例を示しています。灯りを点ける方法と、粘着面へ虫を付ける方法は別です。黄色という共通点だけで、黄色灯の対象や働きを黄色の粘着材へそのまま移しません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-PHYSICAL-CONTROLS-02",
            "AGR-K-PAR11-MANAGEMENT-PHYSICAL-CONTROLS-03"
          ]
        },
        {
          "id": "agr-par11-management-physical-controls-p3",
          "titleJa": "黄色と青色の粘着材",
          "textJa": "粘着テープは、害虫を誘い寄せて捕らえるための資材です。2号の掲載例では、黄色はオンシツコナジラミなど、青色はスリップスなどに対応します。色と対象の組合せを区別し、全ての虫が同じ色に同じように反応するとは考えません。これは対象を整理するための例で、発生量や設置密度の基準ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-PHYSICAL-CONTROLS-03"
          ]
        },
        {
          "id": "agr-par11-management-physical-controls-p4",
          "titleJa": "熱を使う二つの例",
          "textJa": "2号資料には、病害虫を抑える物理的な手段として、太陽熱と温水がそれぞれ挙がっています。光の反射、粘着による捕獲とは異なり、熱を利用する例として区別します。両者を同じ作業手順へまとめたり、必要な温度や処理時間を推測したりしません。具体的な条件を確かめずに処理を始めるための説明ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-PHYSICAL-CONTROLS-04"
          ]
        },
        {
          "id": "agr-par11-management-physical-controls-p5",
          "titleJa": "周囲に植えるバリアープランツ",
          "textJa": "2号は、畑作で麦や牧草などを圃場や作物の周囲に植えると、アブラムシ類の発生が少なくなるという例を示し、バリアープランツと呼んでいます。虫を粘着面で捕らえる仕組みや、光を反射するテープとは区別します。あらゆる植物を周囲に植えれば全害虫を防げる、という意味には広げません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-PHYSICAL-CONTROLS-05"
          ]
        },
        {
          "id": "agr-par11-management-physical-controls-p6",
          "titleJa": "同じ防除でも働きは異なる",
          "textJa": "例を説明するときは、「何を使うか」「どの対象が示されるか」「何によって抑えるか」を組にします。アブラムシと反射テープ、夜行性のガと黄色灯、オンシツコナジラミと黄色粘着材のように整理すれば、見た色だけで方法を取り違えにくくなります。対象と働きの理解を、資材の設置条件や製品の使用条件を確認したことに置き換えないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-PHYSICAL-CONTROLS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "物理的防除",
          "reading": "ぶつりてきぼうじょ"
        },
        {
          "ja": "反射",
          "reading": "はんしゃ"
        },
        {
          "ja": "誘殺",
          "reading": "ゆうさつ"
        },
        {
          "ja": "夜行性",
          "reading": "やこうせい"
        }
      ],
      "activityJa": "反射テープ、黄色灯、黄色・青色の粘着材、太陽熱・温水、バリアープランツを、対象と働きで分類します。「黄色だから同じ方法」という記録を、具体例を用いて訂正してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
