  "lessons": [
    {
      "id": "agr-par11-management-film-effects",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "フィルムの色・構造と働きを読む",
      "objectiveJa": "マルチ用フィルムの地温・雑草・反射への働きと、穴の有無による雨水の通り方を区別できる。",
      "paragraphs": [
        {
          "id": "agr-par11-management-film-effects-p1",
          "titleJa": "比較の範囲を付けて読む",
          "textJa": "両資料の色別比較では、透明フィルムは地温を上げる効果が最も高い位置にあります。「高い」という印象だけでなく、この表の中での順位として読みます。全ての資材や気象条件を調べた結果という意味へ広げず、地温の上昇量や栽培に適する温度までは、この順位から決めません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-FILM-EFFECTS-01"
          ]
        },
        {
          "id": "agr-par11-management-film-effects-p2",
          "titleJa": "緑色には二つの項目がある",
          "textJa": "緑色フィルムについては、地温を上げる働きが透明と黒色の中間にあることに加え、雑草を抑える働きも記載されています。地温だけを記録すると、もう一方の目的を落としてしまいます。中間という比較が掛かるのは地温への働きであり、雑草抑制の強さまで同じ順位と読み替えません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-FILM-EFFECTS-02"
          ]
        },
        {
          "id": "agr-par11-management-film-effects-p3",
          "titleJa": "銀色の三つの目的を分ける",
          "textJa": "シルバーの欄には、地温上昇の抑制、病害虫防除、果実の着色という三つの働きが並びます。光を反射するという性質と関連付けつつ、土の温度、病害虫、果実の色を別々の観察項目にします。この欄だけで、全ての病害虫に同じ効果があることや、被害が必ずなくなることを保証するものではありません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-FILM-EFFECTS-03"
          ]
        },
        {
          "id": "agr-par11-management-film-effects-p4",
          "titleJa": "白黒二層は構造も読む",
          "textJa": "白と黒を組み合わせた二層フィルムは、資料では地温の上昇を抑えるものとして挙げられています。「黒が入っているから雑草対策だけ」と色の一部分で判断せず、二層という構造と掲載された目的を合わせて説明します。この記述は、どちらの面を上にするかという設置手順を示すものではありません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-FILM-EFFECTS-04"
          ]
        },
        {
          "id": "agr-par11-management-film-effects-p5",
          "titleJa": "穴の有無と雨水を分ける",
          "textJa": "植え付け穴のあるものを有孔フィルムといいます。資料は、有孔のものを除くフィルムについて、雨水が土壌へ浸透するのを妨げると説明しています。「どのフィルムでも雨水が同じように土へ入る」とまとめず、穴の有無という条件を残します。有孔であれば必要な水が必ず足りる、とまでは判断できません。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-FILM-EFFECTS-05"
          ]
        },
        {
          "id": "agr-par11-management-film-effects-p6",
          "titleJa": "目的と条件を並べて整理する",
          "textJa": "フィルムを比べる記録では、地温を上げるか上昇を抑えるか、雑草を抑えるか、反射を利用するかを分け、雨水については穴の有無も添えます。例えば、緑色の記録には地温と雑草の二項目、シルバーの記録には三つの掲載目的を残せます。一つの長所だけで資材を決めず、実際の栽培条件に合うかは別に確認します。",
          "knowledgeIds": [
            "AGR-K-PAR11-MANAGEMENT-FILM-EFFECTS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "有孔フィルム",
          "reading": "ゆうこうふぃるむ"
        },
        {
          "ja": "地温",
          "reading": "ちおん"
        },
        {
          "ja": "二層",
          "reading": "にそう"
        },
        {
          "ja": "浸透",
          "reading": "しんとう"
        }
      ],
      "activityJa": "透明・緑色・シルバー・白黒二層について、地温への働きと追加の目的を別欄に書きます。次に、雨水の入り方を比べる記録へ必要な構造条件を加え、資料からは決められない設置手順を区別してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 33,
          "printedPage": 27
        },
        {
          "documentId": "AGR-S2",
