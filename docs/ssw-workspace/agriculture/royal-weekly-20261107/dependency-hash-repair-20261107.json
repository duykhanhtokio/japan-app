  "affectedQuestions": [
    {
      "id": "agr-1-m03-q02",
      "objectiveId": "AGR-ASSESS-20261031-A-002",
      "topicJa": "果樹栽培作業",
      "stemJa": "図の果実名として適切なのはどれですか。赤い皮に縦の筋と、上のくぼみに軸が見えます。",
      "optionsJa": [
        "ウンシュウミカン。",
        "カキ。",
        "リンゴ。",
        "モモ。"
      ],
      "correctIndex": 2,
      "optionReasonsJa": [
        "細かな油胞のある橙色の皮と異なります。",
        "大きなへたの付いた外観ではありません。",
        "赤い皮・軸・丸い形が対応します。",
        "毛のある皮や中央の割れ目とは違います。"
