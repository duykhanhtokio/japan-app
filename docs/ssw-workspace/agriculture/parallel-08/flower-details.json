  "lessons": [
    {
      "id": "agr-flower-details-table-examples",
      "revision": "v1",
      "chapter": "花き栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "花きの分類表で追加の品目を照合する",
      "objectiveJa": "分類表の追加例を使い、品目名と資料上の欄を対応させられる。",
      "paragraphs": [
        {
          "id": "agr-flower-details-table-examples-p1",
          "titleJa": "非耐寒性の追加例",
          "textJa": "分類表では、ペチュニアとニチニチソウも非耐寒性一年草の例です。最初に学んだサルビアだけを覚えるのでなく、別の品目名でも同じ欄を探す練習をします。この欄の名称から、具体的な最低温度を補ってはいけません。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-TABLE-EXAMPLES-01"
          ]
        },
        {
          "id": "agr-flower-details-table-examples-p2",
          "titleJa": "耐寒性の欄を広げて読む",
          "textJa": "スイートピーとスターチスは、資料の耐寒性一年草の欄に置かれています。ペチュニアの欄と隣り合っていても同じ区分ではありません。品目名を受け取ったら、寒さへの性質の欄まで戻って照合します。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-TABLE-EXAMPLES-02"
          ]
        },
        {
          "id": "agr-flower-details-table-examples-p3",
          "titleJa": "二年草の別の品目",
          "textJa": "ビジョナデシコは、ジギタリスやカンパニュラとともに二年草の例として載っています。名前に含まれる語だけで一年草の欄へ移さず、資料にある区分を記録します。これは実際の栽培年数や開花日を確定する作業とは異なります。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-TABLE-EXAMPLES-03"
          ]
        },
        {
          "id": "agr-flower-details-table-examples-p4",
          "titleJa": "宿根草の残る例を見る",
          "textJa": "宿根草の欄には、リンドウやシャクヤクもあります。切り花として利用するかどうかと、表の園芸的な区分は別の観点です。品目名と区分を対応させた後、出荷形態についての記録を別に作ると混同を防げます。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-TABLE-EXAMPLES-04"
          ]
        },
        {
          "id": "agr-flower-details-table-examples-p5",
          "titleJa": "ランの欄を照合する",
          "textJa": "ファレノプシスは洋ラン、エビネランは東洋ランの例として示されています。同じラン類でも、資料では二つの欄に分かれています。この対応を学ぶ際は、花色や鉢の大きさを分類の代わりに使わないようにします。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-TABLE-EXAMPLES-05"
          ]
        },
        {
          "id": "agr-flower-details-table-examples-p6",
          "titleJa": "観葉植物の内側の区分",
          "textJa": "観葉植物では、クロトンは木本類、ポトスは草本類の欄にあります。どちらも観葉植物という利用上のまとまりに入りながら、表の内側では別の欄になる例です。ここでの照合結果を、未確認の全品種の性質へ広げないでください。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-TABLE-EXAMPLES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "品目",
          "reading": "ひんもく"
        },
        {
          "ja": "木本類",
          "reading": "もくほんるい"
        },
        {
          "ja": "草本類",
          "reading": "そうほんるい"
        },
        {
          "ja": "洋ラン",
          "reading": "ようらん"
        },
        {
          "ja": "東洋ラン",
          "reading": "とうようらん"
        }
      ],
      "activityJa": "ペチュニア、スターチス、ビジョナデシコ、シャクヤク、ファレノプシス、ポトスを資料上の欄へ対応させます。分類の照合ができたことと、実物を識別できたことは分けて記録してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 124,
          "printedPage": 122
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 125,
          "printedPage": 123
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "4e62602c5fb58534fa99340ae5c4ba24f7abf9e2658d7e6be0e2f4d88e11bcb9"
    },
    {
      "id": "agr-flower-details-economic-rows",
      "revision": "v1",
      "chapter": "花き栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "切り花の費用・価格・労力を行ごとに比べる",
      "objectiveJa": "相対的な費用・価格・労力の組合せを読み、価格だけから利益を推定しない比較ができる。",
      "paragraphs": [
        {
          "id": "agr-flower-details-economic-rows-p1",
          "titleJa": "高低は別々の項目",
          "textJa": "切り花の経営比較は、種苗費、市場価格、栽培に必要な労力を別々に示しています。「高い」が何の欄を指すのかを先に確認しましょう。価格の評価を、そのまま費用や労力の評価へ写さない読み方が必要です。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-ECONOMIC-ROWS-01"
          ]
        },
        {
          "id": "agr-flower-details-economic-rows-p2",
          "titleJa": "安い種苗費でも労力は多い例",
          "textJa": "一・二年草の欄では、種苗費と市場価格は安い側ですが、労力は多い側です。種苗を安く準備できるという情報と、作業の負担が小さいという情報は一致しません。両方の欄を残して比較します。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-ECONOMIC-ROWS-02"
          ]
        },
        {
          "id": "agr-flower-details-economic-rows-p3",
          "titleJa": "宿根草の二つのやや高い",
          "textJa": "宿根草は、種苗費と市場価格がともにやや高い側で、労力は多い側に置かれています。「やや」を省いて最も高い区分と同じにせず、表が示す相対的な違いを保ちます。高低の語から具体的な円の額は計算できません。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-ECONOMIC-ROWS-03"
          ]
        },
        {
          "id": "agr-flower-details-economic-rows-p4",
          "titleJa": "球根類は種苗費と労力が逆方向",
          "textJa": "球根類では種苗費は高い側、市場価格はやや高い側、労力は少ない側です。種苗費が高いから作業も多い、と一つの欄から他を決めないようにします。購入負担と作業負担を分けて説明する例になります。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-ECONOMIC-ROWS-04"
          ]
        },
        {
          "id": "agr-flower-details-economic-rows-p5",
          "titleJa": "花木・枝ものは労力をさらに分ける",
          "textJa": "花木・枝ものの行は、種苗費が高い側、市場価格がやや高い側です。一方、労力はバラが多い側、その他が少ない側と分かれます。行の見出しが共通でも、その中の品目による違いを読み落とさないことが大切です。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-ECONOMIC-ROWS-05"
          ]
        },
        {
          "id": "agr-flower-details-economic-rows-p6",
          "titleJa": "相対表から利益を引き算しない",
          "textJa": "球根類と宿根草は、ともに市場価格がやや高い側でも、種苗費と労力の欄は同じではありません。比較表の語だけでは販売額や総費用が分からず、利益額は求められません。現在の取引を計画するには、具体的な費用や販売条件を別に確認します。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-ECONOMIC-ROWS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "種苗費",
          "reading": "しゅびょうひ"
        },
        {
          "ja": "市場価格",
          "reading": "しじょうかかく"
        },
        {
          "ja": "労力",
          "reading": "ろうりょく"
        },
        {
          "ja": "相対的",
          "reading": "そうたいてき"
        },
        {
          "ja": "総費用",
          "reading": "そうひよう"
        }
      ],
      "activityJa": "一・二年草、宿根草、球根類について種苗費・市場価格・労力の三項目を短文で比較します。次に花木・枝もののバラとその他で労力欄がどう違うか説明し、金額計算に不足する情報を挙げてください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 125,
          "printedPage": 123
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "1ad06032a2e0ac9686f7ff5de53a676dac99432bf23ca15315a46ba8d02b63cd"
    },
    {
      "id": "agr-flower-details-seasonal-examples",
      "revision": "v1",
      "chapter": "花き栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "季節表の追加品目と地面の被覆を読み分ける",
      "objectiveJa": "追加の花壇用草花を資料の利用時期へ対応させ、秋と夏から秋などの幅を区別できる。",
      "paragraphs": [
        {
          "id": "agr-flower-details-seasonal-examples-p1",
          "titleJa": "秋冬から春の追加例",
          "textJa": "デージーやハボタンは、秋・冬から春の花壇に利用する欄にあります。春という語だけを抜き出して春限定の欄へ移すと、資料の期間の幅を失います。表の左側の時期も品目名と一緒に記録します。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-SEASONAL-EXAMPLES-01"
          ]
        },
        {
          "id": "agr-flower-details-seasonal-examples-p2",
          "titleJa": "春の欄にある品目",
          "textJa": "リナリアとラナンキュラスは、春の花壇に利用する例です。デージーの欄と春の時期は重なりますが、表の区分は同一ではありません。利用例の期間と、実際にいつ植えるかという作業日は分けて扱います。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-SEASONAL-EXAMPLES-02"
          ]
        },
        {
          "id": "agr-flower-details-seasonal-examples-p3",
          "titleJa": "春から夏へ続く欄",
          "textJa": "デルフィニウムとロベリアは、春から夏の欄に置かれています。資料上の期間を残して紹介し、花名を知っていることだけで春限定と省略しないようにします。地域や品種ごとの具体的な開花日は、この欄からは決まりません。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-SEASONAL-EXAMPLES-03"
          ]
        },
        {
          "id": "agr-flower-details-seasonal-examples-p4",
          "titleJa": "春から秋の幅を持つ例",
          "textJa": "ジニアとアゲラタムは、春から秋に利用する欄の例です。春から夏の欄と終わりの季節が違います。作業メモで両方を単に「春の花」とまとめると比較ができなくなるため、終わりの季節まで書きます。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-SEASONAL-EXAMPLES-04"
          ]
        },
        {
          "id": "agr-flower-details-seasonal-examples-p5",
          "titleJa": "夏から秋と秋を区別する",
          "textJa": "ハナスベリヒユとメランポディウムは夏から秋、秋ギクとスプレーギクは秋の欄です。秋が共通していても、利用時期の始まりが異なります。ここで示すのは資料上の例であり、全地域で同じ開花日を保証するものではありません。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-SEASONAL-EXAMPLES-05"
          ]
        },
        {
          "id": "agr-flower-details-seasonal-examples-p6",
          "titleJa": "這いビャクシンの利用目的",
          "textJa": "這いビャクシンは、資料のグランドカバープランツの例の一つです。樹木の根元などを覆い、表土の流出を抑えたり景観を整えたりする目的と結び付けます。季節の花壇の例を覚える仕事と、地面を覆う場所と目的を考える仕事を分けましょう。",
          "knowledgeIds": [
            "AGR-K-FLOWER-DETAILS-SEASONAL-EXAMPLES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "利用時期",
          "reading": "りようじき"
        },
        {
          "ja": "花壇",
          "reading": "かだん"
        },
        {
          "ja": "秋ギク",
          "reading": "あきぎく"
        },
        {
          "ja": "表土",
          "reading": "ひょうど"
        },
        {
          "ja": "這いビャクシン",
          "reading": "はいびゃくしん"
        }
      ],
      "activityJa": "デージー、リナリア、ロベリア、ジニア、メランポディウム、秋ギクについて、資料の利用時期を順に説明します。最後に這いビャクシンの利用目的を述べ、これらの例から全国共通の植え付け日は作らないでください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 127,
          "printedPage": 125
        }
      ],
