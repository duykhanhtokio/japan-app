    {
      "id": "agr-management-detail-cooling-curing",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "冷却方式と傷口を保護する処理",
      "objectiveJa": "冷風冷却と真空冷却の仕組み・保冷との関係を比較し、キュアリングを冷却と区別できる。",
      "paragraphs": [
        {
          "id": "agr-management-detail-cooling-curing-p1",
          "titleJa": "冷気を通す経路が違う",
          "textJa": "2号資料の冷風冷却には、庫内で冷たい空気を循環させる強制通風と、容器の通気孔へ冷気を通す差圧通風があります。どちらも風を使いますが、庫内の空気の流れと、容器を通過する流れを同じ説明にまとめないようにします。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COOLING-CURING-01"
          ]
        },
        {
          "id": "agr-management-detail-cooling-curing-p2",
          "titleJa": "冷やす役割と保つ役割",
          "textJa": "冷風冷却の設備は、資料では保冷庫としても使えると説明されています。予冷で温度を下げることと、その後に冷たさを維持することは別の役割です。冷却が終わったという記録だけで、次の保管条件まで確認したことにはなりません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COOLING-CURING-02"
          ]
        },
        {
          "id": "agr-management-detail-cooling-curing-p3",
          "titleJa": "真空冷却は水分の蒸発を利用する",
          "textJa": "真空冷却では、装置内に置いた野菜の水分が蒸発するときに熱を奪う仕組みを利用します。2号資料は冷却にかかる時間が短い一方、別に保冷庫が必要だとしています。短時間で冷えることと、その装置だけで保冷を続けられることを区別します。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COOLING-CURING-03"
          ]
        },
        {
          "id": "agr-management-detail-cooling-curing-p4",
          "titleJa": "果実なら何でも同じではない",
          "textJa": "水分が抜けにくい果実は、2号資料では真空冷却に向かない対象として示されています。短時間という利点だけで方式を選ばず、収穫物から水分が抜ける性質との関係を考えます。全品目に共通の温度や運転時間は、この説明から決められません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COOLING-CURING-04"
          ]
        },
        {
          "id": "agr-management-detail-cooling-curing-p5",
          "titleJa": "傷口に層を作るキュアリング",
          "textJa": "キュアリングは、収穫などでできた傷口にコルク層を形成させ、腐敗を防ぐための処理です。収穫物を冷やす予冷と同じ作業名ではありません。温度を下げたという記録を、そのまま傷口の保護が進んだ記録に読み替えないようにします。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COOLING-CURING-05"
          ]
        },
        {
          "id": "agr-management-detail-cooling-curing-p6",
          "titleJa": "乾燥と湿度の条件を取り違えない",
          "textJa": "キュアリングの例では、サツマイモや花の球根には高温多湿、カボチャには常温乾燥という異なる条件が示されています。「収穫後だから全て低温」や「同じ湿度でよい」とは整理できません。この授業は具体的な温度、湿度、日数を処方するものではありません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COOLING-CURING-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "強制通風",
          "reading": "きょうせいつうふう"
        },
        {
          "ja": "差圧通風",
          "reading": "さあつつうふう"
        },
        {
          "ja": "真空冷却",
          "reading": "しんくうれいきゃく"
        },
        {
          "ja": "保冷庫",
          "reading": "ほれいこ"
        },
        {
          "ja": "コルク層",
          "reading": "こるくそう"
        }
      ],
      "activityJa": "強制通風、差圧通風、真空冷却について、利用する流れや現象と保冷の扱いを表にします。別にキュアリングの目的を書き、サツマイモ・花の球根とカボチャの条件を取り違えた記録を訂正してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
