  "lessons": [
    {
      "id": "agr-management-detail-staged-thinning",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "生理落果を見ながら進める摘果",
      "objectiveJa": "予備摘果から仕上げ摘果への順序を説明し、隔年結果への対応と葉果比の読み方を区別できる。",
      "paragraphs": [
        {
          "id": "agr-management-detail-staged-thinning-p1",
          "titleJa": "自然に落ちる時期を見込む",
          "textJa": "果樹では、生理落果が続く間に行う予備摘果と、その後の仕上げ摘果を分けて考えます。2号資料の予備摘果は、やや多めに果実を残す段階です。最初の作業で最終的な数へ必ず合わせるという説明ではありません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-STAGED-THINNING-01"
          ]
        },
        {
          "id": "agr-management-detail-staged-thinning-p2",
          "titleJa": "仕上げる前に段階を確かめる",
          "textJa": "本摘果は、資料では仕上げ摘果とも呼ばれます。生理落果が終わった後に行う流れを、予備摘果より後に置きます。暦の日付だけで順序を覚えず、自然に果実が落ちる段階との関係を説明できるようにします。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-STAGED-THINNING-02"
          ]
        },
        {
          "id": "agr-management-detail-staged-thinning-p3",
          "titleJa": "今年だけでなく年ごとに比べる",
          "textJa": "隔年結果は、果実が多い年と少ない年が一年おきに現れることです。同じ年の樹ごとの違いや、一日の収穫量の違いを指す言葉ではありません。年を並べた記録から、結実量の変化を読むための用語です。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-STAGED-THINNING-03"
          ]
        },
        {
          "id": "agr-management-detail-staged-thinning-p4",
          "titleJa": "果実より前の段階にも働きかける",
          "textJa": "2号資料は、カンキツ類やカキで隔年結果が起こりやすいとし、その防止に摘蕾・摘花・摘果を挙げています。調整の対象は、すでに育った果実だけではありません。ただし、どれか一回の作業で翌年の収量まで保証できるとはしません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-STAGED-THINNING-04"
          ]
        },
        {
          "id": "agr-management-detail-staged-thinning-p5",
          "titleJa": "葉の数は何に対する数か",
          "textJa": "葉果比を読むときは、果実一個に対応する葉の数なのか、ブドウなどの一房に対応する数なのかを確かめます。2号資料の表題も一果と一房を分けており、果粒一個と房全体を同じ単位として扱うと意味が変わります。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-STAGED-THINNING-05"
          ]
        },
        {
          "id": "agr-management-detail-staged-thinning-p6",
          "titleJa": "樹種と単位を外して使わない",
          "textJa": "資料の葉数の表は、リンゴ、ナシ、ブドウの品種などを別々の行で示しています。一つの行の値を全ての果樹へ広げたり、葉を数えることだけで摘果を終えたりしません。この授業は共通の数値基準や作業日、薬剤の使用条件を定めません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-STAGED-THINNING-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "生理落果",
          "reading": "せいりらっか"
        },
        {
          "ja": "予備摘果",
          "reading": "よびてきか"
        },
        {
          "ja": "本摘果",
          "reading": "ほんてきか"
        },
        {
          "ja": "隔年結果",
          "reading": "かくねんけっか"
        },
        {
          "ja": "葉果比",
          "reading": "ようかひ"
        }
      ],
      "activityJa": "生理落果、予備摘果、本摘果の関係を時間軸で整理します。果実一個と一房の二つの欄を作り、葉果比の数値だけを写した記録に何が足りないか説明しましょう。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 37,
          "printedPage": 35
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "3d29c9699fe5ff0d4280e8043aed5550b22661ca99cea114934810113cc53a99"
    },
    {
      "id": "agr-management-detail-compatibility",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "花粉が付いた後に必要な条件",
      "objectiveJa": "自家不和合性と受精の関係を説明し、資料の作物例と単為結果を混同せず整理できる。",
      "paragraphs": [
        {
          "id": "agr-management-detail-compatibility-p1",
          "titleJa": "受粉の記録だけでは判断しない",
          "textJa": "2号資料は、柱頭に花粉が付く段階と、その後の受精を分けています。受粉作業を済ませた記録があっても、それだけで受精まで確認したことにはなりません。花粉を届ける作業と、結実につながる条件を分けて考えます。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COMPATIBILITY-01"
          ]
        },
        {
          "id": "agr-management-detail-compatibility-p2",
          "titleJa": "同じ花粉で受精できない性質",
          "textJa": "自家不和合性は、同じ品種や同じ花の花粉が柱頭に付いても受精しない性質として説明されています。単に花粉が付かなかった状態とは違います。花粉の量を増やすことだけを、品種の組合せに関する問題の解決と考えないようにします。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COMPATIBILITY-02"
          ]
        },
        {
          "id": "agr-management-detail-compatibility-p3",
          "titleJa": "品種を分けて記録する理由",
          "textJa": "この性質を持つ作物で結実を目指す場合、資料は複数品種の花粉の必要性を示しています。花粉を運ぶ人や昆虫の確保とは別に、花粉を得る品種を確かめる必要があるということです。異なる品種なら全ての組合せでよい、とは読み取りません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COMPATIBILITY-03"
          ]
        },
        {
          "id": "agr-management-detail-compatibility-p4",
          "titleJa": "果樹の例として読む",
          "textJa": "2号資料は、自家不和合性に関係する果樹の例としてリンゴ、ナシ、ウメ、クリを挙げています。これは学習用の例の整理であり、個々の品種の性質や受粉樹の具体的な組合せを、この一覧だけで決めるものではありません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COMPATIBILITY-04"
          ]
        },
        {
          "id": "agr-management-detail-compatibility-p5",
          "titleJa": "果樹だけの用語ではない",
          "textJa": "同じ説明には、キャベツなどのアブラナ科野菜や、キク、カーネーション、ペチュニアも載っています。果樹で習った用語として閉じず、資料が複数の作物群を挙げていることを確認します。花粉を扱う目的や具体的な栽培方法まで同じとは限りません。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COMPATIBILITY-05"
          ]
        },
        {
          "id": "agr-management-detail-compatibility-p6",
          "titleJa": "単為結果という別の道筋",
          "textJa": "単為結果は、受精を経ずに果実ができる現象です。2号資料の例にはウンシュウミカン、パイナップル、バナナ、イチジク、キュウリがあります。自家不和合性によって受精しないことと、その作物で受精なしに果実が育つことを、一つの性質として扱わないようにします。",
          "knowledgeIds": [
            "AGR-K-MANAGEMENT-DETAIL-COMPATIBILITY-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "自家不和合性",
          "reading": "じかふわごうせい"
        },
        {
          "ja": "受精",
          "reading": "じゅせい"
        },
        {
          "ja": "結実",
          "reading": "けつじつ"
        },
        {
          "ja": "単為結果",
          "reading": "たんいけっか"
        }
      ],
      "activityJa": "「花粉が届いていない」「花粉は届いたが同じ品種では受精しない性質がある」「受精を経ずに果実が育つ」の三つを区別します。異なる品種という情報だけでは、具体的な組合せを確定できない理由も述べましょう。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 37,
          "printedPage": 35
        },
