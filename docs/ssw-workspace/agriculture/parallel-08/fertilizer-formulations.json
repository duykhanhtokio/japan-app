  "lessons": [
    {
      "id": "agr-fertilizer-example-names",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1"
      ],
      "titleJa": "肥料の名前を分類表に対応させる",
      "objectiveJa": "単肥・化成肥料・配合肥料の具体名を資料の分類に対応させ、名前と形状・施用量を混同せずに読める。",
      "paragraphs": [
        {
          "id": "agr-fertilizer-example-names-p1",
          "titleJa": "窒素肥料の別名",
          "textJa": "1号資料の単肥の欄では、窒素肥料に硫安・尿素・硝安が挙げられています。硫安には硫酸アンモニウムという別の呼び方も付いています。別名を別の肥料として数えず、同じ名称の対応として整理します。",
          "knowledgeIds": [
            "AGR-K-FERTILIZER-EXAMPLE-NAMES-01"
          ]
        },
        {
          "id": "agr-fertilizer-example-names-p2",
          "titleJa": "リン酸肥料の具体名",
          "textJa": "過リン酸石灰と熔性リン肥は、資料ではリン酸肥料の例です。「石灰」という文字が含まれていても、表のどの見出しに置かれているかを確かめます。名前の一部分だけを見て、別の分類欄へ移さないようにします。",
          "knowledgeIds": [
            "AGR-K-FERTILIZER-EXAMPLE-NAMES-02"
          ]
        },
        {
          "id": "agr-fertilizer-example-names-p3",
          "titleJa": "加里という表記を読む",
          "textJa": "硫酸加里と塩化加里は、資料の加里肥料の例です。二つの名前に共通する「加里」と、異なる前半部分を分けて読みます。似た名前でも同じ製品と決めず、ここでは分類表の例として対応させます。",
          "knowledgeIds": [
            "AGR-K-FERTILIZER-EXAMPLE-NAMES-03"
          ]
        },
        {
          "id": "agr-fertilizer-example-names-p4",
          "titleJa": "化成肥料の例を見つける",
          "textJa": "化成肥料の欄には、燐硝安加里・燐加安・硫加燐安・塩化燐安・NK化成・PK化成が並んでいます。資料に挙げられた名称を、単肥の具体名とは別の欄に置きます。この一覧だけでは、それぞれの成分割合までは分かりません。",
          "knowledgeIds": [
            "AGR-K-FERTILIZER-EXAMPLE-NAMES-04"
          ]
        },
        {
          "id": "agr-fertilizer-example-names-p5",
          "titleJa": "配合肥料の例を見つける",
          "textJa": "BB肥料と有機入り配合肥料は、配合肥料の例として示されています。「有機入り」という文字を見ただけで、有機質肥料の欄と同じものにまとめません。資料では、原料の特徴と分類上の位置を併せて読む必要があります。",
          "knowledgeIds": [
            "AGR-K-FERTILIZER-EXAMPLE-NAMES-05"
          ]
        },
        {
          "id": "agr-fertilizer-example-names-p6",
          "titleJa": "名称の照合と使用判断を分ける",
          "textJa": "例えば「硫安」と書いた名札を見つけたら、硫酸アンモニウムとの対応と窒素肥料の欄を確認できます。ただし、名称を照合できたことだけで、目の前の作物に使う量や時期まで決まったとはいえません。名前の学習と現場の施肥判断を分けて記録します。",
          "knowledgeIds": [
            "AGR-K-FERTILIZER-EXAMPLE-NAMES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "硫安",
          "reading": "りゅうあん"
        },
        {
          "ja": "尿素",
          "reading": "にょうそ"
        },
        {
          "ja": "硝安",
          "reading": "しょうあん"
        },
        {
          "ja": "過リン酸石灰",
          "reading": "かりんさんせっかい"
        },
        {
          "ja": "熔性リン肥",
          "reading": "ようせいりんぴ"
        },
        {
          "ja": "配合肥料",
          "reading": "はいごうひりょう"
        }
      ],
      "activityJa": "資料の具体名を窒素肥料・リン酸肥料・加里肥料・化成肥料・配合肥料の欄へ分けます。硫安の別名も書き、名称の一覧だけでは決められない成分割合や施用量は別の未確認欄に残します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 24,
          "printedPage": 18
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "29cad1cc13ce47d39b76394209d0adcc7acbb0b56a473e81fd432fe665d2d774"
    },
    {
      "id": "agr-amendment-labels-2",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "土壌改良材の名称と写真ラベル",
      "objectiveJa": "2号資料の土壌改良材の一覧と写真のラベルを区別し、見た目だけで資材や使い方を確定しない。",
      "paragraphs": [
        {
          "id": "agr-amendment-labels-2-p1",
          "titleJa": "改良する性質を捉える",
          "textJa": "2号資料は、土壌改良材を、土の物理的性質・化学的性質・微生物相を改善するものとして説明しています。単に肥料成分を追加するという一つの目的に狭めず、どの性質について述べているかを整理します。",
          "knowledgeIds": [
            "AGR-K-AMENDMENT-LABELS-2-01"
          ]
        },
        {
          "id": "agr-amendment-labels-2-p2",
          "titleJa": "一覧にある名称",
          "textJa": "本文の例には、ピートモス・パーライト・バーミキュライト・木炭・ゼオライト・腐植質資材・石灰があります。これは土壌改良材の名称を学ぶ一覧です。名前が同じ欄にあることを、同じ量で交換できるという意味にはしません。",
          "knowledgeIds": [
            "AGR-K-AMENDMENT-LABELS-2-02"
          ]
        },
        {
          "id": "agr-amendment-labels-2-p3",
          "titleJa": "写真の六つのラベル",
          "textJa": "写真には、ピートモス・パーライト・赤玉土・腐葉土・くん炭・バーミキュライトというラベルが付いています。本文の一覧と写真のラベルは完全に同じ並びではありません。写真に付いた名称と、本文で例示された名称を別々に照合します。",
          "knowledgeIds": [
            "AGR-K-AMENDMENT-LABELS-2-03"
          ]
        },
        {
          "id": "agr-amendment-labels-2-p4",
          "titleJa": "本文と写真の範囲を区別する",
          "textJa": "例えば、ゼオライトは本文の一覧にあり、赤玉土は写真のラベルにあります。本文に名前があることを、そのページで同名の写真も示されているという意味に変えません。どこで確認した名前かを記録すると、見ていない写真を見たとする誤りを避けられます。",
          "knowledgeIds": [
            "AGR-K-AMENDMENT-LABELS-2-04"
          ]
        },
        {
          "id": "agr-amendment-labels-2-p5",
          "titleJa": "似た見た目に頼りすぎない",
          "textJa": "掲載写真では、白い粒や茶色い粒、黒っぽい資材などの見え方を比べられます。ただし、色や粒の大きさだけで、現場にある資材を同じものと断定する練習にはしません。ここでは写真のラベルとの対応を確認し、実物の識別には表示などの追加情報を残します。",
          "knowledgeIds": [
            "AGR-K-AMENDMENT-LABELS-2-05"
          ]
        },
        {
          "id": "agr-amendment-labels-2-p6",
          "titleJa": "名称の学習を施用指示にしない",
          "textJa": "写真から名称を探す課題と、栽培に使う資材や量を選ぶ課題は別です。このページの写真には、すべての作物に共通する配合比や施用量は示されていません。学習記録には確認した名称と未確認の使用条件を分けて書きます。",
          "knowledgeIds": [
            "AGR-K-AMENDMENT-LABELS-2-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "土壌改良材",
          "reading": "どじょうかいりょうざい"
        },
        {
          "ja": "微生物相",
          "reading": "びせいぶつそう"
        },
        {
          "ja": "赤玉土",
          "reading": "あかだまつち"
        },
        {
          "ja": "腐葉土",
          "reading": "ふようど"
        },
        {
          "ja": "くん炭",
          "reading": "くんたん"
        }
      ],
      "activityJa": "本文の一覧と写真のラベルを二つの欄に書き分けます。両方にある名前と片方だけの名前を確認し、色だけで実物を確定したり、未確認の配合比を付け加えたりしないようにします。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 32,
          "printedPage": 30
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "4c3be53c804a52c1a1bfdb765bf06f021110609a2f26556e92d6c8b96accd35d"
    },
    {
      "id": "agr-pesticide-formulation-reading-2",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "農薬の剤型表を三つの欄で読む",
      "objectiveJa": "商品の形状、水を加えた場合の表の記述、成分が水に溶けるかを分けて読み、調製の指示に置き換えない。",
      "paragraphs": [
        {
          "id": "agr-pesticide-formulation-reading-2-p1",
          "titleJa": "剤型と商品の形状",
          "textJa": "2号資料の剤型表は、商品の形状と、水を加えた場合の状態を別々に示しています。同じ液体の形状にも液剤・乳剤・フロアブル剤があり、形状が同じだから同じ剤型とは限りません。まず剤型名と元の形状を対応させます。",
          "knowledgeIds": [
            "AGR-K-PESTICIDE-FORMULATION-READING-2-01"
          ]
        },
        {
          "id": "agr-pesticide-formulation-reading-2-p2",
          "titleJa": "液体でも表の説明は異なる",
          "textJa": "液剤については、水を加えたときの状態が透明で、成分が水に溶けると示されています。一方、乳剤とフロアブル剤は濁る状態で、成分は水に溶けないと説明されています。水に加えるという表現だけを、成分が水に溶けることと同じ意味にしません。",
          "knowledgeIds": [
            "AGR-K-PESTICIDE-FORMULATION-READING-2-02"
          ]
        },
        {
          "id": "agr-pesticide-formulation-reading-2-p3",
          "titleJa": "粉末状の二つの違い",
          "textJa": "水溶剤と水和剤は、どちらも商品の形状が粉末状です。しかし表では、水溶剤は透明で成分が水に溶け、水和剤は濁って成分は水に溶けないとされています。元の形が粉末という共通点と、水を加えた後の違いを分けて読みます。",
          "knowledgeIds": [
            "AGR-K-PESTICIDE-FORMULATION-READING-2-03"
          ]
        },
        {
          "id": "agr-pesticide-formulation-reading-2-p4",
          "titleJa": "ドライフロアブル剤の欄",
          "textJa": "ドライフロアブル剤も、資料の表では粉末状の区分に置かれています。水を加えたときは濁り、成分は水に溶けないという説明です。「ドライ」という名称だけから、水に加えた場合の状態や、成分の溶け方を推測しません。",
          "knowledgeIds": [
            "AGR-K-PESTICIDE-FORMULATION-READING-2-04"
          ]
        },
        {
          "id": "agr-pesticide-formulation-reading-2-p5",
          "titleJa": "そのまま使用する区分",
          "textJa": "資料の表では、粉剤・粒剤と油剤が、そのまま使用する区分にあります。前者は粉末状・粒状、後者は液体として示されています。すべての液体が水を加える区分に入るわけではないことを、油剤と液剤の欄を比べて確認します。",
          "knowledgeIds": [
            "AGR-K-PESTICIDE-FORMULATION-READING-2-05"
          ]
        },
        {
          "id": "agr-pesticide-formulation-reading-2-p6",
          "titleJa": "表の読み取りと実際の調製",
          "textJa": "例えば粉末状の見本名が二つあるとき、元の形だけでは水溶剤か水和剤かを決められません。剤型名と表の説明を併せて記録します。この学習は分類表を読む練習であり、製品を混ぜる順序・希釈倍率・使用量を決める手順ではありません。",
          "knowledgeIds": [
            "AGR-K-PESTICIDE-FORMULATION-READING-2-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "剤型",
          "reading": "ざいけい"
        },
        {
          "ja": "液剤",
          "reading": "えきざい"
        },
        {
          "ja": "乳剤",
          "reading": "にゅうざい"
        },
        {
          "ja": "水溶剤",
          "reading": "すいようざい"
        },
        {
          "ja": "水和剤",
          "reading": "すいわざい"
        },
        {
          "ja": "油剤",
          "reading": "ゆざい"
        }
      ],
      "activityJa": "液剤・乳剤・フロアブル剤・水溶剤・水和剤・ドライフロアブル剤・粉剤・粒剤・油剤を、商品の形状と表にある水を加えた後の状態に分けて整理します。表にない調製順序や倍率は補わず、分類上の違いだけを説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 48,
          "printedPage": 46
        }
      ],
