  "lessons": [
    {
      "id": "agr-soil-detail-rotation-intervals-2",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "再作付けまでの年数を条件付きで読む",
      "objectiveJa": "作物別の再作付け間隔を資料の目安として整理し、土壌・気候による違いと安全保証との違いを説明できる。",
      "paragraphs": [
        {
          "id": "agr-soil-detail-rotation-intervals-2-p1",
          "titleJa": "年数の意味を先に確かめる",
          "textJa": "2号資料の年数は、同じ野菜を再び植えるまでの間隔の目安です。植えてから収穫するまでの日数ではありません。土壌や気候の状況で異なるという条件と一緒に読み、年数だけを独立した規則にしないようにします。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-ROTATION-INTERVALS-2-01"
          ]
        },
        {
          "id": "agr-soil-detail-rotation-intervals-2-p2",
          "titleJa": "比較的長い間隔の例",
          "textJa": "ショウガやゴボウには4～5年という目安が示されています。作付け記録を調べるときは、作物名と年を対応させます。この範囲は、どの土地でも同じ年数が経過すれば障害がなくなるという保証ではありません。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-ROTATION-INTERVALS-2-02"
          ]
        },
        {
          "id": "agr-soil-detail-rotation-intervals-2-p3",
          "titleJa": "3～4年のまとまり",
          "textJa": "トマト、ナス、ピーマン、サトイモは、資料では3～4年の群です。前の群と同じ年数にまとめず、作物名を確かめて記録します。収量が下がった原因を、この間隔の情報だけで確定することはできません。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-ROTATION-INTERVALS-2-03"
          ]
        },
        {
          "id": "agr-soil-detail-rotation-intervals-2-p4",
          "titleJa": "2～3年と1～2年を区別する",
          "textJa": "キュウリ、スイカ、ジャガイモ、ハクサイには2～3年、ダイコン、ニンジン、ホウレンソウには1～2年という目安があります。似た作物名や栽培場所だけで群を取り違えず、資料に載る組合せを読み比べます。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-ROTATION-INTERVALS-2-04"
          ]
        },
        {
          "id": "agr-soil-detail-rotation-intervals-2-p5",
          "titleJa": "連作可能という説明の範囲",
          "textJa": "資料はトウモロコシ、カボチャ、サツマイモを連作可能な例として挙げています。これは、病害虫や養分の問題が一切起こらないという意味に広げません。前作や生育の記録を省いてよい理由にもなりません。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-ROTATION-INTERVALS-2-05"
          ]
        },
        {
          "id": "agr-soil-detail-rotation-intervals-2-p6",
          "titleJa": "記録を使う練習",
          "textJa": "例えば同じ畑で次にトマトを植える案を読むときは、前回のトマトの作付け年を記録から探し、資料の3～4年という目安と照らし合わせます。土壌や気候の違いを残したまま整理し、この比較だけで作付けの安全を決定しないことが大切です。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-ROTATION-INTERVALS-2-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "再作付け",
          "reading": "さいさくづけ"
        },
        {
          "ja": "目安",
          "reading": "めやす"
        },
        {
          "ja": "間隔",
          "reading": "かんかく"
        },
        {
          "ja": "連作",
          "reading": "れんさく"
        }
      ],
      "activityJa": "資料の四つの年数群と連作可能の例を表にし、各行に作物名を入れます。最後に、土壌・気候によって異なるという条件を添えて説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 27,
          "printedPage": 25
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "20759d5f3f8a7017594dcb2bcfdf25550570a8d047ad086b8d9ba0cfbac42eb9"
    },
    {
      "id": "agr-soil-detail-crop-ph-table",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "作物名とpHの範囲を照合する",
      "objectiveJa": "共通資料の作物別pH表を正確に読み、範囲が重なることと同じ範囲であることを区別できる。",
      "paragraphs": [
        {
          "id": "agr-soil-detail-crop-ph-table-p1",
          "titleJa": "同じ表でも目標は一つではない",
          "textJa": "作物別のpH表は、作物ごとに適する酸度の範囲を比べるためのものです。ここでは両資料に共通する表を使います。酸性土などの分類境界を決める表とは分け、数値をそのまま石灰の施用量にも置き換えません。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-CROP-PH-TABLE-01"
          ]
        },
        {
          "id": "agr-soil-detail-crop-ph-table-p2",
          "titleJa": "6.0～7.0の作物をまとめる",
          "textJa": "ダイコン、キャベツ、トマトはpH6.0～7.0の行にあります。三つの作物名を同じ行の範囲と結び付けて読みます。トマトだけ別の範囲を割り当てたり、下限と上限を逆にしたりしないようにします。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-CROP-PH-TABLE-02"
          ]
        },
        {
          "id": "agr-soil-detail-crop-ph-table-p3",
          "titleJa": "ナスとレタスの範囲",
          "textJa": "ナスとレタスの行はpH6.0～6.5です。前の行と下限は同じですが、上限は違います。下限だけ見て「ダイコンと全く同じ範囲」とまとめず、両端をそろえて比較します。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-CROP-PH-TABLE-03"
          ]
        },
        {
          "id": "agr-soil-detail-crop-ph-table-p4",
          "titleJa": "5.5～6.5の三作物",
          "textJa": "イチゴ、タマネギ、ニンジンはpH5.5～6.5の行です。ナスやレタスと上限が同じでも、下限は一致しません。表を写す練習では、作物名と二つの端の値を一組として確かめます。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-CROP-PH-TABLE-04"
          ]
        },
        {
          "id": "agr-soil-detail-crop-ph-table-p5",
          "titleJa": "二つのイモ類を区別する",
          "textJa": "サツマイモはpH5.5～6.0、ジャガイモはpH5.0～6.5と示されています。名前にイモが含まれていても同じ行ではありません。サツマイモの範囲はジャガイモの範囲の内側にありますが、二つの範囲が等しいわけではありません。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-CROP-PH-TABLE-05"
          ]
        },
        {
          "id": "agr-soil-detail-crop-ph-table-p6",
          "titleJa": "重なりを読む例",
          "textJa": "例えばpH6.2という値は、表のダイコン、ナス、ニンジン、ジャガイモの各範囲に入ります。一方、サツマイモの行の上限6.0は超えています。これは表の読み取り例であり、この値だけで畑全体の適否や土壌改良の方法まで決まるものではありません。",
          "knowledgeIds": [
            "AGR-K-SOIL-DETAIL-CROP-PH-TABLE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "土壌pH",
          "reading": "どじょうピーエイチ"
        },
        {
          "ja": "上限",
          "reading": "じょうげん"
        },
        {
          "ja": "下限",
          "reading": "かげん"
        },
        {
          "ja": "範囲",
          "reading": "はんい"
        }
      ],
      "activityJa": "ダイコン、ナス、ニンジン、サツマイモ、ジャガイモの範囲を書き、共通する端の値と異なる端の値を説明します。pH6.2が各範囲に入るかも表から確認してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 19,
          "printedPage": 13
        },
