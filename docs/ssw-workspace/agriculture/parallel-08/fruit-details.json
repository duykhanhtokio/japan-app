    },
    {
      "id": "agr-fruit-detail-harvest-calendar",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "六つの果樹の収穫期を資料から比較する",
      "objectiveJa": "収穫期表の六行と上旬・中旬・下旬を読み、作物名や期間を取り違えずに資料の例として説明できる。",
      "paragraphs": [
        {
          "id": "agr-fruit-detail-harvest-calendar-p1",
          "titleJa": "モモから始まる収穫期の読み方",
          "textJa": "両資料の表では、モモの期間を6月下旬～8月下旬としています。始まりと終わりを一組で読み、6月全体から8月全体までと広げないようにします。この表を読むことと、個別の園地で実際の収穫日を決めることは分けます。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-HARVEST-CALENDAR-01"
          ]
        },
        {
          "id": "agr-fruit-detail-harvest-calendar-p2",
          "titleJa": "ブドウは夏から秋へまたがる",
          "textJa": "ブドウの行は8月中旬～10月上旬です。モモと終わりの月を入れ替えると、資料が示す期間ではなくなります。引継ぎメモでは、ブドウという名前に加え、8月の中旬から10月の上旬までという両端を残します。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-HARVEST-CALENDAR-02"
          ]
        },
        {
          "id": "agr-fruit-detail-harvest-calendar-p3",
          "titleJa": "リンゴの始まりと終わり",
          "textJa": "リンゴの行には9月上旬～11月中旬とあります。ブドウより表の開始時期は後で、終了時期も後に位置します。ただし、この表の期間の順序から、一つ一つの果実の熟度や収穫可否まで判断することはできません。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-HARVEST-CALENDAR-03"
          ]
        },
        {
          "id": "agr-fruit-detail-harvest-calendar-p4",
          "titleJa": "ナシという行名の違い",
          "textJa": "1号資料の表はナシ、2号資料の対応する表はニホンナシと記し、どちらも8月中旬～11月下旬を示しています。表の行名も記録し、収穫後の追熟の例に挙がるセイヨウナシへ、この期間をそのまま当てはめないようにします。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-HARVEST-CALENDAR-04"
          ]
        },
        {
          "id": "agr-fruit-detail-harvest-calendar-p5",
          "titleJa": "カキは秋から冬の初めまで",
          "textJa": "カキの期間は9月下旬～12月上旬です。表では、リンゴより開始は後ですが、終わりも後まで続きます。9月に始まるという共通点だけでリンゴと同じ期間にまとめず、上旬と下旬の違いまで読み取ります。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-HARVEST-CALENDAR-05"
          ]
        },
        {
          "id": "agr-fruit-detail-harvest-calendar-p6",
          "titleJa": "ウンシュウミカンは開始が異なる",
          "textJa": "ウンシュウミカンは10月中旬～12月上旬です。カキと終わりは同じ表現でも、開始は約一か月後の別の旬になります。これらは資料に示す収穫期の幅であり、その月に入れば全果実を収穫できるという判定基準ではありません。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-HARVEST-CALENDAR-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "上旬",
          "reading": "じょうじゅん"
        },
        {
          "ja": "中旬",
          "reading": "ちゅうじゅん"
        },
        {
          "ja": "下旬",
          "reading": "げじゅん"
        },
        {
          "ja": "収穫期",
          "reading": "しゅうかくき"
        }
      ],
      "activityJa": "資料の六樹種を、収穫期の開始時期の順に並べ、開始が同じものと終了が同じものを探します。期間の両端を読み上げた後、実際の熟度を確認する情報と表の月を区別して説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 91,
          "printedPage": 85
        },
        {
