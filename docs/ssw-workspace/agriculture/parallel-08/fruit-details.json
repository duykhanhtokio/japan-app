  "lessons": [
    {
      "id": "agr-fruit-detail-ph-columns",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "果樹のpH表を二つの範囲で読む",
      "objectiveJa": "1号資料の九樹種について、適する範囲と最も生育がよい範囲を区別し、数値を出典とともに読み取れる。",
      "paragraphs": [
        {
          "id": "agr-fruit-detail-ph-columns-p1",
          "titleJa": "二つの列を混ぜない",
          "textJa": "1号資料のpH表には、栽培に適する幅と、その中でも生育が最もよい幅が別々にあります。ウンシュウミカンなら、前者は4.2～7.0、後者は5.4～6.3です。幅広い方の端まで、全てが最適だという意味にはしません。ここでは1号資料の数値を読む練習として扱います。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-COLUMNS-01"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-columns-p2",
          "titleJa": "リンゴとカキの共通点と差",
          "textJa": "リンゴは適する幅が4.6～7.1、最もよい幅が5.5～6.6です。カキはそれぞれ4.5～7.0と5.5～6.6になっています。最もよい幅が同じでも、もう一方の上限と下限まで同一だとは限らないことが分かります。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-COLUMNS-02"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-columns-p3",
          "titleJa": "ナシとモモは列を替えると違う",
          "textJa": "ニホンナシとモモは、適する幅だけを読むとどちらも4.3～6.7です。一方、最もよい幅はニホンナシが5.3～6.2、モモが4.8～5.9です。樹種名と列の見出しを一組にして答えれば、同じ数字があることによる取り違えを防げます。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-COLUMNS-03"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-columns-p4",
          "titleJa": "ブドウとイチジクを比較する",
          "textJa": "ブドウの適する幅は5.0～7.9で、最もよい幅は6.1～7.4です。イチジクは適する幅が5.5～7.5、最もよい幅が6.1～7.2です。両者の最もよい幅は下端が同じですが、上端は異なります。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-COLUMNS-04"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-columns-p5",
          "titleJa": "クリとビワの数値を対応させる",
          "textJa": "クリでは、適する幅4.1～6.1に対して、最もよい幅は4.6～5.5です。ビワでは、適する幅4.3～6.5に対して、最もよい幅は5.1～6.0です。表から記録するときは、幅だけを書かず、クリかビワか、どちらの列かも残します。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-COLUMNS-05"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-columns-p6",
          "titleJa": "資料の値と園地の調整を分ける",
          "textJa": "2号資料の樹種別の表にも、この九樹種の適する幅が載っていますが、1号資料の最もよい幅の列はありません。片方の見出しをもう片方へ付け替えず、参照した資料を明示します。また、これらの範囲だけで石灰の量や園地の一律の設定値は決めません。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-COLUMNS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "土壌酸度",
          "reading": "どじょうさんど"
        },
        {
          "ja": "適範囲",
          "reading": "てきはんい"
        },
        {
          "ja": "上限",
          "reading": "じょうげん"
        },
        {
          "ja": "下限",
          "reading": "かげん"
        }
      ],
      "activityJa": "リンゴ、ニホンナシ、モモについて、1号資料の適する幅と最もよい幅を別々に記録します。ナシとモモの共通点と相違点を列ごとに説明し、この表だけでは石灰の施用量を決められないことも確認してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 93,
          "printedPage": 87
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 117,
          "printedPage": 115
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "614ec51ed0c201c1c89549c8abb19b29bac4fd9cb046c27b1dd15271eded19f6"
    },
    {
      "id": "agr-fruit-detail-ph-groups-2",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "2号のpH概略区分と樹種別の幅",
      "objectiveJa": "2号に加わるブルーベリーの数値と三つの概略区分を読み、樹種別の適範囲を概略値で上書きしない。",
      "paragraphs": [
        {
          "id": "agr-fruit-detail-ph-groups-2-p1",
          "titleJa": "ブルーベリーの行を見付ける",
          "textJa": "2号資料の樹種別の表には、ブルーベリーの適する幅としてpH4.0～5.0が載っています。この行は1号資料の同じ表にはありません。クリの行の数値を代わりに使わず、ブルーベリーという樹種に結び付けて記録します。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-GROUPS-2-01"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-groups-2-p2",
          "titleJa": "酸性域を好む組合せ",
          "textJa": "2号資料の別枠には、酸性域を好む果樹としてクリとブルーベリーがまとめられています。そこに示すのは、おおよそpH4.0～5.0程度という区分です。樹種ごとの細かな上下限を並べる表とは、情報の細かさが違います。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-GROUPS-2-02"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-groups-2-p3",
          "titleJa": "弱酸性域の仲間",
          "textJa": "弱酸性域を好む組には、カンキツ類、リンゴ、ニホンナシ、モモ、カキが挙げられています。おおよその値はpH5.0～6.0程度です。「カンキツ類」というまとめ方にも注意し、別の表のウンシュウミカンの行と見出しまで同じだとは扱いません。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-GROUPS-2-03"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-groups-2-p4",
          "titleJa": "中性域の二樹種",
          "textJa": "ブドウとイチジクは、中性域を好む組としてpH7.0程度に対応しています。この程度という表現は、一つの大まかな区分を示します。ブドウもイチジクも、適する値が7.0だけに限られるという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-GROUPS-2-04"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-groups-2-p5",
          "titleJa": "クリで二つの表を照合する",
          "textJa": "クリの樹種別の適範囲はpH4.1～6.1ですが、概略の分類では酸性域の4.0～5.0程度という組に入っています。この二つは同じ欄の矛盾した答えとして扱わず、樹種別の幅を尋ねたのか、概略の好みを尋ねたのかを確かめます。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-GROUPS-2-05"
          ]
        },
        {
          "id": "agr-fruit-detail-ph-groups-2-p6",
          "titleJa": "数字の前に見出しを報告する",
          "textJa": "例えばブドウについて、適範囲の表を読めば5.0～7.9、概略の組を読めば中性域で7.0程度と報告します。二つを平均した新しい目標値は作りません。資料名、樹種、見出し、数値の順に伝えると、範囲と概略の取り違えを防げます。",
          "knowledgeIds": [
            "AGR-K-FRUIT-DETAIL-PH-GROUPS-2-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "酸性域",
          "reading": "さんせいいき"
        },
        {
          "ja": "弱酸性域",
          "reading": "じゃくさんせいいき"
        },
        {
          "ja": "中性域",
          "reading": "ちゅうせいいき"
        },
        {
          "ja": "樹種",
          "reading": "じゅしゅ"
        }
      ],
      "activityJa": "2号資料のクリとブドウについて、樹種別の適範囲と概略の区分を二通りずつ説明します。ブルーベリーをどの区分に置くかも答え、概略値を最適範囲や薬剤の施用量に読み替えないようにしてください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 117,
