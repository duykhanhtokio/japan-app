  "lessons": [
    {
      "id": "agr-seed-f1-fixed",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "交配で作るF1種子と固定種を区別する",
      "objectiveJa": "F1・一代雑種・雑種強勢の関係を説明し、種子の由来と加工方法を混同せずに整理できる。",
      "paragraphs": [
        {
          "id": "agr-seed-f1-fixed-p1",
          "titleJa": "F1という名前が指すもの",
          "textJa": "F1種子は一代雑種種子とも呼ばれます。F1と一代雑種を別々の種子群として数えるのではなく、同じ対象を表す二つの呼び方として結び付けます。種の袋や作業記録の表記を読むときの基礎になります。",
          "knowledgeIds": [
            "AGR-K-PAR08-SEED-F1-FIXED-01"
          ]
        },
        {
          "id": "agr-seed-f1-fixed-p2",
          "titleJa": "親となる固定種と交配",
          "textJa": "二号資料では、異なる固定種をかけ合わせてF1種子を得る仕組みが説明されています。親に使う固定種と、交配によって得られた一代目を分けて整理します。二種類の種を一つの袋に混ぜることを、交配と呼ぶのではありません。",
          "knowledgeIds": [
            "AGR-K-PAR08-SEED-F1-FIXED-02"
          ]
        },
        {
          "id": "agr-seed-f1-fixed-p3",
          "titleJa": "雑種強勢を利用する",
          "textJa": "一代雑種で両親の優れた形質が現れる現象を雑種強勢と呼び、その性質を種子の生産に利用します。「強勢」は、薬剤で種の表面を処理する作業名ではありません。また、この説明だけから全ての栽培条件で同じ成果が出ると保証することはできません。",
          "knowledgeIds": [
            "AGR-K-PAR08-SEED-F1-FIXED-03"
          ]
        },
        {
          "id": "agr-seed-f1-fixed-p4",
          "titleJa": "固定種との区別を保つ",
          "textJa": "一号資料は、固定種について親の優れた性質が引き継がれた種子として説明しています。一方、F1の説明では異なる固定種の交配と雑種強勢に注目します。「固定種も親の性質を持つからF1と同じ呼び名でよい」とまとめず、用語ごとの説明を対応させます。",
          "knowledgeIds": [
            "AGR-K-PAR08-SEED-F1-FIXED-04"
          ]
        },
        {
          "id": "agr-seed-f1-fixed-p5",
          "titleJa": "利用例と分類の限界",
          "textJa": "資料では多くの野菜にF1種子が使われると説明され、固定種の例には京野菜や加賀野菜などの地域の野菜が挙げられています。これは掲載された例です。地域名や売り場の表示だけを根拠に、目の前の全品種の育成方法を断定しないでください。",
          "knowledgeIds": [
            "AGR-K-PAR08-SEED-F1-FIXED-05"
          ]
        },
        {
          "id": "agr-seed-f1-fixed-p6",
          "titleJa": "由来と加工を別々に記録する",
          "textJa": "種子の一覧を作るなら、F1などの由来を示す欄と、コーティングなどの加工を示す欄を分けると違いを説明できます。資料でも加工した種子とF1種子は別の項目で扱われています。この授業は生物学の用語を整理するもので、採種や増殖の法的な許可を判定する授業ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR08-SEED-F1-FIXED-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "一代雑種",
          "reading": "いちだいざっしゅ"
        },
        {
          "ja": "雑種強勢",
          "reading": "ざっしゅきょうせい"
        },
        {
          "ja": "固定種",
          "reading": "こていしゅ"
        },
        {
          "ja": "形質",
          "reading": "けいしつ"
        },
        {
          "ja": "交配",
          "reading": "こうはい"
        }
      ],
      "activityJa": "F1、一代雑種、雑種強勢、固定種を、同じ呼び名・現象・親となる種の区分に整理してください。種子の由来と加工の違いも、二つの記録欄で説明しましょう。採種の許可についてはこの説明から判断しません。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 61,
          "printedPage": 55
        },
        {
          "documentId": "AGR-S2",
