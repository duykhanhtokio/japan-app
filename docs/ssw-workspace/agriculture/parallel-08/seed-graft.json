    },
    {
      "id": "agr-transplant-figure-reading",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "苗の取り出し方と植え付け姿勢を読む",
      "objectiveJa": "ポット苗とセル成型苗の図を比較し、根鉢・地表・うねの中央・傾きの確認点を区別できる。",
      "paragraphs": [
        {
          "id": "agr-transplant-figure-reading-p1",
          "titleJa": "ポットの向きと支える手",
          "textJa": "ポット苗を取り出す良い例では、苗の根元側を手で支え、ポットを逆さにしています。図の矢印は容器を外す方向を示しています。葉や茎だけを持って苗の重さを支える場面として読まないことが大切です。",
          "knowledgeIds": [
            "AGR-K-PAR08-TRANSPLANT-FIGURE-READING-01"
          ]
        },
        {
          "id": "agr-transplant-figure-reading-p2",
          "titleJa": "茎を引き上げる例との違い",
          "textJa": "もう一つの取り出し図では、ポットを置いたまま茎を上へ引く姿に不適切の印が付いています。二つの図を比べると、容器から抜ければ方法は何でもよいという説明ではないと分かります。作業確認では、何を手で支えているかも言葉にします。",
          "knowledgeIds": [
            "AGR-K-PAR08-TRANSPLANT-FIGURE-READING-02"
          ]
        },
        {
          "id": "agr-transplant-figure-reading-p3",
          "titleJa": "ポット苗の根鉢と地表",
          "textJa": "植え付けたポット苗の良い例では、根を包む土のまとまりである根鉢が土の中に入り、その上面が周囲の地表とほぼそろっています。根鉢が地表から出ている例と、深く下がって茎の下部まで土がかかる例には不適切の印があります。図には一律の深さを決める数値はありません。",
          "knowledgeIds": [
            "AGR-K-PAR08-TRANSPLANT-FIGURE-READING-03"
          ]
        },
        {
          "id": "agr-transplant-figure-reading-p4",
          "titleJa": "セル苗はうねの中央を見る",
          "textJa": "セル成型苗の図は、うねの中央に植え付ける例を適切としています。うねの端や斜面側に置く例と比べ、まず横方向の位置を確かめます。「根鉢が土に入った」という縦方向の確認だけでは、植える場所の確認は終わりません。",
          "knowledgeIds": [
            "AGR-K-PAR08-TRANSPLANT-FIGURE-READING-04"
          ]
        },
        {
          "id": "agr-transplant-figure-reading-p5",
          "titleJa": "セル苗の深さの比較",
          "textJa": "セル成型苗の深さを比べる段では、やや深植えの例が良いとされ、根鉢の上が出るような浅植えは不適切とされています。ポット苗の段とセル苗の段を取り違えず、それぞれの図で根鉢と地表の位置を見ます。作物を問わず同じ深さにするという数値規則にはしません。",
          "knowledgeIds": [
            "AGR-K-PAR08-TRANSPLANT-FIGURE-READING-05"
          ]
        },
        {
          "id": "agr-transplant-figure-reading-p6",
          "titleJa": "傾きと確認順序",
          "textJa": "セル成型苗の斜め植えにも不適切の印が付いています。例えば苗を植える図を点検するなら、うねのどこか、深さはどうか、苗が傾いていないかを別々に確認します。この教材は掲載図の読み取りであり、作物別の実作業の深さや使用器具を新たに指定するものではありません。",
          "knowledgeIds": [
            "AGR-K-PAR08-TRANSPLANT-FIGURE-READING-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "根鉢",
          "reading": "ねばち"
        },
        {
          "ja": "定植",
          "reading": "ていしょく"
        },
        {
          "ja": "浅植え",
          "reading": "あさうえ"
        },
        {
          "ja": "深植え",
          "reading": "ふかうえ"
        },
        {
          "ja": "斜め植え",
          "reading": "ななめうえ"
        }
      ],
      "activityJa": "容器から取り出す場面と、植え付け後の場面を分けて説明してください。セル苗では位置・深さ・傾きの三項目を順番に確認し、図にないセンチメートル値を付け足さないようにします。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 14,
          "printedPage": 8
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 17,
          "printedPage": 15
        }
      ],
      "humanReviewed": false,
