    {
      "id": "agr-f40-flower-add-machine-extension2",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "移動散布と昇降機能の掲載説明を読む",
      "objectiveJa": "SSの移動しながら液状薬剤をまく説明と、高所作業機の自走・昇降機能を、実機の安全条件とは分けて記録できる。",
      "paragraphs": [
        {
          "id": "agr-f40-flower-add-machine-extension2-p1",
          "titleJa": "SSの移動と液状薬剤",
          "textJa": "2号資料はスピードスプレーヤーについて、液状の薬剤を噴霧しながら移動して散布する機械と説明しています。既習の大型タンクやファンという構成に加え、液状薬剤と移動という情報も残します。この説明から、散布量、走行速度、散布できる高さや、周囲への飛散がないことを決めません。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-ADD-MACHINE-EXTENSION2-01"
          ]
        },
        {
          "id": "agr-f40-flower-add-machine-extension2-p2",
          "titleJa": "高所作業機の自走と昇降",
          "textJa": "同じ資料の高所作業機には、自走する機械で、2m以上の高さへ昇降できる機能があると説明されています。自走という移動の情報と、台が昇降する機能を別の欄にします。「2m以上」は資料内の機能説明であり、どの機械でもその高さで安全に作業できるという保証ではありません。実機の仕様、作業条件や必要な資格は別に確認します。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-ADD-MACHINE-EXTENSION2-02"
          ]
        }
      ],
      "terms": [
        {
          "ja": "液状",
          "reading": "えきじょう"
        },
        {
          "ja": "噴霧",
          "reading": "ふんむ"
        },
        {
          "ja": "自走",
          "reading": "じそう"
        },
        {
          "ja": "昇降",
          "reading": "しょうこう"
        }
      ],
      "activityJa": "SSの説明を「扱うもの・移動」の二欄へ、高所作業機の説明を「移動・昇降機能」の二欄へ記録します。資料の記述だけでは決められない実機の条件も分けて書きます。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
