{
  "schemaVersion": 1,
  "lessons": [
    {
      "id": "agr-f40-flower-add-orchard-base",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "酸性土壌の改良方向と機械の用途を読む",
      "objectiveJa": "資料の酸性土壌と石灰資材の関係、果樹機械の五つの用途を、作業量や機械操作の条件とは分けて説明できる。",
      "paragraphs": [
        {
          "id": "agr-f40-flower-add-orchard-base-p1",
          "titleJa": "酸性土壌と石灰資材の調整方向",
          "textJa": "両資料は、日本に酸性の土壌が多いことと、アルカリ性の石灰質資材などでpHを調整することを結び付けています。酸性に偏った状態を改良し、pHを高める側への調整として理解します。ただし、作物ごとの適する範囲と現場の測定が必要です。この方向を読めたことだけで、石灰の量や全園地に共通する目標値を決めることはできません。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-ADD-ORCHARD-BASE-01"
          ]
        },
        {
          "id": "agr-f40-flower-add-orchard-base-p2",
          "titleJa": "果樹機械の用途を五つに分ける",
          "textJa": "果樹に使う農業機械の用途として、資料は土を耕すこと、薬剤をまくこと、除草、結実管理、運搬を挙げています。例えば「薬剤散布」と「運搬」は、同じ機械を動かす仕事でも目的の欄が異なります。名称の一覧を整理するときは、何の仕事に使う機械かを先に記し、実機の操作条件や乗車の可否とは別に確認します。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-ADD-ORCHARD-BASE-02"
          ]
        }
      ],
      "terms": [
        {
          "ja": "酸性土壌",
          "reading": "さんせいどじょう"
        },
        {
          "ja": "石灰質資材",
          "reading": "せっかいしつしざい"
        },
        {
          "ja": "結実管理",
          "reading": "けつじつかんり"
        },
        {
          "ja": "運搬",
          "reading": "うんぱん"
        }
      ],
      "activityJa": "酸性土壌の説明に調整方向を書き添え、施用量は未確認と区別します。次に五つの用途欄を作り、果樹機械の掲載例を、操作条件と混ぜずに整理します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 92,
