{
  "schemaVersion": 1,
  "lessons": [
    {
      "id": "agr-f40-flower-examples",
      "revision": "v1",
      "chapter": "花き栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "花きの追加例と出荷容器を照合する",
      "objectiveJa": "未整理の分類名・利用時期・出荷容器を資料の欄へ対応させ、実物の識別や栽培日程とは分けて説明できる。",
      "paragraphs": [
        {
          "id": "agr-f40-flower-examples-p1",
          "titleJa": "多肉植物・サボテン類の追加例",
          "textJa": "2号資料の多肉植物・サボテン類の欄には、リュウゼツラン、ウチワサボテン、タマサボテン、ハナキリンもあります。四つの名前をこのまとまりへ対応させます。これは表の掲載名の整理であり、全てをサボテンと呼び替えたり、写真の識別点や水やりの条件を補ったりはしません。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-EXAMPLES-01"
          ]
        },
        {
          "id": "agr-f40-flower-examples-p2",
          "titleJa": "観葉植物の草本類の追加例",
          "textJa": "観葉植物の草本類には、アナナス類とディフェンバギアも載っています。観葉植物という見出しと、その中の草本類という欄を一緒に残します。鉢の大きさや茎の見た目だけで区分を決めず、この欄から全品種の管理温度を指定しないようにします。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-EXAMPLES-02"
          ]
        },
        {
          "id": "agr-f40-flower-examples-p3",
          "titleJa": "切り花を詰める容器",
          "textJa": "切り花の輸送には、段ボール箱などへ詰めて出荷する例が示されています。束をフィルムなどで包む工程と、出荷する容器へ詰める工程は分けて記録します。容器名だけでは低温管理の実施を確認できず、箱の寸法や詰める本数もこの説明からは決まりません。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-EXAMPLES-03"
          ]
        },
        {
          "id": "agr-f40-flower-examples-p4",
          "titleJa": "秋・冬から春の追加例",
          "textJa": "資料の秋・冬から春に花壇へ利用する欄には、クリサンセマム、プリムラポリアンサ、プリムラマラコイデス、クリスマスローズもあります。品目名と期間の幅を一組にします。これは掲載された利用例で、全地域での開花日や植付け日を保証するものではありません。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-EXAMPLES-04"
          ]
        },
        {
          "id": "agr-f40-flower-examples-p5",
          "titleJa": "春から夏の追加例",
          "textJa": "春から夏に花壇へ利用する欄の追加例は、ゼラニウム、マーガレット、ラベンダー、ジギタリス、ルピナスです。春だけの欄と混ぜず、終わりが夏であることも残して整理します。分類表にある一年草・宿根草などの区分とは、別の情報として扱います。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-EXAMPLES-05"
          ]
        },
        {
          "id": "agr-f40-flower-examples-p6",
          "titleJa": "春から秋の追加例",
          "textJa": "春から秋の欄には、サルビア、インパチェンス、ペチュニア、ベゴニアセンパフローレンスもあります。春から夏の欄と、利用例の終わる季節を比べます。この表を読めたことだけで、現場の植付け時期や、写真に写る植物の種類を確定したことにはなりません。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-EXAMPLES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "多肉植物",
          "reading": "たにくしょくぶつ"
        },
        {
          "ja": "観葉植物",
          "reading": "かんようしょくぶつ"
        },
        {
          "ja": "草本類",
          "reading": "そうほんるい"
        },
        {
          "ja": "段ボール箱",
          "reading": "だんぼーるばこ"
        }
      ],
      "activityJa": "品目名・見出し・下位区分・利用期間の欄を作り、追加例を記録します。出荷のメモでは、束の包装、箱詰め、低温管理を別々の確認項目にします。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
