      ],
      "titleJa": "出典の記述と限界を読む",
      "objectiveJa": "記載事項と、出典に書かれていない条件を区別できる。",
      "paragraphs": [
        {
          "id": "agr-f40-flower-family-label-correction-p1",
          "titleJa": "出典の記述と限界",
          "textJa": "1号写真のホウレンソウ「アカザ科」、タマネギ「ユリ科」は、写真の元ラベルとして記録します。Kewの確認済み分類では、Spinacia oleraceaはAmaranthaceae、Allium cepaはAmaryllidaceaeです。元ラベルを現在の分類として暗記せず、参照した分類体系を分けます。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-FAMILY-LABEL-CORRECTION-1"
          ]
        }
      ],
      "terms": [
        {
          "ja": "分類",
          "reading": "ぶんるい"
        }
      ],
      "activityJa": "記述、対象範囲、未記載の条件を記録します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
