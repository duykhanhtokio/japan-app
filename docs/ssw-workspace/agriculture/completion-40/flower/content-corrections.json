    {
      "id": "agr-f40-flower-terminology-corrections",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "出典の記述と限界を読む",
      "objectiveJa": "記載事項と、出典に書かれていない条件を区別できる。",
      "paragraphs": [
        {
          "id": "agr-f40-flower-terminology-corrections-p1",
          "titleJa": "出典の記述と限界",
          "textJa": "科・属・種という階級の列挙は二名法そのものではありません。植物の種名は属名と種小名の組合せです。また、資料の「イケベリア」の印字をそのまま学名にせず、確認した属名Echeveriaと対応させます。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-TERMINOLOGY-CORRECTIONS-1"
          ]
        },
        {
          "id": "agr-f40-flower-terminology-corrections-p2",
          "titleJa": "出典の記述と限界",
          "textJa": "STSは農研機構の研究情報でチオ硫酸銀錯塩と確認できますが、化学名の確認から製品の処方は決まりません。また、切り花は光合成を一切しないという絶対命題にはしません。アルストロメリア切り花の葉で光合成が測定された研究があり、光・葉の状態・経過時間などの条件を伴って考えます。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-TERMINOLOGY-CORRECTIONS-2"
          ]
        }
      ],
      "terms": [
        {
          "ja": "切り花",
