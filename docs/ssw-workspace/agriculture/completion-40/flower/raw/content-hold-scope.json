    {
      "id": "agr-f40-flower-undated-percentages",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "1"
      ],
      "titleJa": "出典の記述と限界を読む",
      "objectiveJa": "記載事項と、出典に書かれていない条件を区別できる。",
      "paragraphs": [
        {
          "id": "agr-f40-flower-undated-percentages-p1",
          "titleJa": "出典の記述と限界",
          "textJa": "1号資料の掲載値を、年が示されていない記述として読みます。栽培カンキツ内のウンシュウミカンは70%、品種例は宮川早生21%・青島温州14%・興津早生13%、リンゴはふじ52%・つがる13%・王林8%、ブドウは巨峰35%・デラウェア19%・ピオーネ16%、カキは富有25%・平核無17%・刀根早生15%、ナシは幸水40%・豊水27%・新高10%、モモはあかつき19%・白鳳16%・川中島白桃14%です。各品種の割合の年と詳しい分母は当該頁に示されていません。現在の統計や、年・指標のある2号の数値へ置き換えません。",
          "knowledgeIds": [
            "AGR-K-F40-FLOWER-UNDATED-PERCENTAGES"
          ]
        }
      ],
      "terms": [],
      "activityJa": "記述、対象範囲、未記載の条件を記録します。",
