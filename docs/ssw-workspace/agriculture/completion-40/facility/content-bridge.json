{
  "lessons": [
    {
      "id": "agr-f40-facility-level1-supplement",
      "revision": "v1",
      "chapter": "施設園芸・果樹栽培作業",
      "levels": [
        "1"
      ],
      "titleJa": "1号の追加例：施設作物と果樹管理",
      "objectiveJa": "イチゴとバラの資料例、苗の観察点、高接ぎの目的、摘果の対象と翌年への働きを説明できる。",
      "paragraphs": [
        {
          "id": "agr-f40-facility-level1-supplement-p1",
          "titleJa": "イチゴの施設栽培とランナー",
          "textJa": "1号資料は、イチゴでは施設栽培が中心と述べています。苗を増やす説明では、開花・結実が終わるとランナーが伸び、その先の子株を繁殖に使うという順序を示しています。施設の位置付けと、親株から子株を得る段階を別々に整理しましょう。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-BRIDGE-01"
          ]
        },
        {
          "id": "agr-f40-facility-level1-supplement-p2",
          "titleJa": "バラの四季咲き性",
          "textJa": "施設のバラでは、四季咲き性をもつ品種が中心と1号資料は説明しています。これは品種の開花の性質に関する記述です。施設で周年出荷するという説明と関連付けつつ、一株が絶えず同じ数の花を付けるという保証に変えません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-BRIDGE-02"
          ]
        },
        {
          "id": "agr-f40-facility-level1-supplement-p3",
          "titleJa": "窒素不足の二つの観察点",
          "textJa": "1号資料の窒素肥料不足の例には、下葉が黄色くなることと、苗の勢いが落ちることがあります。色と勢いを別の欄に書けば、どちらを見たか伝わります。ただし、この二つだけで現場の原因や追加する肥料の量を決めるものではありません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-BRIDGE-03"
          ]
        },
        {
          "id": "agr-f40-facility-level1-supplement-p4",
          "titleJa": "良い果樹苗の状態",
          "textJa": "果樹の良い苗木について、1号資料は細根がよく伸び、病虫害に侵されていないものを挙げています。根の発達と苗木自体の健全な状態を別々に確認する考え方です。抵抗性のある台木品種を知っていることだけでは、受け取った苗木そのものを調べたことにはなりません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-BRIDGE-04"
          ]
        },
        {
          "id": "agr-f40-facility-level1-supplement-p5",
          "titleJa": "高接ぎによる品種更新",
          "textJa": "高接ぎには、比較的短い期間で品種を更新する目的があると1号資料は説明しています。既存の木に別品種の枝を接ぐ方法を、新しい苗木へ植え替える改植と区別します。ここでいう短期間から、全園地で同じ年数になるとは決めません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-BRIDGE-05"
          ]
        },
        {
          "id": "agr-f40-facility-level1-supplement-p6",
          "titleJa": "摘果の目的と対象",
          "textJa": "1号資料は摘果を、良い果実を育てることと翌年の花付きをよくすることに結び付けています。対象例は、病虫害の被害や傷がある果実、発育が遅れたり変形した果実、袋をかけにくい位置の果実です。数だけでなく状態と位置を分けて整理し、実際に残す数や摘果日を一律に指定しません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-BRIDGE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "四季咲き性",
          "reading": "しきざきせい"
        },
        {
          "ja": "高接ぎ",
          "reading": "たかつぎ"
        },
        {
          "ja": "摘果",
          "reading": "てきか"
        },
        {
          "ja": "細根",
          "reading": "さいこん"
        }
      ],
      "activityJa": "イチゴの繁殖の順序とバラの開花性を分けて記します。苗の色・勢い・細根・病虫害を観察項目として整理し、高接ぎの更新目的と摘果の目的・対象を説明します。",
      "targetMinutes": 30,
