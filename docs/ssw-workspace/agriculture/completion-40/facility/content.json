{
  "lessons": [
    {
      "id": "agr-f40-facility-fruit-observation",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "苗木・枝の観察と樹形の補足",
      "objectiveJa": "根の構成と懸念される外観、車枝、不要枝の道具、追加の樹形例とわい化栽培の利点を区別して説明できる。",
      "paragraphs": [
        {
          "id": "agr-f40-facility-fruit-observation-p1",
          "titleJa": "苗木の根を太さと数で見る",
          "textJa": "細根が伸びているかという既習の観察に、2号資料は根の太さと数の比較を加えています。良い苗木の説明では、ゴボウのように太い根は少なく、細い根が多いことが挙げられます。一本の根の太さだけで評価を終えず、根全体の構成を見て記録します。この比較は、全樹種共通の根の本数や直径の基準を定めるものではありません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-01"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-observation-p2",
          "titleJa": "白いカビや膨らみを記録する",
          "textJa": "苗木に白いカビやこぶ状の膨らみが見られる場合、資料は病虫害の心配があるとしています。白い部分と膨らんだ部分を別々に記録し、根の量の記録とは分けましょう。これは注意を向けるための観察例です。その外観だけで病名や害虫名を確定したり、薬剤や処分方法を決めたりする説明ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-02"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-observation-p3",
          "titleJa": "主枝の集中する場所を確認する",
          "textJa": "主枝の配置を調べる際は、枝の数だけでなく、主幹のどの場所から出ているかも確認します。一か所に何本もの主枝が集中する形を車枝と呼び、資料は整枝でこの形を避けるよう注意しています。この名称の理解を、切る枝や切断の順番を実物で確認したことに置き換えません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-03"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-observation-p4",
          "titleJa": "不要枝の太さと道具を対応させる",
          "textJa": "不要な枝を基部から除く間引きせん定について、資料は太い枝ではのこぎり、細い枝でははさみという道具の違いを示します。切断位置が基部であることと、枝の太さによる道具の区別を組にして整理します。残す細枝を葉芽の上で切る切り返しの説明とは、目的も位置も区別します。ここから刃物の選定寸法や安全な操作手順を推測しません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-04"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-observation-p5",
          "titleJa": "樹形の追加例を整理する",
          "textJa": "2号資料の樹形の例には、変則主幹形のクリ、開心自然形のカンキツ類、棚仕立てのキウイフルーツもあります。既習の代表例だけで一覧を終えず、樹種名と仕立て方を一組で記します。同じ樹種であれば必ずこの形にするという規則ではなく、写真の見分け方や樹種別のせん定手順を示すものでもありません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-05"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-observation-p6",
          "titleJa": "低い樹高の利点を複数に分ける",
          "textJa": "わい性台木を用いて樹高を低くし、密植するわい化栽培について、2号資料は作業性の向上や早期多収に加え、農薬散布量の軽減も利点として挙げています。作業のしやすさ、収量が上がる時期、散布量という異なる項目を分けて整理しましょう。資料は一律の削減率や無農薬を保証していません。実際の製品の使用量を、この利点の説明だけで変更することはできません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "細根",
          "reading": "さいこん"
        },
        {
          "ja": "車枝",
          "reading": "くるまえだ"
        },
        {
          "ja": "間引きせん定",
          "reading": "まびきせんてい"
        },
        {
          "ja": "わい化栽培",
          "reading": "わいかさいばい"
        }
      ],
      "activityJa": "苗木の根の構成と気になる外観を別欄に記します。次に車枝の意味、不要な太枝・細枝の道具、三つの追加樹形例を整理し、わい化栽培の利点と本文だけでは決められない数値を分けて説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
