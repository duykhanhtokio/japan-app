{
  "lessons": [
    {
      "id": "agr-f40-facility-environment-equipment",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "2"
      ],
      "titleJa": "施設の散布・照明と環境管理の補足",
      "objectiveJa": "自動散布と防虫照明の目的、炭酸ガス不足と過剰、地上・地下の環境項目と夏の冷房を区別できる。",
      "paragraphs": [
        {
          "id": "agr-f40-facility-environment-equipment-p1",
          "titleJa": "自動散布装置の目的",
          "textJa": "2号資料では、施設内の自走式噴霧器などによる自動散布を、労力の削減と作業者の安全性の確保に結び付けています。省力化と安全の両目的を記録し、装置があれば農薬の使用条件や作業者の確認が不要とは考えません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-ENV-01"
          ]
        },
        {
          "id": "agr-f40-facility-environment-equipment-p2",
          "titleJa": "二つの照明名を区別する",
          "textJa": "化学農薬を使わない方法の例には、着色粘着テープと防虫照明があります。資料の黄色灯は黄色防蛾灯、青色灯は紫外線殺虫器と併記されています。粘着材の色による虫の誘引と、照明装置の名称を別に整理し、色が同じなら働きも同じとはしません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-ENV-02"
          ]
        },
        {
          "id": "agr-f40-facility-environment-equipment-p3",
          "titleJa": "不足する場面を読む",
          "textJa": "冬は日中に施設を閉め切る時間が長くなりがちです。2号資料は、このような冬期の栽培や養液栽培で炭酸ガスが不足し、光合成が抑えられて成長が悪くなる場合を挙げています。冬なら必ず不足するという断定ではなく、掲載された場面と影響の関係を読みます。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-ENV-03"
          ]
        },
        {
          "id": "agr-f40-facility-environment-equipment-p4",
          "titleJa": "過剰な炭酸ガスへの注意",
          "textJa": "資料は、過剰に供給した炭酸ガスが大気へ排出され、地球温暖化の原因物質にもなると注意しています。補給の目的を学ぶだけでなく、供給量を守る必要性も整理します。多ければ多いほどよいとはせず、この本文から機器の設定値や濃度を独自に決めません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-ENV-04"
          ]
        },
        {
          "id": "agr-f40-facility-environment-equipment-p5",
          "titleJa": "地上と地下の測定項目",
          "textJa": "施設環境の記録は、地上と地下に分けられます。資料が地上の例に挙げるのは気温・湿度・光、地下の例は地温・土壌水分・養分濃度です。気温と地温を同じ一欄にせず、何をどこで調べるかを対応させます。これは測定器の設置位置や設定値の指示ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-ENV-05"
          ]
        },
        {
          "id": "agr-f40-facility-environment-equipment-p6",
          "titleJa": "夏の冷房を換気と区別する",
          "textJa": "高温の夏には、冷房装置で施設内の温度を下げる場合もあると2号資料は述べています。窓や換気扇で空気を入れ替える換気と、冷房装置による温度低下を別の方法として記録します。冷房を挙げたことは、全施設で常時運転する指示や設定温度の保証ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-ENV-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "自走式噴霧器",
          "reading": "じそうしきふんむき"
        },
        {
          "ja": "防蛾灯",
          "reading": "ぼうがとう"
        },
        {
          "ja": "養分濃度",
          "reading": "ようぶんのうど"
        },
        {
          "ja": "地温",
          "reading": "ちおん"
        }
      ],
      "activityJa": "散布装置と照明装置の目的を別欄に整理します。炭酸ガス不足と過剰の影響を比べ、環境の六項目を地上・地下に分けて記録し、換気と冷房を別の方法として説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
