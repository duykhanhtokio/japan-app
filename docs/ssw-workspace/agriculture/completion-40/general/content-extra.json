    {
      "id": "agr-f40-general-historical-statistic-scopes",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "平成30年の図の表示と公式統計を分ける",
      "objectiveJa": "元図の金額・割合・列を、公式統計の範囲と未解決の表示差を残して読める。",
      "paragraphs": [
        {
          "id": "agr-f40-general-historical-statistic-scopes-p1",
          "titleJa": "元図の部門表示を年とともに読む",
          "textJa": "平成30年の元図の表示は、野菜23,212億円・26％、米17,416億円・19％、果実8,406億円・9％、花き3,567億円・4％、いも・豆・麦計2,976億円・3％、その他3,106億円・3％です。これらの表示割合は図の農業全体に対するものです。現在値として使ったり、確定した共通の分母から再計算した数値とみなしたりしません。",
          "knowledgeIds": [
            "AGR-K-F40-GENERAL-EXTRA-HISTORICAL-STATISTIC-SCOPES-01"
          ]
        },
        {
          "id": "agr-f40-general-historical-statistic-scopes-p2",
          "titleJa": "中心額・部門合計・別調査を照合する",
          "textJa": "元図の中心は90,558億円、表示部門を足すと90,812億円、注記に別掲される総額は92,742億円です。表示を黙ってそろえません。確認した農林水産省の平成30年の生産農業所得統計では総額90,558億円、花き3,327億円です。元図は花きに別調査を加えると説明しており、花き3,567億円と同じ範囲とは扱いません。",
          "knowledgeIds": [
            "AGR-K-F40-GENERAL-EXTRA-HISTORICAL-STATISTIC-SCOPES-02"
          ]
        },
        {
          "id": "agr-f40-general-historical-statistic-scopes-p3",
          "titleJa": "県別表の三つの列を区別する",
          "textJa": "元表を「億円／全国シェア％／県農業内％」の順で読むと、愛知543／16.3／17、千葉193／5.8／5、福岡172／5.2／8、埼玉160／5.5／9、静岡157／4.8／8です。二つの割合の分母は異なります。公式資料で五県の金額と順位は確認できましたが、元表の全国シェアには全国3,327億円との計算で整合しない表示があります。その表示を正確な割合の正解にせず、列の意味と確認済みの金額を分けます。",
          "knowledgeIds": [
            "AGR-K-F40-GENERAL-EXTRA-HISTORICAL-STATISTIC-SCOPES-03"
          ]
        }
      ],
      "terms": [
        {
          "ja": "産出額",
          "reading": "さんしゅつがく"
        }
      ],
      "activityJa": "元図の表示・公式統計・未解決の表示差を別欄にし、全国割合と県農業内割合を区別します。",
      "targetMinutes": 15,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 7,
