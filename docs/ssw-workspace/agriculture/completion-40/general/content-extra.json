  "lessons": [
    {
      "id": "agr-f40-general-qualified-variety-share",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "果樹の「7割以上」の読み取り",
      "objectiveJa": "母集団・時点が省略された割合を、掲載表現と確認事項に分けられる。",
      "paragraphs": [
        {
          "id": "agr-f40-general-qualified-variety-share-p1",
          "titleJa": "育成品種の割合と確認できない範囲",
          "textJa": "2号資料の果樹紹介には、育成品種が7割以上という表現があります。ただし、何を数えた割合か、その時点は本文に明示されていません。掲載表現として読み、現在の面積・本数・品種数の割合へ置き換えません。また、育成品種という語だけで、品種登録され権利が存続していると判断することもできません。",
          "knowledgeIds": [
            "AGR-K-F40-GENERAL-EXTRA-QUALIFIED-VARIETY-SHARE-01"
          ]
        }
      ],
      "terms": [
        {
          "ja": "母集団",
          "reading": "ぼしゅうだん"
        }
      ],
      "activityJa": "割合の対象・時点が不明な点と、育成と品種登録が別である点を記します。",
      "targetMinutes": 10,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 6,
          "printedPage": 4
        }
      ],
