    {
      "id": "agr-f40-general-variety-rights-check",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "品種の増殖・海外持出しで確認する事項",
      "objectiveJa": "固定種・登録品種・利用目的・海外の条件を区別して確認できる。",
      "paragraphs": [
        {
          "id": "agr-f40-general-variety-rights-check-p1",
          "titleJa": "固定種という分類と増殖の許諾を分ける",
          "textJa": "固定種は種子の生物学的な分類で、登録品種か一般品種かとは別です。2026年10月29日に確認した農林水産省の説明では、農業経営で登録品種を自家増殖する場合も育成者権者の許諾が必要です。一方、一般品種はこの品種登録制度による利用制限の対象ではなく、個人的・家庭的利用には例外があります。固定種という名だけで採種・増殖の許可を決めず、品種と利用目的を確認します。",
          "knowledgeIds": [
            "AGR-K-F40-GENERAL-EXTRA-VARIETY-RIGHTS-CHECK-01"
          ]
        },
        {
          "id": "agr-f40-general-variety-rights-check-p2",
          "titleJa": "権利と植物検疫を一括しない",
          "textJa": "新品種の育成者権、技術の特許、名称の商標は、保護対象や成立条件が異なります。海外持出しも全作物一律の禁止ではなく、登録品種の増殖、相手国の保護制度、品種の輸出制限などで許諾が必要になる場合があります。正規購入だけで判断せず、品種・目的・相手国・制限を確認します。権利の許諾とは別に、輸入国が求める植物検疫条件も植物防疫所等へ確認します。",
          "knowledgeIds": [
            "AGR-K-F40-GENERAL-EXTRA-VARIETY-RIGHTS-CHECK-02"
          ]
        }
      ],
      "terms": [
        {
          "ja": "育成者権",
          "reading": "いくせいしゃけん"
        },
        {
          "ja": "自家増殖",
          "reading": "じかぞうしょく"
        }
      ],
      "activityJa": "品種の名称、登録の有無、増殖や持出しの目的、相手国、権利の条件と植物検疫の確認先を分けて書きます。",
      "targetMinutes": 10,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
