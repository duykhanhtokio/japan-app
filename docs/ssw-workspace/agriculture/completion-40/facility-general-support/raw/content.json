    {
      "id": "agr-f40-fgs-flower-source-examples",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "2"
      ],
      "titleJa": "2号の鉢花・ユリ・カーネーションの例",
      "objectiveJa": "出荷形態、原産地と改良地、花型を異なる軸として整理する。",
      "paragraphs": [
        {
          "id": "agr-f40-fgs-flower-source-examples-p1",
          "titleJa": "形態・地域・花型を混ぜない",
          "textJa": "2号はシクラメン・ラン類・観葉植物を鉢花、ガーデニング用を苗生産の例にします。ユリではテッポウユリの原産地例を九州・沖縄とし、欧州で改良されたオリエンタルとアジアティックのハイブリッドの人気増を記します。これは資料内の比較で、現在の人気調査ではありません。カーネーションは大輪系とスプレー系を区別します。原産地、改良地、出荷形態、花型は別の情報です。",
          "knowledgeIds": [
            "AGR-K-F40-FGS-FLOWER-SOURCE-EXAMPLES-01"
          ]
        }
      ],
      "terms": [],
      "activityJa": "品目を出荷形態の欄へ置き、原産地と改良地を別欄にします。",
      "targetMinutes": 10,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
