    {
      "id": "agr-f40-fgs-hydroponic-claim-scope",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "養液栽培の利点の読み取り範囲",
      "objectiveJa": "肥料や連作障害についての断定を管理不要の保証へ広げない。",
      "paragraphs": [
        {
          "id": "agr-f40-fgs-hydroponic-claim-scope-p1",
          "titleJa": "利点の列挙と保証を分ける",
          "textJa": "両資料の養液栽培の特徴には「肥料のむだがない」「連作障害がない」とあります。これは資料が利点を列挙した表現として読み、全方式・全管理条件で肥料損失や障害がゼロという保証にはしません。培養液と病害の管理を省いてよい理由にもなりません。",
          "knowledgeIds": [
            "AGR-K-F40-FGS-HYDROPONIC-CLAIM-SCOPE-01"
          ]
        }
      ],
      "terms": [],
      "activityJa": "資料の利点と、その文だけでは保証できない範囲を分けます。",
      "targetMinutes": 10,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
          "pdfPage": 74,
          "printedPage": 68
        },
        {
