{
  "lessons": [
    {
      "id": "agr-f40-fgs-source1-equipment",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "1"
      ],
      "titleJa": "1号の防除装置と育苗環境",
      "objectiveJa": "装置の目的、環境の場所、苗間隔の影響を対応させる。",
      "paragraphs": [
        {
          "id": "agr-f40-fgs-source1-equipment-p1",
          "titleJa": "装置と地上・地下の環境",
          "textJa": "1号資料は、自走式噴霧器による自動散布を省力と作業者の安全性確保の例とします。化学農薬を使わない例は着色粘着テープ、黄色灯（黄色防蛾灯）、青色灯（紫外線殺虫器）です。地上の環境は気温・湿度・光、地下は地温・土壌水分・養分濃度と分けます。装置があれば確認不要という意味ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-FGS-SOURCE1-EQUIPMENT-01"
          ]
        },
        {
          "id": "agr-f40-fgs-source1-equipment-p2",
          "titleJa": "苗間隔と徒長",
          "textJa": "1号資料は接ぎ木苗の収量増加を利点に挙げますが、全組合せ・全条件での増収保証にはしません。1号資料は、苗の間を十分に取らないと徒長しやすいと説明します。間隔の不足という条件を、過剰な水分、高温、光不足など他の条件と分けて確認します。ここから全作物共通の間隔の数値は決まりません。",
          "knowledgeIds": [
            "AGR-K-F40-FGS-SOURCE1-EQUIPMENT-02"
          ]
        }
      ],
      "terms": [],
      "activityJa": "装置の目的と観察する環境を別の欄に書きます。",
      "targetMinutes": 15,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S1",
