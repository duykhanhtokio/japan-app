    {
      "id": "agr-f40-fgs-flower-source-period",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "花きの順位・増減・割合の記載範囲",
      "objectiveJa": "年が示されない資料内の順位・増減・割合を現在値と区別する。",
      "paragraphs": [
        {
          "id": "agr-f40-fgs-flower-source-period-p1",
          "titleJa": "年がない比較を現在へ延長しない",
          "textJa": "1号はキクを切り花生産第1位、ユリを近年増産、カーネーションのスプレー作付けを約70％と記します。2号は施設花きの生産額約3,000億円、キクの切り花生産額1位、カーネーションがかつて国内消費額3位で、ユリ・トルコギキョウの消費増とコロンビアからの安価な輸入により生産減と説明します。各記載の基準年は本文にありません。生産・消費・作付けを分け、現在の順位や割合へ置き換えません。",
          "knowledgeIds": [
            "AGR-K-F40-FGS-FLOWER-SOURCE-PERIOD-01"
          ]
        }
      ],
      "terms": [],
      "activityJa": "1号と2号の記載を分け、確認できない年を明記します。",
      "targetMinutes": 10,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
