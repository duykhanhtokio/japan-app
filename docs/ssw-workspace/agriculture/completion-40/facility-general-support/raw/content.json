    {
      "id": "agr-f40-fgs-source-corrections",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "2"
      ],
      "titleJa": "2号の用語・温度記載を照合する",
      "objectiveJa": "元資料の印字と確認した名称・条件を別々に記録する。",
      "paragraphs": [
        {
          "id": "agr-f40-fgs-source-corrections-p1",
          "titleJa": "単為結果・ロゼット・材料名の照合",
          "textJa": "2号のキュウリ欄は受粉・受精なしの結実を「単為受精」と記しますが、確認した公的説明では単為結果性です。トルコギキョウ欄の「育苗期の低温でロゼット化」はそのまま採用しません。農林水産省は育苗期の高温条件でのロゼットと低温不足等を示し、低温処理を予防例にします。また原頁のPCの長い名称、農酢ビのPVA、フッ素フィルムのETEFは、確認先のポリカーボネート（PC）・EVA・ETFEと区別します。原印字を保存し、誤表記を正答にしません。品種・生育段階・製品の条件を省いた温度設定や材料の互換性は導きません。",
          "knowledgeIds": [
            "AGR-K-F40-FGS-SOURCE-CORRECTIONS-01"
          ]
        },
        {
          "id": "agr-f40-fgs-source-corrections-p2",
          "titleJa": "水気耕の併記名と湿度管理",
          "textJa": "2号は根の大部分を空気中に張らせる水気耕に「ハイポニカ農法」を併記しています。この頁の名称対応であり、全製品を同一装置とみなしません。湿度欄は施設を閉め切ると過湿となり、結露やモヤが発生しやすいと説明し、加温や内張りカーテンの短時間開放による換気を挙げます。加湿用の霧発生と取り違えず、開放時間や設定値はこの文から補いません。",
          "knowledgeIds": [
            "AGR-K-F40-FGS-SOURCE-CORRECTIONS-02"
          ]
        }
      ],
      "terms": [],
      "activityJa": "元の表記、確認結果、採用する範囲を三列で照合します。",
      "targetMinutes": 15,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
