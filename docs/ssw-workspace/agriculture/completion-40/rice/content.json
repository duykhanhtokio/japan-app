{
  "lessons": [
    {
      "id": "agr-f40-rice-calendar",
      "revision": "v1",
      "chapter": "稲作作業",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "早生の作期図で生育と作業の帯を読み分ける",
      "objectiveJa": "掲載された早生の例について、春の準備から成熟までの前後関係を読み、生育段階・作業名・帯の重なりを区別できる。",
      "paragraphs": [
        {
          "id": "agr-f40-rice-calendar-p1",
          "titleJa": "生育の段階と仕事を別に読む",
          "textJa": "両資料の早生の作期図は、上側にイネの生育、下側に主な仕事を並べています。播種や田植えの位置を読み、生育の段階名と作業名を分けましょう。以下の月はこの掲載例の読み取りであり、全地域・全品種の作業予定ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-CALENDAR-01"
          ]
        },
        {
          "id": "agr-f40-rice-calendar-p2",
          "titleJa": "春の播種・育苗・田植え",
          "textJa": "掲載例では播種が3月側、育苗が3～4月側、田植えが4～5月側に示されています。浸種・催芽は播種より前の準備です。育苗と田植えの帯が近くにあることを、一つの作業名や全株共通の実施日へまとめません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-CALENDAR-02"
          ]
        },
        {
          "id": "agr-f40-rice-calendar-p3",
          "titleJa": "分げつから幼穂形成へ",
          "textJa": "図では田植えの後、5月側に分げつ開始、6～7月側に幼穂形成が置かれています。茎が増える段階と、小さな穂ができる段階の順序をたどります。本文の分げつ開始までの目安と、図の月による表示は、数え方の異なる情報です。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-CALENDAR-03"
          ]
        },
        {
          "id": "agr-f40-rice-calendar-p4",
          "titleJa": "穂ばらみ・出穂・成熟の順序",
          "textJa": "掲載例は7月側の穂ばらみから、7～8月側の出穂、9月側の成熟へ進みます。穂が葉鞘の中で育つ段階、穂が外へ出る段階、穀粒が成熟する段階を区別して読みます。この順序を知ることだけで、実物の収穫適期を判定したことにはなりません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-CALENDAR-04"
          ]
        },
        {
          "id": "agr-f40-rice-calendar-p5",
          "titleJa": "同じ月でも作業名は別の情報",
          "textJa": "下側には基肥・代かき、除草剤散布、中干し、穂肥、収穫が並びます。上側の幼穂形成と下側の穂肥のように、近い位置にある項目も、一方は生育、他方は作業です。図の配置だけから薬剤の製品・使用条件や施肥量を決めません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-CALENDAR-05"
          ]
        },
        {
          "id": "agr-f40-rice-calendar-p6",
          "titleJa": "重なりと前後関係を記録する",
          "textJa": "図の帯には幅や重なりがあります。前後を説明するときは「この例では播種後に育苗・田植えへ進み、出穂の後に成熟・収穫が示される」のように、対象と順序を残します。帯の長さから正確な日数を計算したり、別の年の予定へそのまま移したりしません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-CALENDAR-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "早生",
          "reading": "わせ"
        },
        {
          "ja": "作期",
          "reading": "さくき"
        },
        {
          "ja": "幼穂形成",
          "reading": "ようすいけいせい"
        },
        {
          "ja": "穂ばらみ",
          "reading": "ほばらみ"
        }
      ],
      "activityJa": "生育と作業の二欄を作り、春の播種から秋の成熟・収穫までを順に並べます。月が近い生育名と作業名を一組選び、同じ意味ではない理由を説明します。掲載例だけでは決まらない現場の条件も一つ記します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
