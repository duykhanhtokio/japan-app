{
  "lessons": [
    {
      "id": "agr-f40-rice-vegetable-details-2",
      "revision": "v1",
      "chapter": "畑作・野菜作業",
      "levels": [
        "2"
      ],
      "titleJa": "2号の野菜分類・利用先・紹介値を補って読む",
      "objectiveJa": "追加の科名と利用区分、畑作の場所や加工先を整理し、資料の比率を年・指標の分からない現在値へ読み替えず説明できる。",
      "paragraphs": [
        {
          "id": "agr-f40-rice-vegetable-details-2-p1",
          "titleJa": "自然分類の追加名を対応させる",
          "textJa": "2号の表では、ニンニクはヒガンバナ科、ブロッコリーはアブラナ科です。パセリとミツバはセリ科に置かれています。既習のタマネギやニンジンの名前だけで科の欄を終えず、追加名も同じ分類軸で照合します。これを実物の写真を見分ける学習と同じ扱いにはしません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-VEG2-01"
          ]
        },
        {
          "id": "agr-f40-rice-vegetable-details-2-p2",
          "titleJa": "残る科の欄を追加例で埋める",
          "textJa": "同じ2号表には、サトイモはサトイモ科、エダマメ・インゲン・エンドウはマメ科、アスパラガスはキジカクシ科、ハスはハス科という対応があります。例えば食べる部分の説明から科名を推測するのでなく、掲載名を科の欄へ戻して確認します。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-VEG2-02"
          ]
        },
        {
          "id": "agr-f40-rice-vegetable-details-2-p3",
          "titleJa": "果実的野菜と根菜類の欄",
          "textJa": "2号は、イチゴ、メロン、スイカを、栽培では野菜、消費では果物として扱う果実的野菜の欄に置いています。一方、サツマイモは利用器官の表で根菜類に含まれます。科名、食べる部位、栽培・消費の見方という異なる分類を混ぜないようにします。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-VEG2-03"
          ]
        },
        {
          "id": "agr-f40-rice-vegetable-details-2-p4",
          "titleJa": "畑作の栽培場所と加工先を補う",
          "textJa": "2号は、畑作物に連作に弱いものが多く、輪作などの対策が必要と説明しています。ラッカセイは畑と水田転換畑の両方へ直まきする例です。また、サツマイモには焼酎原料としての利用もあります。場所、作付順序、加工先を別欄に置き、この記述から一律の輪作年数や加工手順は決めません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-VEG2-04"
          ]
        },
        {
          "id": "agr-f40-rice-vegetable-details-2-p5",
          "titleJa": "果菜類の利用と移植の追加例",
          "textJa": "2号は糖度の高いミニトマトと、加工用のトマト品種を紹介しています。キュウリのサラダ・漬物という利用例と、キュウリやナスを移植栽培する説明も補って整理します。甘さ、食品としての利用先、畑への植え方は別の情報です。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-VEG2-05"
          ]
        },
        {
          "id": "agr-f40-rice-vegetable-details-2-p6",
          "titleJa": "2号の工芸作物の列挙を読む",
          "textJa": "2号の工芸作物の欄には、茶、コンニャク、イグサ、タバコ、テンサイ、サトウキビなどが載っています。油料として別の箇所に出るダイズやラッカセイと合わせて整理するときも、どの箇所のどの用途を読んだのかを残します。加工が必要という共通点だけで、同じ科や同じ処理方法とは考えません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-VEG2-06"
          ]
        },
        {
          "id": "agr-f40-rice-vegetable-details-2-p7",
          "titleJa": "小麦の輸入比率の記述範囲",
          "textJa": "2号の麦類紹介は、コムギの利用が多い一方、80％以上は輸入品だと説明しています。この紹介文には、比率の年や細かい集計条件が付いていません。掲載資料の紹介として記録し、現在の輸入比率の確定値や、国産自給率を厳密に計算するための値として使いません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-VEG2-07"
          ]
        },
        {
          "id": "agr-f40-rice-vegetable-details-2-p8",
          "titleJa": "大豆の転換畑比率は面積の記述",
          "textJa": "2号は、日本のダイズ作付面積の80％が水田転換畑で栽培されると述べています。ここでの80％は作付面積についての紹介で、収穫重量や輸入量の割合ではありません。年が明記されていない記述を現在値へ変えず、ラッカセイも転換畑で育つという説明から同じ80％を移しません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-VEG2-08"
          ]
        }
      ],
      "terms": [
        {
          "ja": "自然分類",
          "reading": "しぜんぶんるい"
        },
        {
          "ja": "果実的野菜",
          "reading": "かじつてきやさい"
        },
        {
          "ja": "転換畑",
          "reading": "てんかんばたけ"
        },
        {
          "ja": "焼酎",
          "reading": "しょうちゅう"
        },
        {
          "ja": "作付面積",
          "reading": "さくづけめんせき"
        }
      ],
      "activityJa": "作物名、科名、利用区分、栽培場所、加工先を別欄で照合します。最後に小麦と大豆の二つの80％の説明を読み、何の割合か、資料だけでは確認できない年や条件は何かを区別して記録します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
