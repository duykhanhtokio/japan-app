{
  "lessons": [
    {
      "id": "agr-f40-rice-source1-supplement",
      "revision": "v1",
      "chapter": "稲作作業・畑作野菜作業",
      "levels": [
        "1"
      ],
      "titleJa": "1号の稲作・野菜で残る掲載例を整理する",
      "objectiveJa": "1号資料の病害虫・作業方式・野菜の追加例を、剤型、用語、目的、形、用途の違いを保って説明できる。",
      "paragraphs": [
        {
          "id": "agr-f40-rice-source1-supplement-p1",
          "titleJa": "田植え後の除草剤の剤型",
          "textJa": "1号資料は田植え後の除草剤に、粒剤やフロアブル剤などがあると説明しています。作業時期の名前と剤型の名前を別欄にします。剤型を知っただけで使う製品や使用量、湛水日数を決めることはできません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-01"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p2",
          "titleJa": "病名と地域の害虫を分ける",
          "textJa": "1号資料の稲作の病害例は、いもち病とごま葉枯れ病です。また、田植え後に葉や穂を食べる害虫が発生する地域では、その害虫を防除するという説明があります。病名、加害する部位、地域での発生を分けて記録し、名前だけで症状を診断しません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-02"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p3",
          "titleJa": "穎花はイネ科の花の呼び方",
          "textJa": "1号資料が「えい花」と呼ぶのはイネ科植物の花です。穎花（えいか）という語を、穂全体や出穂という生育段階の別名にしないようにします。この語の意味を理解することと、現場の穂肥の時期・量を決めることは別です。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-03"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p4",
          "titleJa": "水分を減らす目的と火力乾燥",
          "textJa": "収穫後のもみの説明では、1号資料は火力乾燥という方式を挙げています。乾燥で水分を減らす目的と、熱を使う方式を分けて読みます。もみの水分割合は機械の設定温度ではなく、掲載値だけで実機の温度や運転時間は決まりません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-04"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p5",
          "titleJa": "機械の共用と疎植の費用項目",
          "textJa": "1号の乾田直播には、播種機械などを麦用の畑作物と共用できる例があります。一方、疎植で育苗箱を減らす説明は、種子・育苗資材などの生産コストと労働時間の削減に結び付きます。設備の共用と、箱数から変わる費用項目を区別し、全機械の互換性や同じ節約額を保証しません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-05"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p6",
          "titleJa": "葉茎菜類の利用と移植の掲載例",
          "textJa": "1号資料はハクサイの漬物・鍋料理という利用例を挙げます。レタスには結球するもの、しないもの、葉が縮れるものがあり、移植栽培するという説明もあります。タマネギも移植栽培の例です。料理、葉の形、栽培方式を別々の情報として整理します。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-06"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p7",
          "titleJa": "サツマイモで施肥過多の説明を読む",
          "textJa": "1号資料は、サツマイモが肥料の少ない土でもよく育つ一方、肥料が多すぎると葉や茎が大きくなり、地下の収穫部分の肥大が進まないという関係を説明しています。肥料を多くするほど収穫部分も必ず大きくなる、と読み替えません。この説明から無施肥や一律の施肥量を指定しません。器官名の資料間の違いは、この課では解消したことにしません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-07"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p8",
          "titleJa": "工芸作物の追加例を用途欄に置く",
          "textJa": "1号資料の工芸作物には、茶、コンニャク、ラッカセイ、イグサ、タバコ、テンサイ、サトウキビなどがあります。ここで整理するのは、利用するために特有の加工が必要な作物という用途の欄です。同じ植物の科や同じ加工工程をもつという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-08"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p9",
          "titleJa": "加工種子と播種後の覆土を区別する",
          "textJa": "1号のネーキッド種子は、固い皮を取り除いた種子で、ホウレンソウが例です。これは種子そのものの加工で、播種後に土をかける覆土とは別です。明発芽種子のニンジンでは覆土が多すぎると発芽しにくいため薄く土をかける例がありますが、全種子共通の厚さの数値はここから決めません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-09"
          ]
        },
        {
          "id": "agr-f40-rice-source1-supplement-p10",
          "titleJa": "種の分布と株間を分ける",
          "textJa": "1号のばらまきはうね全体へ種をまく方法で、タマネギの育苗が例です。すじまきは一列にまく方法でニンジン、点まきは一か所に数粒ずつまく方法でダイコンが例です。種の配置と、株と株の間隔である株間を分けて読み、図の点の数や長さから一律の粒数・間隔を決めません。",
          "knowledgeIds": [
            "AGR-K-F40-RICE-S1-10"
          ]
        }
      ],
      "terms": [
        {
          "ja": "フロアブル剤",
          "reading": "ふろあぶるざい"
        },
        {
          "ja": "穎花",
          "reading": "えいか"
        },
        {
          "ja": "火力乾燥",
          "reading": "かりょくかんそう"
        },
        {
          "ja": "疎植",
          "reading": "そしょく"
        },
        {
          "ja": "ネーキッド種子",
          "reading": "ねーきっどしゅし"
        }
      ],
      "activityJa": "稲作では剤型・病名・花の呼称・乾燥方式・費用項目を別欄にします。野菜では料理、形、移植、肥料への反応、用途、種子加工と覆土を分け、掲載例だけでは決まらない現場の条件も記します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
