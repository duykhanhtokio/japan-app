{
  "schemaVersion": 1,
  "lessons": [
    {
      "id": "agr-f40-soil-field-details",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1"
      ],
      "titleJa": "1号：水・土づくり・作業機の補足",
      "objectiveJa": "かん水の時間、土壌改良の具体例、作業機の呼び方、連作障害への対策を、資料の条件に沿って整理できる。",
      "paragraphs": [
        {
          "id": "agr-f40-soil-field-details-p1",
          "titleJa": "真夏の頭上かん水",
          "textJa": "1号資料は、作物の上から水をかける頭上かん水について、真夏の日中はなるべく避けるとしています。夏の午前中・夕方という既習の目安に、この方法と季節の注意を重ねて読みます。全ての作物へ同じ時刻や水量を指定するものではありません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-FIELD-DETAILS-01"
          ]
        },
        {
          "id": "agr-f40-soil-field-details-p2",
          "titleJa": "有機物と団粒の発達",
          "textJa": "土の粒子が集まる団粒構造を発達させる方法として、資料は堆肥や有機物を入れることを挙げています。耕うんで土を掘り返す作業と、有機物を補う作業を分けて記録しましょう。この説明だけから、投入する材料の量や効果が出る日数は決まりません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-FIELD-DETAILS-02"
          ]
        },
        {
          "id": "agr-f40-soil-field-details-p3",
          "titleJa": "苦土石灰という具体例",
          "textJa": "1号資料は、酸性の土を改良するために使う例として、石灰に加えて苦土石灰を挙げています。「適量」という条件を残し、資材名が分かっただけで散布量を決めないようにします。酸度を調整する仕事と、土をやわらかくする耕うんは別の改善方法です。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-FIELD-DETAILS-03"
          ]
        },
        {
          "id": "agr-f40-soil-field-details-p4",
          "titleJa": "トラクタ本体と作業機",
          "textJa": "1号資料では、トラクタにロータリーやプラウを装着して耕うんします。本体と取り付ける作業機を別欄にして記録しましょう。乗用トラクタは通常トラクタ、歩行用トラクタは耕うん機・管理機と呼ばれます。名称の照合は、実機の操作や適合を確認したこととは異なります。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-FIELD-DETAILS-04"
          ]
        },
        {
          "id": "agr-f40-soil-field-details-p5",
          "titleJa": "連作障害の養分不足",
          "textJa": "1号資料が挙げる連作障害の原因には、病原体や害虫の増加に加え、特定養分の欠乏があります。同じ畑で生育が悪くなったという観察だけで、原因を肥料不足一つに決めません。病原体、害虫、養分、生育を妨げる物質という確認対象を分けます。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-FIELD-DETAILS-05"
          ]
        },
        {
          "id": "agr-f40-soil-field-details-p6",
          "titleJa": "土壌消毒の利用例",
          "textJa": "連作障害への対策として、1号資料は薬剤や太陽光による土壌消毒を挙げています。同じ対策欄にある輪作・つぎ木・耐病性品種の利用と区別し、土壌消毒の二つの利用例として整理します。名称だけから薬量、温度、被覆期間などの作業条件を補いません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-FIELD-DETAILS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "団粒",
          "reading": "だんりゅう"
        },
        {
          "ja": "苦土石灰",
          "reading": "くどせっかい"
        },
        {
          "ja": "歩行用トラクタ",
          "reading": "ほこうようとらくた"
        },
        {
          "ja": "欠乏",
          "reading": "けつぼう"
        },
        {
          "ja": "土壌消毒",
          "reading": "どじょうしょうどく"
        }
      ],
      "activityJa": "水やりの注意、土の構造・酸度の改善、本体と作業機、連作障害の原因と対策を別欄にまとめます。各欄に資料から分かることと、現場で別に確認する条件を書いてください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
