{
  "schemaVersion": 1,
  "lessons": [
    {
      "id": "agr-f40-soil-common-reading",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "土の観察・輪作・排水を資料別に読む",
      "objectiveJa": "pH測定、団粒・EC、二つの輪作例、排水方法を、資料の条件と違いを残して説明できる。",
      "paragraphs": [
        {
          "id": "agr-f40-soil-common-reading-p1",
          "titleJa": "一般的なpHの目安",
          "textJa": "両資料は、多くの作物に適する土壌pHの目安を5.5～6.5としています。作物別の表の範囲とは別欄に記し、全作物に共通する設定値にしません。この範囲だけから石灰の量は決まりません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-COMMON-01"
          ]
        },
        {
          "id": "agr-f40-soil-common-reading-p2",
          "titleJa": "測定前に土を湿らせる程度",
          "textJa": "直接差し込む簡易酸度計の掲載例では、土を握ると固まるくらい十分に湿らせてから測ります。土性を見分ける握り試験とは目的が違います。この準備を全機種共通の方法にはせず、器具の説明も確認します。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-COMMON-02"
          ]
        },
        {
          "id": "agr-f40-soil-common-reading-p3",
          "titleJa": "団粒を育てる有機物の補充",
          "textJa": "両資料は、団粒構造を発達させる方法として堆肥や有機物を入れることを挙げています。土を動かす耕うんとは分けて、構造を育てる材料の補充として記録します。投入量や必要日数はこの説明から指定しません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-COMMON-03"
          ]
        },
        {
          "id": "agr-f40-soil-common-reading-p4",
          "titleJa": "EC高値の読みと条件",
          "textJa": "両資料は、ECが高い土について肥料が多く残っていると説明しています。ECは塩類の状態を調べる手掛かりです。測定法・作物・土壌条件を確認せず、残留量の逆算や一律の追加施肥へ結び付けません。2号の掲載しきい値の適用保留も解除しません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-COMMON-04"
          ]
        },
        {
          "id": "agr-f40-soil-common-reading-p5",
          "titleJa": "夏作と冬作をつなぐ輪作例",
          "textJa": "資料の二年四作の例の一つは、ダイズ、コムギ、サツマイモ、コムギという順です。夏作物と冬作物をつなぎます。同じコムギの名が二回出ても、二年の中の別の作として数えます。地域共通の作付け日程にせず、例の順序として読みます。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-COMMON-05"
          ]
        },
        {
          "id": "agr-f40-soil-common-reading-p6",
          "titleJa": "夏作と秋作をつなぐ輪作例",
          "textJa": "別の二年四作の例は、サツマイモ、ハクサイ、スイカ、ダイコンという順です。夏作物と秋作物を組み合わせています。図の月軸は十二月の後も翌年へ続くため、作物の順序と年の区切りを別に確認します。図の例を全地域の播種・収穫月にはしません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-COMMON-06"
          ]
        },
        {
          "id": "agr-f40-soil-common-reading-p7",
          "titleJa": "管を埋める方法と亀裂を入れる方法",
          "textJa": "暗きょは土中に管を埋めて排水する方法です。心土破砕は硬盤や心土に機械で亀裂を入れ、水を流れやすくします。管の埋設と土層の破砕を同じ作業として記録しません。この対比で資料の見出し配置の相違や共通の施工深さを確定するものではありません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-COMMON-07"
          ]
        },
        {
          "id": "agr-f40-soil-common-reading-p8",
          "titleJa": "明きょの利用例と作業性",
          "textJa": "1号資料は明きょの説明で麦・大豆・野菜栽培を挙げています。2号資料は、作物の間に溝を作るため作業性が下がる点も示します。地表の水を流す目的、掲載された作物例、作業性という別の情報を保ち、どの圃場にも同じ溝が必要と決めません。",
          "knowledgeIds": [
            "AGR-K-F40-SOIL-COMMON-08"
          ]
        }
      ],
      "terms": [
        {
          "ja": "酸度計",
          "reading": "さんどけい"
        },
        {
          "ja": "団粒構造",
          "reading": "だんりゅうこうぞう"
        },
        {
          "ja": "二年四作",
          "reading": "にねんよんさく"
        },
        {
          "ja": "心土破砕",
          "reading": "しんどはさい"
        },
        {
          "ja": "明きょ",
          "reading": "めいきょ"
        }
      ],
      "activityJa": "観察・測定と改善作業を別欄にし、二つの輪作例を年をまたぐ順序で書きます。排水方法では管・土層・地表の違いを記し、本文から決まらない測定条件や作業日程を挙げてください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
