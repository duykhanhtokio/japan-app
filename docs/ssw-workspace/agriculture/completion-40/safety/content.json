{
  "lessons": [
    {
      "id": "agr-f40-safety-cultivation-details",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "枝葉・収穫・被覆の補足事項を確認する",
      "objectiveJa": "枝葉管理、受粉、収穫後の生理、被覆資材の対象と働きを区別し、資料の例と現場で別に確認する条件を説明できる。",
      "paragraphs": [
        {
          "id": "agr-f40-safety-cultivation-details-p1",
          "titleJa": "摘心の後に出る芽",
          "textJa": "摘心の後には、葉の付け根である葉腋から側芽や新梢が出やすくなると2号資料は説明しています。先端を切った位置と、その後に芽が出る位置を分けて観察します。全ての芽を残すか取るかは、この説明だけでは決めません。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-01"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p2",
          "titleJa": "摘葉とリンゴの着色",
          "textJa": "リンゴの例では、摘葉によって果実に日光が当たりやすくなることと、色が出やすくなることが関連付けられています。葉を取る枚数や収穫日を指定する説明ではなく、通風の改善とは別の掲載目的として整理します。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-02"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p3",
          "titleJa": "剪定の対象と目的",
          "textJa": "2号資料は、果樹だけでなくナスの更新剪定という野菜の例も挙げています。枝を切り、内部の日当たりと風通しを改善することは、品質の改善や病虫害の抑制にも関係します。整枝・誘引の収量や品質への効果は目的の説明であり、全条件での増収保証ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-03"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p4",
          "titleJa": "自家受粉と他家受粉の資料上の区分",
          "textJa": "この資料は、同じ花の柱頭へ花粉が付く場合を自家受粉、別の花の柱頭へ付く場合を他家受粉として分けています。ここでは資料の区分を読み、花粉が付いたことと受精したことを別々に記録します。別の花という説明だけで、実際に必要な品種の組合せは決められません。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-04"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p5",
          "titleJa": "収穫判断で糖と酸を分ける",
          "textJa": "果樹の収穫期を判断する目安には、果皮の色、果肉の硬さ、糖の含量と酸の含量の測定があります。糖を測った記録だけでは、酸も測ったことになりません。目安の種類を分けて記録し、この一覧から品種共通の収穫基準値は作りません。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-05"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p6",
          "titleJa": "収穫後も続く呼吸と蒸散",
          "textJa": "野菜や果実は、収穫した後も呼吸や蒸散を続けます。資料は、時間の経過や温度の影響でその量が増えると、しおれ、つやの低下、軟化などにつながると説明しています。収穫で生理活動が止まると考えず、鮮度保持を収穫後の仕事として計画します。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-06"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p7",
          "titleJa": "強制通風の冷却速度の説明",
          "textJa": "冷風を庫内で強制的に循環させる方式は、2号資料ではゆっくり冷やす方式として紹介されています。方式名に「強制」があることを、全ての収穫物を最速で冷却するという意味に置き換えません。実際の所要時間は、この定性的な比較だけでは決められません。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-07"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p8",
          "titleJa": "果樹のトンネルは棚を覆う例",
          "textJa": "トンネル栽培の説明では、野菜や花はうねを覆い、果樹は棚を覆うという対象の違いがあります。被覆する位置を確認してから、支柱と被覆資材の組合せを記録します。名称が同じでも、全作物に同じ大きさの覆いを使うという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-08"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p9",
          "titleJa": "水分の流亡と土の流出を区別する",
          "textJa": "マルチの説明には、水分や肥料の流亡を抑えることに加え、土そのものの流出を防ぐ目的があります。水分を保つことと土の移動を抑えることを、異なる確認項目として残します。どの斜面でも流出がなくなるという保証ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-09"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p10",
          "titleJa": "雨水の流入と糖度の掲載関係",
          "textJa": "2号資料は、マルチで雨水が土壌へ入るのを抑えることを、糖度の高い果実の生産へ結び付けて説明しています。これは資料にある関係の整理で、全ての果実の糖度が必ず上がるという約束ではありません。具体的な水管理や資材の選択は、作物と栽培条件を別に確認します。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-10"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p11",
          "titleJa": "有機マルチとPEフィルムの材料例",
          "textJa": "有機マルチの材料例には、稲わらのほかに草やおがくずがあります。一方、プラスチックマルチでは主にポリエチレン（PE）フィルムが使われると資料は説明しています。材料の区分と例を対応させ、草やおがくずをプラスチックの種類へ入れないようにします。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-11"
          ]
        },
        {
          "id": "agr-f40-safety-cultivation-details-p12",
          "titleJa": "かがむ姿勢が続くときの掲載例",
          "textJa": "腰をかがめる仕事などで同じ姿勢が続く場合、2号資料は時々立ち上がって背伸びをする例を挙げています。姿勢を変えるための区切りを予定へ入れ、かがんだまま仕事内容だけを替えることと区別します。身体の状態を問わず同じ動きを強いる説明や、一律の医学的な時間基準ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-SAFETY-CULTIVATION-12"
          ]
        }
      ],
      "terms": [
        {
          "ja": "葉腋",
