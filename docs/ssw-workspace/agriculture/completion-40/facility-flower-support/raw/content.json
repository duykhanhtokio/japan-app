{
  "schemaVersion": 1,
  "lessons": [
    {
      "id": "agr-f40-facility-fruit-source-reading",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "1",
        "2"
      ],
      "titleJa": "出典の記述と限界を読む",
      "objectiveJa": "記載事項と、出典に書かれていない条件を区別できる。",
      "paragraphs": [
        {
          "id": "agr-f40-facility-fruit-source-reading-p1",
          "titleJa": "出典の記述と限界",
          "textJa": "1号では果樹を果実収穫のための樹と説明し、実を「果実」とも呼びます。メロン・スイカは実を収穫しても一年で枯れる草なので野菜とする例です。2号の定義は2年以上栽培する木本・草本も含みます。甘く香りのよい果実が食生活を豊かにし、良質な果実は高く売れ、小面積でも多くの収入になるというのは資料内の意義の説明であり、個別経営の収益保証ではありません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-FRUIT-SUPPORT-01"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-source-reading-p2",
          "titleJa": "出典の記述と限界",
          "textJa": "両資料ではクリは落葉果樹、ユズは常緑果樹の例です。冬に葉が落ちることと、一年中葉があることを分けて整理します。また2号は「日本ナシ」を本文中で「ナシ」と書く規則を明記しています。この資料内の呼称を、セイヨウナシを含むすべてのナシの説明へ無条件に広げません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-FRUIT-SUPPORT-02"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-source-reading-p3",
          "titleJa": "出典の記述と限界",
          "textJa": "1号・2号の概説はリンゴ・ナシを今年伸びた新しい枝に花芽が付く型に含めます。一方2号の詳細図は、前年に結果枝ができ、その先端や頂部腋芽が少し伸びた後に花芽が開花・着果する型として示します。概説の短い表現だけで枝齢を一律に決めず、花芽形成、開花・着果、図の年次を区別して読みます。この表現差を実物の切断指示にしません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-FRUIT-SUPPORT-03"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-source-reading-p4",
          "titleJa": "出典の記述と限界",
          "textJa": "花芽分化時期は、1号のブドウが5月下旬、ウンシュウミカンが10～12月です。2号ではブドウが5月下旬～7月、ウンシュウミカンが10月～翌年2月と幅が異なります。出典と両端を一組にして記録し、二つを一つの共通期間へ直したり、全地域・全品種の実施日へ変えたりしません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-FRUIT-SUPPORT-04"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-source-reading-p5",
          "titleJa": "出典の記述と限界",
          "textJa": "果樹の栄養は窒素・リン・カリだけで完結せず、ほかの要素も含めた均衡が必要だと資料は説明します。肥料は与える時期と量が適切なことも大切です。要素名、均衡、時期、量を別の確認欄にし、この概説だけから園地共通の施肥量や日付を計算しません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-FRUIT-SUPPORT-05"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-source-reading-p6",
          "titleJa": "出典の記述と限界",
          "textJa": "両資料の概説には変則主幹形の例としてリンゴとカキがあり、2号の図にはカキ・クリも示されます。掲載された樹種と形を対応させ、同じ樹種なら必ず同形とはしません。切り返しは枝の途中で切り新梢成長を盛んにする説明、間引きは不要枝を除き採光・通風をよくする説明です。切断位置と目的を分けます。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-FRUIT-SUPPORT-06"
          ]
        },
        {
          "id": "agr-f40-facility-fruit-source-reading-p7",
          "titleJa": "出典の記述と限界",
          "textJa": "摘蕾・摘花には、良質な果実を育てることと翌年の花付きをよくすることの両目的が、両資料に記されています。今年の果実だけで目的を終えず、余分な蕾・花を取り除く対象と翌年への目的を記録します。実際に残す個数や時期はこの目的説明だけで決めません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-FRUIT-SUPPORT-07"
          ]
        }
      ],
      "terms": [],
      "activityJa": "記述、対象範囲、未記載の条件を記録します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
