    {
      "id": "agr-f40-facility-fruit-bud-options2",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "出典の記述と限界を読む",
      "objectiveJa": "記載事項と、出典に書かれていない条件を区別できる。",
      "paragraphs": [
        {
          "id": "agr-f40-facility-fruit-bud-options2-p1",
          "titleJa": "出典の記述と限界",
          "textJa": "2号は、弱い苗や若い苗を旺盛に育てるため全ての蕾を取る場合と、花・果実を大きくするため数個の蕾を残す場合を挙げています。またウンシュウミカンやリンゴで摘果剤を使うことがあると記しています。これは条件付きの掲載例です。全苗で蕾を全て取る指示や、製品名・濃度・使用日を定める処方にはしません。",
          "knowledgeIds": [
            "AGR-K-F40-FACILITY-FRUIT-SUPPORT-08"
          ]
        }
      ],
      "terms": [],
      "activityJa": "記述、対象範囲、未記載の条件を記録します。",
