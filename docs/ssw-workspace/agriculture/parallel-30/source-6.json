  "questions": [
    {
      "id": "agr-s30-label-detail-q01",
      "stemJa": "有効成分の名称を記録したので、「成分の欄は全て確認済み」としました。ただし含有量は空欄です。この課の読み方に合う点検はどれですか。",
      "optionsJa": [
        "内容量が分かれば、成分ごとの含有量も確認したことにする。",
        "成分名を読めても、どれだけ含まれるかの情報は別に確認する。",
        "販売名をもう一度読めば、含有量の空欄を埋めたことにする。",
        "成分名が同じなら、含有量も製品間で同じとして記す。"
      ],
      "correctIndex": 1,
      "optionReasonsJa": [
        "容器全体の製品量と、成分の含有量を混同しています。",
        "何が含まれるかと、どれだけ含まれるかを分けて確認しています。",
        "販売名の再確認は、含有量を確認した証拠にはなりません。",
        "成分名の一致だけでは、製品ごとの含有量の一致を判断できません。"
      ],
      "lessonId": "agr-s30-label-detail",
      "lessonSourceHash": "4f59e4dff44612fcb5707f0ad354194852df649b6234110becfdbd8dcf7741b4",
      "knowledgeIds": [
        "AGR-K-S30-LABEL-DETAIL-02"
      ],
      "nativeReviewed": false,
      "domainReviewed": false
    },
    {
      "id": "agr-s30-label-detail-q02",
      "stemJa": "教材の量の欄を「そのまま使う場合／希釈して使う場合」の順に整理します。この課の説明に合う対応はどれですか。",
      "optionsJa": [
        "使う製品の量／希釈に加えた水だけの量。",
        "容器に残った製品の量／希釈前の製品だけの量。",
        "使う製品の量／希釈後の薬液の量。",
        "容器全体の内容量／製造時の有効成分名。"
      ],
      "correctIndex": 2,
      "optionReasonsJa": [
        "後者は加えた水だけではなく、希釈後の薬液量として読む説明です。",
        "残量や希釈前の製品だけの量へ、使用時に読む量を置き換えています。",
        "教材が分ける二つの使用場面と量の意味を保持しています。",
        "容器全体の内容量と成分名は、ここで比べる二つの使用量の意味ではありません。"
      ],
      "lessonId": "agr-s30-label-detail",
      "lessonSourceHash": "4f59e4dff44612fcb5707f0ad354194852df649b6234110becfdbd8dcf7741b4",
      "knowledgeIds": [
        "AGR-K-S30-LABEL-DETAIL-06"
      ],
      "nativeReviewed": false,
      "domainReviewed": false
    }
  ],
