  "lessons": [
    {
      "id": "agr-s30-rice-detail",
      "revision": "v1",
      "chapter": "稲作作業",
      "levels": [
        "2"
      ],
      "titleJa": "水田の雑草対策と収穫後・省力化の記録",
      "objectiveJa": "水田雑草の対策例、収穫後耕うんの対象、機械共用と費用項目を、資料の条件を残して説明できる。",
      "paragraphs": [
        {
          "id": "agr-s30-rice-detail-p1",
          "titleJa": "先に草種と生育時期を記録する",
          "textJa": "水田の雑草対策では、草種と生育時期の観察が大切です。「雑草がある」という一言では、どの種類か、どの段階まで育っているかが残りません。二つを別欄へ記録し、防除方法を考える情報として整理します。この観察だけから、使う薬剤や量が決まるわけではありません。",
          "knowledgeIds": [
            "AGR-K-S30-RICE-DETAIL-01"
          ]
        },
        {
          "id": "agr-s30-rice-detail-p2",
          "titleJa": "栽培の仕事に組み込む予防",
          "textJa": "2号資料の耕種的防除には、秋の耕うん、春先の耕うん、丁寧な代かきという例があります。田の準備や栽培に関わる仕事を、雑草の発生を少なくする目的と結び付けています。掲載された季節を残して整理しますが、全ての田で同じ日程を使えるという保証にはしません。",
          "knowledgeIds": [
            "AGR-K-S30-RICE-DETAIL-02"
          ]
        },
        {
          "id": "agr-s30-rice-detail-p3",
          "titleJa": "防除の分類と働きをそろえる",
          "textJa": "資料は、除草剤を使う方法を化学的防除、手動式や動力式の水田用除草機による機械除草を物理的防除の例としています。アイガモのヒナに雑草を食べさせる方法は、生物的防除の例です。分類名だけでなく、薬剤、機械、生物のどの働きを使うかも対応させます。この説明は、薬剤の使用条件や実機操作、アイガモを導入する手順まで定めるものではありません。",
          "knowledgeIds": [
            "AGR-K-S30-RICE-DETAIL-03"
          ]
        },
        {
          "id": "agr-s30-rice-detail-p4",
          "titleJa": "乾燥の方式と設定値は別",
          "textJa": "収穫後のもみの調製について、2号資料は火力乾燥という方式を挙げています。水分を減らす目的と、熱を使う方式という二つの情報を分けて整理します。「火力乾燥」と書いたことは、実機の温度や運転時間を確認したこととは別です。もみの水分割合を、そのまま乾燥機の設定温度へ読み替えないようにします。",
          "knowledgeIds": [
            "AGR-K-S30-RICE-DETAIL-04"
          ]
        },
        {
          "id": "agr-s30-rice-detail-p5",
          "titleJa": "収穫後の耕うんで対象を分ける",
          "textJa": "資料では、収穫後に速やかに耕うんし、切り株やわらの分解を進めると説明しています。さらに、多年生雑草を掘り起こすことと、表層にある雑草を土へ埋め込むことを挙げています。残さの分解、掘り出す対象、埋める対象を一つの片付け欄にまとめず、何に働きかける仕事かを分けます。この記述から、実機の操作や土壌条件ごとの作業設定は決めません。",
          "knowledgeIds": [
            "AGR-K-S30-RICE-DETAIL-05"
          ]
        },
        {
          "id": "agr-s30-rice-detail-p6",
          "titleJa": "機械と育苗箱に関わる省力化",
          "textJa": "乾田直播の説明には、播種機械などを麦用の畑作物の機械と共用できる例があります。育苗を省くこととは別に、設備を共用する観点です。一方、疎植で必要な育苗箱を減らす説明は、種子・育苗資材などの費用や労働時間と結び付いています。設備の共用と、箱数に関わる費用項目を別に整理し、全機械の互換性や全圃場で同じ額の節約を保証する説明にはしません。",
          "knowledgeIds": [
            "AGR-K-S30-RICE-DETAIL-06"
          ]
        }
      ],
      "terms": [
