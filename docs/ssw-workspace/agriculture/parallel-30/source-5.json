  "lessons": [
    {
      "id": "agr-s30-fruit-detail",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "摘果の追加条件と果樹園の気象・地域を読む",
      "objectiveJa": "摘果の状態・位置の条件を追加し、気象の種類と果樹別の地域例を混同せずに整理できる。",
      "paragraphs": [
        {
          "id": "agr-s30-fruit-detail-p1",
          "titleJa": "摘果では状態と位置も見る",
          "textJa": "摘果の候補を選ぶとき、2号資料には傷のある果実や発育の遅れた果実も挙げられています。さらに、袋をかけにくい位置にある果実も確認する対象です。傷や変形などの状態だけで判断を終えず、袋かけを行うときの位置も別の項目にします。この説明だけで、全ての樹で残す数や摘果日を決めることはできません。",
          "knowledgeIds": [
            "AGR-K-S30-FRUIT-DETAIL-01"
          ]
        },
        {
          "id": "agr-s30-fruit-detail-p2",
          "titleJa": "気象の心配を六つに分ける",
          "textJa": "果樹園で気象の影響を整理する際、資料は強風、寒さ、大雨、干ばつ、大雪、ひょうを挙げています。雨が多いことと水が足りないこと、雪が多いこととひょうが降ることは、同じ一項目にせず分けて記録します。被害を受けやすい地域では対策が行われるという説明であり、どの園地にも同じ資材を置けばよいという手順ではありません。",
          "knowledgeIds": [
            "AGR-K-S30-FRUIT-DETAIL-02"
          ]
        },
        {
          "id": "agr-s30-fruit-detail-p3",
          "titleJa": "カンキツの強風への備えの例",
          "textJa": "カンキツ類については、寒さや強い風に弱いという特徴に続き、防風林や防風資材を使う例が示されています。樹を取り巻く風への備えと、果実を一つずつ保護する袋かけは、管理する範囲が異なります。防風という名称を、寒さ・大雨・干ばつなど全ての気象被害をなくす保証にはせず、園地ごとの確認につなげます。",
          "knowledgeIds": [
            "AGR-K-S30-FRUIT-DETAIL-03"
          ]
        },
        {
          "id": "agr-s30-fruit-detail-p4",
          "titleJa": "リンゴの栽培地を読む",
          "textJa": "リンゴの項では、冬に寒い地域で多く栽培されると説明されています。「冬に寒い」という季節を伴う地域の特徴を、すべての生育段階で低温が必要という指示へ変えないようにします。栽培地域の説明と、人工受粉や摘果などの作業名は別の情報として整理できます。",
          "knowledgeIds": [
            "AGR-K-S30-FRUIT-DETAIL-04"
          ]
        },
        {
          "id": "agr-s30-fruit-detail-p5",
          "titleJa": "ブドウの広がりと園地の条件",
          "textJa": "ブドウは日本全国で広く栽培される作物として紹介されています。一方、同じ項には風雨や病気への弱さから施設で栽培する例もあります。国内に広く栽培地があるという説明は、各地で管理条件が同じという意味ではありません。地理的な広がりと、園地の環境に応じた栽培方法を分けて読みます。",
          "knowledgeIds": [
            "AGR-K-S30-FRUIT-DETAIL-05"
          ]
        },
        {
          "id": "agr-s30-fruit-detail-p6",
          "titleJa": "甘ガキの地域についての掲載範囲",
          "textJa": "2号資料は、甘ガキを日本特産の果樹として紹介し、栽培する温暖な地方の例を福島以南としています。ここでの説明の対象は甘ガキであり、カキという名だけで全ての種類に同じ地域条件を当てはめないことが大切です。「福島以南」という掲載範囲は、個々の園地の適否を地名だけで決める境界線として使うものではありません。",
          "knowledgeIds": [
            "AGR-K-S30-FRUIT-DETAIL-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "摘果",
          "reading": "てきか"
        },
        {
          "ja": "干ばつ",
          "reading": "かんばつ"
        },
        {
          "ja": "防風林",
          "reading": "ぼうふうりん"
        },
        {
          "ja": "防風資材",
          "reading": "ぼうふうしざい"
        },
        {
          "ja": "甘ガキ",
          "reading": "あまがき"
        }
      ],
      "activityJa": "摘果の確認表を「傷・発育・形・袋かけの位置」に分けます。次に六つの気象の欄を作り、カンキツ、リンゴ、ブドウ、甘ガキの掲載例を、対象の作物と季節・地域を添えて整理します。最後に、地域の例だけでは決まらない現場の条件を挙げて振り返ります。",
      "targetMinutes": 30,
      "measuredMinutes": null,
