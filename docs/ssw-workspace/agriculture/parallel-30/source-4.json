  "lessons": [
    {
      "id": "agr-s30-facility-flower",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "2"
      ],
      "titleJa": "施設花きの系統・培地・球根処理を読み分ける",
      "objectiveJa": "キクとバラの掲載分類、ユリの球根処理の方向、カーネーションの繁殖方法を、資料の範囲を保って説明できる。",
      "paragraphs": [
        {
          "id": "agr-s30-facility-flower-p1",
          "titleJa": "キクの系統と調節の対象",
          "textJa": "キクの系統を並べる欄には、夏ギク・夏秋ギク・秋ギクに加えて寒ギクも入ります。2号資料で短日性と電照による開花調節を結び付けている対象は、夏秋ギクと秋ギクです。寒ギクを同じ一覧に書いたことだけを理由に、全系統の電照方法が共通だと判断しないようにします。",
          "knowledgeIds": [
            "AGR-K-S30-FACILITY-FLOWER-01"
          ]
        },
        {
          "id": "agr-s30-facility-flower-p2",
          "titleJa": "キクの花型を別欄に置く",
          "textJa": "同じキクを整理するとき、季節に関わる系統名の欄とは別に、花型の欄を作ります。2号資料に載る花型の名称は、輪咲きとスプレータイプです。この二つの名称だけから、写真の識別点や一本の茎に残す花数まで決めることはできません。",
          "knowledgeIds": [
            "AGR-K-S30-FACILITY-FLOWER-02"
          ]
        },
        {
          "id": "agr-s30-facility-flower-p3",
          "titleJa": "バラに使われる培地の掲載例",
          "textJa": "バラの施設栽培について、2号資料はロックウールを植え込み材料に使う養液栽培が主流だと説明しています。既習の養液栽培の仕組みに、バラという掲載例と固形培地の名前を対応させましょう。これは資料の記述であり、現在の全国普及率や全品種に適する装置仕様を示す数値ではありません。",
          "knowledgeIds": [
            "AGR-K-S30-FACILITY-FLOWER-03"
          ]
        },
        {
          "id": "agr-s30-facility-flower-p4",
          "titleJa": "バラの開花性と系統名",
          "textJa": "施設のバラについて資料に挙がるのは、四季咲き性をもつハイブリッドティー系とフロリバンダ系です。四季咲きという開花の性質と、二つの系統名を別々の情報として記録します。このページには系統別の枝の整え方や環境設定は示されていないため、系統名の対応から作業条件を補わないようにします。",
          "knowledgeIds": [
            "AGR-K-S30-FACILITY-FLOWER-04"
          ]
        },
        {
          "id": "agr-s30-facility-flower-p5",
          "titleJa": "ユリの球根処理で変わる方向",
          "textJa": "ユリの出荷時期を調節する説明では、球根の冷蔵を休眠の打破に結び付け、促成栽培の側に置いています。一方、冷凍処理は休眠を遅らせるものとして、抑制栽培と結び付けられています。冷たくする処理という一語で両方をまとめず、処理名・休眠への働き・作型を三つの欄で対応させます。温度や処理日数はここから決めません。",
          "knowledgeIds": [
            "AGR-K-S30-FACILITY-FLOWER-05"
          ]
        },
        {
          "id": "agr-s30-facility-flower-p6",
          "titleJa": "カーネーションを増やす仕事",
          "textJa": "2号資料はカーネーションを増やす方法として、さし芽を挙げています。大輪系かスプレー系かという生産する花のタイプの整理と、株を増やすための方法の整理は別です。ここで確認するのは繁殖方法の名称であり、採る芽の長さ、発根の条件、母株の選び方をこのページだけで決めるものではありません。",
          "knowledgeIds": [
            "AGR-K-S30-FACILITY-FLOWER-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "寒ギク",
          "reading": "かんぎく"
        },
        {
          "ja": "輪咲き",
          "reading": "りんざき"
        },
        {
          "ja": "四季咲き",
          "reading": "しきざき"
        },
        {
          "ja": "促成栽培",
          "reading": "そくせいさいばい"
        },
        {
          "ja": "抑制栽培",
          "reading": "よくせいさいばい"
        },
        {
          "ja": "さし芽",
          "reading": "さしめ"
        }
      ],
      "activityJa": "「植物・処理や分類の名前・説明の対象」の三欄を作り、キクの系統と花型、バラの培地と系統を整理します。続いて、ユリの二つの球根処理を、休眠への働きと作型へそれぞれ結び付けてください。",
