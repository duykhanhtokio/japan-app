  "lesson": {
    "id": "agr-s30-plant-detail",
    "revision": "v1",
    "chapter": "耕種農業一般",
    "levels": [
      "2"
    ],
    "titleJa": "花芽・発芽・作付計画の追加用語を段階で整理する",
    "objectiveJa": "二号資料の花芽分化と発芽の追加例・別名を区別し、作付けと経済的栽培を目指す作型の観点を説明できる。",
    "paragraphs": [
      {
        "id": "agr-s30-plant-detail-p1",
        "titleJa": "花になる芽と規則的な分化",
        "textJa": "花芽とは、後に花を付ける芽のことです。二号資料の規則的に花芽分化する型には、トマトに加え、ナス、ピーマン、キュウリも載っています。ある程度育った後の分化という掲載例を一群にまとめ、何日後なら全て同時に花が開くという意味にはしません。花芽の形成と開花は別の段階として記録します。",
        "knowledgeIds": [
          "AGR-K-S30-PLANT-DETAIL-01"
        ]
      },
      {
        "id": "agr-s30-plant-detail-p2",
        "titleJa": "短日型の掲載例を補う",
        "textJa": "暗い時間が一定の長さを超える条件に着目する短日植物として、二号資料にはトウガラシ、シソ、イチゴ、ダイズ、キク、アサガオが挙がっています。例えばダイズの札を整理するなら、「花芽分化の日長反応の例」という欄に置きます。この列挙だけで全品種に共通する暗期の時間数や開花日を決めないでください。",
        "knowledgeIds": [
          "AGR-K-S30-PLANT-DETAIL-02"
        ]
      },
      {
        "id": "agr-s30-plant-detail-p3",
        "titleJa": "長日と低温の欄を混ぜない",
        "textJa": "暗い時間が一定の長さより短い条件の例には、ホウレンソウ、ダイコン、コムギ、アスター、ナデシコがあります。同じ頁には低温による花芽分化の例としてダイコンなどもあります。ダイコンが二つの説明に現れても、日長と低温を同じ環境条件だとまとめません。掲載例と、何の条件を説明する欄なのかを一組で確かめます。",
        "knowledgeIds": [
          "AGR-K-S30-PLANT-DETAIL-03"
        ]
      },
      {
        "id": "agr-s30-plant-detail-p4",
        "titleJa": "作付けと作型の目的を区別する",
        "textJa": "播種や定植をして作物を栽培する行為を作付けと呼びます。一方、二号資料の作型は、地域や季節で異なる自然環境の下で経済的に栽培するための作付体系という説明です。例えば計画を説明するときは、種をまく日だけを作型とせず、環境に応じた組立てと経済的栽培を目指す観点を残します。これは、その計画なら必ず利益が出るという実績の保証ではありません。",
        "knowledgeIds": [
          "AGR-K-S30-PLANT-DETAIL-04"
        ]
      },
      {
        "id": "agr-s30-plant-detail-p5",
        "titleJa": "明発芽と好光性は同じ側の呼び名",
        "textJa": "光があると発芽しやすい性質をもつ明発芽種子は、好光性種子とも呼ばれます。二号資料の例はニンジンとレタスです。「明発芽」と「好光性」を二種類の別々の種子群として数えず、対応する名前としてまとめます。資料では薄く覆土する説明ですが、この区分名だけから覆土を何ミリにするかまでは決まりません。",
        "knowledgeIds": [
          "AGR-K-S30-PLANT-DETAIL-05"
        ]
      },
      {
        "id": "agr-s30-plant-detail-p6",
        "titleJa": "暗発芽と嫌光性を対応させる",
        "textJa": "光があると発芽しにくい暗発芽種子は、嫌光性種子という呼び名にも対応します。二号資料のこの欄に載るのはダイコン、トマト、スイカです。資料の相対的な説明では厚く覆土します。前の段落の花芽分化における長日・短日と、種子が発芽するときの光への反応は、対象の段階が違う分類として別欄に記しましょう。",
        "knowledgeIds": [
          "AGR-K-S30-PLANT-DETAIL-06"
        ]
      }
    ],
    "terms": [
      {
        "ja": "花芽",
        "reading": "かが"
      },
      {
        "ja": "好光性種子",
        "reading": "こうこうせいしゅし"
      },
      {
        "ja": "嫌光性種子",
        "reading": "けんこうせいしゅし"
      },
      {
        "ja": "作付け",
        "reading": "さくつけ"
      },
      {
        "ja": "作付体系",
        "reading": "さくつけたいけい"
      },
      {
        "ja": "作型",
        "reading": "さくがた"
      }
    ],
    "activityJa": "花芽分化、発芽、栽培計画の三つの欄を作り、掲載例と別名の札を置き分けます。ダイコンの日長・低温・発芽の説明は対象条件も併記します。最後に、作付けは行為、作型は環境と経済的栽培を考えた組立てと説明し、日数・厚さ・利益を資料にない数字で補わないことを確認します。",
    "targetMinutes": 30,
    "measuredMinutes": null,
