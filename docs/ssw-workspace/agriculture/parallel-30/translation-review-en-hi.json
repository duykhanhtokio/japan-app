  "patches": [
    {
      "locale": "en",
      "lessonId": "agr-s30-rice-detail",
      "field": "paragraphs",
      "paragraphId": "agr-s30-rice-detail-p4",
      "before": "For preparing harvested paddy rice, the No. 2 material lists heat drying. Separate its purpose of reducing moisture from its method of applying heat. Writing “heat drying” does not mean that the actual machine temperature or operating time has been checked. Do not reinterpret the moisture percentage of paddy rice as a dryer temperature setting.",
      "after": "For preparing harvested paddy rice, the No. 2 material lists fuel-heated drying. Separate its purpose of reducing moisture from its method of applying heat from fuel. Writing “fuel-heated drying” does not mean that the actual machine temperature or operating time has been checked. Do not reinterpret the moisture percentage of paddy rice as a dryer temperature setting.",
      "reason": "Preserve 火力乾燥 as fuel-heated drying rather than generic heat drying; no fuel type, temperature or duration is added."
    },
    {
      "locale": "hi",
      "lessonId": "agr-s30-rice-detail",
      "field": "paragraphs",
      "paragraphId": "agr-s30-rice-detail-p4",
      "before": "कटाई के बाद छिलके वाले धान की तैयारी में दूसरे स्तर की सामग्री ताप से सुखाने की विधि बताती है। नमी कम करने के उद्देश्य और ऊष्मा इस्तेमाल करने की विधि, इन दोनों जानकारियों को अलग रखें। “ताप से सुखाना” लिख देने का अर्थ यह नहीं कि वास्तविक मशीन का तापमान या चलाने का समय जाँच लिया गया है। धान की नमी के प्रतिशत को सीधे ड्रायर की तापमान सेटिंग न मानें।",
      "after": "कटाई के बाद छिलके वाले धान की तैयारी में दूसरे स्तर की सामग्री ईंधन की ऊष्मा से सुखाने की विधि बताती है। नमी कम करने के उद्देश्य और ईंधन की ऊष्मा इस्तेमाल करने की विधि, इन दोनों जानकारियों को अलग रखें। “ईंधन की ऊष्मा से सुखाना” लिख देने का अर्थ यह नहीं कि वास्तविक मशीन का तापमान या चलाने का समय जाँच लिया गया है। धान की नमी के प्रतिशत को सीधे ड्रायर की तापमान सेटिंग न मानें।",
      "reason": "Preserve 火力乾燥 as fuel-heated drying rather than generic heat drying; no fuel type, temperature or duration is added."
    }
