  "questions": [
    {
      "id": "agr-s30-soil-detail-q01",
      "objectiveId": "AGR-ASSESS-S30-SOIL-DETAIL-01",
      "topicJa": "かん水",
      "stemJa": "うね間かん水の比較メモに「大量の水が必要なので、資材や手間も多い」と書きました。2号の掲載説明に沿う修正はどれですか。",
      "optionsJa": [
        "水が多ければ、資材と労力の欄も水量と同じ評価にする。",
        "必要な水と資材・手間を分け、掲載例では資材や手間がかからない点も残す。",
        "資材や手間がかからないので、水の必要量も少ないと書き換える。",
        "資材や手間を問わず、水の量だけで三つの欄を代表させる。"
      ],
      "correctIndex": 1,
      "optionReasonsJa": [
        "水量から資材や労力も同じ評価だと推定しています。",
        "水量と資材・手間を別に比べる、掲載説明の対比を残しています。",
        "資材・手間の特徴から、水量まで少ないという説明へ逆に広げています。",
        "三つの異なる比較軸を、水量だけへまとめてしまっています。"
      ],
      "knowledgeIds": [
        "AGR-K-S30-SOIL-DETAIL-01"
      ],
      "lessonId": "agr-s30-soil-detail",
      "lessonSourceHash": "99fc3081607f12007267e0a1836bf79e200a3025ce486ab71116664cdadc3c05",
      "levels": [
