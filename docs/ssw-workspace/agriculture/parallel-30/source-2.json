  "lessons": [
    {
      "id": "agr-s30-soil-detail",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "かん水の比較と養分の取り込みを詳しく読む",
      "objectiveJa": "うね間方式の水・資材・手間を別々に比較し、チューブの材質例と吐出、必須元素の語義、元素と物質と取り込み部位、窒素の構成上の役割を説明できる。",
      "paragraphs": [
        {
          "id": "agr-s30-soil-detail-p1",
          "titleJa": "うね間方式は水と資材を別に比べる",
          "textJa": "2号のうね間かん水には、資材や手間がかからない一方、大量の水が必要だという比較があります。水の量が多いことから、資材や労力も必ず多いとまとめると、資料の説明と違ってしまいます。方式を比べるメモでは「必要な水」「資材」「手間」を分けましょう。この掲載例を、どのほ場でも準備や管理が全く不要という保証にはしません。",
          "knowledgeIds": [
            "AGR-K-S30-SOIL-DETAIL-01"
          ]
        },
        {
          "id": "agr-s30-soil-detail-p2",
          "titleJa": "チューブの材料と散水の仕組み",
          "textJa": "かん水チューブの掲載説明には、ビニールなどで作られ、多くの穴から水を散らすという特徴があります。材料の例と、水が出る仕組みを一組にして読みます。点滴かん水チューブについては、点滴孔から水滴を出す説明があるので、名前が似ていても同じ吐出の仕組みと決めつけません。ビニールなどという例を、全製品の材料を指定する言葉には変えません。",
          "knowledgeIds": [
            "AGR-K-S30-SOIL-DETAIL-02"
          ]
        },
        {
          "id": "agr-s30-soil-detail-p3",
          "titleJa": "必須元素という上位の言葉",
          "textJa": "植物の生育に欠かせない養分をまとめる言葉が、必須元素です。肥料の三要素という名前だけを覚えて終わらず、ここでは「生育に不可欠な養分を指す言葉」として整理します。資料間で確認が残る元素の総数や区分は、この課で一つに決めません。用語を理解したことと、実際にどの肥料をどれだけ補うかを決めたことも分けましょう。",
          "knowledgeIds": [
            "AGR-K-S30-SOIL-DETAIL-03"
          ]
        },
        {
          "id": "agr-s30-soil-detail-p4",
          "titleJa": "炭素は二酸化炭素と葉を結び付ける",
          "textJa": "2号の養分の説明では、炭素は、空気中の二酸化炭素を葉から取り込む経路と結び付いています。元素名の「炭素」、取り込む物質の「二酸化炭素」、取り込む部分の「葉」を別欄にして対応させます。これは土へ肥料として補う養分の説明とは区別されます。炭素という名称だけから、すべてを根で土から取り込むという記録にはしません。",
          "knowledgeIds": [
            "AGR-K-S30-SOIL-DETAIL-04"
          ]
        },
        {
          "id": "agr-s30-soil-detail-p5",
          "titleJa": "水素と酸素は水と根の経路も見る",
          "textJa": "同じ2号の説明は、水素と酸素について、根から水を吸収する経路を示しています。呼吸で酸素を取り込む既習の話と一緒に考えても、ここで述べる水に由来する取り込みを落とさないことが大切です。記録には「水素・酸素／水／根」と書き、前段の「炭素／二酸化炭素／葉」と比べます。元素、物質、部位の三欄を混同せず、個々の取り込み量はこの説明から推定しません。",
          "knowledgeIds": [
            "AGR-K-S30-SOIL-DETAIL-05"
          ]
        },
        {
          "id": "agr-s30-soil-detail-p6",
          "titleJa": "窒素の構成上の役割も残す",
          "textJa": "窒素の欄には、茎葉や葉色への関係だけでなく、タンパク質や葉緑体の構成成分として生育や収量性に関わるという説明があります。葉が濃いか薄いかという外からの観察と、植物の中の何を構成するかという説明を、同じ一欄に縮めないようにします。窒素と葉緑体の関係を学んでも、葉の見た目だけで原因を確定したり、追加量を決めたりはしません。",
          "knowledgeIds": [
            "AGR-K-S30-SOIL-DETAIL-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "うね間かん水",
