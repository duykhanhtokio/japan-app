  "lessons": [
    {
      "id": "agr-s37-rice-observation-detail",
      "revision": "v1",
      "chapter": "稲作作業",
      "levels": [
        "2"
      ],
      "titleJa": "分げつの目安と水田管理の目的を補って読む",
      "objectiveJa": "分げつの三つの目安と水田管理の因果・目的を資料の条件付きで整理し、深水の予防例、二つの病名、穎花という用語を区別して説明できる。",
      "paragraphs": [
        {
          "id": "agr-s37-rice-observation-detail-p1",
          "titleJa": "分げつの開始・継続・茎数を一つの例として読む",
          "textJa": "2号資料には、分げつが移植後およそ3週間で始まり、その後およそ6週間続くという例があります。開始までの期間と、始まってからの継続期間は、数え始める点が異なります。一苗の茎がおよそ20本になると止まるという説明も、同じ資料の目安として読みます。この三つを、全ての田の予定日や目標本数に置き換えず、一つの観察記録にまとめます。",
          "knowledgeIds": [
            "AGR-K-S37-RICE-OBSERVATION-01"
          ]
        },
        {
          "id": "agr-s37-rice-observation-detail-p2",
          "titleJa": "湛水を続けることと根の健康の関係",
          "textJa": "2号資料は、湛水状態を続けると、穂にならない無効分げつが多くなり、土壌の還元状態が進んで有害物質が生じ、根の健康も悪くなりやすいと説明しています。既習の分げつの定義に加え、水の状態と土壌・根の変化を関係付けて整理します。この説明を、全ての田で必ず同じ変化が起こるという断定にはしません。ここから薬剤や水管理の具体的な日数を決めることもありません。",
          "knowledgeIds": [
            "AGR-K-S37-RICE-OBSERVATION-02"
          ]
        },
        {
          "id": "agr-s37-rice-observation-detail-p3",
          "titleJa": "中干しの目的を根と地盤で分ける",
          "textJa": "中干しは田の水を抜いて田面を干す仕事です。2号資料は、その目的として根の活力を高めることと、地耐力を高めることの二つを挙げています。根についての説明と、田の地盤についての説明を別々の欄に残しましょう。根への影響を知るだけで、地盤の状態まで確認できたとはしません。この課は目的を分けて読むもので、資料の時期表現を全圃場共通の実施日や継続日数へ置き換えません。",
          "knowledgeIds": [
            "AGR-K-S37-RICE-OBSERVATION-03"
          ]
        },
        {
          "id": "agr-s37-rice-observation-detail-p4",
          "titleJa": "深水を雑草予防の掲載例として整理する",
          "textJa": "2号資料の水田雑草の説明では、秋や春先の耕うん、丁寧な代かきに加え、深水にすることが雑草の発生を少なくする例として挙がっています。作業の種類と、雑草発生の低減という目的を対応させます。これは全ての生育段階で水を深く保つ指示ではなく、この記述だけで水深、期間、入水や落水の日程を決めるものでもありません。",
          "knowledgeIds": [
            "AGR-K-S37-RICE-OBSERVATION-04"
          ]
        },
        {
          "id": "agr-s37-rice-observation-detail-p5",
          "titleJa": "病名の記録と見分ける力を区別する",
          "textJa": "2号資料は稲作の病害例として、いもち病とごま葉枯れ病を挙げています。この二つは別の病名として記録します。病名が二つ示されていることと、写真から二つを見分けられることは別です。名称だけから、ごま葉枯れ病と葉いもちの症状の比較や診断までできるとは考えません。実際の症状を判断するときに必要な確認を、この病名の説明だけで置き換えないようにします。",
          "knowledgeIds": [
            "AGR-K-S37-RICE-OBSERVATION-05"
          ]
        },
        {
          "id": "agr-s37-rice-observation-detail-p6",
          "titleJa": "えい花という用語を穂全体と分ける",
          "textJa": "2号資料は、イネ科植物の花を「えい花」と説明しています。ここでは穎花（えいか）という用語を、花の呼び方として記録します。幼穂ができる段階や、穂が外へ出る段階を整理するときも、花という単位と穂全体を同じ語にまとめないようにします。この用語を知っただけで、実際の穂の観察や追肥の時期・量を判断できるという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-S37-RICE-OBSERVATION-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "分げつ",
          "reading": "ぶんげつ"
        },
        {
          "ja": "湛水",
          "reading": "たんすい"
        },
        {
          "ja": "還元",
          "reading": "かんげん"
        },
        {
          "ja": "地耐力",
          "reading": "ちたいりょく"
        },
        {
          "ja": "深水",
          "reading": "しんすい"
        },
        {
          "ja": "穎花",
          "reading": "えいか"
        }
      ],
      "activityJa": "分げつの資料例を、移植から開始まで・開始後の継続・一苗の茎数の三欄に整理します。次に、湛水・土壌・根の関係と、中干しの二つの目的を別々に書きます。深水の掲載目的、二つの病名、穎花の意味を確認し、資料からは決められない日程や診断を記録に書き足さないよう見直します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
