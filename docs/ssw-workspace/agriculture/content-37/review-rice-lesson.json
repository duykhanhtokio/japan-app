  "decisions": [
    {
      "paragraphId": "agr-s37-rice-observation-detail-p1",
      "decision": "accept",
      "reasonJa": "移植後約三週間・開始後約六週間・一苗約二十本がPDF62の例に一致。開始と継続の起点を分離し、全田への目標を強制しない。"
    },
    {
      "paragraphId": "agr-s37-rice-observation-detail-p2",
      "decision": "accept",
      "reasonJa": "PDF62の連続湛水・無効分げつ・還元進行・有害物質・根の健康の関係に一致。全圃場必発や具体的処方へ広げない。"
    },
    {
      "paragraphId": "agr-s37-rice-observation-detail-p3",
      "decision": "accept",
      "reasonJa": "PDF66の根の活力と地耐力という二目的に一致。既習の中干しの作業定義へ目的を追加し、実施日数を決めない。"
    },
    {
      "paragraphId": "agr-s37-rice-observation-detail-p4",
      "decision": "accept",
      "reasonJa": "PDF66の耕種的防除の深水例に一致。既習の秋春耕うん・代かきは前提として参照し、水深と日程を創作しない。"
    },
    {
      "paragraphId": "agr-s37-rice-observation-detail-p5",
      "decision": "accept",
      "reasonJa": "PDF67に二病名がある。名称の説明と外観比較・診断を区別。0215の認識保留は別記され、閉鎖対象に入っていない。"
    },
    {
      "paragraphId": "agr-s37-rice-observation-detail-p6",
      "decision": "accept",
      "reasonJa": "PDF67のイネ科植物の花というえい花の説明に一致。穂全体や追肥条件と分離する。"
    }
  ],
