  "currentOverlapBindings": [
    {
      "lessonId": "agr-pest-foundation",
      "lessonSourceHash": "e2a082542bd9f5809055c29015b12fd541107c32b5f446f0c338f1085473b51f",
      "paragraphId": "agr-pest-foundation-p1",
      "paragraphSha256": "41bdaab8d6d55afb31b6d1f1d6900d60cbc6fe75116231a11ae109ce7f97fb87",
      "textJa": "病害虫対策では、発生した後の処置だけでなく、発生しにくい環境をつくることが基本です。生育環境を観察することと、被害の有無を確認することをつなげます。"
    },
    {
      "lessonId": "agr-pest-ipm",
      "lessonSourceHash": "4b5c989cf3e4d35093895407a282f89632e7ffe99a509d8c0db5de1edcee14b0",
      "paragraphId": "agr-pest-ipm-p3",
      "paragraphSha256": "71305ad3022486b57de8f5485fe633f4549993d50c9698f1f289698a0dea7eeb",
      "textJa": "品種、栽培方法、圃場の条件を調整して、病害虫が発生しにくい条件にします。輪作、抵抗性品種、枯れ枝や落ち葉の整理などを、この考え方と関連付けます。"
    },
    {
      "lessonId": "agr-soil-biological-2",
      "lessonSourceHash": "8591d5fa198b6048dcfff5a0f676037b18d714adab04a0c7b4a0fb9a9858a7bb",
      "paragraphId": "agr-soil-biological-2-p5",
      "paragraphSha256": "3de56c7a3b4f131aca0947798107d8adf39dac5b771986998fb28e6cd0087413",
      "textJa": "資料は土壌微生物に細菌、放線菌、糸状菌、藻類を、土壌動物にセンチュウ類やミミズを挙げています。異なる生物の群を、すべて同じ名前でまとめないようにします。"
    }
  ],
  "newScopeJa": "既習の病原体分類と予防一般を繰り返すのでなく、糸状菌に多い環境傾向・風で運ばれる胞子と、細菌の別名・分裂による増殖という未説明部分を補う。",
  "excludedSourceItems": [
    {
      "sourceItemId": "AGR-A10-SAFETY-0254",
      "reasonJa": "保留中の放線菌・菌糸の分類説明を加えず、根拠の未確定な科学的一般化を避ける。"
    }
  ],
  "limitsJa": "温暖多湿を全糸状菌共通条件にせず、病気の必発、伝播速度、現場の防除処方を決めない。全細菌が病原体であるとも記さない。",
