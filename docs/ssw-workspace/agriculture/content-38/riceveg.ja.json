  "lessons": [
    {
      "id": "agr-s38-vegetable-environment-seed-detail",
      "revision": "v1",
      "chapter": "畑作・野菜作業",
      "levels": [
        "2"
      ],
      "titleJa": "畑作・野菜の水分・温度と種子の条件を補って読む",
      "objectiveJa": "過湿への弱さ、生育適温表の作物別の範囲、発芽時の酸素不足、保存状態と種子寿命、加工種子の目的を、資料の条件と既習内容との差を残して説明できる。",
      "paragraphs": [
        {
          "id": "agr-s38-vegetable-environment-seed-detail-p1",
          "titleJa": "畑作物とイモ類の過湿への弱さを読む",
          "textJa": "2号資料は、畑で栽培する作物には過湿に弱いものが多く、排水などの過湿対策が必要だと説明しています。イモ類の説明でも、ジャガイモやサツマイモなどの過湿への弱さを挙げています。畑作物に多いという傾向と、掲載されたイモ類の例を区別して整理しましょう。全ての種類・品種で同じ程度の影響があるとは決めず、この記述だけで排水溝の深さや具体的な灌水量を設定しません。",
          "knowledgeIds": [
            "AGR-K-S38-RICEVEG-DETAIL-01"
          ]
        },
        {
          "id": "agr-s38-vegetable-environment-seed-detail-p2",
          "titleJa": "果菜類の生育適温を表の条件付きで対応させる",
          "textJa": "2号資料の生育適温表では、キュウリは18～25℃、メロン・スイカ・ナスは25～30℃、トマト・ピーマンは20～25℃の行に対応します。同じ果菜類でも、一つの温度帯へまとめず、作物名と範囲を組にして記録します。この表は発芽適温の表ではありません。資料の生育適温という条件を残し、どの品種や生育段階にも共通するハウス設定値として使わないようにします。",
          "knowledgeIds": [
            "AGR-K-S38-RICEVEG-DETAIL-02"
          ]
        },
        {
          "id": "agr-s38-vegetable-environment-seed-detail-p3",
          "titleJa": "葉菜類などの生育適温をまとめて読む",
          "textJa": "同じ生育適温表は、タマネギを15～23℃、ニンジンを18～22℃としています。ネギ・レタス・ホウレンソウ・ダイコン・キャベツ・ハクサイは15～20℃の行です。タマネギとネギのように名前が近いものも、同じ範囲だと置き換えず、掲載された対応を確認します。ここで比較するのは資料表の生育適温で、全地域・全生育段階の管理温度を一律に指定するものではありません。",
          "knowledgeIds": [
            "AGR-K-S38-RICEVEG-DETAIL-03"
          ]
        },
        {
          "id": "agr-s38-vegetable-environment-seed-detail-p4",
          "titleJa": "発芽前の過剰な水と酸素不足をつなげる",
          "textJa": "発芽には水・温度・酸素が必要であることは既習です。2号資料は、水を与え過ぎると酸素が不足し、発芽が悪くなると説明しています。「水を増やせば発芽がよくなる」と一方向だけに考えず、水と酸素という二つの条件を関係付けて整理します。成長後の根の障害の説明とは、生育段階を分けて記録しましょう。この因果から、全ての種子に共通する水量や灌水回数は決めません。",
          "knowledgeIds": [
            "AGR-K-S38-RICEVEG-DETAIL-04"
          ]
        },
        {
          "id": "agr-s38-vegetable-environment-seed-detail-p5",
          "titleJa": "保存状態が悪いと寿命が短くなる方向を読む",
          "textJa": "種子の寿命が種類と保存条件で変わるという説明に加え、2号資料は保存状態が悪いと寿命が短くなる方向を明示しています。寿命の表にある年数を見たら、保存状態の記録も合わせて確認します。低温・乾燥という保存の原則を知っていても、ある年数まで全ての種子が必ず発芽するという保証にはなりません。この課は保存状態と寿命の関係を読むもので、実物の発芽率や使用期限を判定するものではありません。",
          "knowledgeIds": [
            "AGR-K-S38-RICEVEG-DETAIL-05"
          ]
        },
        {
          "id": "agr-s38-vegetable-environment-seed-detail-p6",
          "titleJa": "加工した種子の目的を三つに分ける",
          "textJa": "加工した種子の目的として、2号資料は、まきやすくすること、発芽をよくすること、病気を予防することを挙げています。既習のコーティング種子・種子消毒種子・シードテープの形や名称と、加工をする目的の欄を分けて整理しましょう。発芽をよくするという目的があることは、全ての加工種子が必ず同じ発芽率になるという意味ではありません。この説明だけで製品の選択や薬剤の処理条件を決めることもしません。",
          "knowledgeIds": [
            "AGR-K-S38-RICEVEG-DETAIL-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "過湿",
          "reading": "かしつ"
        },
        {
          "ja": "生育適温",
          "reading": "せいいくてきおん"
        },
        {
          "ja": "灌水",
          "reading": "かんすい"
        },
        {
          "ja": "酸素",
          "reading": "さんそ"
        },
        {
          "ja": "寿命",
          "reading": "じゅみょう"
        },
        {
          "ja": "加工種子",
          "reading": "かこうしゅし"
        }
      ],
      "activityJa": "過湿の影響を畑の作物と発芽前の種子に分けて記録します。次に、生育適温表の作物名と温度範囲を対応させ、発芽適温やハウス設定値へ置き換えていないか確かめます。保存状態による寿命の変化と、種子加工の三つの目的をまとめ、資料からは決められない水量・期限・製品条件を一つずつ挙げます。",
