  "lessons": [
    {
      "id": "agr-s38-facility-cover-details",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "2"
      ],
      "titleJa": "施設の被覆資材を比較と使い方から読む",
      "objectiveJa": "硬質板とフィルムの比較、内張りの目的、アクリル板と農PO系の注意を、資料の対象と条件を保って説明できる。",
      "paragraphs": [
        {
          "id": "agr-s38-facility-cover-details-p1",
          "titleJa": "硬質板は形と衝撃の説明を分ける",
          "textJa": "施設の硬質板には、平らな板状と波状のものがあると2号資料は説明しています。資料は、雹などの落下物による衝撃に強いという特徴も挙げています。板の表面が平らか波状かという形の情報と、衝撃に対する性質の情報を別の欄にします。既習のPC板という材料名だけに整理を任せず、形と材料を対応させましょう。ただし、この説明で全ての厚さや製品の耐衝撃性能が同じになるわけではありません。",
          "knowledgeIds": [
            "AGR-K-S38-FACILITY-COVER-DETAILS-01"
          ]
        },
        {
          "id": "agr-s38-facility-cover-details-p2",
          "titleJa": "硬質フィルムと硬質板を比較する",
          "textJa": "2号資料は、硬質フィルムを硬質板と比べ、耐用年数は短い一方で軽い資材として説明しています。比較するときは、軽さと長く使えるかどうかを同じ長所としてまとめないようにします。既習の硬質フィルムの耐久年数に関する説明と並べる場合も、どの資材同士を比べているのかを残します。この相対的な比較だけで、手元の製品の交換日や、全製品に共通する寿命を決めることはできません。",
          "knowledgeIds": [
            "AGR-K-S38-FACILITY-COVER-DETAILS-02"
          ]
        },
        {
          "id": "agr-s38-facility-cover-details-p3",
          "titleJa": "内張りの保湿を保温と区別する",
          "textJa": "ハウス内側の内張りは、2号資料では保温だけでなく保湿などを目的に使われるものとして紹介されています。熱を保つという説明と、湿り気を保つという説明を分け、同じ言葉で記録しないようにします。内張りという位置の名前だけから目的を一つに決めることもできません。保湿という目的があることは、過湿を避ける必要がないという意味ではなく、湿度をどこまで高めるかの設定値を示すものでもありません。",
          "knowledgeIds": [
            "AGR-K-S38-FACILITY-COVER-DETAILS-03"
          ]
        },
        {
          "id": "agr-s38-facility-cover-details-p4",
          "titleJa": "開閉は昼間の遮光や遮熱にも関わる",
          "textJa": "2号資料は、内張り資材が保温性の向上に加え、昼間の遮光や遮熱などのためにも開閉できるよう設置されると説明しています。季節、時間、作物などで管理が異なる点を残して読みましょう。既習の可動式カーテンという構造の名前に、何のために開閉するのかという目的を補って整理します。この記述だけで、全ての日に共通する開け閉めの時刻や、同じ開度を指定することはしません。",
          "knowledgeIds": [
            "AGR-K-S38-FACILITY-COVER-DETAILS-04"
          ]
        },
        {
          "id": "agr-s38-facility-cover-details-p5",
          "titleJa": "アクリル板の伸縮性と展張の注意",
          "textJa": "硬質板のアクリル板について、2号資料は伸縮性が大きいため展張時に注意が必要だと説明しています。材料を張って設置する仕事の記録では、「硬い板である」という分類だけでなく、伸び縮みする性質も別の確認点にします。アクリル板のこの注意を、全ての被覆資材に同じ性質があるという説明へ広げないようにします。このページから伸縮量、取付けの間隔や、具体的な施工手順を独自に決めることはできません。",
          "knowledgeIds": [
            "AGR-K-S38-FACILITY-COVER-DETAILS-05"
          ]
        },
        {
          "id": "agr-s38-facility-cover-details-p6",
          "titleJa": "農PO系の白濁と光の通りを関係付ける",
          "textJa": "2号資料は、農PO系特殊フィルムについて、裂けにくい一方で、繰り返すこすれや強い衝撃を受けた箇所が白濁し、光の透過率が大きく下がると説明しています。破れが見えないことだけで、光を通す状態も変わっていないとは判断しません。白く濁った箇所と、こすれや衝撃を受けた場所を対応させて読みます。この記述だけで交換の時期を確定したり、透過率の低下を一律の数値にしたりしません。",
          "knowledgeIds": [
            "AGR-K-S38-FACILITY-COVER-DETAILS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "硬質板",
          "reading": "こうしつばん"
        },
        {
          "ja": "硬質フィルム",
          "reading": "こうしつふぃるむ"
        },
        {
          "ja": "保湿",
