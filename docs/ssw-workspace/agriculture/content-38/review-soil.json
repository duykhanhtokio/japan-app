  "decisions": [
    {
      "paragraphId": "agr-s38-soil-condition-drainage-p1",
      "decision": "accept",
      "reasonJa": "S2PDF25は日本の作物の多くにpH5.5～6.5を明記。既存本文は作物別の範囲だけで、この一般値はない。表に異なる範囲もあるという限定を保持し、石灰量や全作物設定へ変えない。",
      "sourceBacklogBindings": [
        {
          "sourceItemId": "AGR-A10-SOIL-0150",
          "documentId": "AGR-S2",
          "pdfPage": 25,
          "objectiveJa": "多くの作物の一般範囲を例外のある説明として読む。"
        }
      ],
      "countsAsClosedSourceOccurrence": false,
      "independentQuestionCapacityCertified": false
    },
    {
      "paragraphId": "agr-s38-soil-condition-drainage-p2",
      "decision": "accept",
      "reasonJa": "S2PDF26の握って固まる程度という準備条件を確認。既存ph-measure-p4は十分湿らせるまでで、この程度の説明を欠く。既存土性の握り試験とは目的を明確に分けている。",
      "sourceBacklogBindings": [
        {
          "sourceItemId": "AGR-A10-SOIL-0189",
          "documentId": "AGR-S2",
          "pdfPage": 26,
          "objectiveJa": "簡易器具例の握ると固まる程度という湿らせ方を、全機種へ一般化せず読む。"
        }
      ],
      "countsAsClosedSourceOccurrence": false,
      "independentQuestionCapacityCertified": false
    },
    {
      "paragraphId": "agr-s38-soil-condition-drainage-p3",
      "decision": "accept",
      "reasonJa": "S2PDF27の特定養分の欠乏・過剰を明示。既存rotation-p2の偏りという総称を二方向へ補足する。原因をこれだけに限定せず、不足の決め付けや施肥量へ進まない。",
      "sourceBacklogBindings": [
        {
          "sourceItemId": "AGR-A10-SOIL-0216",
          "documentId": "AGR-S2",
          "pdfPage": 27,
          "objectiveJa": "連作障害の一因として養分不足を整理する。"
        },
        {
          "sourceItemId": "AGR-A10-SOIL-0219",
          "documentId": "AGR-S2",
          "pdfPage": 27,
          "objectiveJa": "2号の特定養分の過剰も原因となる説明を、欠乏と分けて示す。"
        }
      ],
      "countsAsClosedSourceOccurrence": false,
      "independentQuestionCapacityCertified": false
    },
    {
      "paragraphId": "agr-s38-soil-condition-drainage-p4",
      "decision": "accept",
      "reasonJa": "S2PDF27は薬剤や太陽光による土壌消毒を挙げる。既存rotation-p5の総称とphysical-controls-p4の熱利用一般は関連するが土壌消毒の具体的利用例の対応は不足。土壌文脈の補足のみで、独立した新問容量の認定ではない。",
      "sourceBacklogBindings": [
        {
          "sourceItemId": "AGR-A10-SOIL-0231",
          "documentId": "AGR-S2",
          "pdfPage": 27,
          "objectiveJa": "土壌消毒の太陽光利用と薬剤利用の方法名を区別する。"
        }
      ],
      "countsAsClosedSourceOccurrence": false,
      "independentQuestionCapacityCertified": false
    },
    {
      "paragraphId": "agr-s38-soil-condition-drainage-p5",
      "decision": "accept",
      "reasonJa": "S2PDF34の素焼き土管と専用穴あき管を確認。既存排水p2の一般構造に材料名を補う。既存の排水見出し不一致は保持し、規格・深さへ一般化しない。",
      "sourceBacklogBindings": [
        {
          "sourceItemId": "AGR-A10-SOIL-0502",
          "documentId": "AGR-S2",
          "pdfPage": 34,
          "objectiveJa": "素焼き土管と穴あき専用管という材料例を区別する。"
        }
      ],
      "countsAsClosedSourceOccurrence": false,
      "independentQuestionCapacityCertified": false
    },
    {
      "paragraphId": "agr-s38-soil-condition-drainage-p6",
      "decision": "accept",
      "reasonJa": "S2PDF35の限定された改善範囲と比較的簡単な施工の対比。既存排水p5は範囲のみ、施工容易性を欠く。費用や効果の保証に変換せず客土用法のholdも維持。",
      "sourceBacklogBindings": [
        {
          "sourceItemId": "AGR-A10-SOIL-0539",
          "documentId": "AGR-S2",
          "pdfPage": 35,
          "objectiveJa": "限定部分の排水改善と比較的簡単な施工というトレードオフを説明する。"
        }
      ],
      "countsAsClosedSourceOccurrence": false,
      "independentQuestionCapacityCertified": false
    }
