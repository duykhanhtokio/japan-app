  "decisions": [
    {
      "paragraphId": "agr-s38-vegetable-environment-seed-detail-p1",
      "decision": "accept_source_bound_prose",
      "reasonJa": "PDF71は畑作物には過湿に弱いものが多いという傾向を、PDF72はジャガイモやサツマイモなどのイモ類の過湿への弱さを明示。既存environment-p5の一般的な酸素不足・根腐れだけとは対象付きの補足が異なる。「多い」及び例の対象を保持し全種類の一律処方へ広げない。",
      "sourceItemIds": [
        "AGR-A10-RICE-0494",
        "AGR-A10-RICE-0533"
      ],
      "sourceOccurrencesClosedByThisReview": 0,
      "independentQuestionCapacityCredit": 0
    },
    {
      "paragraphId": "agr-s38-vegetable-environment-seed-detail-p2",
      "decision": "accept_source_bound_prose",
      "reasonJa": "PDF80の左側の生育適温表で、キュウリ18〜25、メロン・スイカ・ナス25〜30、トマト・ピーマン20〜25℃の全六対応を直接確認。発芽適温と混同せず、施設設定値にしない制限は適切。温度行ごとに独立問題容量を増やさない。",
      "sourceItemIds": [
        "AGR-A10-RICE-0712",
        "AGR-A10-RICE-0713",
        "AGR-A10-RICE-0714",
        "AGR-A10-RICE-0715",
        "AGR-A10-RICE-0716",
        "AGR-A10-RICE-0717"
      ],
      "sourceOccurrencesClosedByThisReview": 0,
      "independentQuestionCapacityCredit": 0
    },
    {
      "paragraphId": "agr-s38-vegetable-environment-seed-detail-p3",
      "decision": "accept_source_bound_prose",
      "reasonJa": "PDF80でタマネギ15〜23、ニンジン18〜22、ネギ・レタス・ホウレンソウ・ダイコン・キャベツ・ハクサイ15〜20℃の全八対応を直接確認。前段と一つの表を読みやすく分けた二段落として採用し、14別能力へ認定しない。",
      "sourceItemIds": [
        "AGR-A10-RICE-0718",
        "AGR-A10-RICE-0719",
        "AGR-A10-RICE-0720",
        "AGR-A10-RICE-0721",
