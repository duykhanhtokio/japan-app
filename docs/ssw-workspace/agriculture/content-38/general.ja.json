  "lessons": [
    {
      "id": "agr-s38-plant-classification-seedling-signs",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "葉の性質による分類と苗の観察を補う",
      "objectiveJa": "常緑・落葉と資料の野菜の定義を整理し、施設栽培の傾向と苗の勢い・細根という観察項目を、対象と限界を保って説明できる。",
      "paragraphs": [
        {
          "id": "agr-s38-plant-classification-seedling-signs-p1",
          "titleJa": "常緑果樹の葉の性質",
          "textJa": "常緑果樹は、一年を通して葉を付けている果樹です。果樹を分類するときは、果実の色や味だけでなく、葉がある時期にも着目しましょう。この説明を、同じ一枚の葉がいつまでも残るという意味に広げません。",
          "knowledgeIds": [
            "AGR-K-S38-PLANT-CLASSIFICATION-SIGNS-01"
          ]
        },
        {
          "id": "agr-s38-plant-classification-seedling-signs-p2",
          "titleJa": "落葉果樹の葉の性質",
          "textJa": "資料は、寒くなると葉が落ちる果樹を落葉果樹として説明しています。常緑・落葉を区別するときは、葉の挙動を確認します。ここでいう季節の説明から、どの地域や品種も同じ月に落葉するという日程は決められません。",
          "knowledgeIds": [
            "AGR-K-S38-PLANT-CLASSIFICATION-SIGNS-02"
          ]
        },
        {
          "id": "agr-s38-plant-classification-seedling-signs-p3",
          "titleJa": "暑い国由来の果樹と施設栽培",
          "textJa": "二号資料は、暑い国に由来する果樹では施設で栽培されることが多いと述べています。果樹の由来する気候と、栽培に使う施設を対応させて読む例です。「多い」という傾向を、すべての果樹に必ず施設が必要という条件に変えません。",
          "knowledgeIds": [
            "AGR-K-S38-PLANT-CLASSIFICATION-SIGNS-03"
          ]
        },
        {
          "id": "agr-s38-plant-classification-seedling-signs-p4",
          "titleJa": "野菜の利用部位と草本という説明",
          "textJa": "二号資料のこの説明では、葉・茎・花・果実などを利用する草本類を野菜としています。利用する部分と、草本という植物の性質を別々に整理しましょう。例示された部位だけを根拠に、根を利用する野菜が含まれないと判断するものではありません。",
          "knowledgeIds": [
            "AGR-K-S38-PLANT-CLASSIFICATION-SIGNS-04"
          ]
        },
        {
          "id": "agr-s38-plant-classification-seedling-signs-p5",
          "titleJa": "窒素不足の例は葉色と苗の勢いを分ける",
          "textJa": "2号資料の健苗の説明では、窒素肥料が不足した場合、下葉が黄色くなることに加えて、苗の勢いが落ちるとされています。既習の葉色や葉の大きさの記録だけで終わらず、苗の勢いという観察項目を別に残します。これは資料に掲載された関係を整理する説明です。黄色い葉や勢いの弱さを一つ見ただけで原因を窒素不足と確定したり、追加する肥料の量を決めたりはしません。",
          "knowledgeIds": [
            "AGR-K-S38-PLANT-CLASSIFICATION-SIGNS-05"
          ]
        },
        {
          "id": "agr-s38-plant-classification-seedling-signs-p6",
          "titleJa": "良い苗木は細根と病害虫の状態も見る",
          "textJa": "2号資料は良い苗木について、細い根がよく伸びていることと、病害虫に侵されていないことを挙げています。細根の発達と病害虫の有無を別々の確認項目にして、どちらを観察したか記録しましょう。穂木の品種の品質や、台木に求める抵抗性を知ることだけでは、苗木そのもののこの二項目を確認したことにはなりません。この説明は根の長さの数値基準や、見た目だけで病害虫がないと確定する診断方法を示すものではありません。",
          "knowledgeIds": [
            "AGR-K-S38-PLANT-CLASSIFICATION-SIGNS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "常緑果樹",
          "reading": "じょうりょくかじゅ"
        },
        {
          "ja": "落葉果樹",
          "reading": "らくようかじゅ"
        },
        {
          "ja": "草本",
          "reading": "そうほん"
        },
        {
          "ja": "細根",
          "reading": "さいこん"
        }
      ],
      "activityJa": "常緑・落葉は葉の挙動、暑い国由来の果樹は栽培環境、野菜は利用部位と草本という性質に分けて整理します。苗の観察記録には葉色と勢い、細根と病害虫の状態を別欄で書き、名称や一つの外観だけから決められないことを説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
