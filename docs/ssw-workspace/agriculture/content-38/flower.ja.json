  "lessons": [
    {
      "id": "agr-s38-flower-additional-examples",
      "revision": "v1",
      "chapter": "花き栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "花きの追加品目を資料の区分へ対応させる",
      "objectiveJa": "トルコギキョウの掲載名・特徴と、花き分類表の追加例を区分別に整理し、利用時期や実物の識別、個別の栽培条件と混同せず説明できる。",
      "paragraphs": [
        {
          "id": "agr-s38-flower-additional-examples-p1",
          "titleJa": "トルコギキョウの掲載名と特徴を分ける",
          "textJa": "2号資料のトルコギキョウの欄には、ユーストマという表記もあります。一年草の切り花としての利用、白やピンクなどの花色、覆輪の品種、日持ちのよさを、それぞれ別の情報として整理します。日持ちの記述から具体的な日数を保証したり、掲載名だけで現在の学名体系を確認したとしたりはしません。花色の説明を、バラやカーネーションと確実に見分ける特徴へ置き換えないことも大切です。",
          "knowledgeIds": [
            "AGR-K-S38-FLOWER-EXAMPLES-01"
          ]
        },
        {
          "id": "agr-s38-flower-additional-examples-p2",
          "titleJa": "非耐寒性一年草の追加例を読む",
          "textJa": "分類表の非耐寒性一年草には、マリーゴールド、インパチェンス、ベゴニアセンパフローレンス、コスモス、ヒマワリも載っています。既習の季節別の花壇利用や、マリーゴールドの土壌センチュウに関する例とは、照合する欄が異なります。ここでは五つの掲載名を寒さへの性質の欄に対応させ、品種ごとの最低温度や、どの地域でも同じ季節に植える日程までは決めません。",
          "knowledgeIds": [
            "AGR-K-S38-FLOWER-EXAMPLES-02"
          ]
        },
        {
          "id": "agr-s38-flower-additional-examples-p3",
          "titleJa": "耐寒性一年草の追加例を一組で記録する",
          "textJa": "耐寒性一年草の欄には、ビオラ、プリムラ類、ハボタン、デージー、キンセンカ、ヤグルマギク、ルピナスが挙げられています。ビオラやデージーを花壇の利用時期の欄で見たことがあっても、今回は園芸的分類の対応として記録します。プリムラ類は本来の性質と園芸利用上の一年草という扱いを分ける既習の注意も保ち、耐寒性という語を全品種の越冬保証にはしません。",
          "knowledgeIds": [
            "AGR-K-S38-FLOWER-EXAMPLES-03"
          ]
        },
        {
          "id": "agr-s38-flower-additional-examples-p4",
          "titleJa": "宿根草の未整理の品目を対応させる",
          "textJa": "宿根草の追加例として、資料はゼラニウム、シュッコンカスミソウ、キキョウ、ハナショウブ、マーガレットを挙げています。キクやカーネーションだけで宿根草の一覧を終えず、受け取った品目名をこの欄へ戻して照合します。表の区分を知ったことと、実際の株を何年間栽培するかを決めることは別です。掲載名の対応から、未確認の写真の識別点や管理条件を補いません。",
          "knowledgeIds": [
            "AGR-K-S38-FLOWER-EXAMPLES-04"
          ]
        },
        {
          "id": "agr-s38-flower-additional-examples-p5",
          "titleJa": "球根類の内側の区分を追加例で確かめる",
          "textJa": "球根類の表では、スイセンとヒヤシンスはりん茎、クロッカスは球茎、球根ベゴニアは塊茎、スイレンは根茎の欄にあります。球根という見出しだけで照合を終えず、品目名と内側の区分を一組にします。例えば球根ベゴニアの「球根」という名前だけから、りん茎の欄へ移すことはできません。この対応を学ぶことを、実物の地下部の形を画像で識別済みという意味にはしません。",
          "knowledgeIds": [
            "AGR-K-S38-FLOWER-EXAMPLES-05"
          ]
        },
        {
          "id": "agr-s38-flower-additional-examples-p6",
          "titleJa": "花木の名前を似た別の掲載名と混同しない",
          "textJa": "花木の欄には、センリョウ、ボタン、ハイビスカス、ピラカンサも載っています。バラやアジサイ、既習のツバキなどと同じ園芸的な欄へ対応させます。ボタンという掲載名を、別に学んだマツバボタンやハボタンの名の一部とだけ照合して、同じ品目として処理しないようにします。ここで確認するのは表の品目と花木の対応であり、植物の科名、出荷形態、剪定方法を一度に決めるものではありません。",
          "knowledgeIds": [
            "AGR-K-S38-FLOWER-EXAMPLES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "ユーストマ",
          "reading": "ゆーすとま"
        },
        {
          "ja": "非耐寒性",
          "reading": "ひたいかんせい"
        },
        {
          "ja": "耐寒性",
          "reading": "たいかんせい"
        },
        {
          "ja": "宿根草",
          "reading": "しゅっこんそう"
        },
        {
          "ja": "りん茎",
          "reading": "りんけい"
        },
        {
          "ja": "花木",
          "reading": "かぼく"
        }
      ],
      "activityJa": "掲載名と区分の二欄を作り、追加例を一年草・宿根草・球根類・花木へ対応させます。球根類は内側の区分も書きます。次に、既習の花壇利用の季節と今回の分類が違う情報である例を一つ選び、表の対応だけでは分からない実物の特徴や栽培条件も区別して記録します。",
      "targetMinutes": 30,
