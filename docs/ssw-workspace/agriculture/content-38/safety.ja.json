  "lessons": [
    {
      "id": "agr-s38-safety-reading-supplement",
      "revision": "v1",
      "chapter": "安全衛生",
      "levels": [
        "2"
      ],
      "titleJa": "農薬の分類と電源・燃料の注意を補って読む",
      "objectiveJa": "資料の農薬分類の追加項目と、散布後・電源・燃料保管の注意を区別し、既習内容にない補足と現場で別に確認する事項を説明できる。",
      "paragraphs": [
        {
          "id": "agr-s38-safety-reading-supplement-p1",
          "titleJa": "保管場所の確認と気化したガスを結び付ける",
          "textJa": "2号資料は燃料の保管場所について、火気厳禁にすること、消火器を設けること、換気に注意することを示しています。給油中の確認とは場面を分けて読みます。ガソリンは室温でも気化し、そのガスが滞留しないようにするという理由も添えて整理しましょう。火気・消火器・換気を別々に確認しても、独立した三つの処方を作る説明ではありません。この記述から容器の規則、消火器の種類や数、換気量は決めません。",
          "knowledgeIds": [
            "AGR-K-S38-SAFETY-READING-01"
          ]
        },
        {
          "id": "agr-s38-safety-reading-supplement-p2",
          "titleJa": "植物成長調整剤と殺そ剤も分類表で読む",
          "textJa": "2号資料の農薬の説明には、病気・害虫・雑草への薬剤に加え、ねずみを対象とする殺そ剤と、作物の開花や結実を制御する植物成長調整剤が挙げられています。既習の殺菌剤・殺虫剤という二つの分類だけで、資料の一覧が終わるとはしません。名称と掲載された対象・目的を分けて記録します。これは資料の分類を読む補足であり、現在の登録範囲や、個別の作物に使える製品・条件をこの一覧だけで指定するものではありません。",
          "knowledgeIds": [
            "AGR-K-S38-SAFETY-READING-02"
          ]
        },
        {
          "id": "agr-s38-safety-reading-supplement-p3",
          "titleJa": "化学合成だけで資料の範囲を決めない",
          "textJa": "資料は、農薬の説明の中で、天敵など化学合成されたものではないものも含むと述べています。既習の天敵による捕食・寄生という働きの説明に加え、資料の分類を読むときに「化学合成かどうか」だけで範囲を決めないことを確認します。天敵という名前のあるものを、全て自由に使用できると判断する説明ではありません。現在の制度上の扱いや製品の条件は、資料中の分類を読めたこととは別に確認する事項です。",
          "knowledgeIds": [
            "AGR-K-S38-SAFETY-READING-03"
          ]
        },
        {
          "id": "agr-s38-safety-reading-supplement-p4",
          "titleJa": "交信撹乱剤と展着剤は別の名称として残す",
          "textJa": "2号資料の種類の一覧には、交信撹乱剤と展着剤が別々に載っています。交信撹乱の働きは既習ですが、その説明だけで展着剤まで説明したことにはなりません。一覧を写すのではなく、二つを異なる名称として整理し、殺菌剤・殺虫剤などの区分と混ぜないようにします。このページの列挙だけから、展着剤の詳しい作用、混ぜ方、使用量、使える製品の組合せを補いません。名称の確認と実際の製品の使用判断を分けます。",
          "knowledgeIds": [
            "AGR-K-S38-SAFETY-READING-04"
          ]
        },
        {
          "id": "agr-s38-safety-reading-supplement-p5",
          "titleJa": "三相交流の注意に書かれた理由を読む",
          "textJa": "2号資料は農業で使われる電源として、単相交流100ボルトと三相交流200ボルトの例を挙げ、三相交流の注意点では電圧が高いので取り扱いに特に注意するとしています。既習の単相・三相の用途や送れる電力の比較と、ここに示された電圧への注意を別に読みます。電源名や差込口の形を知ったことだけで接続できるとは判断しません。この説明は、配線、相の入れ替え、通電点検などの操作手順を教えるものではありません。",
          "knowledgeIds": [
            "AGR-K-S38-SAFETY-READING-05"
          ]
        },
        {
          "id": "agr-s38-safety-reading-supplement-p6",
          "titleJa": "散布後の項目を手洗いとうがいで分ける",
          "textJa": "散布後の処理として、2号資料は器具の洗浄に加え、手洗いとうがいを挙げています。既習の後片付けの欄へ、手を洗うことと、うがいという掲載項目を分けて補います。器具の洗浄をした記録だけで、身体の後片付けも終わったとはしません。この項目は資料の日常的な後片付けの説明で、農薬を飲み込んだ場合や体調異常の際の治療・救急処置を示すものではありません。異常時の受診という既習の注意とは区別して読みます。",
          "knowledgeIds": [
            "AGR-K-S38-SAFETY-READING-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "殺そ剤",
          "reading": "さっそざい"
        },
        {
          "ja": "植物成長調整剤",
          "reading": "しょくぶつせいちょうちょうせいざい"
        },
        {
          "ja": "展着剤",
          "reading": "てんちゃくざい"
        },
        {
          "ja": "換気",
          "reading": "かんき"
        },
        {
          "ja": "気化",
          "reading": "きか"
        },
        {
          "ja": "三相交流",
          "reading": "さんそうこうりゅう"
        }
      ],
      "activityJa": "資料の分類に追加される名称と目的を整理し、列挙だけでは分からないことも書きます。次に、散布後の身体・器具、電源の注意、燃料の保管場所を別欄にします。最後に、保管場所の換気とガソリンの気化を関係付け、資料から決まらない製品条件や操作を補っていないか確認します。",
