  "lessons": [
    {
      "id": "agr-s38-soil-condition-drainage",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "土の条件の読み取りと排水方法の補足",
      "objectiveJa": "酸度や測定準備、連作障害の養分の偏りと対策を区別し、排水管の材料例と盛土の比較条件を説明できる。",
      "paragraphs": [
        {
          "id": "agr-s38-soil-condition-drainage-p1",
          "titleJa": "酸度の一般的な目安と作物別の範囲",
          "textJa": "2号資料は、日本の作物の多くについて、土壌pH5.5～6.5が生育に適するという目安を示しています。これは多くの作物をまとめた説明で、全作物に共通する設定値ではありません。既習の作物別の表には異なる範囲もあるので、一般的な目安と個別作物の行を分けて記録します。この数字を、そのまま石灰の施用量へ置き換えません。",
          "knowledgeIds": [
            "AGR-K-S38-SOIL-CONDITION-01"
          ]
        },
        {
          "id": "agr-s38-soil-condition-drainage-p2",
          "titleJa": "簡易酸度計の例で土を湿らせる程度",
          "textJa": "掲載された土へ直接差し込む簡易酸度計の使い方では、測定する土を十分に湿らせます。その程度を示す説明が、手で握ると固まるくらいという目安です。これは器具を使う前の土の準備であり、既習の土性を見分ける握り試験そのものではありません。別の測定器にも同じ湿らせ方が必要とは決めず、機種ごとの使い方を確かめます。",
          "knowledgeIds": [
            "AGR-K-S38-SOIL-CONDITION-02"
          ]
        },
        {
          "id": "agr-s38-soil-condition-drainage-p3",
          "titleJa": "養分の欠乏と過剰を別の原因として読む",
          "textJa": "連作障害の原因について、2号資料は特定の養分の欠乏と過剰を挙げています。養分の偏りという既習の言葉を、足りない場合と多すぎる場合に分けて整理します。生育が悪いという観察だけで、不足と決めて肥料を足すことはできません。病原体や害虫など別の原因もあるため、この二つを全ての連作障害の原因とはせず、施肥量もここから指定しません。",
          "knowledgeIds": [
            "AGR-K-S38-SOIL-CONDITION-03"
          ]
        },
        {
          "id": "agr-s38-soil-condition-drainage-p4",
          "titleJa": "土壌消毒の二つの利用例",
          "textJa": "連作障害への対策の欄には、薬剤や太陽光を利用する土壌消毒が示されています。土壌消毒という総称の下に、何を利用する例かを分けて記録しましょう。既習の熱を利用する防除一般と関連はありますが、この欄では土壌への対策として挙げられています。方法名を知っただけで作業条件を確認したとはせず、薬量、被覆条件、温度や期間を推測しません。",
          "knowledgeIds": [
            "AGR-K-S38-SOIL-CONDITION-04"
          ]
        },
        {
          "id": "agr-s38-soil-condition-drainage-p5",
          "titleJa": "暗きょに用いる管の材料例",
          "textJa": "2号資料の暗きょの説明には、素焼き土管と穴の開いた専用管という例があります。土の中へ管を埋めるという既習の仕組みに、材料の例を対応させます。管の周りを排水性のよい資材で保護することと、管自体の材料は別の情報です。この例から全ての圃場に共通する管の規格や施工深さは決めません。名称と構造の理解を、具体的な設計の確認と分けます。",
          "knowledgeIds": [
            "AGR-K-S38-SOIL-CONDITION-05"
          ]
        },
        {
          "id": "agr-s38-soil-condition-drainage-p6",
          "titleJa": "盛土による改善範囲と施工の比較",
          "textJa": "果樹の盛土による排水改善の例は、改善する部分が限られる一方、比較的簡単に施工できると説明されています。既習の改善範囲に、施工のしやすさという別の比較項目を補います。簡単に施工できるという資料の説明を、どの園地でも費用が安い、又は十分な排水効果が得られるという保証にはしません。場所と目的に応じた確認が必要です。",
          "knowledgeIds": [
            "AGR-K-S38-SOIL-CONDITION-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "欠乏",
          "reading": "けつぼう"
        },
        {
          "ja": "過剰",
          "reading": "かじょう"
        },
        {
          "ja": "土壌消毒",
          "reading": "どじょうしょうどく"
        },
        {
          "ja": "素焼き土管",
          "reading": "すやきどかん"
        },
        {
          "ja": "盛土",
          "reading": "もりど"
        }
      ],
      "activityJa": "一般的なpHの目安と作物別の範囲を別欄に書きます。測定前の土の準備を土性試験と区別し、連作障害の欠乏・過剰と土壌消毒の利用例を整理します。最後に、排水管の材料例と盛土の改善範囲・施工の比較を記し、本文から決まらない現場の条件を挙げます。",
      "targetMinutes": 30,
      "measuredMinutes": null,
