  "lessons": [
    {
      "id": "agr-s36-fruit-environment-layering",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "果樹の生育環境と取り木の補足を読む",
      "objectiveJa": "花芽分化の掲載時期と生育環境、強風の影響を区別し、取り木の方法名・材料・順序と掲載例を説明できる。",
      "paragraphs": [
        {
          "id": "agr-s36-fruit-environment-layering-p1",
          "titleJa": "落葉果樹の分化時期を資料の範囲で読む",
          "textJa": "2号資料では、多くの落葉果樹が花芽分化する時期を6～8月としています。「多くの落葉果樹」という対象と、始まりから終わりまでの幅を一緒に記録します。既習の、収穫する年より前から芽を観察する考え方へ、この資料内の時期を補って整理しましょう。花芽分化と開花は別の段階です。この月の幅を、全ての果樹や品種に共通する開花日や、作業開始日の指示にしません。",
          "knowledgeIds": [
            "AGR-K-S36-FRUIT-ENVIRONMENT-LAYERING-01"
          ]
        },
        {
          "id": "agr-s36-fruit-environment-layering-p2",
          "titleJa": "新梢と果実を取り巻く三つの環境",
          "textJa": "新梢は新しく伸びる枝です。2号資料は、新梢と果実の生育に関わる条件として、適切な気温、日照時間、降水量を挙げています。枝の伸びや果実の状態を記すときは、温度だけでなく、光が当たる時間と雨の量も別の項目にして整理します。このページには、樹種ごとの適温や必要な日照時間、雨量の数値は示されていません。項目を知ったことから、一律の環境設定値を決めないようにします。",
          "knowledgeIds": [
            "AGR-K-S36-FRUIT-ENVIRONMENT-LAYERING-02"
          ]
        },
        {
          "id": "agr-s36-fruit-environment-layering-p3",
          "titleJa": "強風の影響を枝と果実で分ける",
          "textJa": "強風について資料が挙げる影響には、枝が折れること、果実が傷付くこと、果実が落ちることがあります。「風の被害」と一語でまとめず、枝の状態、果実の傷、落果を分けて読むと、何が起きたかを伝えやすくなります。風を避けるように栽培するという説明はありますが、このページだけで安全な風速や設備の強度は決まりません。対策を選ぶ前に、どの部位にどのような影響があったかを分けて整理するための説明です。",
          "knowledgeIds": [
            "AGR-K-S36-FRUIT-ENVIRONMENT-LAYERING-03"
          ]
        },
        {
          "id": "agr-s36-fruit-environment-layering-p4",
          "titleJa": "取り木の二つの方法名を対応させる",
          "textJa": "親の枝につながったまま根を出させる取り木には、資料の表で二つの方法名が示されています。枝を曲げ、一部を土に埋める型が圧条法です。枝の周囲の皮を環状にはがす型が環状はく皮法です。既習の二つの型へ、この名前をそれぞれ対応させます。どちらも根が出てから切り離すという関係を保ち、最初に切り取るさし木の手順と入れ替えないようにします。",
          "knowledgeIds": [
            "AGR-K-S36-FRUIT-ENVIRONMENT-LAYERING-04"
          ]
        },
        {
          "id": "agr-s36-fruit-environment-layering-p5",
          "titleJa": "環状はく皮法の材料と工程を読む",
          "textJa": "環状はく皮法の掲載工程では、枝の周囲を一周するように形成層まで皮をはがし、ミズゴケをあて、その表面をビニールなどで覆って発根を促します。その後、根が出てから切断して植え込みます。「はく皮する部分」「あてる材料」「覆う材料」「発根後の切断」を分けて順に整理しましょう。この説明から、はがす幅や作業日、発根までの期間、使う薬剤の条件は補いません。",
          "knowledgeIds": [
            "AGR-K-S36-FRUIT-ENVIRONMENT-LAYERING-05"
          ]
        },
        {
          "id": "agr-s36-fruit-environment-layering-p6",
          "titleJa": "取り木の例ではリンゴの台木も読む",
          "textJa": "資料の取り木繁殖の欄は、利用する例としてリンゴの台木やブルーベリーなどを挙げています。リンゴについては「台木」という用途まで残して記録し、リンゴの果実を得る穂木の品種を増やす説明と同じにしません。この例の欄は圧条法と環状はく皮法の説明に共通して置かれています。作物名が同じ欄にあることだけで、両方の作物へ必ず同じ方法や同じ条件を使うとは判断しないでください。",
          "knowledgeIds": [
            "AGR-K-S36-FRUIT-ENVIRONMENT-LAYERING-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "花芽分化",
          "reading": "かがぶんか"
        },
        {
          "ja": "新梢",
          "reading": "しんしょう"
        },
        {
          "ja": "圧条法",
          "reading": "あつじょうほう"
        },
        {
          "ja": "環状はく皮法",
          "reading": "かんじょうはくひほう"
        },
        {
          "ja": "形成層",
          "reading": "けいせいそう"
        },
        {
          "ja": "発根",
          "reading": "はっこん"
        }
      ],
      "activityJa": "観察メモを「芽が花芽になる時期」「気温・日照時間・降水量」「枝と果実への風の影響」に分けます。次に、二つの取り木の名前と方法を対応させ、環状はく皮法の材料と工程を順に整理します。最後に、リンゴの台木という掲載例を読み、資料だけでは決まらない現場の条件を一つ挙げます。",
