  "lessons": [
    {
      "id": "agr-par12-soil-nutrient-details",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "養分ごとの働きと不足・過剰を分ける",
      "objectiveJa": "2号資料の窒素・リン酸・カリの追加説明を使い、葉の大きさ、開花・結実、土壌条件、根、他元素の吸収を区別できる。",
      "paragraphs": [
        {
          "id": "agr-par12-soil-nutrient-details-p1",
          "titleJa": "窒素不足では葉の大きさも見る",
          "textJa": "2号資料の窒素不足の例には、葉色が薄くなることだけでなく、葉が小さくなることもあります。色の記録と大きさの記録を分ければ、どの特徴を観察したのか伝わります。小さい葉を見ただけで窒素不足と確定したり、追加する肥料の量を決めたりはしません。葉の大きさを、窒素の説明に含まれる一つの観察例として整理します。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-NUTRIENT-DETAILS-01"
          ]
        },
        {
          "id": "agr-par12-soil-nutrient-details-p2",
          "titleJa": "リン酸と開花・結実",
          "textJa": "リン酸の欄は、主に開花と結実に影響するという働きを挙げています。葉の色や茎葉の伸びを中心にした窒素の説明とは、着目する生育の場面が異なります。例えば観察表では、開花や実の付き方の欄と、葉色の欄を分けられます。この関係を、リン酸を増やせば必ず花や実が増えるという施肥指示にはしません。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-NUTRIENT-DETAILS-02"
          ]
        },
        {
          "id": "agr-par12-soil-nutrient-details-p3",
          "titleJa": "アルミニウムや鉄が多い土という条件",
          "textJa": "同じリン酸の説明でも、アルミニウムや鉄が多い土では水に溶けにくくなり、植物が利用しにくくなるという土壌条件が付いています。肥料に成分があることと、土の中で作物が利用しやすいことを区別します。葉や花の外観だけから土のアルミニウム・鉄の量を推定せず、この条件を確認済みだと記録しないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-NUTRIENT-DETAILS-03"
          ]
        },
        {
          "id": "agr-par12-soil-nutrient-details-p4",
          "titleJa": "カリは根の発育にも関わる",
          "textJa": "2号のカリの欄には、根の発育に影響するという説明があります。地上の葉だけでなく、地下の根も養分の働きを整理する対象です。根の発育という働きと、窒素不足で葉が小さくなる例を別の欄へ入れると、三要素の説明を取り違えにくくなります。根の状態だけからカリの必要量を逆算できるという意味ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-NUTRIENT-DETAILS-04"
          ]
        },
        {
          "id": "agr-par12-soil-nutrient-details-p5",
          "titleJa": "カリウム過剰と他元素の吸収",
          "textJa": "カリウムが過剰になると、他の元素の吸収を妨げるという関係が示されています。不足を避けたいから多く与える、という考えだけでは、別の養分を取り込む働きを見落とします。これは一つの養分と他の養分との関係の説明です。この欄には全作物共通の施用上限は示されていないので、独自の上限値や追加量を作りません。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-NUTRIENT-DETAILS-05"
          ]
        },
        {
          "id": "agr-par12-soil-nutrient-details-p6",
          "titleJa": "カリ不足の部位と見え方",
          "textJa": "カリ不足の例には、下葉または外葉から葉の縁が褐色になることと、葉全体に斑点が生じることがあります。「葉が変色した」だけで終えず、下葉・外葉、葉縁、葉全体という場所と、褐色・斑点という見え方を分けて記録します。これらは掲載された不足の例であり、斑点を見ればカリだけが原因だと決める診断基準ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-NUTRIENT-DETAILS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "結実",
          "reading": "けつじつ"
        },
        {
          "ja": "葉縁",
          "reading": "ようえん"
        },
        {
          "ja": "吸収",
          "reading": "きゅうしゅう"
        },
        {
          "ja": "過剰",
          "reading": "かじょう"
        }
      ],
      "activityJa": "窒素・リン酸・カリの三欄を作り、働き、不足・過剰の例、土の条件を別々に記録します。カリ不足の記録には、どの葉からどの部分が変わるかも書き、観察だけで施肥量を決めない理由を説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 29,
          "printedPage": 27
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "153bdd1aec0a87377b11410adbf1cf5d88d6b641ea1948a7ed709fe969219027"
    },
    {
      "id": "agr-par12-soil-application-area-tools",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "施肥する範囲と散布機の役割を比べる",
      "objectiveJa": "2号資料の全面施肥・部分施肥の範囲と目的を分け、三つの散布機を扱う資材と散布範囲で比較できる。",
      "paragraphs": [
        {
          "id": "agr-par12-soil-application-area-tools-p1",
          "titleJa": "全面施肥と部分施肥の範囲",
          "textJa": "全面施肥は圃場の全面に肥料を入れる方法、部分施肥は根が伸びる部分だけに肥料を施す方法です。両者を分けるのは、肥料を置く範囲です。元肥と追肥のような時期の区分や、肥料の成分による区分とは別に整理します。例えば同じ圃場の記録でも、いつ与えたかと、どの範囲へ与えたかは別欄にできます。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-APPLICATION-AREA-TOOLS-01"
          ]
        },
        {
          "id": "agr-par12-soil-application-area-tools-p2",
          "titleJa": "広く根を張らせる目的",
          "textJa": "資料は、広く根を張らせたいときに全面施肥を使うという目的との対応を示しています。全面へ施すという範囲の説明に加えて、根の広がりを意図する点を残します。この目的を、どんな作物・土壌でも全面施肥が常に最良だという順位へ変えません。広くという語から散布量が多いほどよいとも判断できません。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-APPLICATION-AREA-TOOLS-02"
          ]
        },
        {
          "id": "agr-par12-soil-application-area-tools-p3",
          "titleJa": "無駄を減らす目的",
          "textJa": "部分施肥には、無駄を減らしたいときに有効という説明があります。根の伸びる部分に施す範囲と、この目的を組にして理解します。全面施肥と部分施肥のどちらかを選ぶ話と、必要な成分量を計算する話は別です。部分施肥なら全ての肥料で同じ割合だけ節約できるという数値や、肥料を根へ直接触れさせる手順を、この説明から加えません。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-APPLICATION-AREA-TOOLS-03"
          ]
        },
        {
          "id": "agr-par12-soil-application-area-tools-p4",
          "titleJa": "ブロードキャスタの資材と範囲",
          "textJa": "ブロードキャスタの説明は、粒状の肥料や土壌改良材を広い範囲にまくというものです。「粒状」という資材の状態と、「広い範囲」という散布先を合わせて記録します。機械名だけを覚えるより、堆肥などの有機物を扱う機械との違いを説明しやすくなります。この用途の説明だけで、実機の設定や対応する全製品が決まるわけではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-APPLICATION-AREA-TOOLS-04"
          ]
        },
        {
          "id": "agr-par12-soil-application-area-tools-p5",
          "titleJa": "マニュアスプレッダの対象",
          "textJa": "マニュアスプレッダは、堆肥などの有機物を圃場へ全面散布する機械として示されています。堆肥という材料と、全面へ散布する機能を一組にします。粒状肥料を広くまくブロードキャスタと、掲載された対象の違いを比べましょう。全面へ散布できる機能は、その圃場で必ず全面施肥を選ぶべきだという判断と同じではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-APPLICATION-AREA-TOOLS-05"
          ]
        },
        {
          "id": "agr-par12-soil-application-area-tools-p6",
          "titleJa": "ライムソーワの形状条件",
          "textJa": "ライムソーワの欄には、粉末状・砂状の石灰や有機質肥料を散布する用途があります。石灰という名前だけでなく、粉末状・砂状という資材の形状を残して説明します。三つの機械を比べるときは、粒状資材、堆肥など、粉末状・砂状という各説明の組合せを確認します。名称と用途を照合したことを、適用製品・設定・安全な操作を確認したことに置き換えないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR12-SOIL-APPLICATION-AREA-TOOLS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "全面施肥",
          "reading": "ぜんめんせひ"
        },
        {
          "ja": "部分施肥",
          "reading": "ぶぶんせひ"
        },
        {
          "ja": "土壌改良材",
          "reading": "どじょうかいりょうざい"
        },
        {
          "ja": "散布",
          "reading": "さんぷ"
        }
      ],
      "activityJa": "圃場全面と根の伸びる部分の二欄に施肥方法と目的を対応させます。続いて三つの散布機について、粒状の資材、堆肥などの有機物、粉末状・砂状の石灰の対応を書き、機械名からは決まらない施用量や操作条件を区別してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
