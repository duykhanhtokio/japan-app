  "lessons": [
    {
      "id": "agr-par12-riceveg-legume-uses",
      "revision": "v1",
      "chapter": "畑作・野菜作業",
      "levels": [
        "2"
      ],
      "titleJa": "マメ科作物の働きと利用先を結ぶ",
      "objectiveJa": "マメ科作物と油料の分類を区別し、根粒菌、国産ダイズの食品用途、専用品種、ラッカセイの収穫後の流れを説明できる。",
      "paragraphs": [
        {
          "id": "agr-par12-riceveg-legume-uses-p1",
          "titleJa": "四つの作物をマメ科へ対応させる",
          "textJa": "2号資料は、ダイズ、ラッカセイ、アズキ、インゲンをマメ科の作物として挙げています。ダイズとアズキだけで一覧を終えず、ラッカセイやインゲンも同じ科の欄へ対応させます。これは植物の科によるまとまりであり、全てを同じ食品に加工するという説明ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-LEGUME-USES-01"
          ]
        },
        {
          "id": "agr-par12-riceveg-legume-uses-p2",
          "titleJa": "油分を利用する別の分類",
          "textJa": "ダイズとラッカセイは油分が多いため、工芸作物の中の油料にも分類されると説明されています。マメ科という植物の分類と、油を得る用途の分類は両立します。油料と記したから食用の説明を消すのではなく、何に着目した分類かを欄の見出しに残します。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-LEGUME-USES-02"
          ]
        },
        {
          "id": "agr-par12-riceveg-legume-uses-p3",
          "titleJa": "根粒菌の共生と窒素固定",
          "textJa": "マメ科作物の根には、窒素固定を行う根粒菌が共生すると資料は説明しています。少ない肥料で栽培できるという記述は、この関係と結び付けて読みます。作物が全ての養分を自力で無限に得るという意味ではなく、この説明だけで無施肥を決めたり、具体的な施肥量を設定したりはしません。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-LEGUME-USES-03"
          ]
        },
        {
          "id": "agr-par12-riceveg-legume-uses-p4",
          "titleJa": "国産ダイズの食品の例",
          "textJa": "資料が国産ダイズの主な利用先として挙げるのは、豆腐、納豆、煮豆、味噌、醤油です。一つの作物名から複数の食品へつながる例として、五つを食用の欄に整理します。この一覧は加工工程や配合を示していないため、名前を対応させる学習と食品の製造手順を分けます。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-LEGUME-USES-04"
          ]
        },
        {
          "id": "agr-par12-riceveg-legume-uses-p5",
          "titleJa": "用途に合わせた専用品種",
          "textJa": "ダイズと、未熟な段階で利用するエダマメには、それぞれ専用品種があると2号資料は示しています。未熟なダイズをエダマメと呼ぶという基礎に加え、利用する目的に合わせた品種の区別も確認します。どの品種でも収穫時期だけを変えれば同じ用途へ適する、と読み替えないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-LEGUME-USES-05"
          ]
        },
        {
          "id": "agr-par12-riceveg-legume-uses-p6",
          "titleJa": "掘り取ったラッカセイの後工程",
          "textJa": "ラッカセイでは、地中のさやを掘り出した後、乾燥し、さやを外す脱莢という流れが示されています。利用例には炒りざや、炒り豆、豆菓子があり、さやごとゆでて食べる例もあります。さやの扱いが違う利用例を分け、全ての食品が同じ後工程を通ると一つにまとめないことが大切です。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-LEGUME-USES-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "マメ科",
          "reading": "まめか"
        },
        {
          "ja": "油料",
          "reading": "ゆりょう"
        },
        {
          "ja": "根粒菌",
          "reading": "こんりゅうきん"
        },
        {
          "ja": "窒素固定",
          "reading": "ちっそこてい"
        },
        {
          "ja": "脱莢",
          "reading": "だっきょう"
        }
      ],
      "activityJa": "ダイズ・ラッカセイ・アズキ・インゲンを科の欄へ置き、油料にも当たる二つを別欄に示します。ダイズの五つの食品と専用品種の説明を整理し、ラッカセイは収穫後の工程とさやを残す利用例を分けて説明しましょう。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 71,
          "printedPage": 69
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 72,
          "printedPage": 70
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "121d6b85bfc8d65ceb9c0bd7bae02cf4d1ffb58d0db1d16a12a555121625ccd6"
    },
    {
      "id": "agr-par12-riceveg-grain-purpose",
      "revision": "v1",
      "chapter": "畑作・野菜作業",
      "levels": [
        "2"
      ],
      "titleJa": "麦類とトウモロコシを用途で読み分ける",
      "objectiveJa": "麦類の食用・飼料利用、スイートコーンとデントコーン、専用品種とF1の違い、クリーニングクロップの掲載条件を説明できる。",
      "paragraphs": [
        {
          "id": "agr-par12-riceveg-grain-purpose-p1",
          "titleJa": "麦類の利用先は同じではない",
          "textJa": "2号資料は、コムギは食用が多いとし、オオムギ、ライムギ、エンバクは食用のほか飼料にも多く使うと説明しています。四つの名前を覚えるだけでなく、どの利用先が示されているかを比べます。この対比を、コムギには食用以外の用途が一切ないという断定にはしません。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-GRAIN-PURPOSE-01"
          ]
        },
        {
          "id": "agr-par12-riceveg-grain-purpose-p2",
          "titleJa": "未成熟のスイートコーン",
          "textJa": "スイートコーンは、日本では未成熟な状態で生食され、野菜に分類される例として示されています。トウモロコシという作物名だけで完熟した穀粒の利用に限らず、利用する生育段階と用途を一緒に読みます。この説明は調理方法や食べる量の指示ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-GRAIN-PURPOSE-02"
          ]
        },
        {
          "id": "agr-par12-riceveg-grain-purpose-p3",
          "titleJa": "飼料向けのデントコーン",
          "textJa": "デントコーンは飼料用に栽培し、青刈りで利用したり、サイレージにしたりするものとして載っています。スイートコーンの未熟な実の利用とは、目的と利用する形が異なります。青刈りという利用の仕方と、サイレージという加工・貯蔵した形を分けて記録します。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-GRAIN-PURPOSE-03"
          ]
        },
        {
          "id": "agr-par12-riceveg-grain-purpose-p4",
          "titleJa": "専用品種という用途の情報",
          "textJa": "スイートコーンとデントコーンには、それぞれ専用品種があると資料は説明しています。専用という語は、どの利用目的に向けた品種かを示します。トウモロコシなら品種を確認せず同じ用途へ使える、とせず、食用か飼料用かという用途の欄を設けます。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-GRAIN-PURPOSE-04"
          ]
        },
        {
          "id": "agr-par12-riceveg-grain-purpose-p5",
          "titleJa": "ほぼ全てがF1という範囲",
          "textJa": "同じ説明には、トウモロコシの品種のほぼ全てが雑種第1代、すなわちF1やハイブリッドであるという記述があります。「ほぼ」を落として例外のない断定に変えません。用途を示す専用品種という情報と、交配による由来を示すF1という情報は、別々の欄で記録できます。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-GRAIN-PURPOSE-05"
          ]
        },
        {
          "id": "agr-par12-riceveg-grain-purpose-p6",
          "titleJa": "養分吸収を使う後作の例",
          "textJa": "トウモロコシは養分吸収力が強いため、塩類が集積しやすい野菜の跡地で過剰な養分を除くクリーニングクロップ、清耕作物として栽培する例も示されています。ここで着目するのは、前作の跡地と養分吸収の関係です。土の病害を全てなくす処理や、吸収後の養分量を保証する作業とはせず、作付け条件や期間はこの例だけから決めません。",
          "knowledgeIds": [
            "AGR-K-PAR12-RICEVEG-GRAIN-PURPOSE-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "スイートコーン",
          "reading": "すいーとこーん"
        },
        {
          "ja": "デントコーン",
          "reading": "でんとこーん"
        },
        {
          "ja": "青刈り",
          "reading": "あおがり"
        },
        {
          "ja": "雑種第1代",
          "reading": "ざっしゅだいいちだい"
        },
        {
          "ja": "清耕作物",
          "reading": "せいこうさくもつ"
        }
      ],
      "activityJa": "コムギと他の三つの麦類の利用先を比較します。次に、スイートコーンとデントコーンを利用段階・用途・利用形態で分け、専用品種とF1を別欄に記します。クリーニングクロップの例では、どの跡地で何を除くのかも書きましょう。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
