  "lessons": [
    {
      "id": "agr-par12-general-rice-classification-detail",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "イネの地域・粒・栽培場所の区分を重ねずに読む",
      "objectiveJa": "2号資料の栽培地域、粒形と粘りの傾向、コメという名称、水稲と陸稲、日本の分布を別々の軸で説明できる。",
      "paragraphs": [
        {
          "id": "agr-par12-general-rice-classification-detail-p1",
          "titleJa": "二つのイネと主な栽培地域",
          "textJa": "2号資料では、アジアイネはアジアを中心に世界で、アフリカイネは西アフリカを中心に栽培されると説明しています。既習の二つの名称に、主な栽培地域を対応させましょう。「中心に」という表現は、その地域以外には全くないという限定ではありません。地名と種の区分を一組にして記録します。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-01-01"
          ]
        },
        {
          "id": "agr-par12-general-rice-classification-detail-p2",
          "titleJa": "インディカは粒と炊飯後を組にする",
          "textJa": "インディカの説明では、主に粒が細長く、炊いたときに粘り気がないものが多いという二つの特徴があります。粒の形と炊飯後の性質は別の観察項目です。形だけで全品種を確定する基準や、全てのインディカが必ず同じ食感になるという保証に変えず、資料にある傾向として整理します。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-01-02"
          ]
        },
        {
          "id": "agr-par12-general-rice-classification-detail-p3",
          "titleJa": "ジャポニカも二つの特徴で比べる",
          "textJa": "ジャポニカは、主に粒が短く丸みを帯び、炊くと粘り気があるものが多いと説明されています。インディカと比べるときは、どちらも粒の形と炊飯後の粘りという同じ二項目でそろえます。日本で中心となる分類名を答えるだけでなく、この二つの特徴を説明できるようにします。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-01-03"
          ]
        },
        {
          "id": "agr-par12-general-rice-classification-detail-p4",
          "titleJa": "コメという呼び名の範囲",
          "textJa": "資料は玄米と精米した白米の両方を「コメ」と呼んでいます。既習のもみすりと精米の順序に加えて、呼び名が含む範囲を確認します。例えば玄米の記録にコメと書いてあっても、それだけで精米済みの白米だったとは決まりません。加工段階を区別したい記録では、玄米か白米かも添えます。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-01-04"
          ]
        },
        {
          "id": "agr-par12-general-rice-classification-detail-p5",
          "titleJa": "栽培する場所から水稲と陸稲を分ける",
          "textJa": "水田で栽培するイネは水稲、畑で栽培するイネは陸稲とされ、陸稲にはオカボという呼び方も付いています。これは栽培する場所を対応させる区分です。インディカとジャポニカという区分や、玄米と白米という加工段階を、この二つの名称にそのまま置き換えないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-01-05"
          ]
        },
        {
          "id": "agr-par12-general-rice-classification-detail-p6",
          "titleJa": "日本での主流と分布を別々に読む",
          "textJa": "続く説明では、日本の稲作はほとんどが水稲栽培で、温暖な沖縄県から寒冷な北海道まで、全ての都道府県でイネが栽培されるとしています。「主にどの場所で育てるか」と「どの地域に栽培があるか」は別の情報です。この資料の分布説明から、どの地点でも同じ品種や作型が使えるとは判断しません。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-01-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "水稲",
          "reading": "すいとう"
        },
        {
          "ja": "陸稲",
          "reading": "りくとう"
        },
        {
          "ja": "玄米",
          "reading": "げんまい"
        },
        {
          "ja": "粘り気",
          "reading": "ねばりけ"
        }
      ],
      "activityJa": "アジアイネとアフリカイネに主な地域を添え、インディカとジャポニカは形と粘りで比較します。別欄にコメの呼び名、水稲・陸稲の栽培場所、日本の主流と分布を書き、異なる分類軸を混ぜない説明を作ってください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 4,
          "printedPage": 2
        },
        {
          "documentId": "AGR-S2",
          "pdfPage": 5,
          "printedPage": 3
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "1dcef37610781b273ab68d3d4928a426466dac46babc9c613a48490498766cff"
    },
    {
      "id": "agr-par12-general-direct-seeding-comparison",
      "revision": "v1",
      "chapter": "日本農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "直播の利点と条件付きの短所を比較する",
      "objectiveJa": "2号資料の直播の広がり、規模拡大への利点、気候・品種・鳥害の短所と、機械化全体の労働時間例を区別できる。",
      "paragraphs": [
        {
          "id": "agr-par12-general-direct-seeding-comparison-p1",
          "titleJa": "ごく少ないは数値の普及率ではない",
          "textJa": "2号資料の稲作の紹介では、種もみを田へ直接まく直播栽培はごくわずかだと述べています。これは掲載時点の広がりを定性的に表す言葉です。例えば比較メモには「資料ではごくわずか」と書き、示されていない割合を何％と補ったり、現在も同じ普及状況だと言い切ったりしません。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-02-01"
          ]
        },
        {
          "id": "agr-par12-general-direct-seeding-comparison-p2",
          "titleJa": "作業の軽減を規模の話へつなげる",
          "textJa": "直播栽培の利点欄には、育苗と田植えの作業が軽くなり、規模を拡大しやすいというつながりがあります。既習の作業削減の説明に、経営規模への意味を加えて読みます。「広げやすい」は、どの農場でも必ず面積を増やせるという保証ではありません。作業が軽くなる理由と、規模拡大の可能性を分けて説明します。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-02-02"
          ]
        },
        {
          "id": "agr-par12-general-direct-seeding-comparison-p3",
          "titleJa": "気候と出芽・苗立ちの不安定さ",
          "textJa": "短所の一つは、気候によって出芽や苗立ちが不安定になりやすいことです。苗立ちは、まいた後に苗が立ち育つ状態に着目した言葉として、出芽と一緒に記録します。種子を直接まいたという方法の説明だけでは、苗が安定して育つことまで確認したことにはなりません。この記述から対策の資材や処理条件は指定しません。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-02-03"
          ]
        },
        {
          "id": "agr-par12-general-direct-seeding-comparison-p4",
          "titleJa": "倒伏しやすさには品種の条件がある",
          "textJa": "直播の短所欄の倒伏については、品種により倒れやすいという条件が付いています。単に「直播は必ず倒れる」とまとめると、品種という条件と可能性の程度が失われます。比較表には、倒伏しやすさと品種による違いを一緒に残し、全品種に同じ結果や対策が当てはまるとは扱いません。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-02-04"
          ]
        },
        {
          "id": "agr-par12-general-direct-seeding-comparison-p5",
          "titleJa": "鳥害は別の短所として記録する",
          "textJa": "資料は、鳥害を受けやすいことも直播栽培の短所に挙げています。気候による出芽の不安定さや、品種による倒伏しやすさと別の項目です。例えば、苗がそろわなかったという記録だけから、原因を全て鳥害と決めないでください。この項目を理解することと、鳥の種類や具体的な防除方法を決定することは別です。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-02-05"
          ]
        },
        {
          "id": "agr-par12-general-direct-seeding-comparison-p6",
          "titleJa": "機械化の労働時間例は面積とセット",
          "textJa": "同じページには、機械化一貫体系が確立され、年間の労働時間は10a当たり約25時間という紹介があります。面積10a、年間、約という条件を数値と一緒に読みます。これは稲作の機械化についての掲載例であり、直播だけにかかる時間や、直播導入後の削減時間を表す値ではありません。全農場の現在の実績としても扱いません。",
          "knowledgeIds": [
            "AGR-K-PAR12-GENERAL-02-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "直播",
          "reading": "ちょくは"
        },
        {
          "ja": "苗立ち",
          "reading": "なえだち"
        },
        {
          "ja": "倒伏",
          "reading": "とうふく"
        },
        {
          "ja": "鳥害",
          "reading": "ちょうがい"
        }
      ],
      "activityJa": "直播の紹介を、広がり、作業軽減と規模、気候、品種、鳥害の五欄で整理してください。10a当たり年間約25時間という記載は機械化全体の別欄に置き、資料からは決められない現在の普及率や削減時間を付け足さないようにします。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
