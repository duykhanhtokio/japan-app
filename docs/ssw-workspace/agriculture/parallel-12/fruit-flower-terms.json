  "lessons": [
    {
      "id": "agr-par12-flower-cultivar-area",
      "revision": "v1",
      "chapter": "果樹栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "六つの果樹の品種割合を同じ年の資料で比べる",
      "objectiveJa": "2017年の掲載品種の栽培面積割合を読み、樹種内の順位、合計、異なる母集団と未掲載部分の限界を説明できる。",
      "paragraphs": [
        {
          "id": "agr-par12-flower-cultivar-area-p1",
          "titleJa": "ウンシュウミカンの品種を比べる",
          "textJa": "資料の2017年の例では、ウンシュウミカンの品種に宮川早生17%、青島温州10%、興津早生9%が挙がっています。いずれも栽培面積についての割合として読みます。同じ頁の2014年の出荷カンキツの説明とは、年も対象も違います。この授業では2017年の品種の比較に範囲を絞り、現在の面積や出荷量へ置き換えません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-CULTIVAR-AREA-01"
          ]
        },
        {
          "id": "agr-par12-flower-cultivar-area-p2",
          "titleJa": "リンゴでは割合の大きさを並べる",
          "textJa": "2017年のリンゴの掲載例は、ふじ47%、つがる12%、王林7%です。三つを比べると、ふじの割合が最も大きいことが分かります。ただし、この順位から果実一個の大きさや販売価格は分かりません。品種名、栽培面積という指標、年、割合を一組にして記録します。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-CULTIVAR-AREA-02"
          ]
        },
        {
          "id": "agr-par12-flower-cultivar-area-p3",
          "titleJa": "ブドウでは同率の品種も残す",
          "textJa": "同じ2017年のブドウでは、巨峰22%、ピオーネ12%、デラウェア12%が掲載されています。ピオーネとデラウェアは掲載値が同じなので、順に書かれているという理由だけで両者の大小を決めません。巨峰とピオーネの二つの掲載値を足すと34%です。この合計はブドウの中での割合で、他の樹種の面積を足した値ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-CULTIVAR-AREA-03"
          ]
        },
        {
          "id": "agr-par12-flower-cultivar-area-p4",
          "titleJa": "カキの品種と甘渋を組にする",
          "textJa": "2017年のカキの例は、富有17%、平核無12%、刀根早生11%です。資料では富有を甘ガキ、後の二つを渋ガキとして示しているため、品種と甘渋も対応させます。富有の17%と宮川早生の17%が同じでも、カキとウンシュウミカンでは基準となる樹種の面積が異なります。割合が等しいことだけでは実面積が等しいとは言えません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-CULTIVAR-AREA-04"
          ]
        },
        {
          "id": "agr-par12-flower-cultivar-area-p5",
          "titleJa": "ナシの掲載二品種を合計して比較する",
          "textJa": "2017年のニホンナシは、幸水30%、豊水21%、新高7%という掲載例です。幸水と豊水を足すと51%で、ブドウの巨峰とピオーネの合計34%より、その樹種内での割合は大きくなります。これは別々の樹種の中で占める割合の比較です。ナシとブドウの面積そのものの大小や、両方を合わせた面積割合を求めたわけではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-CULTIVAR-AREA-05"
          ]
        },
        {
          "id": "agr-par12-flower-cultivar-area-p6",
          "titleJa": "モモの未掲載部分を一品種にしない",
          "textJa": "モモの2017年の掲載例は、あかつき15%、白鳳13%、川中島白桃11%です。掲載値を単純に合計すると39%で、100%との差は61ポイントです。しかし、その差を未掲載の一品種の割合と決めることはできません。元の値の丸め方も示されていないため、差から精密な残余面積を求めたとは扱わず、未掲載部分があると理解します。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-CULTIVAR-AREA-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "栽培面積",
          "reading": "さいばいめんせき"
        },
        {
          "ja": "品種",
          "reading": "ひんしゅ"
        },
        {
          "ja": "割合",
          "reading": "わりあい"
        },
        {
          "ja": "同率",
          "reading": "どうりつ"
        },
        {
          "ja": "母集団",
          "reading": "ぼしゅうだん"
        }
      ],
      "activityJa": "各樹種の三品種について、2017年・栽培面積・品種名・割合を記録します。ブドウとニホンナシの掲載二品種の合計を比べ、同じ17%の二樹種で実面積が等しいとは言えない理由と、モモの未掲載部分について決められないことを説明してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
