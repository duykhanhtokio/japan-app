    {
      "id": "agr-par12-flower-group-records",
      "revision": "v1",
      "chapter": "花き栽培作業",
      "levels": [
        "2"
      ],
      "titleJa": "花きの分類表を見出しと下位区分で点検する",
      "objectiveJa": "追加の花き名を花木・ラン・多肉植物等の見出しへ対応させ、観葉植物とハーブの内側の区分や誤記録を点検できる。",
      "paragraphs": [
        {
          "id": "agr-par12-flower-group-records-p1",
          "titleJa": "花木の見出しにある追加例",
          "textJa": "花木の欄には、アザレア、ツツジ、ツバキ、サザンカが載っています。これらの名を受け取ったときは、まず花木という園芸的な欄を確認します。これは表で使う区分の照合であり、植物の科名、出荷形態、実物の見分け方を一度に答えたことにはなりません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-GROUP-RECORDS-01"
          ]
        },
        {
          "id": "agr-par12-flower-group-records-p2",
          "titleJa": "洋ランの欄を品目名で確認する",
          "textJa": "洋ランの追加例には、シンビジューム、デンドロビウム、オンシジューム、バンダ、パフィオペディルムがあります。ラン類という大きな見出しで記録を止めず、洋ランという内側の欄まで照合します。品目名だけから温度の設定値や栽培期間を決める説明ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-GROUP-RECORDS-02"
          ]
        },
        {
          "id": "agr-par12-flower-group-records-p3",
          "titleJa": "東洋ランへの記録を修正する",
          "textJa": "カンラン、フウラン、セッコクは東洋ランの欄です。例えばシンビジュームを洋ラン、カンランを東洋ラン、セッコクを洋ランとした三件のメモでは、セッコクの記録を直す必要があります。一つのランの例を知っていることと、受け取った品目を一件ずつ照合することを分けましょう。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-GROUP-RECORDS-03"
          ]
        },
        {
          "id": "agr-par12-flower-group-records-p4",
          "titleJa": "多肉植物・サボテン類という一つの欄",
          "textJa": "アロエ、シャコバサボテン、カランコエは、資料の多肉植物・サボテン類という欄に載っています。この見出しは二つの語をまとめたものなので、欄にある品目を全てサボテンと呼び替えません。また、花を楽しむ品目だからという理由でラン類の欄へ移すこともできません。ここでは表のまとまりを保って記録します。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-GROUP-RECORDS-04"
          ]
        },
        {
          "id": "agr-par12-flower-group-records-p5",
          "titleJa": "観葉植物は下位区分も確認する",
          "textJa": "観葉植物のうち、ドラセナ類とヤシ類は木本類、シダ類、アンスリウム、スパティフィラムは草本類の欄にあります。「観葉植物」とだけ書いた記録では、この内側の区別が残りません。木本類か草本類かも表に戻って確認し、見た葉の大きさや鉢の大きさだけでその区分を決めないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-GROUP-RECORDS-05"
          ]
        },
        {
          "id": "agr-par12-flower-group-records-p6",
          "titleJa": "同じ木本類でも上の見出しは異なる",
          "textJa": "ハーブでは、レモングラス、バジル、カモミール、レモンバームが草本類、ローズマリーが木本類の欄です。観葉植物のドラセナ類とハーブのローズマリーは、ともに木本類という語に対応しても、上の見出しが違います。見出し、内側の区分、品目名の順で記録すれば、同じ区分名を理由に別のまとまりを混ぜる誤りを防げます。",
          "knowledgeIds": [
            "AGR-K-PAR12-FLOWER-GROUP-RECORDS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "花木",
          "reading": "かぼく"
        },
        {
          "ja": "洋ラン",
          "reading": "ようらん"
        },
        {
          "ja": "東洋ラン",
          "reading": "とうようらん"
        },
        {
          "ja": "木本類",
          "reading": "もくほんるい"
        },
        {
          "ja": "草本類",
          "reading": "そうほんるい"
        },
        {
          "ja": "下位区分",
          "reading": "かいくぶん"
        }
      ],
      "activityJa": "花木、ラン類、多肉植物・サボテン類、観葉植物、ハーブの見出しを作り、本文の追加品目を記入します。必要な見出しには下位区分も付けてください。セッコクの誤記録を一件修正し、木本類という語が同じでも上の見出しを省けない例を説明します。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
