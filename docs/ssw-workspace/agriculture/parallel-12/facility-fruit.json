  "lessons": [
    {
      "id": "agr-par12-facility-ventilation-conditions-2",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "2"
      ],
      "titleJa": "換気の効果と寒い時期の開口条件",
      "objectiveJa": "2号資料の換気について、設置位置と環境による効果差、機械制御時の順序、冷気の直撃を避ける条件、遮光という選択を説明できる。",
      "paragraphs": [
        {
          "id": "agr-par12-facility-ventilation-conditions-2-p1",
          "titleJa": "能力だけでは効果を決めない",
          "textJa": "強制換気は換気扇を電力で動かす方法ですが、2号資料では効果を左右する条件が能力だけに限られていません。取り付け位置、気温、湿度なども挙げられています。同じ能力の換気扇という記録だけで効果が同一とせず、装置の位置と環境条件を別々に確認します。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-VENTILATION-CONDITIONS-2-01"
          ]
        },
        {
          "id": "agr-par12-facility-ventilation-conditions-2-p2",
          "titleJa": "外気の取り入れと排気を一組にする",
          "textJa": "2号の強制換気の説明は、外の空気を取り入れることに加え、施設内の熱気を外へ押し出すことも示しています。空気を送る装置があるという観察と、施設内外の空気が入れ替わるという働きを区別します。この説明だけから、個別施設の必要風量や設置場所を決めることはできません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-VENTILATION-CONDITIONS-2-02"
          ]
        },
        {
          "id": "agr-par12-facility-ventilation-conditions-2-p3",
          "titleJa": "トマト施設という資料の範囲",
          "textJa": "2号は、強制換気についてトマトの施設栽培で最も普及していると記しています。これは掲載資料の作物別の説明として読み、すべての作物で同じ利用状況だとは扱いません。現在の普及率や設置台数の数字もこの記述にはなく、今日の導入状況を確認したことにはなりません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-VENTILATION-CONDITIONS-2-03"
          ]
        },
        {
          "id": "agr-par12-facility-ventilation-conditions-2-p4",
          "titleJa": "機械制御の場合の開く順序",
          "textJa": "換気の順序では、まず自然換気を行います。2号は機械で制御している場合として、カーテンを開け、次に天窓を開ける順序を示しています。それでも施設内の気温が高い場合に側窓へ進みます。開口部の名前だけでなく、機械制御という条件と気温がまだ高いという条件を残して説明します。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-VENTILATION-CONDITIONS-2-04"
          ]
        },
        {
          "id": "agr-par12-facility-ventilation-conditions-2-p5",
          "titleJa": "寒い時期は冷気の当たり方を見る",
          "textJa": "寒い時期に側窓を開けると、外の冷たい空気が作物へ直接当たることが問題になります。資料では、側窓の開け幅を狭くするか、側面のカーテンを開けないようにする説明です。カーテンは必ず全開にするという読み方をせず、冷気の直撃を避ける目的と二つの対応を結び付けます。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-VENTILATION-CONDITIONS-2-05"
          ]
        },
        {
          "id": "agr-par12-facility-ventilation-conditions-2-p6",
          "titleJa": "自然換気で下がらない場合の二つの選択",
          "textJa": "自然換気で温度が下がらない場合、2号は強制換気を行うか、遮光して過度な温度上昇を防ぐとしています。空気の入れ替えと光を遮る方法は、使う仕組みが違います。両方を常に同時に行うという指示や、遮光の割合・運転の設定値をこの説明から作らず、資料に加わる選択肢として比較します。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-VENTILATION-CONDITIONS-2-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "排気",
          "reading": "はいき"
        },
        {
          "ja": "側窓",
          "reading": "そくそう"
        },
        {
          "ja": "機械制御",
          "reading": "きかいせいぎょ"
        },
        {
          "ja": "遮光",
          "reading": "しゃこう"
        }
      ],
      "activityJa": "換気扇の能力、取り付け位置、気温、湿度を別欄にします。機械制御時の開口順序と寒冷時の二つの対応を説明し、自然換気で下がらない場合の強制換気と遮光を仕組みで比較してください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 89,
          "printedPage": 87
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "3bd57a4c3a52ec57ba6392cc9dccc29dc91256bc6c9e17cd41bc0ac0c4eaeff9"
    },
    {
      "id": "agr-par12-facility-strawberry-development-2",
      "revision": "v1",
      "chapter": "施設園芸作業",
      "levels": [
        "2"
      ],
      "titleJa": "イチゴのランナーと花芽を条件で読み分ける",
      "objectiveJa": "ランナー発生の二条件、自然条件での花芽分化と翌年の開花、分化促進の条件と掲載育苗名を区別できる。",
      "paragraphs": [
        {
          "id": "agr-par12-facility-strawberry-development-2-p1",
          "titleJa": "ランナー発生は二つの条件で読む",
          "textJa": "既存の苗づくりでは、親株、ランナー、子株の関係を学びました。2号資料は、開花・結実が終わった場合、又は栄養が過剰になった場合にランナーが発生すると説明しています。二つの条件は同時に必要という意味ではありません。ランナーを見ただけで、目の前の株が必ず栄養過剰だと断定することもできません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-STRAWBERRY-DEVELOPMENT-2-01"
          ]
        },
        {
          "id": "agr-par12-facility-strawberry-development-2-p2",
          "titleJa": "自然条件の秋以降は花芽分化",
          "textJa": "自然条件では、秋以降の低温と短日の条件で花芽分化するとされています。季節と温度、日長を組にして読み、単に秋に花が開くという説明へ置き換えないようにします。ここで示されるのは芽が花芽になる段階であり、すでに咲いた花や収穫果の観察とは異なります。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-STRAWBERRY-DEVELOPMENT-2-02"
          ]
        },
        {
          "id": "agr-par12-facility-strawberry-development-2-p3",
          "titleJa": "翌年の春以降に開花・結実へ進む",
          "textJa": "同じ自然条件の説明では、翌年の春以降、高温・長日になると開花し、結実します。秋以降の低温・短日による分化と、翌年の暖かく日が長い時期の開花・結実を、年のつながりを保って並べます。低温・短日と高温・長日を一つの段階の条件として混ぜません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-STRAWBERRY-DEVELOPMENT-2-03"
          ]
        },
        {
          "id": "agr-par12-facility-strawberry-development-2-p4",
          "titleJa": "促進の条件には肥料中断もある",
          "textJa": "栽培では、花芽分化を早める育苗の条件として、低温、短日、肥料中断などが挙げられています。温度と日長だけを抜き出して、掲載された条件がそれで全てだとしないことが大切です。ただし、これは資料の条件例を読む学習であり、肥料をいつから何日止めるかを個別の苗へ指示するものではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-STRAWBERRY-DEVELOPMENT-2-04"
          ]
        },
        {
          "id": "agr-par12-facility-strawberry-development-2-p5",
          "titleJa": "高冷地育苗と夜冷育苗の名前",
          "textJa": "2号は、育苗方法の名称として高冷地育苗と夜冷育苗を挙げています。二つを同じ名前にまとめず、資料に出てくる方法名として読み分けます。このページには各方法の作業手順や温度・時間の数値までは載っていないため、名称から細かな操作条件を推測して付け足しません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-STRAWBERRY-DEVELOPMENT-2-05"
          ]
        },
        {
          "id": "agr-par12-facility-strawberry-development-2-p6",
          "titleJa": "低温暗黒育苗とポット育苗も区別する",
          "textJa": "同じ列挙には低温暗黒育苗とポット育苗もあります。低温暗黒育苗という名称と、容器を示すポットという語を一つの意味として扱わず、方法名をそれぞれ記録します。四つの名称を挙げられることと、それぞれの実施手順を習得したことを分け、どの方法でも同じ条件で分化が保証されるとは説明しません。",
          "knowledgeIds": [
            "AGR-K-PAR12-FACILITY-STRAWBERRY-DEVELOPMENT-2-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "栄養過剰",
          "reading": "えいようかじょう"
        },
        {
          "ja": "高冷地育苗",
          "reading": "こうれいちいくびょう"
        },
        {
          "ja": "夜冷育苗",
          "reading": "やれいいくびょう"
        },
        {
          "ja": "低温暗黒育苗",
          "reading": "ていおんあんこくいくびょう"
        }
      ],
      "activityJa": "ランナー発生、秋以降の花芽分化、翌春以降の開花・結実を条件付きで三欄に整理します。分化促進の条件例を別欄へ置き、四つの育苗名を書き出してください。掲載されていない温度、日数、肥料中断の日程は補いません。",
