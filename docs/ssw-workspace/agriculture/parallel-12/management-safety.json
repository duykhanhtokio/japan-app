{
  "schemaVersion": 1,
  "owner": "agri_management_safety",
  "status": "awaiting_independent_ai_review",
  "lessons": [
    {
      "id": "agr-par12-management-machine-mechanisms",
      "revision": "v1",
      "chapter": "耕種農業一般",
      "levels": [
        "2"
      ],
      "titleJa": "噴霧器と草刈り機を仕組みで区別する",
      "objectiveJa": "手動・動力・送風という噴霧器の違いと、草刈り機の駆動・刃・乗用方式を説明できる。",
      "paragraphs": [
        {
          "id": "agr-par12-management-machine-mechanisms-p1",
          "titleJa": "手で圧力を蓄える噴霧器",
          "textJa": "2号資料の肩掛け式手動噴霧器は、手動で圧力を蓄え、薬液を霧状にして作物や雑草へ吹きかける装置です。肩から掛ける形だけでなく、圧力をどのように生むかも名称と結び付けます。「手動」は人が持っているという意味だけではなく、蓄圧の方法を区別する手掛かりです。ここでは薬液の選択や圧力の設定は扱いません。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-MACHINE-MECHANISMS-01"
          ]
        },
        {
          "id": "agr-par12-management-machine-mechanisms-p2",
          "titleJa": "エンジンやモーターを使う噴霧器",
          "textJa": "背負い式動力噴霧器は、資料ではエンジン又はモーターによって圧力を蓄え、薬液を吹きかける装置として示されています。背負うか肩に掛けるかという運び方の違いと、手動か動力かという圧力の作り方の違いを分けて記録します。背負える装置なら全て手動である、と判断しないようにします。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-MACHINE-MECHANISMS-02"
          ]
        },
        {
          "id": "agr-par12-management-machine-mechanisms-p3",
          "titleJa": "タンクとファンを備えるSS",
          "textJa": "スピードスプレーヤーはSSとも記され、大型タンクと大型ファンを備える機械として説明されています。資料は、果樹などに大量の薬剤を一度に散布し、高い所や広い範囲にも届く機構を示しています。タンクが液を保持する役割と、ファンを使うという特徴を分けます。この説明から散布可能な高さや量、周囲への飛散がないことを保証するものではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-MACHINE-MECHANISMS-03"
          ]
        },
        {
          "id": "agr-par12-management-machine-mechanisms-p4",
          "titleJa": "携帯する草刈り機と刃の例",
          "textJa": "草刈り機は刈払機とも呼ばれ、機械を肩に掛けるか背負い、エンジン又はモーターで刃を回して雑草を刈る機械です。掲載される刃の例には、チップソーとナイロンコードカッターがあります。携帯の仕方、回転を生む動力、刃の種類という三つの情報を別々に整理します。二つの刃を全ての機種で交換できるという説明ではありません。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-MACHINE-MECHANISMS-04"
          ]
        },
        {
          "id": "agr-par12-management-machine-mechanisms-p5",
          "titleJa": "縦回転で草を砕くモア",
          "textJa": "自走式草刈り機の説明には、ハンマーナイフモアという名称があります。刈刃は縦に回転するハンマーナイフ式で、草を細かく砕く機械として示されています。携帯型の草刈り機についての説明を、そのままこの刈刃の説明へ当てはめず、回転の仕組みと草を砕く働きを一組にして覚えます。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-MACHINE-MECHANISMS-05"
          ]
        },
        {
          "id": "agr-par12-management-machine-mechanisms-p6",
          "titleJa": "乗用方式と刈幅を対応させる",
          "textJa": "乗用草刈り機は、人が乗って草を刈れる機械です。資料では刈幅が広く、広い敷地の草刈りに使えると説明されています。自走式という名称と乗用という名称を同じ意味とせず、乗って使うことが明示される機械を区別します。ここでの比較は機械の説明であり、作業場所の傾斜限度や運転資格、実機の操作を定めません。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-MACHINE-MECHANISMS-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "蓄圧",
          "reading": "ちくあつ"
        },
        {
          "ja": "動力",
          "reading": "どうりょく"
        },
        {
          "ja": "刈払機",
          "reading": "かりはらいき"
        },
        {
          "ja": "刈幅",
          "reading": "かりはば"
        }
      ],
      "activityJa": "手動噴霧器、動力噴霧器、SSについて圧力や送風の特徴を分けます。草刈り機三種では携帯方法・刈刃の仕組み・乗用の可否を、本文に書かれた範囲で比較してください。写真だけで操作できるとは判断しません。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
      "sources": [
        {
          "documentId": "AGR-S2",
          "pdfPage": 50,
          "printedPage": 48
        }
      ],
      "humanReviewed": false,
      "nativeReviewed": false,
      "domainReviewed": false,
      "sourceHash": "4a69532cdef892351cff0ac6e3b4f01339c608954efb32a0695304eb843dc03a"
    },
    {
      "id": "agr-par12-management-power-fuel-information",
      "revision": "v1",
      "chapter": "安全衛生",
      "levels": [
        "2"
      ],
      "titleJa": "電源の分類と燃料の確認を分ける",
      "objectiveJa": "DC・ACと単相・三相の分類、差込み部の異物リスク、不明な燃料と長期保管燃料に関する資料の注意を区別できる。",
      "paragraphs": [
        {
          "id": "agr-par12-management-power-fuel-information-p1",
          "titleJa": "DCとACの身近な例",
          "textJa": "2号資料は、乾電池やバッテリーを直流電源の例とし、DCという表記を添えています。一方、コンセントなどは交流電源で、ACと表記されます。電源の例と略号を対応させ、バッテリーの例へAC、コンセントの例へDCを入れ替えて記録しないようにします。この分類だけで機械へ接続できるとは判断しません。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-POWER-FUEL-INFORMATION-01"
          ]
        },
        {
          "id": "agr-par12-management-power-fuel-information-p2",
          "titleJa": "単相と三相では送れる電力も比べる",
          "textJa": "資料は単相と三相を区別し、一度に送れる電力量が単相では少なく、三相では多いと説明しています。その比較に続けて、小さい機械では単相、大きな機械では三相を用いることが多いとしています。「多い」という傾向を、外形が大きければ全て三相という判定規則に変えないことが大切です。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-POWER-FUEL-INFORMATION-02"
          ]
        },
        {
          "id": "agr-par12-management-power-fuel-information-p3",
          "titleJa": "大きな機械の利用例を残す",
          "textJa": "三相交流電源を用いる大きな機械の例には、コメの乾燥機や施設の暖房機が挙げられています。単に「大きな機械」とだけ記録するのではなく、乾燥と暖房という用途も名称と対応させます。掲載例を見たことは、現場の個々の機械の電源仕様を確認したこととは別です。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-POWER-FUEL-INFORMATION-03"
          ]
        },
        {
          "id": "agr-par12-management-power-fuel-information-p4",
          "titleJa": "ほこりやごみも事故につながる",
          "textJa": "電気プラグとコンセントについて、資料はほこりやごみが挟まったまま差し込むことも事故につながると注意しています。手が濡れているかという確認と、差込み部分に異物があるかという確認は、異なる項目です。この注意は異物がある状態を使ってよいという意味ではなく、通電したまま清掃する方法も示していません。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-POWER-FUEL-INFORMATION-04"
          ]
        },
        {
          "id": "agr-par12-management-power-fuel-information-p5",
          "titleJa": "種類が分からない燃料は使わない",
          "textJa": "保管している燃料の種類が分からないときは使用しない、という確認原則が資料にあります。機械に合う燃料を使うためには、まず何の燃料かという情報が必要です。置いてあった場所や見た印象だけを、種類が確認できた記録に置き換えません。色の例や容器の外見から不明な燃料を判定する手順は、この授業では作りません。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-POWER-FUEL-INFORMATION-05"
          ]
        },
        {
          "id": "agr-par12-management-power-fuel-information-p6",
          "titleJa": "長期保管と機械不調を結び付ける",
          "textJa": "資料は、燃料が長期間の保管によって変質し、機械の故障につながると説明して、古い燃料を使わないよう注意しています。種類が分かっているかという前段の確認と、保管中に状態が変化していないかという観点を分けます。この記述から全燃料に共通する保管日数を作ったり、古い燃料を回復させる混合手順を考えたりはしません。",
          "knowledgeIds": [
            "AGR-K-PAR12-MANAGEMENT-POWER-FUEL-INFORMATION-06"
          ]
        }
      ],
      "terms": [
        {
          "ja": "直流",
          "reading": "ちょくりゅう"
        },
        {
          "ja": "交流",
          "reading": "こうりゅう"
        },
        {
          "ja": "単相",
          "reading": "たんそう"
        },
        {
          "ja": "三相",
          "reading": "さんそう"
        },
        {
          "ja": "変質",
          "reading": "へんしつ"
        }
      ],
      "activityJa": "DC・AC、単相・三相を別の分類欄に整理し、乾燥機と暖房機の掲載例を対応させます。別欄で差込み部の異物、燃料の種類不明、長期保管による変質を挙げ、確認できない情報を外見から補わない報告を作ってください。",
      "targetMinutes": 30,
      "measuredMinutes": null,
      "timingStatus": "planning_target_unverified",
