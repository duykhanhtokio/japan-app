  "items": [
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "assets/jlpt-original/n5/06/audio/problem-1-01.mp3",
      "startMs": 172080,
      "endMs": 236459,
      "durationMs": 64379,
      "sha256": "ce6a35ccc75091b27b3a609e25d09b1299046092932976fa775222f218124007",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "台所で、男の人が女の人にごはんの作り方を聞いています。男の人は、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "米を二杯入れたよ。水もすぐ入れていい。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "水を入れる前に、米を洗ってね。きれいになったら、この線まで水を入れて。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "水は冷たいのでいいんだね。温かい水もあるけど。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "冷たいのでいいよ。そのあと、ふたを閉めてボタンを押して。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "上の青いボタンかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "うん、それだよ。今はまだ押さないでね。米を洗った水は捨ててから、新しい水を入れるの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかった。では、洗うところから始めるよ。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "assets/jlpt-original/n5/06/audio/problem-1-02.mp3",
      "startMs": 236459,
      "endMs": 307013,
      "durationMs": 70555,
      "sha256": "85e20172a06a26fad7ad2b6542dd4664b46c9e8dc22bd1ffb357da3405ef6251",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "美術館で、男の人と係の女の人が話しています。男の人は、まずどこへ行きますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "この大きいかばんを持って、中へ入ってもいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "大きい荷物は、あちらのロッカーに入れてください。百円玉が一つ必要です。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "財布には千円札が一枚ありますが、百円玉はないんです。どこで百円に変えてもらえますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "入口の案内の机でできますよ。お金は荷物を出すときに戻ります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "わかりました。展示は一階から見ればいいですね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。二階は午後からです。先に案内の机に寄ってくださいね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ありがとうございます。お金を変えてから、荷物を入れます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "assets/jlpt-original/n5/06/audio/problem-1-03.mp3",
      "startMs": 307013,
      "endMs": 376011,
      "durationMs": 68997,
      "sha256": "c313ef31c13e77608e4c5e2cfbf09859aa3324e3156e4c42810515a816aa6c75",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "会社で、二人があしたの会議について話しています。女の人は、何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "会議の部屋が変わったそうですね。お客さんには、メールで知らせればいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "メールを見ない方もいるので、電話してください。来る人は三人です。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "新しい部屋への地図も必要ですよね。わたしが用意しましょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "地図はわたしが印刷します。部屋も、もう予約しました。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "机を動かすのは、どうしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "それは別の人がします。あなたには電話をお願いします。午前中なら、みなさん会社にいます。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、今、三人に電話して、部屋が変わったことを話します。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "assets/jlpt-original/n5/06/audio/problem-1-04.mp3",
      "startMs": 376011,
      "endMs": 444251,
      "durationMs": 68240,
      "sha256": "48218a2d209f69dbc8cfc4c30e988396f377edc26f407090d488b85e9cb571d8",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "図書館で、男の学生と係の人が話しています。男の学生は、どの本を返しますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この写真の本と料理の本、まだ読みたいんですが、もう一週間借りられますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "料理の本は大丈夫です。写真の本は、ほかの人が待っていますから、きょう返してください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかりました。動物の本も借りていますが、家にあります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その本は来週までです。きょう持って来なくて大丈夫ですよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "歴史の本は、先週返しましたよね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい、戻っています。では、写真の本をこちらに置いてください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "はい。料理の本だけ、もう一週間読みます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "assets/jlpt-original/n5/06/audio/problem-1-05.mp3",
      "startMs": 444251,
      "endMs": 510219,
      "durationMs": 65968,
      "sha256": "06753c3b074a6522f3d67658192c635ea0c733c9a6357267554be3e726fd53b1",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "パン屋で、店員の女の人とお客さんが話しています。女の人は、パンをどう入れますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "パンは六つですね。大きい袋に全部入れてもいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "家で二人にあげるので、半分ずつに分けてください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "三つずつですね。パンの種類も同じにしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。この甘いパンを一つと、丸いパンを二つ、どちらの袋にも入れてください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "わかりました。小さい袋を六つ用意する必要はありませんね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ええ、二つだけでいいです。持ちやすいようにしてください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、三つ入れた袋を二つ作ります。少々お待ちください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "assets/jlpt-original/n5/06/audio/problem-1-06.mp3",
      "startMs": 510219,
      "endMs": 574949,
      "durationMs": 64731,
      "sha256": "eaa6037db8e120c4eebec435c01a574c5b4fc009bd243a423987b539eef44a1d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、男の人と女の人が話しています。男の人は、どこへ行きますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "シャツのボタンが取れたんだ。駅前のクリーニング店で直してもらえるかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "あそこは洗うだけだよ。駅の横の洋服の店なら、小さい修理もしてくれるよ。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "学校の近くの店じゃなかった。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "そこは靴の店。シャツは直さないと思う。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "公園の売店は近いけど、服は売っていないよね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "うん、飲み物とお菓子だけ。洋服の店は、今からでも間に合うよ。六時までだから。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ありがとう。シャツを袋に入れて、駅の横へ行ってくる。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "assets/jlpt-original/n5/06/audio/problem-1-07.mp3",
      "startMs": 574949,
      "endMs": 637557,
      "durationMs": 62608,
      "sha256": "c0ce540b19bc64e85841bb054347287ebaad833bbaead70ec2f43139a0d4c449",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
