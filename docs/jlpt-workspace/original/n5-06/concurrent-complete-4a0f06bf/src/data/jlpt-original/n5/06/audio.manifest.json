        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "教室の机は、少し汚れているけど。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "机はわたしがふくから、あなたは飲み物の箱をお願い。そのあと、外のいすを並べよう。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかった。まず教室へ持って行くね。"
        }
      ],
      "scored": false
