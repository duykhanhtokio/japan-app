    {
      "role": "problem_instructions_example_demonstration",
      "problem": 1,
      "startMs": 51413,
      "endMs": 120305,
      "exampleId": "jpapp-n1-original-02-v1-example-1",
      "exampleStartMs": 68223,
      "exampleEndMs": 109140,
      "exampleCount": 1,
      "exampleTurns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、この後何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "案内を入り口に貼りましたが、立ち止まって読む人が少ないですね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "受付で一枚ずつ渡す方がよさそうです。まだ予備があります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "では、受付台にまとめて置いてください。来た人へ私から声を掛けます。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "分かりました。予備を持って受付へ行きます。"
        }
      ],
      "scored": false
    },
    {
      "role": "problem_instructions_example_demonstration",
      "problem": 2,
      "startMs": 749387,
      "endMs": 826833,
      "exampleId": "jpapp-n1-original-02-v1-example-2",
      "exampleStartMs": 765385,
      "exampleEndMs": 815455,
      "exampleCount": 1,
      "exampleTurns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、なぜ原稿を短くしなかったのですか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "この注意書きは、もう少し短くなりませんか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "例を減らせば短くできますが、いつ申請が必要かが分からなくなります。条件の説明は残したいです。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "では、文字の大きさでなく、内容を優先したんですね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ええ。短くする方法がないわけではありません。必要な条件を読み取れることを優先しました。"
        }
      ],
      "scored": false
    },
    {
      "role": "problem_instructions_example_demonstration",
      "problem": 3,
      "startMs": 1525236,
      "endMs": 1613019,
      "exampleId": "jpapp-n1-original-02-v1-example-3",
      "exampleStartMs": 1544765,
      "exampleEndMs": 1601352,
      "exampleCount": 1,
      "exampleTurns": [
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "作品を展示するとき、完成した姿だけを見せると、最初からその形だったように思われます。迷いながら線を消し、色を変えた跡も残せば、選択の過程を感じられるでしょう。私は完成品と一緒に、途中の図も見せたいと思います。未完成品を売るためではありません。"
        },
        {
          "actor": "option-1",
          "role": "youngMale",
          "text": "作品の展示に変更の跡も示す"
        },
        {
          "actor": "option-2",
          "role": "youngMale",
          "text": "作品は全て完成後に破棄する"
        },
        {
          "actor": "option-3",
          "role": "youngMale",
          "text": "作者の説明だけを掲示する"
        },
        {
          "actor": "option-4",
          "role": "youngMale",
          "text": "未完成の作品を販売する"
        }
      ],
      "scored": false
    },
    {
      "role": "problem_instructions_example_demonstration",
      "problem": 4,
      "startMs": 2223923,
      "endMs": 2281624,
      "exampleId": "jpapp-n1-original-02-v1-example-4",
      "exampleStartMs": 2240892,
      "exampleEndMs": 2269541,
      "exampleCount": 1,
      "exampleTurns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "念のため、同じ内容をメールでもいただけますか。"
        },
        {
          "actor": "option-1",
          "role": "youngMale",
          "text": "はい。今お話ししたことを文書で送ります。"
        },
        {
          "actor": "option-2",
          "role": "youngMale",
          "text": "はい。内容を全部変えてお伝えします。"
        },
        {
          "actor": "option-3",
          "role": "youngMale",
          "text": "はい。メールでは連絡しません。"
        }
      ],
      "scored": false
    },
    {
      "role": "problem_instructions_example_demonstration",
      "problem": 5,
      "startMs": 2720200,
      "endMs": 2800127,
      "exampleId": "jpapp-n1-original-02-v1-example-5",
      "exampleStartMs": 2742279,
      "exampleEndMs": 2787063,
      "exampleCount": 1,
      "exampleTurns": [
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "工場へは十一時半までに着きたいです。大きな箱があるので、乗換は避けましょう。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "九時は乗換があり、十時は直通で十一時に着きます。十一時の直通は十二時着です。十二時の便も乗換があります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "では、十時の直通にしましょう。早く着いて受付の準備もできます。"
        }
      ],
      "scored": false
    },
    {
      "role": "closing",
      "startMs": 3276596,
      "endMs": 3284648
    }
  ],
