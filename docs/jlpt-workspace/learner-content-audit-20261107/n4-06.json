        "before": {
          "text": "払って",
          "rationale": "友達への一時的な借金を表さない。"
        },
        "after": {
          "text": "落として",
          "rationale": "お金を落とすことは、必要なお金を一時的に借りることではない。"
        },
        "reason": "A friend paying money for someone who forgot a wallet is as natural as lending; remove the valid payment alternative."
      },
      {
        "questionId": "jpapp-n4-original-06-v1-vocabulary-5-01",
        "kind": "competing_valid_answer",
        "optionId": "3",
        "before": {
          "text": "約束の時間を相談したら、もう三十分過ぎていました。",
          "rationale": "不正解。経過時刻を知るための行為は確認する。相談で時刻を調べない。"
        },
        "after": {
          "text": "約束の時間を時計で相談してから出かけました。",
          "rationale": "時計で時刻を調べるなら「確認する」を使う。「相談する」は相手と話し合うことで、時計を道具として時刻を確認する意味には使えない。"
        },
        "reason": "The original 約束の時間を相談したら、もう三十分過ぎていました permits a valid conversation about an appointment lasting past its time; it is not a misuse of 相談."
      },
      {
        "questionId": "jpapp-n4-original-06-v1-grammar_reading-1-07",
        "kind": "competing_valid_answer",
        "optionId": "1",
        "before": {
          "text": "より",
          "rationale": "不正解。文脈・質問の目的と一致しない。"
        },
        "after": {
          "text": "に",
          "rationale": "「思っていたに辛くありません」という接続はできない。否定比較では「思っていたほど辛くありません」とする。"
        },
        "reason": "思っていたより辛くありません also correctly means less spicy than expected, competing with ほど."
      },
