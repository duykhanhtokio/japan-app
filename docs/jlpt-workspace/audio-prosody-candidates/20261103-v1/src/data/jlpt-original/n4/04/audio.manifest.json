  "items": [
    {
      "questionId": "jpapp-n4-original-04-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/04/audio/problem-1-01.mp3",
      "startMs": 46940,
      "endMs": 114380,
      "durationMs": 67440,
      "sha256": "0439233292948811fc0f1ca7a04fbc754c76be10910db3c235b203520534b298",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "音楽教室で、男の人と先生が話しています。男の人は、次に何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "先生、この曲を最後まで弾いてみました。途中で止まらずにできたんですが、右手と左手がずれている気がします。もう一度全部弾きますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "全部弾く前に、真ん中の四つの小節を練習しましょう。右手が速くなってしまう所です。まず、左手だけでゆっくり弾いてみてください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "左手だけだと、音が少なくて簡単そうですね。右手の動きを先に覚えたほうが、あとで合わせやすくなると思っていたんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "右手は十分動いています。左手の音をよく聞きながら、同じ速さで弾くことが大切です。左手が安定したら、右手を一緒に使いましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-04-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/04/audio/problem-1-02.mp3",
      "startMs": 114380,
      "endMs": 199991,
      "durationMs": 85611,
      "sha256": "94adbb006f678ef6918450f5a53dbdbcdb4e2aba89fe449524a08735ef2c8de0",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "喫茶店で、店員と店長が話しています。店員は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "店長、テーブルの上のメニューが汚れていました。新しいものはまだありますか。昨日、お客さんが飲み物をこぼしたのかもしれません。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "新しいのは奥の棚にあります。ただ、今日から飲み物の値段が変わるので、前のメニューをそのまま出さないでください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "新しい値段を書いた紙を貼ればいいですか。それとも、全部印刷し直しますか。開店までまだ三十分あるので、今ならできそうです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "印刷は私がします。先に、全部のテーブルからメニューを集めてきてください。汚れたものだけでなく、きれいなものも入れ替えます。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。入口に置いてある大きなメニューも持ってきますか。あれにも飲み物の値段が書いてあります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "入口のはあとで私が直します。今はテーブルの分を全部集めて、この箱に入れてください。印刷が終わったら、新しいのを並べてもらいます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-04-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/04/audio/problem-1-03.mp3",
      "startMs": 199991,
      "endMs": 290209,
      "durationMs": 90219,
      "sha256": "6b52cf38b8b8f1ecb8abbaecd134e3dd1b1d3597b923da4c4201000e1bdbc134",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "公園で、女の人と係の人が話しています。女の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "花を植える活動に参加したいんですが、まだ間に合いますか。少し遅れてしまいました。みなさんはもう花壇のところに行っていますね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい、参加できます。道具はあちらで渡しますが、初めて来た方には先に名前を書いていただいています。こちらの紙を使ってください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "電話で申し込んだときに名前を伝えたんですが、もう一度書くんですか。申し込みの番号も持ってきました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今日実際に来た方の人数を確認したいので、お願いします。紙には住所はいりません。名前と、今日連絡できる電話番号だけ書いてください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "わかりました。手袋は持ってきたので、そのあと、花壇に行けばいいですね。長靴は家に忘れましたが、大丈夫でしょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今日は地面が乾いているので、今の靴で大丈夫です。先に紙を書いてください。書き終わったら、私が道具を受け取る場所をご案内します。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-04-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/04/audio/problem-1-04.mp3",
      "startMs": 290209,
      "endMs": 356860,
      "durationMs": 66651,
      "sha256": "7d1346fc3e8dcec19b829f53664678614ad9a4157669412872aaf261cd984ada",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、二人が洗濯について話しています。男の人は、まずどの服を干しますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "洗濯が終わったよ。全部ベランダに干そうと思うけど、午後は雨になるんだよね。今のうちにできるだけ乾かしておきたいな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "そうだね。薄いシャツは早く乾くから、あとでいい。厚いズボンを先に広げてほしい。下の方まで風が通るように、間を空けてね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "タオルもたくさんあるよ。タオルを先に干せば、ズボンを広げる場所が少なくなるけど、洗濯物を一度に全部干せると思う。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "全部一緒には無理だから、タオルは部屋の中に干そう。ズボンは外の大きい物干しを使って。シャツはズボンが乾いたら、同じ場所に干せる。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-04-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/04/audio/problem-1-05.mp3",
      "startMs": 356860,
      "endMs": 445959,
      "durationMs": 89099,
      "sha256": "3e78cf4e115329725bf8fa646d570fe992e23f48073e9893b897de08a4118858",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "店で、男の人と係の人が時計について話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この時計の電池を替えていただけますか。先週から止まっています。前にこの店で買ったものですが、箱や紙は持ってきませんでした。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "電池を替えられます。ただ、これは裏のふたを外すために、特別な道具が必要な時計ですね。今日はその道具を別の店に貸しています。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "では、時計をここに置いていけば、明日直してもらえますか。明後日から旅行に行くので、それまでに使えると助かるんですが。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "明日の夕方ならお渡しできます。お預かりする前に、時計の状態を写真に撮らせてください。その間、この紙に連絡先を書いていただけますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "受け取るときに、何か持ってきますか。家にある買ったときの紙を探したほうがいいでしょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "今お渡しする預かりの紙だけで大丈夫です。まず、こちらに名前と電話番号を書いてください。写真を撮ったら、預かりの紙をお渡しします。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-04-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/04/audio/problem-1-06.mp3",
      "startMs": 445959,
      "endMs": 535409,
      "durationMs": 89451,
      "sha256": "3152ab2edc977094bf7669e4bf629989d25c5a9bd59b32f5abd3993e2f8578ea",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で、女の人と先生が話しています。女の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、明日の見学に参加できなくなりました。朝、病院へ行くことになったんです。見学のあとに出す作文は、どうすればいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "見学できない人は、資料室の写真を見て作文を書きます。今日、少し時間がありますか。部屋は五時まで開いています。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "はい。これから資料室に行けます。何の写真を見ればいいでしょうか。見学する工場の写真が置いてあるんですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "工場の写真もありますが、まず、この本の二十ページを読んでください。何を作る工場なのかがわかります。それから写真を見ると、理解しやすいですよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "本は借りられますか。今日は本を読んで、作文は家で書きたいと思います。写真も家で見られると便利なんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "この本は持ち帰っていいです。まずここで二十ページを読みましょう。写真は資料室で見て、必要なことをメモしてください。写真の持ち出しはできません。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-04-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/04/audio/problem-1-07.mp3",
      "startMs": 535409,
      "endMs": 618119,
      "durationMs": 82709,
      "sha256": "d0580cc96d77a72b0f3c79f540e0f94bff77960dec1afc85ef07fe653a682b39",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "ホテルで、男の人と係の人が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "部屋の鍵をかばんに入れたつもりだったんですが、見つかりません。部屋の中に置いたままかもしれないので、もう一つ鍵を借りられますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "お名前と部屋の番号をお願いします。ご本人か確認してから、新しい鍵をお渡しします。何か名前がわかるものをお持ちですか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "運転免許のカードなら、財布にあります。部屋は五階の五〇六です。昨日、チェックインしたときにもカードをお見せしました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ありがとうございます。今の受付ではまだ確認できていませんので、もう一度見せていただけますか。確認はすぐに終わります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "はい。財布はかばんの横のポケットにあります。古い鍵が部屋にあったら、あとでこちらへ返せばいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうしてください。まず免許のカードを出していただけますか。確認したら新しい鍵をお渡ししますので、部屋で古い鍵を探してみてください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-04-v1-listening-1-08",
      "group": 1,
      "number": 8,
