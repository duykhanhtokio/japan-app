  "items": [
    {
      "questionId": "jpapp-n4-original-06-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/06/audio/problem-1-01.mp3",
      "startMs": 46940,
      "endMs": 145905,
      "durationMs": 98965,
      "sha256": "86c1da3e3fbfa301a7c9ff93d7b0b0ff6639b385265b251e1cda3573ccc90977",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "公民館で、女の人と係の男の人が話しています。女の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "来週、ここで友達と小さな音楽会を開きたいんです。部屋の予約は電話でしてあります。今日、お金を払えば、鍵も受け取れますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ご予約ありがとうございます。音楽会は、部屋の中だけで行う予定ですか。廊下で楽器を鳴らすことはできません。隣では別の教室を使っています。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "部屋の中だけで大丈夫です。歌う人はいません。友達が楽器を弾いて、みんなで聞く予定です。近くの教室の邪魔にならないようにしたいです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "鍵は当日お渡しします。料金を払う前に、この紙に参加する人数と使う楽器を書いてください。楽器によって部屋を変えることがありますから。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ピアノだけを使う予定でしたが、友達がギターも持ってくるそうです。人数は十人です。電話で話したときは八人と伝えてしまいました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "それなら、今の人数とピアノ、ギターの両方を紙に書いてください。書き終わったら、この窓口に出してください。部屋を確認してから料金をお伝えします。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-06-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/06/audio/problem-1-02.mp3",
      "startMs": 145905,
      "endMs": 239943,
      "durationMs": 94037,
      "sha256": "dc9001665d950cffc784a6a38a2d719e339779951a6bb24c4e1f8e91d53dfc82",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "靴の店で、男の人と店員が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "昨日買った靴なんですが、家で履くと右の足だけ痛くなりました。外ではまだ履いていません。もっと大きいサイズに替えたいんです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "お買い上げのときのレシートはお持ちですか。交換には、買った日と商品を確認できるものが必要なんです。箱も一緒にあれば、助かります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "はい、箱の中に入れてあります。昨日は店では短い時間しか履かなかったので、気づきませんでした。今度は、足に合っているかゆっくり確かめたいです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "商品を見てもいいですか。はい、交換できます。同じ靴の大きいサイズもありますが、左右の幅が合わない場合は、別の形のほうがいいこともあります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "長さは今のままでも大丈夫なんです。今日は時間がありますから、別の形も見てみたいです。先に交換の紙を書いたほうがいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "紙は靴が決まってからで結構です。まず、こちらの幅が広い靴を両方履いて、少し歩いてみてください。痛い所がないか確かめてから選びましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-06-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/06/audio/problem-1-03.mp3",
      "startMs": 239943,
      "endMs": 332497,
      "durationMs": 92555,
      "sha256": "48fd92cb7b51bfe630a32e87ba4066f466c484e7159ccdf6fb89310e870b790b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で、二人の学生が話しています。男の学生は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "明日の発表の写真を印刷しようとしたんだけど、プリンターが動かないんだ。先生にメールして、写真なしで発表してもいいか聞こうかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "写真は何枚使うの？大きい写真を何枚も印刷すると、授業が始まるまでに終わらないかもしれないよ。発表の時間は五分だったよね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "二枚だけだよ。説明する場所が違うから、両方必要なんだ。紙は小さいのでいいし、発表に使う文はもうできている。写真さえ用意できれば大丈夫だよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "昨日、私も同じことがあったよ。画面に何か出ていない？紙を入れる所が開いていると、印刷できないことがあるんだって。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "紙は入っているし、ふたも閉まっているよ。あ、画面に黒いインクの印が出てる。新しいインクは棚にあるみたいだけど、勝手に替えていいのかな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "インクは先生が替えることになってるから、自分でやらないでね。メールだと時間がかかるよ。先生は今、隣の教室にいるから、直接伝えに行ったら。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-06-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/06/audio/problem-1-04.mp3",
      "startMs": 332497,
      "endMs": 425233,
      "durationMs": 92736,
      "sha256": "4d92db8563e51ce79a17e94b6af9277cdf9e1fd6772e4efd936d41935b593e8b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "山へ出かける前に、夫婦が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "荷物は車に入れたよ。今日はいつもの道で山へ行こう。途中の店で昼ご飯を買えばいいよね。出る前に、ガソリンを入れておこうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "山では夕方から雨になるらしいよ。遅くならないうちに帰ってこようね。車を止める場所は、前と同じ所を使えるのかな。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "駐車場は昨日、電話で確かめたよ。朝から開いていて、今日は特別な行事もないそうだ。昼ご飯を食べたら、あまり遠くまで歩かずに戻るつもりだよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ガソリンは昨日入れたから大丈夫。それより、山の道が工事中らしいの。昨日のニュースで見たけど、どの辺かまでは分からなかった。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "じゃあ、駅の前を通る道にしようか。少し遠いけど、前に一度行ったことがあるよ。その道なら、途中に店もあるはずだよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その道も通れないかもしれないから、決める前に、町のホームページで工事の場所を調べてくれる？私はその間に家の鍵を確認するね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-06-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/06/audio/problem-1-05.mp3",
      "startMs": 425233,
      "endMs": 523025,
      "durationMs": 97792,
      "sha256": "391c52aea32f7e7e0321e2b7c79e10eab29bada8e82f65fa6593e15fe0193c48",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "会社で、女の人と男の人が話しています。女の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "明日の会議の資料を人数分、机に並べました。会議室の窓を開けてから帰ってもいいですか。今日は少し暑かったので、空気を入れたいんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "会議室に並べてくれてありがとうございます。資料の最後に地図は入っていますか。明日は初めてこの会社に来る人もいるので、帰り道の説明に使います。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい、地図は最後のページにあります。駅までの道とバス停の場所が分かるようにしてあります。紙が裏返しになっているものも直しておきました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今夜は雨が強くなるそうだから、窓は開けないでください。それと、明日は三人増えることになりました。資料は机の上に何部ありますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "十二部です。元の参加者は十二人でしたよね。棚に予備が二部ありますが、足りませんね。もう一部印刷すればいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい、一部印刷してください。棚の二部は私が持っていきますから。印刷が終わったら、窓の鍵を確かめて帰ってください。机の並べ方は明日の朝、私が変えます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-06-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/06/audio/problem-1-06.mp3",
      "startMs": 523025,
      "endMs": 595105,
      "durationMs": 72080,
      "sha256": "4df49792e8fef78a586ced508f3fa6d2c9e42b7efca5be4e0f70b1095e1155d1",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "果物の店で、女の人と店員が話しています。店員は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "りんごを六個、別々に袋に入れてください。近所の人に一個ずつ渡したいんです。大きいものより、持ちやすい小さいものがいいです。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "こちらの小さいりんごはいかがですか。六個ありますが、一個だけ少し傷がついています。味には問題ありませんし、安くできますよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "自分で食べるなら傷があってもいいんですが、人に渡すので、全部傷のないものにしたいです。同じ大きさのものは、まだありますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "店の奥に箱があります。先にそちらから傷のない小さいりんごを一個持ってきますね。六個そろったら、別々の袋に入れます。料金は普通の値段になります。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-06-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n4/06/audio/problem-1-07.mp3",
      "startMs": 595105,
      "endMs": 665361,
      "durationMs": 70256,
      "sha256": "99de3e8640d8b80238f2c6be5b14f66e27ffca91ce35e2aaa3ed528a3e901c69",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "アパートで、学生と管理人が話しています。学生は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "部屋の電気が急に消えたんです。廊下は明るいので、建物全部ではないと思います。電気会社に電話したら、今日は忙しいと言われました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "何を使っていたか覚えていますか。暖房と電子レンジを一緒に使うと、部屋の電気が止まることがあります。入口の上の小さい箱を見てみましょう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "暖房をつけて、お湯を沸かしながら電子レンジを使っていました。箱のスイッチを上げればいいんですね。今すぐ上げてみます。"
        },
