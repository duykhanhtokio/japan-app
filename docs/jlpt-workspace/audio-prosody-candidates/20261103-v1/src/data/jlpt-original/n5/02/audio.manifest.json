  "items": [
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/02/audio/problem-1-01.mp3",
      "startMs": 47431,
      "endMs": 115721,
      "durationMs": 68291,
      "sha256": "47d17142230b06de2c3340fe16db603dacabc67e2b0b00d5517a402968619e56",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "コインランドリーで、店の人と女の人が話しています。女の人は、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "すみません。この洗濯機を使ってもいいですか。洗う服はこのかごに入っています。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。でも、服を入れる前に、この空のかごを入口の棚へ運んでください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "入口の棚ですね。青いかごと白いかごがあるけど、どちらですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "青いほうです。白いかごはあとで私が使うので、ここに置いてください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。それから服を入れます。洗剤も買わないといけませんか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "洗剤は機械の中にあります。床も今ふいたので、そうじはしなくていいですよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "では、青いかごを運んでから、洗濯を始めます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/02/audio/problem-1-02.mp3",
      "startMs": 115721,
      "endMs": 191057,
      "durationMs": 75336,
      "sha256": "6b8393dd9b2cffbffaaed41aa953bff5581dcbdd2a2b56e81e8dd42b934fe763",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "建物の入口で、男の人が係の女の人に聞いています。男の人は、まずどこへ行きますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "写真を見に来ました。切符は、ここで買えますか。この紙は学校でもらいました。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その紙がある方は、先に二階の案内所へ行ってください。今日の切符をもらえます。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "紙には家で名前を書きました。ここでお金も払いますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "いいえ。お金はいりません。二階で、その紙を見せるだけでいいですよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "二階へは、この奥の階段ですか。右にも階段がありますね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "奥のほうです。右はお店の階段です。一階のお店には帰りに寄れますよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "駅の改札でも、この紙を見せるんですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "駅では使いません。二階で切符をもらったら、この入口に戻ってください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/02/audio/problem-1-03.mp3",
      "startMs": 191057,
      "endMs": 260959,
      "durationMs": 69901,
      "sha256": "4a07fbf00c3819a15439cb6982b5fc39cf0b16c6ffc23742023a36790fc5bf1d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、男の人と女の人が携帯電話について話しています。女の人は、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "携帯電話が熱くなっているけど、このまま充電しても大丈夫かな。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "今は充電しないで、先に電話の電源を切っておこう。ずっと使っていたからだと思うよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "電源を切るのね。電池も外したほうがいい？前の電話は外せたよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この電話の電池は自分では取れないから、触らないでね。少し待ってみよう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "お母さんに電話をかけたかったけど、あとにするね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "うん。熱くなくなってから使って。それでも熱かったら、店で見てもらおう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "充電の線も、新しいのを買ったほうがいい？"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "まだ買わなくていいよ。今は使うのをやめて、電源を切ろう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/02/audio/problem-1-04.mp3",
      "startMs": 260959,
      "endMs": 326444,
      "durationMs": 65485,
      "sha256": "8f399ecff336a4bba101f1a9837654ff2f05419cb3d0f5fdc0ee2447991ad141",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、女の人と男の人が空のびんを片づけています。男の人は、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "このびん、中にジュースが少し残っているよ。ふたはもう取ったけど、どうしよう。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "水で洗ってから、こっちのかごに入れて。ふたは私があとで別にするよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "洗ったら、外に出してもいい？今日は、ごみの日だよね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "普通のごみは今日だけど、びんは明日。今日は家の中に置いておいてね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この袋に入れるの？びんが重いから、二枚使おうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "袋は紙のごみ用だよ。びんはかごに入れて。紙を貼らなくてもいいよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "じゃあ、台所で、水で中をきれいにするね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/02/audio/problem-1-05.mp3",
      "startMs": 326444,
      "endMs": 398655,
      "durationMs": 72211,
      "sha256": "1fcca3c240856e8c88d33c993b4e34a52aea2e05be0faddc3c34a15ea4e1b67b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "店で、男の人と女の人が卵を選んでいます。女の人は、どの卵を買いますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "明日は八人で朝ごはんだね。卵は家に何個あるかな。一人一個でいい？"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん、二個あるから、あと六個買えばいいね。パンや野菜も食べるよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "大きい卵の六個入りは、こっちの小さい卵より安いよ。どうする？"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "お皿が小さいから、小さい卵がいいな。全部食べられると思うし。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "じゃあ、小さい卵の十個入りは？残った分は、夜に使えばいいよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "夜は外で食べるし、あさってから旅行に行くから、卵を残したくないの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうか。では、小さい卵の六個入りにしようか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん。家の二個と合わせて、ちょうど八個になるね。これを買おう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/02/audio/problem-1-06.mp3",
      "startMs": 398655,
      "endMs": 464711,
      "durationMs": 66056,
      "sha256": "6c0c81e4c1b9a4876ffa4903d84365aa8632dce254b0abb96909506897b1d211",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "店で、男の人が女の店員にコピーの取り方を聞いています。男の人は、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この紙を十枚コピーしたいんですが、どうしますか。お金はもう入れました。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "今は大きい紙のサイズになっていますね。先に、お持ちの紙と同じ小さいサイズに変えましょう。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この下のボタンですか。十枚という数字も、今入れたほうがいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "数字はサイズのあとです。小さい紙のボタンを押してから、十枚と入れてください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかりました。お金が足りないときは、あとで足せますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。でも、今のお金で十枚は取れると思います。足りないと、画面に出ますよ。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-02-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/02/audio/problem-1-07.mp3",
      "startMs": 464711,
      "endMs": 534164,
      "durationMs": 69453,
      "sha256": "21a79cf30733f2da3123f60bb2d606fea91e936e8cc3478108bac9257082623e",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で、先生と女の人が掃除について話しています。女の人は、まず何を持って来ますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "床はきれいですが、窓の上にごみがありますね。今日はあそこをそうじしましょう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "いすに乗って、ぞうきんでふきますか。台所に小さいぞうきんがあります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "いすは危ないので、やめましょう。長いほうきなら、下から届きますよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "どこにありますか。入口には短いほうきしかありませんでした。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "長いほうきは、廊下の奥の棚にあります。まず、それを持ってきてください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "水のバケツも使いますか。床もふこうと思っていたんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
