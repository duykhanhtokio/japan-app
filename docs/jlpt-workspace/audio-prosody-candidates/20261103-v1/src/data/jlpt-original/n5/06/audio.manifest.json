  "items": [
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/06/audio/problem-1-01.mp3",
      "startMs": 47431,
      "endMs": 107860,
      "durationMs": 60429,
      "sha256": "4ccd384eaaabdc65353c72f759735f6908476de56fc1ce696ab1339364b98745",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "台所で、男の人が女の人にごはんの作り方を聞いています。男の人は、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "米を二杯入れたよ。水もすぐ入れていい。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "水を入れる前に、米を洗ってね。きれいになったら、この線まで水を入れて。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "水は冷たいのでいいんだね。温かい水もあるけど。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "冷たいのでいいよ。そのあと、ふたを閉めてボタンを押して。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "上の青いボタンかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "うん、それだよ。今はまだ押さないでね。米を洗った水は捨ててから、新しい水を入れるの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかった。では、洗うところから始めるよ。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/06/audio/problem-1-02.mp3",
      "startMs": 107860,
      "endMs": 174369,
      "durationMs": 66509,
      "sha256": "108f8df04fde4d648c02744ca204026104940b336b33516bfaba90881b572e6b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "美術館で、男の人と係の女の人が話しています。男の人は、まずどこへ行きますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "この大きいかばんを持って、中へ入ってもいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "大きい荷物は、あちらのロッカーに入れてください。百円玉が一つ必要です。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "財布には千円札が一枚ありますが、百円玉はないんです。どこで百円に変えてもらえますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "入口の案内の机でできますよ。お金は荷物を出すときに戻ります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "わかりました。展示は一階から見ればいいですね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。二階は午後からです。先に案内の机に寄ってくださいね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ありがとうございます。お金を変えてから、荷物を入れます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/06/audio/problem-1-03.mp3",
      "startMs": 174369,
      "endMs": 239161,
      "durationMs": 64792,
      "sha256": "8a453164b09c2c2b7a3f513ab5f9d0eb589fa37a8a272e366b7a39ff3d126cc5",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "会社で、二人があしたの会議について話しています。女の人は、何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "会議の部屋が変わったそうですね。お客さんには、メールで知らせればいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "メールを見ない方もいるので、電話してください。来る人は三人です。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "新しい部屋への地図も必要ですよね。わたしが用意しましょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "地図はわたしが印刷します。部屋も、もう予約しました。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "机を動かすのは、どうしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "それは別の人がします。あなたには電話をお願いします。午前中なら、みなさん会社にいます。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、今、三人に電話して、部屋が変わったことを話します。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/06/audio/problem-1-04.mp3",
      "startMs": 239161,
      "endMs": 303324,
      "durationMs": 64163,
      "sha256": "594fbb49013bb306b40bceb49e0e0cc32fd1f42fd9d0fe722695fda521d4b171",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "図書館で、男の学生と係の人が話しています。男の学生は、どの本を返しますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この写真の本と料理の本、まだ読みたいんですが、もう一週間借りられますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "料理の本は大丈夫です。写真の本は、ほかの人が待っていますから、きょう返してください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかりました。動物の本も借りていますが、家にあります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その本は来週までです。きょう持って来なくて大丈夫ですよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "歴史の本は、先週返しましたよね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい、戻っています。では、写真の本をこちらに置いてください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "はい。料理の本だけ、もう一週間読みます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/06/audio/problem-1-05.mp3",
      "startMs": 303324,
      "endMs": 365439,
      "durationMs": 62115,
      "sha256": "7ffb98d784f25b4a23be29e03c9ec9c66559066fadc419c155efc13fd062a621",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "パン屋で、店員の女の人とお客さんが話しています。女の人は、パンをどう入れますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "パンは六つですね。大きい袋に全部入れてもいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "家で二人にあげるので、半分ずつに分けてください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "三つずつですね。パンの種類も同じにしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。この甘いパンを一つと、丸いパンを二つ、どちらの袋にも入れてください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "わかりました。小さい袋を六つ用意する必要はありませんね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ええ、二つだけでいいです。持ちやすいようにしてください。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、三つ入れた袋を二つ作ります。少々お待ちください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/06/audio/problem-1-06.mp3",
      "startMs": 365439,
      "endMs": 426284,
      "durationMs": 60845,
      "sha256": "b04dbadd0621bea09f4c7a88f1016cbcbe3a4d818e36f6193171ed66966cb4da",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、男の人と女の人が話しています。男の人は、どこへ行きますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "シャツのボタンが取れたんだ。駅前のクリーニング店で直してもらえるかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "あそこは洗うだけだよ。駅の横の洋服の店なら、小さい修理もしてくれるよ。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "学校の近くの店じゃなかった。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "そこは靴の店。シャツは直さないと思う。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "公園の売店は近いけど、服は売っていないよね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "うん、飲み物とお菓子だけ。洋服の店は、今からでも間に合うよ。六時までだから。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ありがとう。シャツを袋に入れて、駅の横へ行ってくる。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/06/audio/problem-1-07.mp3",
      "startMs": 426284,
      "endMs": 485199,
      "durationMs": 58915,
      "sha256": "509a8ea76049528f9aa1669ed5acbddd528d6272d6ff938d64a4a29c69650ea6",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で、女の学生と先生が絵を描く準備をしています。女の学生は、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、この机で描いてもいいですか。絵の具で汚れそうですね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "いいですよ。先に、机の上にこの布をかけてください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "いすは、じゃまだから外に出しましょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "いすはそのままでいいです。座って描きますから。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "絵の具が足りなかったら、買いに行きますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "棚に新しいのがあります。窓は開けたままにして、部屋に風を入れましょう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "はい。机を汚さないように、先に布を広げます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-06-v1-listening-2-01",
      "group": 2,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/06/audio/problem-2-01.mp3",
      "startMs": 598505,
