  "items": [
    {
      "questionId": "jpapp-n5-original-05-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/05/audio/problem-1-01.mp3",
      "startMs": 47431,
      "endMs": 111945,
      "durationMs": 64515,
      "sha256": "d9cf2227168612613ee6cbc06cd1c2c358f489f91ab168bf5e96cbd8ebde300f",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "体操教室の入口で、女の人と係の人が話しています。女の人は、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "初めて来ました。教室は二階ですか。すぐ上へ行けばいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "二階ですが、先にこちらの受付で名前を書いてください。初めての方にはカードを作ります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。二階では靴を脱ぎますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "部屋の前で脱いでください。入口では脱がなくて大丈夫です。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "わかりました。水も持って来ました。部屋で飲んでもいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい、体操の途中でも飲めます。名前を書いたら、カードを持って二階へどうぞ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、こちらで書きますね。ペンをお借りします。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-05-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/05/audio/problem-1-02.mp3",
      "startMs": 111945,
      "endMs": 170199,
      "durationMs": 58253,
      "sha256": "22b5efd893a0b2faf55927acdc10c22c53b7a214d3c50f3b18aecf38d2fcbc67",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学生二人が、あしたの外の授業について話しています。男の学生は、何を持って来ますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "あしたはずっと外にいるんだよね。新しい帽子を買わないと。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "家にある帽子でいいよ。先生は、色や形は何でもいいと言っていたから。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "家の帽子は赤いんだ。それでも大丈夫かな。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん、暑いから頭にかぶる物が必要なんだよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "雨が降ったら、学校の傘を借りられる。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "雨の日は授業が教室に変わるよ。大きいかばんもいらないって。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうなんだ。じゃあ、赤い帽子を今夜かばんに入れておくね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-05-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/05/audio/problem-1-03.mp3",
      "startMs": 170199,
      "endMs": 230831,
      "durationMs": 60632,
      "sha256": "e2313ace223af75eb834f5f1c3dbd23114354bebfa5ff5708a634904beb9da96",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で女の人と男の人が洗濯機を見ています。女の人は、どのボタンを押しますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "この洗濯機、使い方がわからないね。服は入れたけど、どれを押せば始まるの。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "一番下の丸いボタンだよ。押すと洗濯が始まる。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "上にも丸いボタンがあるけど、そちらは。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "それは止めるときに使うよ。真ん中の四角いボタンは、時間を変える物だよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "時間はこのままでいいね。下の四角いボタンは何。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "それは水の量。今は服が少ないから、変えなくても大丈夫。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "わかった。じゃあ、下の丸いほうを押すね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-05-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/05/audio/problem-1-04.mp3",
      "startMs": 230831,
      "endMs": 286759,
      "durationMs": 55928,
      "sha256": "4c321c5e987c114f941acc1daf9df35ef97fc0f6ca2e0585d5badca08a6df4e0",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で学生二人が話しています。男の学生は、どこで写真を撮りますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "クラスの写真、学校の門の前で撮ろうか。みんな、そこに来られるよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "門は今、工事をしているから使えないよ。図書館の前なら広いけど。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "教室の中でもいいかな。雨が降りそうだし。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "教室は少し暗いから、きれいに撮れないと思う。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "体育館はどう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "きょうはほかのクラスが使うよ。まだ雨が降っていないから、外で撮ろう。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうだね。じゃあ、図書館の前に集まってもらうね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-05-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/05/audio/problem-1-05.mp3",
      "startMs": 286759,
      "endMs": 349865,
      "durationMs": 63107,
      "sha256": "793d42a7f563aec2d07f0e3b853d32e8f96228d5bb15f3b38322a5504dc8e000",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "事務所で、女の人と男の人が手紙を送る準備をしています。女の人は、先に何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "手紙と紙を全部入れました。封筒を閉じてもいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ちょっと待ってください。赤い紙も入れましたか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。白い紙と一緒に入れました。入れないほうがいいんですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "赤い紙はこちらで使います。出して、わたしの机に置いてください。白い紙だけ送ります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "わかりました。住所はもう書いてあります。切手も貼りました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ありがとうございます。赤い紙を出したら、封筒を閉じていいですよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。机の上に置いてから閉じますね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-05-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/05/audio/problem-1-06.mp3",
      "startMs": 349865,
      "endMs": 409879,
      "durationMs": 60013,
      "sha256": "2502c8b044c2fa7a6db0fcb04fa8f6f379e76dc000d86f906c78f46790c87832",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "友だちの家で、男の人と女の人が話しています。男の人は、どうやって家へ帰りますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "もうこんな時間だね。バスはまだあるかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "このバスは九時で終わりだよ。今、九時半だから、もうないね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "じゃあ、タクシーを呼ぼうかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "駅まで十分歩けば、電車はまだあるよ。タクシーは高いから。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうだね。道は明るい。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "うん、大きい道でまっすぐだよ。車で送ってあげたいけど、きょうは兄が使っているの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "大丈夫。駅まで歩くよ。電車のほうが安いから、その方法にするね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-05-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/05/audio/problem-1-07.mp3",
      "startMs": 409879,
      "endMs": 471823,
      "durationMs": 61944,
      "sha256": "9efc18ba394fd6de5413aef13724872259737c896da9d63553058039ab487b97",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "教室で先生と女の学生が話しています。女の学生は、先生に何を渡しますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、このノートと紙を出せばいいですか。本も持って来ました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ノートは自分で持っていてください。きょう出すのは、この二枚の紙です。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "一枚は宿題で、もう一枚は名前を書く紙ですね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。両方に名前を書いてください。名前を書く紙は、上のところだけでいいです。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "本は来週の授業で使うんですよね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうです。本もノートも、かばんに戻していいですよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。二枚とも名前を書いたので、お願いします。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-05-v1-listening-2-01",
      "group": 2,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-v1/assets/jlpt-original/n5/05/audio/problem-2-01.mp3",
