      "sha256": "286ecd448188a9a233b60434ef23618f4c9701c71f8c0b327570bc18303526de",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "この荷物、持ってもらえる？"
        },
        {
          "actor": "option-1",
          "role": "youngMale",
          "text": "いいよ。どこまで運ぶ？"
        },
        {
          "actor": "option-2",
          "role": "youngMale",
          "text": "もう持ってくれたんだね。"
        },
        {
          "actor": "option-3",
          "role": "youngMale",
          "text": "荷物は昨日届いたよ。"
        }
      ]
    },
    {
