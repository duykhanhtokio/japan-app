        {
          "actor": "option-1",
          "role": "femaleStudent",
          "text": "昨日は休みだったよ。"
        },
        {
          "actor": "option-2",
          "role": "femaleStudent",
          "text": "四時までの予定だよ。"
        },
        {
          "actor": "option-3",
          "role": "femaleStudent",
          "text": "教室は二階だよ。"
