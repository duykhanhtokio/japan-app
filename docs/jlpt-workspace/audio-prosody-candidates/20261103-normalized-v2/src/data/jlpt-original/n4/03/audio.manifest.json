  "items": [
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-1-01.mp3",
      "startMs": 46940,
      "endMs": 130503,
      "durationMs": 83563,
      "sha256": "deb9c8b08a147d349635d8c314340ab1412438e18de787c23827a5e0745ef831",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "自転車の店で、男の人と店員が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "自転車の後ろのタイヤから空気が抜けるんです。朝入れたのに、帰るころにはまた柔らかくなっていました。修理をお願いできますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "もちろんです。中のゴムに穴があるか調べましょう。自転車はどこにありますか。ここへ持ってきましたか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "入口の横に置きました。買い物の袋を後ろのかごに入れたままです。袋を取ってから、中に運べばいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "自転車は私が運びますから、先に袋を持ってきてください。野菜が入っているなら、作業の間はこの涼しい所に置いておけますよ。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ありがとうございます。どのくらいかかりますか。直るまで店で待っていようと思っているんですが、夕方までかかるでしょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "穴が小さければ三十分くらいです。まず荷物を取ってきてください。そのあと、自転車を見て、終わる時間をお伝えします。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-1-02.mp3",
      "startMs": 130503,
      "endMs": 215708,
      "durationMs": 85205,
      "sha256": "f0f5069278a1a2bf78aea42e5e15cc90bd9d893ad88660c249088ff00c33e250",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で、学生と先生が話しています。学生は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、発表に使う写真を印刷したんですが、黒い線が入ってしまいました。このまま使うと見にくいと思います。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうですね。教室の機械は昨日から調子が悪いんです。職員室の機械で印刷し直しましょう。元の写真は持っていますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "携帯電話に入っています。でも、職員室に行く前に、発表の文章を直したほうがいいでしょうか。最後の文が少し長いので。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "文章は発表までに直せば大丈夫です。まず、写真を私のメールに送ってください。私のパソコンから印刷します。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "写真は三枚あるんですが、全部送りますか。一枚目だけはきれいに印刷できています。残りの二枚に線が入っています。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "では、二枚目と三枚目だけ送ってください。届いたら私が印刷します。あなたはその間に、文章を短くしておいてください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-1-03.mp3",
      "startMs": 215708,
      "endMs": 292711,
      "durationMs": 77003,
      "sha256": "b5928d595227fc3f66597b3c59c4dbd3fbee7abc4d40e76e469c3b5381d6be88",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、二人が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "明日、親戚が泊まりに来るんだったね。布団はもう出した？今から押し入れの物を動かそうと思うんだけど。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "布団は昼に出して、干してある。まだベランダにあるけど、その前に客の部屋を掃除してくれる？床にほこりがあるの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "わかった。掃除機を持ってくるね。机や椅子も動かしたほうがいいかな。布団を二枚広げるなら、少し狭そうだよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "椅子はもう廊下に出したから大丈夫。先に床に置いてある本を棚に戻して。掃除機はそれからかけてほしい。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "本はどこの棚に入れればいい？いつも使っている本だったら、居間に持っていったほうが便利じゃないかな。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "客の部屋の棚でいいよ。私があとで並べるから、今は空いている所へ入れておいて。終わったら掃除機をお願い。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-1-04.mp3",
      "startMs": 292711,
      "endMs": 374215,
      "durationMs": 81504,
      "sha256": "b3bb6905f3abf57234b2f27a5c0f3312f330098d8930bdb263a6a42406efffa9",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "スーパーで、店長と店員が話しています。店員は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "店長、入口に置く果物が届きました。すぐ並べていいですか。午前中はまだお客さんが少ないので、今なら作業できます。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "その前に値段を確認してください。今日はりんごだけ安くすることになりました。昨日の札では高いままなんです。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。新しい札を作りますね。みかんの値段も変わりますか。箱に貼ってある紙には、前より安い値段が書いてあります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "それは店が仕入れた値段です。売る値段は変えません。りんごの新しい値段は、机にあるノートに書いてあります。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先にノートを見て、それから札を作ればいいですね。入口の台はもう拭いたので、果物はすぐ置けると思います。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうです。まず値段を見てください。札ができたら、箱からりんごを出して並べましょう。みかんは私があとで運びます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-1-05.mp3",
      "startMs": 374215,
      "endMs": 459879,
      "durationMs": 85664,
      "sha256": "bba4e9eb4c035fd8546bab486b5c1b681f1808ed547c90cf9191ac82156ee5c5",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "電話で、男の人と荷物の配達の人が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "荷物を受け取れなかったので、電話しました。紙には今日の夕方にもう一度届けると書いてありますが、夕方も家にいないんです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、明日の午前はいかがですか。九時から十二時までなら届けられます。ご都合のよい時間を教えてください。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "明日は家にいます。でも、大きい棚なので、一人で部屋に運べるか心配です。玄関まで運んでもらえますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "玄関までお持ちします。箱が大きいので、玄関の幅を先に測っていただけますか。狭い場合は別の入口を使う必要があります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "玄関には靴の棚があります。先にそれを動かしたほうがいいでしょうか。棚を動かせば、少し広くなると思います。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "まず幅を測ってください。八十センチ以上あれば、靴の棚は動かさなくて大丈夫です。測ったら、もう一度こちらにお電話ください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-1-06.mp3",
      "startMs": 459879,
      "endMs": 541287,
      "durationMs": 81408,
      "sha256": "0db29223150d8743bad5cf3258e9f0dc90fe88a39bfdcc6cbcf66c7c4af37604",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "料理教室で、先生と参加者が話しています。参加者は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "野菜は全部切りました。次は鍋に入れて煮ればいいですか。水も用意しましたが、どのくらい入れるかわかりません。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "鍋に入れるのは、まだです。今日は野菜を先に炒めます。そのほうが味がよくなります。フライパンは出しましたか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "はい。でも、野菜を切るのに使った包丁とまな板が、机の上に残っています。洗っておいたほうがいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "もう包丁は使いませんから、先に洗ってください。机の上を広くしてから、フライパンを置きましょう。油は私が用意します。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。水はこのまま置いておきますね。野菜は皿に入れてあるので、机を片づけても大丈夫です。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そうしてください。包丁とまな板を洗ったら、ここへ戻ってきてください。炒めるときの火の強さを一緒に確認しましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-1-07.mp3",
      "startMs": 541287,
      "endMs": 622961,
      "durationMs": 81675,
      "sha256": "2b0108076c952c3259291c32eb8bcd326b021ec893c9dd46a9d7a65d2b5d2a9d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "駅で、男の人と駅員が話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "すみません。電車に帽子を忘れました。さっきこの駅に着いた電車です。青い帽子で、席の上の棚に置いていました。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今、忘れ物が届いているか確認しますね。帽子のほかに、何か置いていませんでしたか。かばんなどは大丈夫ですか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "かばんは持っています。帽子だけです。終点まで行けば探せますか。次の電車に乗って追いかけようと思うんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "まず、こちらの紙に、乗った電車と連絡先を書いてください。終点の駅に連絡しますので、急いで行かなくても大丈夫です。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
