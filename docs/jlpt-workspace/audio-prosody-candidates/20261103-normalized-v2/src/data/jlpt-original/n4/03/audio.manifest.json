      "durationMs": 39032,
      "sha256": "0fa24a643f7a60b11774506ab5179dd3baacfea119eb34a235ef3f8869e4ec4b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "友達の家で、あなたは帰ろうとしています。友達が夕食も食べていくように誘います。今夜は家族と食べるので断りたいです。何と言いますか。"
        },
        {
          "actor": "option-1",
          "role": "femaleStudent",
          "text": "ありがとう。でも今日は家で食べるので。"
        },
        {
          "actor": "option-2",
          "role": "femaleStudent",
          "text": "ありがとう。家族も呼びましょう。"
        },
        {
          "actor": "option-3",
          "role": "femaleStudent",
          "text": "ありがとう。では、夕食もいただきます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-4-01",
      "group": 4,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-4-01.mp3",
