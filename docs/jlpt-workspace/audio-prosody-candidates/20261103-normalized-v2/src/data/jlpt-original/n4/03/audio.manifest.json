      "sha256": "bcbfd9c80e043e23b0ef722dc0e707ff6475f8ded79fdf596a3037541c78b876",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "絵を見てください。男の人は、同僚から書類を預かりました。会議室へ届けますが、誰に渡すのかわかりません。同僚に何と言いますか。"
        },
        {
          "actor": "option-1",
          "role": "youngMale",
          "text": "この書類は、どなたが渡してくださいましたか。"
        },
        {
          "actor": "option-2",
          "role": "youngMale",
          "text": "この書類は、どなたに渡せばいいですか。"
        },
        {
          "actor": "option-3",
          "role": "youngMale",
          "text": "この書類は、どなたに返してもらいましたか。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-03-v1-listening-3-05",
      "group": 3,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/03/audio/problem-3-05.mp3",
