      "sha256": "025e2a148e84e3a1f8838ad7f96a74c73240b135997da606a057d7528fa5116b",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "この箱、どこに置けばいい？"
        },
        {
          "actor": "option-1",
          "role": "femaleStudent",
          "text": "棚の一番下にお願い。"
        },
        {
          "actor": "option-2",
          "role": "femaleStudent",
          "text": "もう置いてあるはずだよ。"
        },
        {
          "actor": "option-3",
          "role": "femaleStudent",
          "text": "昨日そこに置いたよ。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-4-02",
      "group": 4,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-4-02.mp3",
