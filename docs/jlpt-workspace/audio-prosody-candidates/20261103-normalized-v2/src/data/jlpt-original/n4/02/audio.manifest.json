      "sha256": "38199f3cb226139688bb934852ca269f3d100071d3948dc538c2b27cbdeef8bd",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "店で、男の人は雨の日に使う靴を選んでいます。二種類あり、どちらが滑りにくいかわかりません。店員に何と言いますか。"
        },
        {
          "actor": "option-1",
          "role": "youngMale",
          "text": "雨の日に滑りにくいのは、どちらですか。"
        },
        {
          "actor": "option-2",
          "role": "youngMale",
          "text": "雨の日に履いたのは、どちらでしたか。"
        },
        {
          "actor": "option-3",
          "role": "youngMale",
          "text": "雨の日まで取っておくのは、どちらですか。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-3-05",
      "group": 3,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-3-05.mp3",
      "startMs": 1613361,
      "endMs": 1654260,
      "durationMs": 40899,
      "sha256": "b29de0e62c0b5e2b9ab31d03d4d3a6a1bdc699ec49a492e4ad29238e921765a2",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "会社で、女の人がコピーをしていると、機械に紙がつまってしまいました。次に使おうとした同僚に、直るまで待ってほしいです。何と言いますか。"
        },
        {
          "actor": "option-1",
          "role": "adultFemale",
          "text": "紙を出しましたから、もう使ってもらえますか。"
        },
        {
          "actor": "option-2",
          "role": "adultFemale",
          "text": "紙がつまったので、少し待ってもらえますか。"
        },
        {
          "actor": "option-3",
          "role": "adultFemale",
          "text": "コピーが終わりましたから、紙を取ってもらえますか。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-4-01",
      "group": 4,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-4-01.mp3",
