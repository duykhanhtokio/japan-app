          "actor": "option-1",
          "role": "youngMale",
          "text": "砂糖を入れたほうがいいですよ。"
        },
        {
          "actor": "option-2",
          "role": "youngMale",
          "text": "砂糖を入れておきますね。"
        },
        {
          "actor": "option-3",
          "role": "youngMale",
          "text": "砂糖は入れないでください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-3-04",
      "group": 3,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-3-04.mp3",
