      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "明日も同じ時間に来られますか。"
        },
        {
          "actor": "option-1",
          "role": "youngMale",
          "text": "はい、三時に来たそうです。"
        },
        {
          "actor": "option-2",
          "role": "youngMale",
          "text": "はい、昨日も来ました。"
        },
        {
          "actor": "option-3",
          "role": "youngMale",
          "text": "はい、三時で大丈夫です。"
        }
      ]
