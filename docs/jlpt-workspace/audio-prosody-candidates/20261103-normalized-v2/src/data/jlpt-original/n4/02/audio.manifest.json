  "items": [
    {
      "questionId": "jpapp-n4-original-02-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-1-01.mp3",
      "startMs": 46940,
      "endMs": 127644,
      "durationMs": 80704,
      "sha256": "b844cfb008c56f9515fa656b1e83f2630ad965e4660746c63039684f65f893c3",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "陶芸教室で、女の人と先生が話しています。女の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、今日作ったお皿は、もう持って帰れますか。机の上でずいぶん乾いたように見えます。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "まだです。今、手で持つと形が変わってしまいます。少なくとも来週までは、ここに置いておきましょう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "では、このまま棚に置けばいいですか。前に作った茶わんは、かごに入れた覚えがあります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今日は作品が多いので、かごは使いません。先に、お皿の底に自分の名前を書いてください。みんなのお皿が似ているので、あとで誰のものかわからなくなります。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "紙に名前を書いて、横に置いてもいいですか。底を触るのが少し心配です。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "紙はなくなることがありますから、底に小さく書きましょう。この棒を使えば、強く押さなくても書けます。名前が書けたら、私が棚へ運びます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-1-02.mp3",
      "startMs": 127644,
      "endMs": 214929,
      "durationMs": 87285,
      "sha256": "9ee3a39c7e4b2f6380b87796cde9525ca90ecc49082206e60fe03ed78f746c90",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、兄と妹が旅行の準備について話しています。妹は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "旅行の切符は買った？明日の朝は早いから、今日のうちに確認しておこう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "切符はかばんに入れたよ。でも、おばあちゃんに持っていく写真が見つからないの。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "先月みんなで撮った写真？本棚の箱の中じゃないかな。僕はまだ見ていないけど。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "そこはさっき探した。前にお母さんが、写真をきれいに並べるって言っていたから、お母さんに電話してみようかな。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今は仕事中だよ。あ、居間の引き出しに、新しいアルバムがあった。まず、それを見てみたら？"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかった。写真があったら、アルバムごと持っていくね。おばあちゃん、前の旅行の写真も見たがっていたから。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "全部は重いと思う。必要な写真だけ小さな袋に入れるほうがいいよ。それから、飲み物も用意しよう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "うん。でも、先に写真を探す。飲み物はあとでも買えるし、切符ももう入れたから。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-1-03.mp3",
      "startMs": 214929,
      "endMs": 289372,
      "durationMs": 74443,
      "sha256": "2f0e4de2fb58f0133f346e6b5cba93c30335025bcf2bd9768215100ed6d4bd26",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "クリーニング店で、客と店員が話しています。客は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "この上着をお願いしたいんですが、ポケットの中に紙を入れたままかもしれません。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "では、先にポケットを確かめてください。紙が入っていると、水で洗うときに問題になることがあります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "はい。あ、ここにありました。レシートだけですね。これを出せば預けられますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "上着の中にも小さなポケットがありませんか。そこも見ていただけますか。こちらでは大事なものが入っていても気づかないことがあります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "そうでした。この前、鍵をそこに入れました。外側だけでなく、中も確認します。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "お願いします。確認が終わったら、このカードにお名前と電話番号を書いてください。お渡しできる日は土曜日です。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-1-04.mp3",
      "startMs": 289372,
      "endMs": 364529,
      "durationMs": 75157,
      "sha256": "679ad1f9e13cbbf18550572da460cd9de4cd003fd09bb427bfba04ae68b6b55f",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "職場で、二人が共有の机について話しています。男の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "この机を会議室へ運んでもいいですか。午後の打ち合わせで人数が増えたので、机が足りないんです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "この机は使っていませんから、大丈夫です。でも、そのまま動かすのは難しいですよ。上の箱が重いので。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "箱を床に下ろしましょうか。中身が書類なら、別の棚に入れることもできます。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "中には小さな部品が入っています。床だと誰かが足をぶつけるかもしれません。空いている棚は、今から確認します。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "じゃあ、私も棚を探します。隣の部屋に置ける場所がありますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その前に、机の引き出しからテープを取って、この箱のふたを閉めておいてください。部品がこぼれたら大変ですから。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-1-05.mp3",
      "startMs": 364529,
      "endMs": 435452,
      "durationMs": 70923,
      "sha256": "91cc4686dec5414d4b7fb1b723d06b8f1ad531c35daa1f5db9e912487fbb69af",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "花屋で、客と店員が話しています。客は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "友達の開店祝いに花を送りたいんですが、花の種類を先に選べばいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "花を選ぶ前に、届く日と時間を決めましょう。お店はもう開いていますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "来週の月曜日に開きます。前の日に届くほうが、準備ができていいと思ったんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "日曜日はお店に誰かいますか。誰もいないと、お届けできません。月曜日の朝でも間に合うと思いますよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "友達は日曜日も準備していると言っていました。でも、何時に行くかは聞いていません。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "では、今、お友達に連絡して、日曜日に受け取れる時間を確かめてください。それがわかってから、花を選びましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-1-06.mp3",
      "startMs": 435452,
      "endMs": 515943,
      "durationMs": 80491,
      "sha256": "11d82838299e3338533bc01bc6b6a48ebc7254bac8dff3427ef32d6c466c2bba",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で、学生と職員が学生証について話しています。学生は、このあと、まず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "学生証をなくしてしまいました。新しく作ってもらいたいんですが、どこへ行けばいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ここで申し込めますよ。ただ、先に落とし物の窓口へ行きましたか。今朝、何枚か学生証が届いています。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "いいえ、まだです。昨日の夕方、体育館の前で使ったのが最後だと思います。名前を言えば調べてもらえますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。窓口は、この建物の一階です。見つからなかったら、ここへ戻って、この用紙を書いてください。新しく作るには写真も必要です。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "写真は家にあります。今日中に新しい学生証ができないと、図書館に入れないですよね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "作るのに三日かかりますが、申込みが済めば、その間使える紙を渡します。それで図書館にも入れます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n4-original-02-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n4/02/audio/problem-1-07.mp3",
      "startMs": 515943,
      "endMs": 606327,
      "durationMs": 90384,
      "sha256": "b145fb3f2eb1b3ce1edbfcfed5c52b1c90fe49a98169d9c389dab189c199d968",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で、二人が共同の自転車置き場について話しています。女の人は、このあと、まず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "管理人さんから手紙が来たね。使っていない自転車を片づけるため、持ち主を調べるそうだよ。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "私の自転車は毎日使っているから、そのままでいいよね。新しい番号のシールが入っているけど。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "毎日使う人も、今週中にこのシールを貼る必要があるって書いてある。貼っていない自転車は、来月、別の場所へ移すんだって。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "そうなんだ。でも、自転車のどこに貼るの？前のシールは泥で汚れて見えなくなった。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今回のは座るところの下だね。汚れている場合は、先にその場所を拭いて、乾いてから貼ってくださいって。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "昨日雨の中で乗ったから、まだ汚れていると思う。今、布を持って見に行くね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "シールも持っていけば、きれいになったらすぐ貼れるよ。自転車を移す必要はないから。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
