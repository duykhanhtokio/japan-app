      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "貸してくれた傘、助かったよ。ありがとう。"
        },
        {
          "actor": "option-1",
          "role": "femaleStudent",
          "text": "こちらこそ、お借りします。"
