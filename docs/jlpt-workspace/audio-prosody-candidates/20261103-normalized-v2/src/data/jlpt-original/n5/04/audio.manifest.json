    {
      "questionId": "jpapp-n5-original-04-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n5/04/audio/problem-1-01.mp3",
      "startMs": 47431,
      "endMs": 111785,
      "durationMs": 64355,
      "sha256": "9ef58b0c697808bbd2d4509cda0670eb63aaa2475b63eeafd80114495475093d",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "集会の前に、女の人と男の人が部屋で話しています。男の人は、まず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "もうすぐみんなが来ますね。いすを並べましょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "お願いします。でも、部屋が暑いですね。先に窓を開けてください。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい。入口の横と、奥にある窓ですね。花はどこに置きますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "花はわたしが運びます。机の上に置きたいです。いすは机の前に十個お願いします。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "十個ですね。床の掃除は、もう終わっていますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ええ、きれいです。窓を開けたら、いすを並べてください。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "わかりました。暑いから、二つとも開けますね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-04-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n5/04/audio/problem-1-02.mp3",
      "startMs": 111785,
      "endMs": 173793,
      "durationMs": 62008,
      "sha256": "39ff8986288b63fcb075abab6b875f240f122e77fe9b6b9da03bbfb76532766e",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で先生と女の学生が、あしたの授業について話しています。女の学生は、どれを持って来ますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "先生、あしたは絵を描くんですよね。絵の具を持って来ますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "あしたは小さいカードを作ります。絵の具は使いません。色えんぴつは持っていますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "はい、家にあります。カードに貼る写真も持って来ますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "写真はこちらで用意します。好きな動物の写真を選んでください。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "写真を切るはさみも必要ですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はさみは学校の物を使います。色えんぴつだけ忘れないでくださいね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "わかりました。帰ったら、かばんに入れます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-04-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n5/04/audio/problem-1-03.mp3",
      "startMs": 173793,
      "endMs": 236740,
      "durationMs": 62947,
      "sha256": "5430c26646ee9f7472b0212b32781818b4d3ed29cdcd5ebfca4981ed276a9602",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "スーパーで女の人と男の人が話しています。女の人は、これから何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "このりんご、お母さんに少し渡したいな。でも、全部一つの袋に入っているね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "売り場に小さい袋があったよ。戻って取って来ようか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "あの袋は野菜用でしょ。持って帰れる袋がほしいの。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "それなら、レジの人にもらえるよ。この店で買った物を入れる小さい袋は無料だって。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "そうなんだ。大きい袋は買わなくていいね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "うん。レジはあっちだよ。ぼくはここで待っているね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ありがとう。りんごを三つ渡すから、小さい袋を頼んで来るね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-04-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n5/04/audio/problem-1-04.mp3",
      "startMs": 236740,
      "endMs": 294407,
      "durationMs": 57667,
      "sha256": "82364de0cb4e8f1300edcc44eaa77e7663202aefc2c36a3c872a5aa7b75a4a48",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校で学生二人が、勉強する場所について話しています。男の学生は、どこで待ちますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "一階の入口で待っていたけど、来なかったね。どこにいたの。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "ごめんね。二階の教室を使いたいから、先生に聞いていたの。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "使えるなら、今から二階へ行こう。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "まだ別の授業をしているよ。あと十分で終わるから、廊下で待とう。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "図書館の中で待つのはどう。いすがあるよ。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "今日は図書館が休みなんだ。廊下にもベンチがあるから大丈夫。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうか。じゃあ、二階へ行って、そこで待つね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-04-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n5/04/audio/problem-1-05.mp3",
      "startMs": 294407,
      "endMs": 352297,
      "durationMs": 57891,
      "sha256": "c0dade2c7a6a3860ba80d2237d8e9bd1b300bd6116a0422c0fc9c976286cad0a",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "家で女の人と男の人が晩ごはんについて話しています。男の人は、何を買いますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "これから買い物に行くけど、晩ごはんに何が必要。肉を買おうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "肉は冷蔵庫にあるよ。きょうはそれを使って、卵とねぎも入れたいな。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "卵は二つ残っていなかった。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "朝ごはんに全部使ったの。ねぎもないから、両方お願い。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "わかった。豆腐はどう。きのうも食べたけど。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "豆腐はまだ一つあるから、買わなくていいよ。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "じゃあ、足りない二つを買って来るね。ほかの物は家にあるんだね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-04-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n5/04/audio/problem-1-06.mp3",
      "startMs": 352297,
      "endMs": 414177,
      "durationMs": 61880,
      "sha256": "43b4dbab69133f8951b0672b29b340a355b3c4b717e087a252fbc851811e259e",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "学校の図書館で学生二人が話しています。女の学生は、本を返す前に何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "この本、きょう返す日だった。急いで返して来るね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ちょっと待って。中に白い紙が入っているよ。授業で使った紙じゃない。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "あ、本当だ。大事な紙だから、取ってから返すね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "本の名前も書いておいたら。また借りたいって言っていたよね。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "名前はもうノートに書いたよ。袋もいらないね。すぐそこだから。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "うん。図書館の人に電話する必要もないよ。まだ開いているから。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "よかった。紙は、なくさないようにノートにはさんでおくね。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-04-v1-listening-1-07",
      "group": 1,
      "number": 7,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n5/04/audio/problem-1-07.mp3",
      "startMs": 414177,
      "endMs": 476516,
      "durationMs": 62339,
      "sha256": "0780f967f39ba173c756973acb834d3ee89b1bee638d8a8c01c6b9f55e2e9bf2",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "narrator",
          "role": "adultFemale",
          "text": "病院の前で女の人と男の人が話しています。女の人は、どこに自転車を置きますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "すみません。自転車は入口の前に置いてもいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "そこは車が来るので、置かないでください。置く場所が変わったんです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "前は隣のお店の横でしたよね。そちらへ行けばいいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今は建物の後ろです。右側の道を少し歩くと、自転車の絵があります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "道の向こう側ではないんですね。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "はい、道を渡らなくて大丈夫です。お店の横は車の場所になりました。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "わかりました。後ろに置いてから、入口に戻って来ます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n5-original-04-v1-listening-2-01",
      "group": 2,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n5/04/audio/problem-2-01.mp3",
