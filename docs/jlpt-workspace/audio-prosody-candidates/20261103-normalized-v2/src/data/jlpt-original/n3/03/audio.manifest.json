  "items": [
    {
      "questionId": "jpapp-n3-original-03-v1-listening-1-01",
      "group": 1,
      "number": 1,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n3/03/audio/problem-1-01.mp3",
      "startMs": 46023,
      "endMs": 132159,
      "durationMs": 86136,
      "sha256": "dc0559de61acdca4de0ccfad440f7d90f98af15eb1ff91907c5d84be381d39f6",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "明日の町歩きの案内札、これで全部でしょうか。開始時刻も書きましたし、今から壁に貼っておこうと思っていたんですが。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "数はそれで全部です。ただ、天気予報が変わって、午前中に少し雨が降るかもしれません。紙のままだと、外に置く札はぬれてしまいますね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "では、全部を透明の袋に入れましょうか。袋は道具の棚にあります。中の会場で使う物も、一緒に入れれば間違えません。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "中で使う物は、そのままで大丈夫です。袋も足りないので、まず屋外用の札だけ箱から選び出してください。裏に小さく外と書いてあります。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "外の札だけですね。入口の外へ持っていって、場所を確かめながら選んだほうがいいですか。札の文字は、離れても読めるでしょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "まだ外に出さなくていいですよ。ここで種類を分けてから、私が袋の大きさを確かめます。貼る場所は、あとで会場の人と相談して決めます。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-03-v1-listening-1-02",
      "group": 1,
      "number": 2,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n3/03/audio/problem-1-02.mp3",
      "startMs": 132159,
      "endMs": 216727,
      "durationMs": 84568,
      "sha256": "794233a924dc6d351ea5bb7732394ec9eba496e6eca98ef8aa74f48f2362a468",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "朗読の録音が終わりました。画面では音の印が動いていたので、ちゃんと入っていると思います。このまま担当の人に送ってもよいでしょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "その前に、実際の音を聞いてみてください。途中でマイクの位置が変わっていたので、後半だけ小さくなっているかもしれません。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今、ここで再生しますか。隣の部屋で打ち合わせをしているようですけれど、小さな音なら邪魔にならないと思います。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "机の引き出しにあるイヤホンを使って、最初と最後を確かめてください。声が小さければ、全体を録り直さずに、音の大きさを調整できる場合もあります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "ファイル名に今日の日付を入れたほうが、分かりやすいですよね。名前を変えてから聞いて、問題がなければ元のファイルは消しておきます。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "元は消さずに残してください。調整する場合は、別の名前で保存します。ファイル名を変える前に、まず音が入っているか確かめましょう。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-03-v1-listening-1-03",
      "group": 1,
      "number": 3,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n3/03/audio/problem-1-03.mp3",
      "startMs": 216727,
      "endMs": 296623,
      "durationMs": 79896,
      "sha256": "6e1654adae65b89dbd5adf720d995ec47e7d18e79ab5a19d0eca3077a7a91ebe",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "舞台の背景に使う布、机の上の物で足りますか。長い物は運びにくいので、半分に切っておけば、明日の準備が楽になると思うんですが。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "ちょっと待って。ここには、使ってもいい布と、切らずに返す約束で借りた布が混ざっているんだ。見た目は似ているけれど、扱いが違う。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "そうなんだ。色ごとに分けていたから、全部同じように使えると思っていたよ。どれを返すかは、端に付いている番号で分かるのかな。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "番号と、この貸出の記録を比べれば分かる。先に、机の布の番号が記録と合っているか確認してもらえるかな。使っていい物には丸が付いている。"
        },
        {
          "actor": "femaleStudent",
          "role": "femaleStudent",
          "text": "記録にあるのに、ここにない番号があったらどうする。足りなければ、買いに行く時間も考えないといけないよね。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "見つからない物は紙に書いておいて。隣の箱に入っている場合もあるから、僕があとで調べる。今日は買いに行かなくても大丈夫だと思う。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-03-v1-listening-1-04",
      "group": 1,
      "number": 4,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n3/03/audio/problem-1-04.mp3",
      "startMs": 296623,
      "endMs": 387964,
      "durationMs": 91341,
      "sha256": "fdfd71ac5b920d51e9a371408b6d7792d83b41fbc43274f66664840c07c83675",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "工事のため通れない所を、案内図に反映したいんですが、新しい地図を作り始めてもいいですか。今の図を全部描き直すと、かなり時間がかかりそうです。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "まず、古い案内図に、変わった所だけ印を付けてください。工事中の通路と、代わりに使う入口が分かれば、担当の人が正しいか確認できます。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "入口の看板も外したほうがいいでしょうか。前のままだと、そちらから入れると思う人がいるかもしれません。地図と看板を同時に直せば安心ですね。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "看板には入口の名前だけ書いてあるので、そのままで大丈夫です。地図の矢印が通れない道を指しているので、そこを直す必要があります。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "では、まず変更を紙に示すんですね。赤い線で通れない道を消して、青い線で新しい道を書けば、見比べやすいでしょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "ええ、その方法でお願いします。確認が済んだら、きれいな図にして印刷します。途中の段階で印刷すると、間違った図が残るので気を付けてください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-03-v1-listening-1-05",
      "group": 1,
      "number": 5,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n3/03/audio/problem-1-05.mp3",
      "startMs": 387964,
      "endMs": 471433,
      "durationMs": 83469,
      "sha256": "697177164ea5960cb5888869b1e1d08773a93fb4712124352830ad8a0c820d56",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "女の人は、このあとまず何をしますか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "料理を入れた箱を車へ運んでもいいですか。車はもう外で待っています。箱のふたも閉じていますし、持ち手はしっかりしています。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "運ぶ前に、箱の中の温度を一度見てください。小さな温度計を上に置いてあります。今の温度が分からないと、保冷剤を足すか決められません。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "外の空気は涼しいですけれど、それだけでは判断できないんですね。ふたを開けたまま少し外に置いて、冷ましてから運んだほうがいいでしょうか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "箱を開けて外に置くのはやめましょう。中を確認したら、すぐふたを閉めてください。今は温度を確かめることが先です。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "分かりました。温度計は上にあるんですね。数字を読んで、ここにある紙に書きますか。それとも、そのまま口で伝えればよいですか。"
        },
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "読んだ数字を私に伝えてください。記録は私が付けます。保冷剤がまだ使えるかも、こちらで確かめるので、勝手に捨てないでください。"
        }
      ]
    },
    {
      "questionId": "jpapp-n3-original-03-v1-listening-1-06",
      "group": 1,
      "number": 6,
      "path": "docs/jlpt-workspace/audio-prosody-candidates/20261103-normalized-v2/assets/jlpt-original/n3/03/audio/problem-1-06.mp3",
      "startMs": 471433,
      "endMs": 560524,
      "durationMs": 89091,
      "sha256": "57077f9fa7d3e350bd4936c56a0257cff06821cc41cf93a98aaeaf1d7e4eebf3",
      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "男の人は、このあとまず何をしますか。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "先輩、この古い作業記録、文字が薄くて読めない所があります。上からなぞれば、あとで使う人も読みやすくなると思うんですが、書いてもいいですか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "原本には書き込まないでください。今見える文字が、あとで調べる手掛かりになるかもしれません。違う字を書いてしまうと、元の状態が分からなくなります。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "そうですね。ただ、分からない所をそのままにすると、次に読む人も困りませんか。別の資料を注文して、こちらは片付けたほうがよいでしょうか。"
        },
        {
          "actor": "adultFemale",
          "role": "adultFemale",
          "text": "この記録は一枚しかないので、注文はできません。まず、読めない部分の場所を、別の紙に書き出してください。何行目のどの辺りか分かれば十分です。"
        },
        {
          "actor": "youngMale",
          "role": "youngMale",
          "text": "読めそうな文字があっても、予想で埋めないほうがいいんですね。読めた部分も全部写して、最初から書き直しますか。"
        },
        {
