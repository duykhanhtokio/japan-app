      "playbackReviewed": false,
      "turns": [
        {
          "actor": "adultMale",
          "role": "adultMale",
          "text": "今日の説明、例があったので分かりやすかったです。"
        },
        {
          "actor": "option-1",
          "role": "adultFemale",
          "text": "では、次の説明が終わるまで待っていてください。"
        },
        {
          "actor": "option-2",
          "role": "adultFemale",
          "text": "例は別の時間に初めて紹介する予定です。"
        },
        {
          "actor": "option-3",
          "role": "adultFemale",
          "text": "そう言っていただけてよかったです。"
        }
      ]
    },
