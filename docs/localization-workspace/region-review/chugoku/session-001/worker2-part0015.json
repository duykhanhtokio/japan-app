n and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-LOC-SMN-ODA-03-001-SHARED-09"},{"scenarioId":"SC-LOC-SMN-ODA-03-001","locale":"vi","turn":10,"field":"translation","before":"Tôi về đường nhựa cùng người đi, lần sau chuẩn bị cả tất thay. Hôm nay tôi đổi kế hoạch.","after":"Tôi sẽ đi cùng người ấy quay lại theo đường trải nhựa, và lần sau sẽ chuẩn bị cả tất thay. Hôm nay tôi sẽ đổi kế hoạch.","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-LOC-SMN-ODA-03-001-SHARED-10"},{"scenarioId":"SC-LOC-SMN-ODA-03-001","locale":"vi","turn":11,"field":"translation","before":"Người cùng đã quay lại nhỉ. Chú ý dưới chân khi về.","after":"Người đi cùng đã quay lại rồi nhỉ. Khi về, anh/chị chú ý chỗ đặt chân nhé.","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-LOC-SMN-ODA-03-001-SHARED-11"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":1,"field":"translation","before":"Anh chị đang so bản đồ mang theo với sơ đồ này sao?","after":"Anh/chị đang so sánh bản đồ mang theo với sơ đồ hướng dẫn này phải không?","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-01"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":2,"field":"translation","before":"Bản đồ chỗ nghỉ cho có đường ven sông liên tục, nhưng ở đây nét đứt giữa. Tôi nên dựa bản nào đi?","after":"Bản đồ tôi nhận ở chỗ nghỉ có đường ven sông nối liền, nhưng trên sơ đồ này đường kẻ bị ngắt giữa chừng. Tôi nên dựa vào bản đồ nào để đi ạ?","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-02"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":3,"field":"translation","before":"Có thể bản cũ. Hôm nay anh chị đi đâu?","after":"Có thể đó là bản đồ cũ. Hôm nay anh/chị định đi đâu?","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-03"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":4,"field":"translation","before":"Tôi muốn xem dãy nhà cổ và về ga. Không ven sông cũng được.","after":"Tôi muốn vừa xem dãy nhà cổ vừa quay về ga. Không đi ven sông cũng được ạ.","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-04"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":5,"field":"translation","before":"Có đường qua cầu ra phố nhưng bản này không có thông tin thi công cầu. Xác nhận đi được trước đi nhé.","after":"Có đường qua cầu ra phố, nhưng bản đồ này không ghi thông tin thi công cầu. Trước khi đi, chúng ta kiểm tra xem có qua được không nhé.","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-05"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":6,"field":"translation","before":"Không dùng cầu sẽ vòng xa, anh chị cũng đánh dấu đường khi đó được không?","after":"Nếu không qua cầu được thì tôi sẽ phải đi vòng. Anh/chị đánh dấu giúp cả đường đi trong trường hợp đó được không ạ?","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-06"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":7,"field":"translation","before":"Được, tôi chỉ đường qua giao lộ bằng chấm. Có giờ về ga chưa?","after":"Được, tôi sẽ đánh dấu đường vòng qua giao lộ này bằng nét chấm. Anh/chị đã định giờ quay về ga chưa?","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-07"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":8,"field":"translation","before":"Tôi muốn đến ga lúc hai rưỡi. Tôi bỏ tham quan giữa, ưu tiên nắm đường về.","after":"Tôi muốn đến ga chậm nhất lúc hai giờ rưỡi. Tôi sẽ bỏ qua việc tham quan dọc đường, trước tiên xác định đường về.","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-08"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":9,"field":"translation","before":"Vậy xác nhận cầu rồi chọn phạm vi đi là tốt. Tôi ghi ngày hôm nay lên đây để khác bản chỗ nghỉ.","after":"Vậy nên kiểm tra tình trạng cầu rồi mới chọn phạm vi đi bộ. Tôi sẽ ghi ngày hôm nay lên bản này để phân biệt với bản đồ ở chỗ nghỉ.","reason":"Use complete natural Vietnamese and preserve cancellation, return route, map-line distinction and deadline meaning.","path":"src/data/dialogue-content/locale-batches/vi/226.json","turnId":"DLG-SC-SMN-ODA-001-SHARED-09"},{"scenarioId":"SC-SMN-ODA-001","locale":"vi","turn":10,"field":"translation","before":"May quá. Tôi dùng bản có ngày, nếu cầu không qua sẽ vòng đường chấm.","after":"May quá. Tôi sẽ dùng bản đồ có ghi ngày; nếu cầu không qua được thì đi vòng theo đường nét chấm.","reason":"Use complete natural Vietname